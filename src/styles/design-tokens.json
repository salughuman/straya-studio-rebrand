{
    "version": "2.2.0",
    "name": "Straya Studio Design Tokens",
    "description": "Single source for Straya Studio. Consumed only by tailwind.config.mjs (theme + addBase/addComponents); global.css must not redefine these values.",
    "media": {
        "_usedBy": "tailwind.config.mjs theme.screens",
        "breakpoints": {
            "sm": "390px",
            "md": "810px",
            "lg": "1200px",
            "xl": "1280px",
            "2xl": "1536px"
        }
    },
    "color": {
        "_usedBy": "tailwind.config.mjs theme.extend.colors — keys map to Tailwind class names; semantic --color-* in addBase derives from same object (no duplicates)",
        "primary": {
            "DEFAULT": "#FFEDD7",
            "container": "#FFF4EB",
            "on": "#000000",
            "onContainer": "#000000"
        },
        "secondary": {
            "DEFAULT": "#DC5000",
            "container": "#FF7A2E",
            "on": "#000000",
            "onContainer": "#000000"
        },
        "background": {
            "DEFAULT": "#080605",
            "surface": "#080605",
            "surfaceDim": "#140E09",
            "surfaceBright": "#1F140D",
            "containerLowest": "#080605",
            "containerLow": "#140E09",
            "container": "#382416",
            "containerHigh": "#5A3A24",
            "containerHighest": "#5A3A24"
        },
        "onBackground": {
            "DEFAULT": "#FFEDD7"
        },
        "onSurface": {
            "DEFAULT": "#FFEDD7",
            "variant": "rgba(255,237,215,0.72)"
        },
        "outline": {
            "DEFAULT": "#5A3A24",
            "variant": "#382416"
        },
        "inverse": {
            "surface": "#FFEDD7",
            "onSurface": "#000000",
            "panel": "#F6E0C6"
        },
        "accent": "#DC5000",
        "status": {
            "success": "#2ECC71",
            "error": "#E74C3C"
        },
        "border": {
            "default": "rgba(255,237,215,0.16)",
            "subtle": "rgba(255,237,215,0.08)",
            "strong": "rgba(255,237,215,0.22)"
        },
        "text": {
            "primary": "#FFEDD7",
            "secondary": "rgba(255,237,215,0.72)",
            "inverse": "#000000"
        }
    },
    "typography": {
        "_usedBy": "tailwind.config.mjs plugin(addComponents); theme.extend.fontFamily; theme.extend.letterSpacing",
        "fontFamily": {
            "display": "'Spline Sans', 'Helvetica Neue', Arial, sans-serif",
            "body": "'Satoshi', system-ui, -apple-system, sans-serif",
            "mono": "'Satoshi', system-ui, -apple-system, sans-serif",
            "fallback": {
                "display": "'Helvetica Neue', Arial, sans-serif",
                "body": "system-ui, -apple-system, sans-serif",
                "mono": "system-ui, -apple-system, sans-serif"
            }
        },
        "style": {
            "_usedBy": "theme.extend.letterSpacing",
            "tightTracking": "-0.045em",
            "blueprintTracking": "0.05em",
            "normalTracking": "0"
        },
        "mono": {
            "_usedBy": "theme.extend.fontFamily.mono + `.type-mono`; --font-body equivalent for eyebrows / UI chrome",
            "fontFamily": "'Satoshi', system-ui, -apple-system, sans-serif",
            "fontSize": "clamp(0.833rem, 0.79rem + 0.21vw, 0.95rem)",
            "fontWeight": "400",
            "lineHeight": "1.55",
            "letterSpacing": "0",
            "color": "rgba(255,237,215,0.72)"
        },
       "h1": {
  "fontSize": "clamp(3.5rem, 1.2rem + 8vw, 10rem)",
  "fontWeight": "800",
  "lineHeight": "0.9",
  "letterSpacing": "-0.06em",
  "fontFamily": "'Spline Sans', 'Helvetica Neue', sans-serif"},
        "h2": {
            "fontSize": "clamp(1.75rem, 1rem + 2.65vw, 3.625rem)",
            "fontWeight": "600",
            "lineHeight": "1.04",
            "letterSpacing": "-0.018em",
            "fontFamily": "'Spline Sans', 'Helvetica Neue', Arial, sans-serif",
            "color": "#FFEDD7"
        },
        "h3": {
            "fontSize": "clamp(1.375rem, 1.025rem + 1.35vw, 2.4375rem)",
            "fontWeight": "600",
            "lineHeight": "1.08",
            "letterSpacing": "-0.011em",
            "fontFamily": "'Spline Sans', 'Helvetica Neue', Arial, sans-serif",
            "color": "#FFEDD7"
        },
        "h4": {
            "fontSize": "clamp(1.15625rem, 1rem + 0.75vw, 1.6875rem)",
            "fontWeight": "600",
            "lineHeight": "1.16",
            "letterSpacing": "-0.006em",
            "fontFamily": "'Spline Sans', 'Helvetica Neue', Arial, sans-serif",
            "color": "#FFEDD7"
        },
        "h5": {
            "fontSize": "clamp(1.0625rem, 1rem + 0.38vw, 1.4375rem)",
            "fontWeight": "500",
            "lineHeight": "1.28",
            "letterSpacing": "0.008em",
            "fontFamily": "'Spline Sans', 'Helvetica Neue', Arial, sans-serif",
            "color": "#FFEDD7"
        },
        "body": {
            "fontSize": "clamp(1.000rem, 0.95rem + 0.25vw, 1.14rem)",
            "fontWeight": "400",
            "lineHeight": "1.55",
            "letterSpacing": "0",
            "fontFamily": "'Satoshi', system-ui, -apple-system, sans-serif",
            "color": "#FFEDD7"
        },
        "bodyLarge": {
            "fontSize": "clamp(1.200rem, 1.14rem + 0.30vw, 1.37rem)",
            "fontWeight": "400",
            "lineHeight": "1.25",
            "letterSpacing": "0",
            "fontFamily": "'Satoshi', system-ui, -apple-system, sans-serif",
            "color": "#FFEDD7"
        },
        "bodySmall": {
            "fontSize": "clamp(0.833rem, 0.79rem + 0.21vw, 0.95rem)",
            "fontWeight": "400",
            "lineHeight": "1.55",
            "letterSpacing": "0",
            "fontFamily": "'Satoshi', system-ui, -apple-system, sans-serif",
            "color": "rgba(255,237,215,0.72)"
        },
        "caption": {
            "fontSize": "clamp(0.833rem, 0.79rem + 0.21vw, 0.95rem)",
            "fontWeight": "400",
            "lineHeight": "1.25",
            "letterSpacing": "0",
            "fontFamily": "'Satoshi', system-ui, -apple-system, sans-serif",
            "color": "rgba(255,237,215,0.72)"
        },
        "label": {
            "fontSize": "clamp(0.694rem, 0.66rem + 0.17vw, 0.79rem)",
            "fontWeight": "500",
            "lineHeight": "1.25",
            "letterSpacing": "0.04em",
            "fontFamily": "'Satoshi', system-ui, -apple-system, sans-serif",
            "color": "#FFEDD7"
        },
        "labelSmall": {
            "fontSize": "clamp(0.625rem, 0.60rem + 0.12vw, 0.72rem)",
            "fontWeight": "500",
            "lineHeight": "1.25",
            "letterSpacing": "0.08em",
            "fontFamily": "'Satoshi', system-ui, -apple-system, sans-serif",
            "color": "rgba(255,237,215,0.72)"
        },
        "hero": {
            "_usedBy": "Hero scrim (--hero-scrim-via-stop in addBase). Hero title uses native `h1` + `.type-h1` → typography.h1.",
            "imageScrimTransparentUntil": "35%"
        },
        "button": {
            "fontSize": "clamp(0.625rem, 0.58rem + 0.14vw, 0.72rem)",
            "fontWeight": "500",
            "lineHeight": "1.25",
            "letterSpacing": "0.08em",
            "fontFamily": "'Bricolage Grotesque', 'Helvetica Neue', sans-serif",
            "textTransform": "uppercase"
        }
    },
    "spacing": {
        "_usedBy": "tailwind.config.mjs theme.extend.spacing + maxWidth.container + plugin components",
        "containerMax": "96rem",
        "containerPaddingMobile": "1.25rem",
        "containerPaddingDesktop": "3rem",
        "sectionMobile": "3rem",
        "sectionDesktop": "12.5rem",
        "cardPadding": "2rem",
        "cardPaddingMobile": "1rem",
        "containerPaddingWide": "2rem"
    },
    "effects": {
        "_usedBy": "tailwind theme.extend.transitionTimingFunction + `.custom-bezier`, `.luxury-bezier`, `.magnetic-cta`",
        "transition": {
            "base": "cubic-bezier(0.16, 1, 0.30, 1)"
        },
        "duration": {
            "entrance": "720ms",
            "normal": "240ms",
            "slow": "420ms"
        },
        "magnetic": {
            "_usedBy": "addBase `--magnetic-cta` + `.magnetic-cta:hover`",
            "cta": "translate(-2px, -2px)"
        }
    },
    "border": {
        "_usedBy": "tailwind theme.extend.borderRadius + plugin layouts",
        "radius": {
            "DEFAULT": "0",
            "lg": "12px",
            "xl": "0",
            "full": "9999px"
        },
        "width": {
            "DEFAULT": "1px"
        },
        "style": "solid"
    },
    "grid": {
        "_usedBy": "addBase `--grid-gutter` + global.css `.grid-*` gap fallback",
        "gutter": "1.5rem"
    }
}
