---
import GlobalSchema from "../components/GlobalSchema.astro";
import Meta from "../components/Meta.astro";
import Navbar from "../components/Navbar.astro";
import GlobalGrain from "../components/design-effects/GlobalGrain.astro";
import GlobalSpatialEffect from "../components/design-effects/GlobalSpatialEffect.astro";
import "../styles/global.css";
import { SITE_CONFIG } from "../data/site-config";

const {
	title,
	description = SITE_CONFIG.description,
	image,
	canonicalUrl,
	noindex = false,
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700&display=swap" rel="stylesheet" />

		<!-- SEO: Title, Description, OG, Twitter -->
		<Meta
			title={title}
			description={description}
			image={image}
			canonicalUrl={canonicalUrl}
			noindex={noindex}
		/>

		<!-- AEO / LLM Discovery -->
		<link rel="llms" type="text/plain" title="LLM-friendly content" href={`${baseUrl}llms.txt`} />
		<link rel="llms-full" type="text/plain" title="Full LLM profile" href={`${baseUrl}llms-full.txt`} />

		<!-- Global Schema -->
		<GlobalSchema />
		<slot name="head" />
	</head>
	<body class="bg-background text-on-background selection:bg-secondary selection:text-on-secondary perspective-[1000px]">
		<div class="grain-overlay"></div>
		<!-- GEMINI §5.O — first focusable element -->
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:px-4 focus:py-3 focus:bg-secondary focus:text-on-secondary focus:outline-none focus:ring-2 focus:ring-white/80 focus:ring-offset-2 focus:ring-offset-background transition-none"
		>
			Skip to main content
		</a>
		<Navbar />
		<main id="main-content">
			<slot />
		</main>
		<GlobalSpatialEffect />
		<GlobalGrain />
	</body>
</html>
