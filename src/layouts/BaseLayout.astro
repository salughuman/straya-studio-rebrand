---
import GlobalSchema from "../components/GlobalSchema.astro";
import Meta from "../components/Meta.astro";
import Navbar from "../components/Navbar.astro";
import Cursor from "../components/Cursor.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import "../styles/global.css";
import { SITE_CONFIG } from "../data/site-config";

const {
	title,
	description = SITE_CONFIG.description,
	image,
	canonicalUrl,
	noindex = false,
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="apple-touch-icon" href={`${baseUrl}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
		<link
			href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700;12..96,800&display=swap"
			rel="stylesheet"
		/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700&display=swap" rel="stylesheet" />

		<!-- SEO: Title, Description, OG, Twitter -->
		<Meta
			title={title}
			description={description}
			image={image}
			canonicalUrl={canonicalUrl}
			noindex={noindex}
		/>

		<!-- AEO / LLM Discovery -->
		<link rel="llms" type="text/plain" title="LLM-friendly content" href={`${baseUrl}llms.txt`} />
		<link rel="llms-full" type="text/plain" title="Full LLM profile" href={`${baseUrl}llms-full.txt`} />

		<!-- Global Schema -->
		<GlobalSchema />
		<slot name="head" />
	</head>
	<body class="bg-background text-on-background selection:bg-fuchsia-500/35 selection:text-on-background">
		<!-- GEMINI §5.O — first focusable element -->
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:px-4 focus:py-3 focus:bg-secondary focus:text-on-secondary focus:outline-none focus:ring-2 focus:ring-accent/70 focus:ring-offset-2 focus:ring-offset-background transition-none"
		>
			Skip to main content
		</a>
		<SmoothScroll />
		<Cursor />
		<Navbar />
		<main id="main-content">
			<slot />
		</main>
	</body>
</html>

<script>
  // Color the last punctuation character in h1–h4 with accent color
  const PUNCT = /[.!?]$/;
  const colorHeadingPunct = () => {
    document.querySelectorAll<HTMLElement>('h1, h2, h3, h4').forEach(h => {
      // Skip if already processed or has no text
      if (h.dataset.punctDone) return;
      h.dataset.punctDone = '1';

      // Walk to the last text node
      const walker = document.createTreeWalker(h, NodeFilter.SHOW_TEXT);
      let lastText: Text | null = null;
      let node: Node | null;
      while ((node = walker.nextNode())) lastText = node as Text;
      if (!lastText) return;

      const text = lastText.textContent ?? '';
      if (!PUNCT.test(text.trimEnd())) return;

      // Find the last punctuation character position
      const trimmed = text.trimEnd();
      const lastIdx = trimmed.length - 1;
      const before  = text.slice(0, lastIdx);
      const punct   = text.slice(lastIdx, lastIdx + 1);
      const after   = text.slice(lastIdx + 1); // trailing whitespace if any

      // Replace text node with: text + <span class="heading-punct">.</span> + whitespace
      const span = document.createElement('span');
      span.className = 'heading-punct';
      span.textContent = punct;

      const parent = lastText.parentNode;
      if (!parent) return;
      parent.insertBefore(document.createTextNode(before), lastText);
      parent.insertBefore(span, lastText);
      if (after) parent.insertBefore(document.createTextNode(after), lastText);
      parent.removeChild(lastText);
    });
  };

  colorHeadingPunct();
  document.addEventListener('astro:after-swap', colorHeadingPunct);
</script>
