---
// ComparisonTable.astro — GEMINI §6 anchor section (elevated). Semantic data table, not a card grid.

const columns = ["Speed", "Flexibility", "Quality", "Scalability", "Price"];

const studio = {
	name: "Straya Studio",
	description:
		"Your dedicated technical studio — senior-level designers, developers and strategists on demand.",
	checks: [true, true, true, true, true],
};

const competitors = [
	{
		icon: "team",
		name: "In-house team",
		description:
			"In-house teams don't always have the skill mix or bandwidth to handle every request the business needs.",
		checks: [false, false, true, false, false],
	},
	{
		icon: "agency",
		name: "Creative agencies",
		description:
			"Working with full-scale creative agencies can be slow, costly, and inflexible.",
		checks: [false, false, true, true, false],
	},
	{
		icon: "freelancer",
		name: "Freelancers",
		description:
			"Freelancers can be unreliable and hard to scale, leading to inconsistent work and questionable quality.",
		checks: [false, false, true, true, false],
	},
	{
		icon: "tools",
		name: "Self-service tools",
		description:
			"These solutions make incremental improvements to capacity, and work mostly for simpler, repetitive tasks.",
		checks: [false, false, true, false, false],
	},
];

const icons: Record<string, string> = {
	team: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
	agency: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>`,
	freelancer: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
	tools: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="12" cy="12" r="1"/></svg>`,
};

const strayaIcon = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`;
---

<section
	id="compare"
	class="comparison-anchor section-y relative z-10 bg-[#0F1115] text-[#FFFFFF]"
	aria-label="Comparison — Straya Studio versus alternatives"
>
	<div class="main-container">
		<header class="mb-12 text-center md:mb-16">
			<p class="type-label mb-4">Straya Studio vs traditional alternatives</p>
			<h2 class="type-h2">Hiring or traditional<br />outsourcing? Neither.</h2>
		</header>

		<p class="sr-only">
			Comparison table: Straya Studio versus in-house teams, creative agencies,
			freelancers, and self-service tools across Speed, Flexibility, Quality,
			Scalability, and Price. Straya Studio is highlighted as the studio row.
		</p>

		<div
			class="overflow-x-auto rounded-xs [-webkit-overflow-scrolling:touch]"
			role="region"
			aria-label="Scroll to compare all columns"
			tabindex="0"
		>
			<table class="comparison-table w-full min-w-[720px] border-collapse text-left">
				<caption class="sr-only">
					Feature comparison: platforms as rows, criteria as columns. Checkmarks
					indicate a strength; crosses indicate a gap.
				</caption>
				<thead>
					<tr>
						<th scope="col" class="type-caption max-w-[14rem] px-4 py-4 font-medium text-[#9CA3AF] md:px-6">
							<span class="sr-only">Platform</span>
						</th>
						{
							columns.map((col) => (
								<th
									scope="col"
									class="type-caption border-b border-[rgba(255,255,255,0.05)] px-3 py-4 text-center font-medium text-[#9CA3AF] md:px-4"
								>
									{col}
								</th>
							))
						}
					</tr>
				</thead>
				<tbody class="border-x border-b border-[rgba(255,255,255,0.05)]">
					<tr class="border-t border-[rgba(60,205,127,0.3)] bg-[#3CCD7F]">
						<th
							scope="row"
							class="max-w-[20rem] px-4 py-5 align-top md:px-6"
						>
							<div class="flex items-start gap-4">
								<div
									class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xs border border-[rgba(60,205,127,0.35)] bg-[rgba(5,5,5,0.35)] text-[#3CCD7F] motion-safe:animate-[iconGlowBrand_3s_cubic-bezier(0.16,1,0.3,1)_infinite] motion-reduce:animate-none"
									set:html={strayaIcon}
									aria-hidden="true"
								/>
								<div class="min-w-0">
									<h3 class="type-h3 mb-1 text-[#050505]">{studio.name}</h3>
									<p class="type-body text-[#050505]/80">{studio.description}</p>
								</div>
							</div>
						</th>
						{
							studio.checks.map((check, i) => (
								<td
									class:list={[
										"px-3 py-5 text-center align-middle md:px-4",
									]}
								>
									<span class="sr-only">
										{columns[i]}: {check ? "yes" : "no"}
									</span>
									<svg
										class="mx-auto h-5 w-5 text-[#3CCD7F]"
										width="20"
										height="20"
										viewBox="0 0 20 20"
										fill="none"
										aria-hidden="true"
										focusable="false"
									>
										<path
											d="M4 10.5L8 14.5L16 6.5"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</td>
							))
						}
					</tr>
					{
						competitors.map((comp) => (
							<tr class="border-b border-[rgba(255,255,255,0.05)] last:border-b-0">
								<th
									scope="row"
									class="max-w-[20rem] px-4 py-5 align-top md:px-6"
								>
									<div class="flex items-start gap-4">
									<div
										class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xs border border-[rgba(255,255,255,0.05)] bg-[rgba(255,255,255,0.04)] text-[#9CA3AF] motion-safe:animate-[iconGlow_5s_cubic-bezier(0.16,1,0.3,1)_infinite] motion-reduce:animate-none"
										set:html={icons[comp.icon]}
										aria-hidden="true"
									/>
										<div class="min-w-0">
											<h3 class="type-h3 mb-1 text-[#FFFFFF]">{comp.name}</h3>
											<p class="type-body text-[#6B7280]">{comp.description}</p>
										</div>
									</div>
								</th>
								{comp.checks.map((check, i) => (
									<td class="px-3 py-5 text-center align-middle md:px-4">
										<span class="sr-only">
											{columns[i]}: {check ? "yes" : "no"}
										</span>
										{check ? (
											<svg
												class="mx-auto h-5 w-5 text-[#9CA3AF]"
												width="20"
												height="20"
												viewBox="0 0 20 20"
												fill="none"
												aria-hidden="true"
												focusable="false"
											>
												<path
													d="M4 10.5L8 14.5L16 6.5"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										) : (
											<svg
												class="mx-auto h-5 w-5 text-[#6B7280] opacity-50"
												width="20"
												height="20"
												viewBox="0 0 20 20"
												fill="none"
												aria-hidden="true"
												focusable="false"
											>
												<path
													d="M5 5L15 15M15 5L5 15"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
												/>
											</svg>
										)}
									</td>
								))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>

<style>
	/* §5.F — focus ring for scroll region (keyboard users) */
	.comparison-anchor [role="region"]:focus-visible {
		outline: 2px solid #3ccd7f;
		outline-offset: 2px;
	}

</style>
