---
import { faqItems } from "../data/faq";
import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";
---

<section
  id="faq"
  aria-label="Frequently asked questions"
  class="section-frosted relative pt-16 pb-16 md:pt-20 md:pb-20"
  data-faq-root
>
  <p class="sr-only">
    Common questions about working with Straya Studio — process, pricing,
    timelines, and what to expect.
  </p>

  <div class="main-container relative z-10 grid grid-cols-12 items-start gap-4 md:gap-6">

    <!-- Heading -->
    <header class="col-span-12 md:col-span-9 md:col-start-2">
      <h2 class="type-h2 max-w-5xl text-on-background mb-4 md:mb-6 leading-tight">
        Questions we hear most.
      </h2>
    </header>

    <!-- Accordion -->
    <div class="col-span-12 md:col-span-6 md:col-start-4 md:mt-5">
      <p class="faq-body-el type-body text-on-background/60 mb-10 max-w-[52ch]">
        Everything you need to know before starting a project with the studio.
      </p>

      <div>
        {faqItems.map((item, i) => (
          <details
            class="faq-item group border-b border-on-background/10"
            data-index={i}
          >
            <summary class="faq-summary cursor-pointer select-none list-none text-left">
              <span class="flex w-full items-center justify-between gap-6 py-5">
                <span class="flex items-baseline gap-4 min-w-0">
                  <span class="type-label text-on-background/25 flex-shrink-0 tabular-nums w-6 font-mono" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span
                    class="type-body text-on-background font-normal group-open:text-accent transition-colors duration-300"
                    role="heading"
                    aria-level="3"
                  >
                    {item.question}
                  </span>
                </span>
                <span
                  class="faq-icon flex-shrink-0 w-5 h-5 flex items-center justify-center border border-on-background/15 transition-all duration-300 group-open:border-accent/40 group-open:bg-accent/8"
                  aria-hidden="true"
                >
                  <svg
                    class="w-3 h-3 text-on-background/40 transition-all duration-300 group-open:rotate-45 group-open:text-accent"
                    viewBox="0 0 12 12" fill="none" stroke="currentColor"
                    stroke-width="1.5" stroke-linecap="round"
                  >
                    <path d="M6 1v10M1 6h10"/>
                  </svg>
                </span>
              </span>
            </summary>

            <div class="faq-content overflow-hidden">
              <p class="type-body-small text-on-background/55 leading-relaxed pb-6 pl-10 pr-4 m-0">
                {item.answer}
              </p>
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- Aside -->
    <aside
      class="col-span-12 mt-12 flex flex-col gap-6 md:col-span-2 md:col-start-11 md:mt-8"
      aria-label="Get in touch"
    >
      <div class="flex flex-col gap-2">
        <p class="type-label-small m-0 font-mono uppercase tracking-[0.08em] text-on-background/40">
          Still have questions?
        </p>
        <p class="type-label-small m-0 font-mono uppercase tracking-[0.08em] text-on-background/40">
          Book a free 30-min call.
        </p>
      </div>

      <Button
        href={SITE_CONFIG.socials.calendly}
        label="Book a call"
        variant="hero-pill"
        target="_blank"
        rel="noopener noreferrer"
      />
    </aside>

  </div>
</section>

<style>
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }

  .faq-eyebrow-rule {
    width: 0;
    transition: width 720ms cubic-bezier(0.16,1,0.3,1);
  }
  .faq-eyebrow-rule.in-view { width: 32px; }

  .faq-body-el { opacity:0; transform:translateY(20px); filter:blur(4px); }

  .faq-content { height: 0; opacity: 0; will-change: height, opacity; }

  /* Summary hover — question text color shift */
  .faq-summary:hover .type-body,
  .faq-summary:focus-visible .type-body {
    color: var(--color-accent, #DC5000);
  }
  .faq-summary:focus-visible {
    outline: 2px solid var(--color-accent, #DC5000);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-eyebrow-rule { transition:none!important; }
    .faq-body-el { opacity:1!important; filter:none!important; transform:none!important; }
    .faq-content { will-change: auto; }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 420;
  const reduced  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Accordion ───────────────────────────────────────────────
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(el => {
    const summary = el.querySelector<HTMLElement>('.faq-summary');
    const content = el.querySelector<HTMLElement>('.faq-content');
    if (!summary || !content) return;
    let anim: Animation | null = null;
    const open = () => {
      el.open = true;
      const h = content.scrollHeight;
      if (anim) anim.cancel();
      if (reduced) { content.style.height = 'auto'; content.style.opacity = '1'; return; }
      anim = content.animate(
        [{ height: '0px', opacity: 0 }, { height: `${h}px`, opacity: 1 }],
        { duration: DURATION, easing: EASE, fill: 'forwards' }
      );
      anim.onfinish = () => { content.style.height = 'auto'; content.style.opacity = '1'; anim = null; };
    };
    const close = () => {
      const h = content.scrollHeight;
      if (anim) anim.cancel();
      if (reduced) { content.style.height = '0px'; content.style.opacity = '0'; el.open = false; return; }
      anim = content.animate(
        [{ height: `${h}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
        { duration: DURATION, easing: EASE, fill: 'forwards' }
      );
      anim.onfinish = () => { el.open = false; content.style.height = ''; content.style.opacity = ''; anim = null; };
    };
    summary.addEventListener('click', e => { e.preventDefault(); el.open ? close() : open(); });
    content.style.height = '0px';
    content.style.opacity = '0';
  });

  // ── Section reveals ─────────────────────────────────────────
  const faqSection = document.getElementById('faq');
  if (faqSection) {
    const ruleEl  = faqSection.querySelector<HTMLElement>('[data-faq-rule]');
    const bodyEl  = faqSection.querySelector<HTMLElement>('.faq-body-el');

    if (reduced) {
      if (ruleEl)  ruleEl.classList.add('in-view');
      if (bodyEl)  { bodyEl.style.opacity = '1'; bodyEl.style.filter = 'none'; bodyEl.style.transform = 'none'; }
    } else {
      if (ruleEl) {
        const obs = new IntersectionObserver(entries => {
          if (!entries[0].isIntersecting) return;
          ruleEl.classList.add('in-view');
          obs.disconnect();
        }, { threshold: 0.2 });
        obs.observe(ruleEl);
      }
      if (bodyEl) {
        let raf = 0;
        const update = () => {
          raf = 0;
          const rect = bodyEl.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / (window.innerHeight * 0.6)));
          bodyEl.style.opacity   = p.toFixed(3);
          bodyEl.style.filter    = `blur(${((1-p)*4).toFixed(1)}px)`;
          bodyEl.style.transform = `translateY(${((1-p)*20).toFixed(1)}px)`;
        };
        window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
        update();
      }
    }
  }
</script>
