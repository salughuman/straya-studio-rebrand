---
// FAQ.astro — Straya Studio [SIMPLE]
// Sticky header + animated accordion. Light mode, numbered questions.
// GEMINI §15: accordion + slide+fade animation, max 7 visible (aria-level=3 on question labels).
// GEMINI §5: light mode tokens, no bold fonts, 0px radius.

import { faqItems } from "../data/faq";
import { SITE_CONFIG } from "../data/site-config";

const baseUrl = import.meta.env.BASE_URL;
---

<section
  id="faq"
  aria-label="Frequently asked questions"
  class="section-y relative bg-surface-container-lowest border-b border-black/5"
>
  <p class="sr-only">
    Common questions about working with Straya Studio — process, pricing,
    timelines, and what to expect.
  </p>

  <div class="main-container">
    <div class="flex flex-col gap-16 lg:flex-row lg:gap-24">

      <!-- Sticky header -->
      <header class="flex-shrink-0 lg:sticky lg:top-28 lg:self-start lg:w-80">
        <span class="faq-el type-label text-on-background/40 block mb-3" data-delay="0">FAQ</span>
        <h2 class="type-h2 text-on-background mb-4">
          <span class="faq-line block overflow-hidden"><span class="faq-el inline-block" data-delay="80">Questions we</span></span>
          <span class="faq-line block overflow-hidden"><span class="faq-el inline-block" data-delay="140">hear most.</span></span>
        </h2>
        <p class="faq-el type-body-small text-on-surface-variant leading-relaxed mb-8" data-delay="240">
          Everything you need to know before starting a project with the studio.
        </p>
        <!-- CTA -->
        <a
          href={SITE_CONFIG.socials.calendly}
          target="_blank"
          rel="noopener noreferrer"
          class="magnetic-cta inline-flex items-center gap-3 type-button text-on-background border-b border-on-background/20 pb-px hover:border-on-background transition-colors duration-300"
        >
          Book a scoping call
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        
      </header>

      <!-- Accordion — native details (not inside <dl>: <details> is not valid as a direct child of definition lists) -->
      <div class="flex-1 min-w-0">
        {faqItems.map((item, i) => (
          <details
            class="faq-item group border-b border-black/5"
            data-index={i}
          >
            <summary class="faq-summary cursor-pointer select-none list-none text-left transition-colors duration-300 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40">
              <!-- Single flow wrapper required by HTML: summary may contain only one flow child -->
              <span class="flex w-full items-center justify-between gap-6 py-6">
                <span class="flex items-baseline gap-4 min-w-0">
                  <span class="type-label text-on-background/20 flex-shrink-0 tabular-nums w-6" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span
                    class="type-body text-on-background font-normal group-open:text-accent transition-colors duration-300"
                    role="heading"
                    aria-level="3"
                  >
                    {item.question}
                  </span>
                </span>
                <span
                  class="faq-icon flex-shrink-0 w-6 h-6 flex items-center justify-center border border-black/10 transition-all duration-300 group-open:border-accent/30 group-open:bg-accent/5"
                  aria-hidden="true"
                >
                  <svg
                    class="w-3 h-3 text-on-background/40 transition-all duration-300 group-open:rotate-45 group-open:text-accent"
                    viewBox="0 0 12 12" fill="none" stroke="currentColor"
                    stroke-width="1.5" stroke-linecap="round"
                  >
                    <path d="M6 1v10M1 6h10"/>
                  </svg>
                </span>
              </span>
            </summary>

            <!-- Answer panel -->
            <div class="faq-content overflow-hidden">
              <p class="type-body-small text-on-surface-variant leading-relaxed pb-6 pl-10 pr-8 m-0">
                {item.answer}
              </p>
            </div>
          </details>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* Remove native marker */
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }

  /* ── Header elements ───────────────────────────────────────── */
  .faq-el { opacity: 0; transform: translateY(28px); }
  .faq-line .faq-el { transform: translateY(100%); opacity: 1; }

  /* Collapsed state */
  .faq-content {
    height: 0;
    opacity: 0;
    will-change: height, opacity;
  }

  /* faq-item: visible by default — no entrance animation */

  @media (prefers-reduced-motion: reduce) {
    .faq-el { opacity: 1 !important; transform: none !important; }
    .faq-content {
      will-change: auto;
    }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 420;
  const reduced  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Accordion ───────────────────────────────────────────────
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(el => {
    const summary = el.querySelector<HTMLElement>('.faq-summary');
    const content = el.querySelector<HTMLElement>('.faq-content');
    if (!summary || !content) return;

    let anim: Animation | null = null;

    const open = () => {
      el.open = true;
      const h = content.scrollHeight;
      if (anim) anim.cancel();
      if (reduced) { content.style.height = 'auto'; content.style.opacity = '1'; return; }
      anim = content.animate(
        [{ height: '0px', opacity: 0 }, { height: `${h}px`, opacity: 1 }],
        { duration: DURATION, easing: EASE, fill: 'forwards' }
      );
      anim.onfinish = () => { content.style.height = 'auto'; content.style.opacity = '1'; anim = null; };
    };

    const close = () => {
      const h = content.scrollHeight;
      if (anim) anim.cancel();
      if (reduced) { content.style.height = '0px'; content.style.opacity = '0'; el.open = false; return; }
      anim = content.animate(
        [{ height: `${h}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
        { duration: DURATION, easing: EASE, fill: 'forwards' }
      );
      anim.onfinish = () => { el.open = false; content.style.height = ''; content.style.opacity = ''; anim = null; };
    };

    summary.addEventListener('click', e => { e.preventDefault(); el.open ? close() : open(); });
    content.style.height  = '0px';
    content.style.opacity = '0';
  });

  // ── Header entrance ─────────────────────────────────────────
  const faqHeaderEls = document.querySelectorAll<HTMLElement>('#faq .faq-el');
  const faqHeaderObs = new IntersectionObserver(entries => {
    if (!entries[0].isIntersecting) return;
    faqHeaderEls.forEach(el => {
      const delay  = parseInt(el.dataset.delay ?? '0');
      const isLine = el.closest('.faq-line') !== null;
      el.animate(
        isLine
          ? [{ transform: 'translateY(100%)' }, { transform: 'translateY(0%)' }]
          : [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
        { duration: 900, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }
      );
    });
    faqHeaderObs.disconnect();
  }, { rootMargin: '0px 0px -80px 0px', threshold: 0 });
  const faqSection = document.getElementById('faq');
  if (faqSection) faqHeaderObs.observe(faqSection);

  // faq-item entrance animation removed — items visible by default
</script>
