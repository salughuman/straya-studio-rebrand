---
import { faqItems } from "../data/faq";
import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<section
  id="faq"
  class="faq-section section-y relative z-10 bg-[#050505] text-[#FFFFFF]"
  aria-label="Frequently asked questions"
>
  <div class="main-container">
    <p class="sr-only">
      Common questions about working with Straya Studio — process, pricing,
      timelines, and what to expect.
    </p>

    <div class="flex flex-col gap-12 lg:flex-row lg:gap-16">
      <header class="shrink-0 lg:sticky lg:top-28 lg:self-start lg:w-[22rem]">
        <p class="type-label">FAQ</p>
        <h2 class="type-h2 mt-3">Questions we hear most.</h2>
        <p class="type-body mt-4 text-[#9CA3AF]">
          Everything you need to know before starting a project with the studio.
        </p>
        <Button
          href={`${baseUrl}contact`}
          label="Ask us anything"
          variant="ghost"
          class="group mt-6 !w-fit !px-5 !py-3 !text-sm"
        >
          <svg
            class="ml-2 h-4 w-4 transition-transform duration-300 ease-luxury group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5" />
          </svg>
        </Button>
      </header>

      <div class="flex-1">
        <dl class="grid gap-0">
          {faqItems.map((item, index) => (
            <details
              class="faq-item group border-b border-border-default"
              data-faq-index={index}
            >
              <summary class="faq-summary flex cursor-pointer select-none items-center justify-between gap-4 py-5 text-left transition-colors duration-300 ease-luxury hover:text-[#3CCD7F] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#3CCD7F] md:py-6">
                <dt class="type-body font-medium text-[#FFFFFF] transition-colors duration-300 ease-luxury group-hover:text-[#3CCD7F] group-open:text-[#3CCD7F]">
                  {item.question}
                </dt>
                <span class="faq-icon shrink-0 flex h-6 w-6 items-center justify-center rounded-xs border border-border-default bg-[rgba(255,255,255,0.03)] transition-[transform,border-color,background-color] duration-300 ease-luxury group-open:rotate-45 group-open:border-brand-secondary/30 group-open:bg-[rgba(60,205,127,0.08)]">
                  <svg
                    class="h-3 w-3 text-[#9CA3AF] transition-colors duration-300 ease-luxury group-open:text-[#3CCD7F]"
                    width="12"
                    height="12"
                    viewBox="0 0 12 12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M6 1v10M1 6h10" />
                  </svg>
                </span>
              </summary>

              <div class="faq-content">
                <dd class="m-0">
                  <p class="type-body pb-5 pr-10 text-[#9CA3AF] leading-relaxed md:pb-6">
                    {item.answer}
                  </p>
                </dd>
              </div>
            </details>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }

  .faq-content {
    overflow: hidden;
    will-change: height, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-content {
      will-change: auto;
    }
  }
</style>

<script>
  const EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
  const DURATION = 450;
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((el) => {
    const summary = el.querySelector<HTMLElement>(".faq-summary");
    const content = el.querySelector<HTMLElement>(".faq-content");
    if (!summary || !content) return;

    let animation: Animation | null = null;

    const open = () => {
      el.open = true;

      const height = content.scrollHeight;
      if (animation) animation.cancel();

      if (prefersReduced) {
        content.style.height = "auto";
        content.style.opacity = "1";
        return;
      }

      animation = content.animate(
        [
          { height: "0px", opacity: 0 },
          { height: `${height}px`, opacity: 1 },
        ],
        { duration: DURATION, easing: EASE, fill: "forwards" }
      );

      animation.onfinish = () => {
        content.style.height = "auto";
        content.style.opacity = "1";
        animation = null;
      };
    };

    const close = () => {
      const height = content.scrollHeight;
      if (animation) animation.cancel();

      if (prefersReduced) {
        content.style.height = "0px";
        content.style.opacity = "0";
        el.open = false;
        return;
      }

      animation = content.animate(
        [
          { height: `${height}px`, opacity: 1 },
          { height: "0px", opacity: 0 },
        ],
        { duration: DURATION, easing: EASE, fill: "forwards" }
      );

      animation.onfinish = () => {
        el.open = false;
        content.style.height = "";
        content.style.opacity = "";
        animation = null;
      };
    };

    summary.addEventListener("click", (e) => {
      e.preventDefault();
      el.open ? close() : open();
    });

    if (!el.open) {
      content.style.height = "0px";
      content.style.opacity = "0";
    }
  });
</script>
