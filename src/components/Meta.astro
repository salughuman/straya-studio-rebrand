---
import tokens from "../styles/design-tokens.json";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Straya Studio is a founder-led technical agency by Salman — Certified Framer Expert, Webflow Architect, and Shopify Developer. We deliver high-end Framer, Webflow, Shopify, and WordPress solutions for tech startups and ecommerce brands in the US, CA, EU, AU, and UK.",
  image = "/og-default.png",
  canonicalUrl = Astro.url.href,
  type = "website",
} = Astro.props;

const siteName = "Straya Studio — Founder-Led Technical Partner";
const twitterHandle = "@strayastudio";
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Author & Theme -->
<meta name="author" content="Salman — Straya Studio" />
<meta name="theme-color" content={tokens.color.background.surface} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta
  property="og:image"
  content={new URL(image, Astro.site ?? Astro.url).href}
/>
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} — Straya Studio`} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={twitterHandle} />
<meta name="twitter:creator" content={twitterHandle} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta
  name="twitter:image"
  content={new URL(image, Astro.site ?? Astro.url).href}
/>
<meta name="twitter:image:alt" content={`${title} — Straya Studio`} />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta
  name="googlebot"
  content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
/>

<!-- AEO: Keyword Signals -->
<meta
  name="keywords"
  content="Framer Expert, Framer Developer, Framer Plugin Development, Webflow Developer, Webflow CMS, Shopify Developer, Shopify Store, WordPress Developer, WooCommerce, No-Code Agency, Technical Agency, Straya Studio"
/>
