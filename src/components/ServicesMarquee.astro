---
/**
 * Services — dark editorial list, infinite sub-service ticker per row.
 */
interface ServiceProject {
  title: string;
  /** Optional; shown to screen readers and as fallback if `tickerItems` is empty. */
  meta?: string;
  /** Phrases shown in the scrolling ticker (in order). */
  tickerItems?: string[];
}

interface Props {
  heading?: string;
  description?: string;
  projects?: ServiceProject[];
}

const DEFAULT_PROJECTS: ServiceProject[] = [
  {
    title: "Web design",
    meta: "Marketing & product surfaces",
    tickerItems: [
      "Landing pages",
      "Design systems",
      "Product UI",
      "Marketing sites",
      "Figma → code",
    ],
  },
  {
    title: "Development",
    meta: "React · Next · Astro",
    tickerItems: ["React", "Next.js", "Astro", "TypeScript", "Headless CMS", "Performance"],
  },
  {
    title: "Motion",
    meta: "Micro-interactions & scroll",
    tickerItems: ["Scroll choreography", "GSAP", "Page transitions", "Micro-interactions", "Reduced motion"],
  },
  {
    title: "Branding",
    meta: "Identity systems",
    tickerItems: ["Logo", "Typography", "Color systems", "Guidelines", "Launch kits"],
  },
  {
    title: "Strategy",
    meta: "Positioning & roadmap",
    tickerItems: ["Discovery", "IA & sitemap", "Technical scope", "SEO baseline", "Launch plan"],
  },
];

const {
  heading = "Services.",
  description =
    "We design, build and ship digital products end to end. Each engagement pairs strategic clarity with production-grade craft — no relays, no handoffs.",
  projects = DEFAULT_PROJECTS,
} = Astro.props as Props;

function segmentsFor(project: ServiceProject): string[] {
  if (project.tickerItems?.length) return project.tickerItems;
  const m = (project.meta ?? "").trim();
  if (!m) return ["Design & Development"];
  const parts = m.split(/\s*·\s*|\s*,\s*/).map((s) => s.trim()).filter(Boolean);
  return parts.length ? parts : [m];
}
---

<section
  class="section-frosted relative overflow-hidden py-20 md:py-28"
  id="services"
  aria-labelledby="services-heading"
>
  <div class="main-container">
    <header class="services-section-head pb-10 md:pb-14">
      <span class="inline-block px-3 py-1 bg-brand-text-primary text-background font-mono text-xs uppercase tracking-widest -rotate-2 mb-6">
        <span class="text-accent">[06]</span> / Capabilities
      </span>
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-12">
        <h2
          id="services-heading"
          class="type-h2 text-[#E1E0CC] md:max-w-[min(100%,20ch)]"
        >
          {heading}
        </h2>
        <p class="max-w-md text-sm font-normal leading-relaxed text-[#E1E0CC] md:text-base">
          {description}
        </p>
      </div>
    </header>

    <div class="relative mt-12 md:mt-16">
      <div
        class="services-list flex w-full flex-col"
        role="list"
      >
        {
          projects.map((project) => {
            const segs = segmentsFor(project);
            const srSummary = segs.join(", ");
            return (
              <div
                class="services-row group flex w-full flex-col gap-4 py-9 sm:flex-row sm:items-center sm:justify-between sm:gap-10 sm:py-11 md:py-12"
                role="listitem"
                data-services-row
              >
                <span class="services-row__overlay" aria-hidden="true"></span>
                <h3 class="services-row__title type-h3 m-0 shrink-0 text-[#E1E0CC]">
                  {project.title}
                </h3>
                <div class="services-row__body min-w-0 flex-1 sm:max-w-[min(100%,32rem)]">
                  <p class="sr-only">
                    {project.title}: {srSummary}
                  </p>
                  <div class="services-ticker" aria-hidden="true">
                    <div class="services-ticker-inner">
                      <div class="services-ticker-chunk">
                        {segs.map((s, i) => (
                          <>
                            {i > 0 && <span class="services-ticker-dot">·</span>}
                            <span>{s}</span>
                          </>
                        ))}
                        <span class="services-ticker-dot">·</span>
                      </div>
                      <div class="services-ticker-chunk" aria-hidden="true">
                        {segs.map((s, i) => (
                          <>
                            {i > 0 && <span class="services-ticker-dot">·</span>}
                            <span>{s}</span>
                          </>
                        ))}
                        <span class="services-ticker-dot">·</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .services-row {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    --slide-tx: 0%;
    --slide-ty: -100%;
    transition: color 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .services-row::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    opacity: 0;
    background: #3ccd7f;
    transition: opacity 250ms ease;
    z-index: 2;
  }
  .services-row:hover::after {
    opacity: 1;
  }

  /* Direction-aware accent slide-in (lives behind text) */
  .services-row__overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--color-accent, #3ccd7f);
    transform: translate(var(--slide-tx), var(--slide-ty));
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  /* Title + body sit above overlay */
  .services-row__title,
  .services-row__body {
    position: relative;
    z-index: 1;
  }

  /* Smooth title shift on hover */
  .services-row__title {
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
      color 240ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .services-row.is-hovered .services-row__title {
    transform: translateX(14px);
    color: #0A0A0A;
  }
  .services-row.is-hovered .services-ticker-chunk,
  .services-row.is-hovered .services-ticker-dot {
    color: #0A0A0A;
  }

  .services-ticker {
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .services-ticker-inner {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: services-ticker-marquee 38s linear infinite;
  }

  .services-ticker-chunk {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.65rem 1.25rem;
    flex-wrap: nowrap;
    padding-right: 2.5rem;
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: #e1e0cc;
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .services-ticker-chunk {
      font-size: 1rem;
    }
  }

  .services-ticker-dot {
    color: rgba(225, 224, 204, 0.35);
    user-select: none;
  }
  .services-row:hover .services-ticker-dot {
    color: rgba(60, 205, 127, 0.85);
  }

  @keyframes services-ticker-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-ticker-inner {
      animation: none;
      transform: none;
    }
    .services-row__overlay,
    .services-row__title {
      transition: none !important;
      transform: none !important;
    }
  }

</style>

<script>
  const setupServicesHover = () => {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fineHover     = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    if (reducedMotion || !fineHover) return;

    const rows = document.querySelectorAll<HTMLElement>("[data-services-row]");
    if (!rows.length) return;

    // ── Direction lookup (pointer-enter/leave) ────────────────────────
    const offsets: Array<[string, string]> = [
      ["0%",    "-100%"], // top
      ["100%",  "0%"   ], // right
      ["0%",    "100%" ], // bottom
      ["-100%", "0%"   ], // left
    ];
    const getDirection = (ev: PointerEvent, el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const x = (ev.clientX - r.left  - r.width  / 2) * (r.width  > r.height ? r.height / r.width  : 1);
      const y = (ev.clientY - r.top   - r.height / 2) * (r.height > r.width  ? r.width  / r.height : 1);
      return Math.round(Math.atan2(y, x) / 1.57079633 + 5) % 4;
    };

    // ── Shared state ──────────────────────────────────────────────────
    let activeRow:  HTMLElement | null = null;
    let pointerX  = -1;
    let pointerY  = -1;
    let lastScrollY = window.scrollY;
    let rafScroll   = 0;

    // Always track where the cursor is (fires on single-finger / mouse move)
    window.addEventListener("pointermove", (e: PointerEvent) => {
      pointerX = e.clientX;
      pointerY = e.clientY;
    }, { passive: true });

    // ── enter / leave helpers ─────────────────────────────────────────
    const activateRow = (row: HTMLElement, tx: string, ty: string) => {
      if (row === activeRow) return;
      // Dismiss whatever was active (scroll may have left a stale row)
      if (activeRow) {
        activeRow.style.setProperty("--slide-tx", "0%");
        activeRow.style.setProperty("--slide-ty", "-100%");
        activeRow.classList.remove("is-hovered");
        activeRow = null;
      }
      const overlay = row.querySelector<HTMLElement>(".services-row__overlay");
      if (overlay) overlay.style.transition = "none";
      row.style.setProperty("--slide-tx", tx);
      row.style.setProperty("--slide-ty", ty);
      if (overlay) overlay.offsetHeight; // force reflow so transition resets
      requestAnimationFrame(() => {
        if (overlay) overlay.style.transition = "";
        row.style.setProperty("--slide-tx", "0%");
        row.style.setProperty("--slide-ty", "0%");
        row.classList.add("is-hovered");
      });
      activeRow = row;
    };

    const deactivateRow = (row: HTMLElement | null, tx: string, ty: string) => {
      if (!row) return;
      row.style.setProperty("--slide-tx", tx);
      row.style.setProperty("--slide-ty", ty);
      row.classList.remove("is-hovered");
      if (activeRow === row) activeRow = null;
    };

    // ── Scroll-driven hover ───────────────────────────────────────────
    // Browsers suppress pointerenter/leave during 2-finger trackpad scroll.
    // Fix: on every scroll frame, hit-test elementFromPoint against the last
    // known cursor position and activate/deactivate accordingly.
    const checkScrollHover = () => {
      rafScroll = 0;
      if (pointerX < 0) return; // cursor never moved — nothing to test

      const scrollY = window.scrollY;
      const scrollDir = scrollY > lastScrollY ? 1 : -1; // 1=down, -1=up
      lastScrollY = scrollY;

      const el  = document.elementFromPoint(pointerX, pointerY);
      const row = el?.closest<HTMLElement>("[data-services-row]") ?? null;

      if (row && row !== activeRow) {
        // Row scrolled under the cursor — enter from the direction it came from
        activateRow(row, "0%", `${scrollDir * 100}%`);
      } else if (!row && activeRow) {
        // Cursor is no longer over any row
        deactivateRow(activeRow, "0%", `${scrollDir * -100}%`);
      }
    };

    window.addEventListener("scroll", () => {
      if (rafScroll) return;
      rafScroll = requestAnimationFrame(checkScrollHover);
    }, { passive: true });

    // ── Pointer-driven hover (original, unchanged logic) ──────────────
    rows.forEach((row) => {
      if (row.dataset.svFxReady === "true") return;
      row.dataset.svFxReady = "true";

      row.addEventListener("pointerenter", (e: PointerEvent) => {
        const [tx, ty] = offsets[getDirection(e, row)];
        activateRow(row, tx, ty);
      });

      row.addEventListener("pointerleave", (e: PointerEvent) => {
        const [tx, ty] = offsets[getDirection(e, row)];
        deactivateRow(row, tx, ty);
      });
    });
  };

  setupServicesHover();
  document.addEventListener("astro:after-swap", setupServicesHover);
</script>
