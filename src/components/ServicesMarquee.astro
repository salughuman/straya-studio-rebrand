---
// ServicesMarquee.astro — Straya Studio
// GEMINI §5–§6: surface background (#0A0A0A), master type utilities, luxury transitions, marquee keyframes + data-card gradients in scoped CSS only.
//
// Card art: put webp (or avif) files in `public/images/services/` — URLs are `/images/services/<file>.webp` (§5.N).
import Button from "./ui/buttons/Button.astro";

const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;

type ServiceItem = {
	title: string;
	tags: string[];
	image?: string;
};

const services: ServiceItem[] = [
    {
        title: "Web design",
        image: withBase("/images/services/web-design.webp"),
        tags: [
            "Responsive layouts",
            "Visual hierarchy",
            "Landing pages",
            "Brand-led design",
            "Wireframing",
            "Creative direction",
        ],
    },
    {
        title: "Web development",
        image: withBase("/images/services/web-development.webp"),
        tags: [
            "Framer",
            "Webflow",
            "Shopify",
            "Wix",
            "WordPress",
            "CMS architecture",
        ],
    },
    {
        title: "Graphic design",
        image: withBase("/images/services/graphic-design.webp"),
        tags: [
            "Social media kits",
            "Pitch decks",
            "Brand assets",
            "Presentation design",
            "Marketing collateral",
            "Ad creatives",
        ],
    },
    {
        title: "E-commerce",
        image: withBase("/images/services/e-commerce.webp"),
        tags: [
            "Shopify stores",
            "Product pages",
            "Checkout optimisation",
            "Theme customisation",
            "Store migration",
            "Conversion tuning",
        ],
    },
    {
        title: "Brand identity",
        image: withBase("/images/services/brand-identity.webp"),
        tags: [
            "Logo design",
            "Visual identity",
            "Brand guidelines",
            "Colour systems",
            "Typography selection",
            "Brand strategy",
        ],
    },
    {
        title: "SEO and performance",
        image: withBase("/images/services/seo-performance.webp"),
        tags: [
            "On-page SEO",
            "Core Web Vitals",
            "Lighthouse tuning",
            "Technical audits",
            "Schema markup",
            "Page speed optimisation",
        ],
    },
];

const duplicatedServices = [...services, ...services];
---

<section
    id="services"
    class="services-section section-y relative z-10 overflow-hidden bg-[#0A0A0A] text-[#FFFFFF]"
    aria-label="Our services"
>
    <p class="sr-only">
        Straya Studio offers web design, web development, graphic design,
        e-commerce, brand identity, and SEO across Framer, Webflow, Shopify,
        Wix, and WordPress. Each service card lists concrete deliverables.
    </p>

    <div class="main-container mb-12 md:mb-16">
        <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
            <div class="flex flex-col gap-4">
                <p class="type-label">What we do</p>
                <h2 class="type-h2 max-w-full text-left md:max-w-[40rem]">
                    Design, development, and graphic
                    {" "}design — across every no-code platform.
                </h2>
            </div>
            <Button href={`${import.meta.env.BASE_URL}#work`} label="See our work" variant="secondary" class="group mt-2 shrink-0 md:mt-0">
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    class="ml-2 transition-transform duration-300 ease-luxury group-hover:translate-x-1 motion-reduce:transition-none"
                >
                    <path
                        d="M6 3L11 8L6 13"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </Button>
        </div>
    </div>

    <div class="services-marquee">
        <div class="services-track flex w-max gap-2 pb-16 pt-4 will-change-transform">
            {
                duplicatedServices.map((service, idx) => (
                    <div
                        class="service-card group relative h-[240px] w-[180px] shrink-0 cursor-pointer overflow-hidden rounded-sm border border-[rgba(255,255,255,0.05)] bg-[#050505] transition-[transform,box-shadow,border-color] duration-300 ease-luxury hover:z-[5] hover:-translate-y-3 hover:border-[rgba(255,255,255,0.1)] hover:shadow-[0_8px_24px_rgba(0,0,0,0.35),0_16px_48px_rgba(0,0,0,0.2)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:border-[rgba(255,255,255,0.05)] motion-reduce:hover:shadow-none lg:h-[400px] lg:w-[300px]"
                        data-card={idx % services.length}
                    >
                        <div class="absolute inset-0 z-0 overflow-hidden rounded-sm" aria-hidden="true">
                            {
                                service.image ? (
                                    <img
                                        src={service.image}
                                        alt=""
                                        width="300"
                                        height="400"
                                        loading="lazy"
                                        decoding="async"
                                        class="absolute inset-0 h-full w-full object-cover"
                                    />
                                ) : null
                            }
                            <div
                                class:list={[
                                    "absolute inset-0 bg-[var(--card-bg)] transition-transform duration-300 ease-luxury group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100",
                                    service.image ? "opacity-90 mix-blend-multiply" : "",
                                ]}
                            />
                            <div
                                class:list={[
                                    "absolute inset-0 bg-gradient-to-t to-transparent",
                                    service.image
                                        ? "from-black/55 via-black/15"
                                        : "from-black/35 via-black/5",
                                ]}
                            />
                        </div>

                        <div class="relative z-[2] flex w-full flex-col items-center p-6 md:p-8">
                            <h3 class="type-h3 text-[1.5rem] max-w-[140px] text-center">
                                {service.title}
                            </h3>
                        </div>

                        <div
                            class="service-card-tags absolute bottom-4 left-3 right-3 z-[2] flex flex-wrap justify-center gap-x-1 gap-y-1 overflow-hidden opacity-0 translate-y-2 transition-[transform,opacity] duration-300 ease-luxury group-hover:translate-y-0 group-hover:opacity-100 lg:bottom-6 lg:left-5 lg:right-5 motion-reduce:translate-y-0 motion-reduce:opacity-100 motion-reduce:transition-none"
                        >
                            {service.tags.map((tag) => (
                                <span class="service-card-tag rounded-xs border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.06)] px-1 py-0.5 font-medium leading-tight text-[#FFFFFF] backdrop-blur-md transition-[border-color,background-color] duration-300 ease-luxury group-hover:border-[rgba(60,205,127,0.35)] group-hover:bg-[rgba(60,205,127,0.08)] whitespace-nowrap motion-reduce:transition-none">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    /* GEMINI §5.F — allowed: keyframes, mask, data-attribute gradients */
    .services-marquee {
        position: relative;
        width: 100%;
        overflow: hidden;
        mask-image: linear-gradient(
            to right,
            transparent 0%,
            black 5%,
            black 95%,
            transparent 100%
        );
        -webkit-mask-image: linear-gradient(
            to right,
            transparent 0%,
            black 5%,
            black 95%,
            transparent 100%
        );
    }

    .services-track {
        animation: services-scroll 60s linear infinite;
    }

    .services-track:hover {
        animation-play-state: paused;
    }

    @keyframes services-scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .services-track {
            animation: none;
            transform: translateX(0);
        }
    }

    /* Tag stack: smaller type, max three rows (chip height = lh + py-0.5 + border; gap-y-1 between rows) */
    .service-card-tag {
        font-size: 0.625rem;
        line-height: 1.25;
    }

    .service-card-tags {
        max-height: calc(3 * (1.25 * 0.625rem + 0.25rem + 2px) + 0.5rem);
    }

    @media (min-width: 1200px) {
        .service-card-tag {
            font-size: 0.6875rem;
        }

        .service-card-tags {
            max-height: calc(3 * (1.25 * 0.6875rem + 0.25rem + 2px) + 0.5rem);
        }
    }

    /* Deep Space Elevation only — §6 / §5.K (no neon template gradients) */
    .service-card[data-card="0"] {
        --card-bg: linear-gradient(135deg, #0f1115 0%, #0a0a0a 45%, #050505 100%);
    }
    .service-card[data-card="1"] {
        --card-bg: linear-gradient(135deg, #050505 0%, #0f1115 40%, #0a0a0a 100%);
    }
    .service-card[data-card="2"] {
        --card-bg: linear-gradient(135deg, #0a0a0a 0%, #050505 50%, #0f1115 100%);
    }
    .service-card[data-card="3"] {
        --card-bg: linear-gradient(135deg, #0f1115 0%, rgba(60, 205, 127, 0.07) 38%, #050505 100%);
    }
    .service-card[data-card="4"] {
        --card-bg: linear-gradient(135deg, #050505 0%, #0a0a0a 55%, #0f1115 100%);
    }
    .service-card[data-card="5"] {
        --card-bg: linear-gradient(135deg, #0a0a0a 0%, #0f1115 50%, #050505 100%);
    }
</style>
