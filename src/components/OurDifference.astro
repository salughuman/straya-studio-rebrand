---
// OurDifference.astro — Straya Studio [IMMERSIVE]
// 3-card bento with platform-faithful UI mockup animations.
// Same animation language as WhyStraya — CSS keyframes inside mockup panels.
// GEMINI §5: light mode tokens, no bold fonts, 0px radius.
---

<section
  id="difference"
  aria-label="Our difference"
  class="section-frosted section-y relative overflow-hidden"
>
  <div class="main-container">

    <!-- Header -->
    <header class="mb-14 flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8">
      <div>
        <span class="od-el type-label text-on-background/40 block mb-3" data-delay="0">Our difference</span>
        <h2 class="type-h2 text-on-background max-w-lg">
          <span class="od-line block overflow-hidden"><span class="od-el inline-block" data-delay="80">Built systems.</span></span>
          <span class="od-line block overflow-hidden"><span class="od-el inline-block" data-delay="140">Faster outcomes.</span></span>
        </h2>
      </div>
    </header>

    <!-- 3-card grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-black/5">
      <p class="sr-only">
        Our difference spans three areas: Bento-Grid Architecture (modular components built with mathematical precision), Zero-Latency Deployment (sub-80ms TTFB on Cloudflare Pages), and Signal Monitoring (live health telemetry maintaining 90+ Lighthouse scores post-launch).
      </p>

      <!-- Card 1: Bento Architecture — Framer canvas grid -->
      <article
        class="diff-card bg-background flex flex-col overflow-hidden group"
        aria-label="Bento-grid architecture"
      >
        <!-- Mockup: Framer-style component grid snapping into place -->
        <div class="diff-mockup relative overflow-hidden bg-surface-container-low border-b border-black/5 min-h-[220px]">
          <!-- Toolbar -->
          <div class="absolute top-0 inset-x-0 flex items-center justify-between px-3 py-2 bg-surface-container-lowest border-b border-black/5 z-10">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-black/10"></div>
              <span class="text-[9px] font-medium tracking-wide text-on-background/30 uppercase">Component Grid</span>
            </div>
            <span class="text-[8px] text-accent font-medium">canvas_constructor.exe</span>
          </div>
          <!-- Grid canvas — bento layout (asymmetric blocks) -->
          <div class="absolute inset-0 top-8 flex items-center justify-center p-5">
            <div class="grid w-full h-full gap-1.5" style="grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr 1fr;">
              <!-- Large block top-left spanning 2 rows -->
              <div class="tile-snap bg-accent/10 border border-accent/20 row-span-2" style="animation-delay: 0ms;"></div>
              <!-- Small blocks right column -->
              <div class="tile-snap bg-surface-container border border-black/5" style="animation-delay: 120ms;"></div>
              <div class="tile-snap bg-surface-container border border-black/5" style="animation-delay: 240ms;"></div>
              <!-- Bottom row: 2 equal blocks -->
              <div class="tile-snap bg-surface-container border border-black/5" style="animation-delay: 180ms;"></div>
              <div class="tile-snap bg-accent/15 border border-accent/25" style="animation-delay: 300ms;"></div>
            </div>
          </div>
        </div>
        <!-- Text -->
        <div class="p-8 flex flex-col gap-3">
          <span class="type-label text-accent">Systemic</span>
          <h3 class="type-h3 text-on-background">Bento-Grid Architecture</h3>
          <p class="type-body-small text-on-surface-variant leading-relaxed">
            Modular components that lock into place with mathematical precision — reusable, scalable, and consistent across every breakpoint.
          </p>
        </div>
      </article>

      <!-- Card 2: Zero-Latency — Webflow edge flow -->
      <article
        class="diff-card bg-background flex flex-col overflow-hidden group"
        aria-label="Zero-latency deployment"
      >
        <!-- Mockup: data flowing across edge nodes -->
        <div class="diff-mockup relative overflow-hidden bg-surface-container-low border-b border-black/5 min-h-[220px]">
          <div class="absolute top-0 inset-x-0 flex items-center justify-between px-3 py-2 bg-surface-container-lowest border-b border-black/5 z-10">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-[#146EF5]/50"></div>
              <span class="text-[9px] font-medium tracking-wide text-on-background/30 uppercase">Edge Network</span>
            </div>
            <span class="text-[8px] text-on-background/30 font-medium">global_edge_sync</span>
          </div>
          <!-- Edge nodes + flow lines -->
          <div class="absolute inset-0 top-8 flex flex-col justify-center gap-5 px-8">
            <!-- Origin node label -->
            <div class="flex items-center justify-between mb-1">
              <span class="text-[8px] text-on-background/30 uppercase tracking-wide">Origin</span>
              <span class="text-[8px] text-accent font-medium">● Live</span>
            </div>
            {[
              { label: "US East",    delay: "0ms"   },
              { label: "EU West",    delay: "400ms" },
              { label: "AP South",   delay: "800ms" },
            ].map(node => (
              <div class="flex items-center gap-3">
                <span class="text-[8px] text-on-background/30 w-14 flex-shrink-0">{node.label}</span>
                <div class="relative flex-1 h-px bg-black/5 overflow-hidden">
                  <div
                    class="flow-pulse absolute top-0 h-full w-16 bg-gradient-to-r from-transparent via-accent to-transparent"
                    style={`animation-delay: ${node.delay}`}
                  ></div>
                </div>
                <div class="w-2 h-2 rounded-full bg-accent/40 flex-shrink-0 edge-dot" style={`animation-delay: ${node.delay}`}></div>
              </div>
            ))}
            <!-- Latency readout -->
            <div class="flex items-center gap-2 mt-1">
              <span class="text-[8px] text-on-background/20 uppercase tracking-wide">TTFB</span>
              <span class="text-[10px] font-medium text-accent latency-counter">< 80ms</span>
            </div>
          </div>
        </div>
        <div class="p-8 flex flex-col gap-3">
          <span class="type-label text-accent">Performance</span>
          <h3 class="type-h3 text-on-background">Zero-Latency Deployment</h3>
          <p class="type-body-small text-on-surface-variant leading-relaxed">
            Instant data propagation across global edge networks. Sub-80ms TTFB on Cloudflare Pages, every time.
          </p>
        </div>
      </article>

      <!-- Card 3: Signal Monitoring — Lighthouse/analytics dashboard -->
      <article
        class="diff-card bg-background flex flex-col overflow-hidden group"
        aria-label="Signal monitoring layer"
      >
        <!-- Mockup: live bar chart with scan line -->
        <div class="diff-mockup relative overflow-hidden bg-surface-container-low border-b border-black/5 min-h-[220px]">
          <div class="absolute top-0 inset-x-0 flex items-center justify-between px-3 py-2 bg-surface-container-lowest border-b border-black/5 z-10">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-[#F4B400]/60"></div>
              <span class="text-[9px] font-medium tracking-wide text-on-background/30 uppercase">Runtime Telemetry</span>
            </div>
            <span class="text-[8px] text-on-background/30 font-medium">v4.1.0</span>
          </div>
          <!-- Animated score counters — count up to target values -->
          <div class="absolute inset-0 top-8 flex items-center justify-center">
            <div class="grid grid-cols-2 gap-px bg-black/5 w-full h-full">
              {[
                { label: "Performance",    score: 99,  delay: 0   },
                { label: "Accessibility",  score: 100, delay: 150 },
                { label: "Best Practices", score: 100, delay: 300 },
                { label: "SEO",            score: 100, delay: 450 },
              ].map((m, i) => (
                <div class="bg-surface-container flex flex-col items-center justify-center gap-2 p-4 score-cell" data-score={m.score} data-delay={m.delay}>
                  <!-- Ring -->
                  <div class="relative w-12 h-12">
                    <svg class="w-full h-full -rotate-90" viewBox="0 0 36 36" aria-hidden="true">
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="rgba(0,0,0,0.06)" stroke-width="2.5"/>
                      <circle
                        cx="18" cy="18" r="15.9" fill="none"
                        stroke="#3CCD7F" stroke-width="2.5"
                        stroke-linecap="round"
                        class="score-ring"
                        data-score={m.score}
                        style={`animation-delay: ${m.delay}ms`}
                      />
                    </svg>
                    <span class="score-number absolute inset-0 flex items-center justify-center text-[11px] font-medium text-on-background" data-target={m.score}>0</span>
                  </div>
                  <span class="text-[7.5px] text-on-background/40 whitespace-nowrap">{m.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="p-8 flex flex-col gap-3">
          <span class="type-label text-accent">Reliability</span>
          <h3 class="type-h3 text-on-background">Signal Monitoring Layer</h3>
          <p class="type-body-small text-on-surface-variant leading-relaxed">
            Live health telemetry catches bottlenecks before they impact conversion. 90+ Lighthouse scores maintained post-launch.
          </p>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  /* ── Header elements ───────────────────────────────────────── */
  .od-el { opacity: 0; transform: translateY(28px); }
  .od-line .od-el { transform: translateY(100%); opacity: 1; }

  /* ── diff-card — visible by default, no entrance animation ─── */

  /* ── Card 1: Tile snap ─────────────────────────────────────── */
  @keyframes tile-snap {
    0%, 10%  { opacity: 0; transform: translateZ(20px) scale(1.08); }
    30%, 70% { opacity: 1; transform: translateZ(0) scale(1); }
    90%, 100%{ opacity: 0; transform: translateZ(-10px) scale(0.94); }
  }
  .tile-snap {
    animation: tile-snap 4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  /* ── Card 2: Flow pulse ────────────────────────────────────── */
  @keyframes flow-run {
    0%   { left: -20%; opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { left: 110%; opacity: 0; }
  }
  .flow-pulse {
    animation: flow-run 2.4s linear infinite;
  }

  @keyframes edge-pulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.4); }
  }
  .edge-dot {
    animation: edge-pulse 2.4s ease infinite;
  }

  /* ── Card 3: Score rings ──────────────────────────────────── */
  @keyframes ring-99 {
    0%, 10%  { stroke-dasharray: 0 100; opacity: 0; }
    30%, 70% { stroke-dasharray: 99 100; opacity: 1; }
    90%, 100%{ stroke-dasharray: 99 100; opacity: 0; }
  }
  @keyframes ring-100 {
    0%, 10%  { stroke-dasharray: 0 100; opacity: 0; }
    30%, 70% { stroke-dasharray: 100 100; opacity: 1; }
    90%, 100%{ stroke-dasharray: 100 100; opacity: 0; }
  }
  .score-ring[data-score="99"]  { stroke-dasharray: 0 100; animation: ring-99  4s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  .score-ring[data-score="100"] { stroke-dasharray: 0 100; animation: ring-100 4s cubic-bezier(0.16, 1, 0.3, 1) infinite; }

  @keyframes score-cell-in {
    0%, 10%  { opacity: 0; transform: translateY(6px); }
    30%, 70% { opacity: 1; transform: translateY(0); }
    90%, 100%{ opacity: 0; transform: translateY(-4px); }
  }
  .score-cell { animation: score-cell-in 4s cubic-bezier(0.16, 1, 0.3, 1) infinite; }

  @media (prefers-reduced-motion: reduce) {
    .tile-snap, .flow-pulse, .edge-dot,
    .score-ring, .score-cell {
      animation: none !important;
      opacity: 1;
    }
    .score-ring { stroke-dasharray: 100 100; }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 900;
  const MARGIN   = '0px 0px -80px 0px';

  // ── Header entrance ─────────────────────────────────────────
  const headerEls = document.querySelectorAll<HTMLElement>('#difference .od-el');
  const headerObs = new IntersectionObserver(entries => {
    if (!entries[0].isIntersecting) return;
    headerEls.forEach(el => {
      const delay  = parseInt(el.dataset.delay ?? '0');
      const isLine = el.closest('.od-line') !== null;
      el.animate(
        isLine
          ? [{ transform: 'translateY(100%)' }, { transform: 'translateY(0%)' }]
          : [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
        { duration: DURATION, delay, easing: EASE, fill: 'forwards' }
      );
    });
    headerObs.disconnect();
  }, { rootMargin: MARGIN, threshold: 0 });
  const diffSection = document.getElementById('difference');
  if (diffSection) headerObs.observe(diffSection);

  // diff-card entrance animation removed — cards visible by default

  // Score counter — counts 0 → target in sync with ring animation (3.5s cycle)
  function animateCounters() {
    const numbers = document.querySelectorAll<HTMLElement>('.score-number');
    numbers.forEach(el => {
      const target = parseInt(el.dataset.target ?? '0');
      const delay  = parseInt(el.closest('.score-cell')?.getAttribute('data-delay') ?? '0');
      const duration = 1400; // ms to count up — matches 4s cycle

      function cycle() {
        let start: number | null = null;
        setTimeout(() => {
          const tick = (ts: number) => {
            if (!start) start = ts;
            const p = Math.min((ts - start) / duration, 1);
            el.textContent = String(Math.round(p * target));
            if (p < 1) requestAnimationFrame(tick);
            else {
              // Hold at target, then reset after ring fades
              setTimeout(() => {
                el.textContent = '0';
                setTimeout(cycle, 200);
              }, 1800);
            }
          };
          requestAnimationFrame(tick);
        }, delay);
      }
      cycle();
    });
  }

  // Start counters when card 3 enters viewport
  const card3 = document.querySelectorAll('.diff-card')[2];
  if (card3) {
    const counterObserver = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        animateCounters();
        counterObserver.disconnect();
      }
    }, { threshold: 0.2 });
    counterObserver.observe(card3);
  }
</script>
