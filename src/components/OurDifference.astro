---
// OurDifference.astro — Straya Studio
// Utility-first refactor for GEMINI compliance.
---

<section
  id="difference"
  class="section-y relative z-10 bg-[#050505] text-[#FFFFFF]"
  aria-label="Our difference"
>
  <div class="main-container flex flex-col gap-8 md:gap-12">
    <p class="sr-only">
      Our Difference presents three strategic advantages: scalable support,
      flexible execution, and nimble delivery for fast-moving brands.
    </p>

    <!-- Section header -->
    <header class="mx-auto flex max-w-[60rem] flex-col gap-4 text-center">
      <p class="type-label">Our difference</p>
      <h2 class="type-h2">
        Straya Studio is the perfect fit for fast moving brands
      </h2>
    </header>

    <!-- Difference cards -->
    <ul class="grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-3 md:gap-6">
      <li
        class="group flex flex-col gap-4 rounded-xs border border-[rgba(255,255,255,0.05)] bg-[#0A0A0A] p-6 transition-[transform,border-color,box-shadow] duration-300 ease-luxury hover:-translate-y-1 hover:border-[rgba(255,255,255,0.1)] hover:shadow-[0_8px_24px_rgba(0,0,0,0.35),0_16px_48px_rgba(0,0,0,0.2)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none"
      >
        <p class="type-label">Scalable</p>
        <h3 class="type-h3">Boost your in-house creative</h3>
        <p class="type-body text-[#9CA3AF]">
          We handle the heavy lifting so you can focus on strategic, high impact
          work without adding overhead to the team.
        </p>
        <div
          class="mt-auto h-40 w-full rounded-xs border border-[rgba(60,205,127,0.2)] bg-[radial-gradient(ellipse_at_top_right,rgba(60,205,127,0.18),transparent_55%),linear-gradient(135deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01))]"
          aria-hidden="true"
        />
      </li>

      <li
        class="group flex flex-col gap-4 rounded-xs border border-[rgba(255,255,255,0.05)] bg-[#0A0A0A] p-6 transition-[transform,border-color,box-shadow] duration-300 ease-luxury hover:-translate-y-1 hover:border-[rgba(255,255,255,0.1)] hover:shadow-[0_8px_24px_rgba(0,0,0,0.35),0_16px_48px_rgba(0,0,0,0.2)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none"
      >
        <p class="type-label">Flexible</p>
        <h3 class="type-h3">
          Say yes to more and bigger projects
        </h3>
        <p class="type-body text-[#9CA3AF]">
          Whether you need more bandwidth or different skills, Straya has
          whatever you need to get the job done.
        </p>
        <div
          class="mt-auto h-40 w-full rounded-xs border border-[rgba(60,205,127,0.2)] bg-[radial-gradient(ellipse_at_top_right,rgba(60,205,127,0.18),transparent_55%),linear-gradient(135deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01))]"
          aria-hidden="true"
        />
      </li>

      <li
        class="group flex flex-col gap-4 rounded-xs border border-[rgba(255,255,255,0.05)] bg-[#0A0A0A] p-6 transition-[transform,border-color,box-shadow] duration-300 ease-luxury hover:-translate-y-1 hover:border-[rgba(255,255,255,0.1)] hover:shadow-[0_8px_24px_rgba(0,0,0,0.35),0_16px_48px_rgba(0,0,0,0.2)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none"
      >
        <p class="type-label">Nimble</p>
        <h3 class="type-h3">
          Don't sacrifice quality for speed
        </h3>
        <p class="type-body text-[#9CA3AF]">
          Our global team delivers agency-level work in a fraction of the time.
        </p>
        <div
          class="mt-auto h-40 w-full rounded-xs border border-[rgba(60,205,127,0.2)] bg-[radial-gradient(ellipse_at_top_right,rgba(60,205,127,0.18),transparent_55%),linear-gradient(135deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01))]"
          aria-hidden="true"
        />
      </li>
    </ul>
  </div>
</section>

