---
const baseCardClass =
  "group flex flex-col gap-6 rounded-md border border-border-default bg-[#0A0A0A] p-6 transition-base hover:-translate-y-1 hover:border-border-strong";

const panelClass =
  "mx-auto w-full overflow-hidden rounded-t-sm border border-border-strong border-b-0 bg-black/40";

const cards = [
  {
    label: "Systemic",
    title: "Bento-Grid Architecture",
    body: "Modular components that lock into place with mathematical precision.",
    header: "Layout Constructor",
    kind: "tiles",
  },
  {
    label: "Performance",
    title: "Zero-Latency Deployment",
    body: "Instant data propagation across global edge networks.",
    header: "Edge Network Sync",
    kind: "flow",
  },
  {
    label: "Reliability",
    title: "Signal Monitoring Layer",
    body: "Live health telemetry catches bottlenecks before they impact conversion.",
    header: "Runtime Health Pulse",
    kind: "signal",
  },
] as const;

const tileItems = [
  "h-6 w-full rounded-[2px] bg-[#3CCD7F]/20 motion-safe:animate-[tileIn_4s_infinite] motion-reduce:animate-none border border-brand-secondary/30",
  "h-6 w-full rounded-[2px] bg-white/5 motion-safe:animate-[tileIn_4s_0.2s_infinite] motion-reduce:animate-none border border-border-strong",
  "h-6 w-full rounded-[2px] bg-white/5 motion-safe:animate-[tileIn_4s_0.4s_infinite] motion-reduce:animate-none border border-border-strong",
  "h-6 w-full rounded-[2px] bg-white/5 motion-safe:animate-[tileIn_4s_0.1s_infinite] motion-reduce:animate-none border border-border-strong",
  "h-6 w-full rounded-[2px] bg-[#3CCD7F]/10 motion-safe:animate-[tileIn_4s_0.3s_infinite] motion-reduce:animate-none border border-brand-secondary/20",
  "h-6 w-full rounded-[2px] bg-white/5 motion-safe:animate-[tileIn_4s_0.5s_infinite] motion-reduce:animate-none border border-border-strong",
];

const flowItems = [
  "motion-safe:animate-[flow_2s_infinite_cubic-bezier(0.16,1,0.3,1)] motion-reduce:animate-none",
  "motion-safe:animate-[flow_2s_0.4s_infinite_cubic-bezier(0.16,1,0.3,1)] motion-reduce:animate-none",
  "motion-safe:animate-[flow_2s_0.8s_infinite_cubic-bezier(0.16,1,0.3,1)] motion-reduce:animate-none",
];
---

<section id="difference" class="section-y relative z-10 bg-[#050505] text-[#FFFFFF]" aria-label="Our difference">
  <div class="main-container flex flex-col gap-8 md:gap-12">
    <p class="sr-only">
      Our difference section highlights system design and performance capabilities with animated visual previews.
    </p>

    <header class="mx-auto flex max-w-[60rem] flex-col gap-4 text-center">
      <p class="type-label text-[#3CCD7F]">Our difference</p>
      <h2 class="type-h2">Built systems. Faster outcomes.</h2>
    </header>

    <ul class="grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-3 md:gap-6">
      {
        cards.map((card) => (
          <li class={baseCardClass}>
            <div class="flex flex-col gap-3">
              <p class="type-label text-[#3CCD7F]">{card.label}</p>
              <h3 class="type-h3">{card.title}</h3>
              <p class="type-body text-[#9CA3AF]">{card.body}</p>
            </div>

            <div class="mt-auto border-t border-border-default pt-6">
              <div class={panelClass}>
                <div class="flex items-center gap-2 border-b border-border-default px-3 py-2">
                  <div class="flex gap-1">
                    <span class="h-1 w-1 rounded-full bg-white/20"></span>
                    <span class="h-1 w-1 rounded-full bg-white/20"></span>
                    <span class="h-1 w-1 rounded-full bg-white/20"></span>
                  </div>
                  <span class="text-[9px] uppercase tracking-[0.2em] text-white/30">{card.header}</span>
                </div>

                {card.kind === "tiles" ? (
                  <div class="flex h-32 items-center justify-center p-4">
                    <div class="grid w-32 grid-cols-3 gap-2 skew-x-[12deg] rotate-[-12deg]">
                      {tileItems.map((tileClass) => (
                        <div class={tileClass}></div>
                      ))}
                    </div>
                  </div>
                ) : card.kind === "flow" ? (
                  <div class="flex h-32 flex-col justify-center gap-4 p-8">
                    {flowItems.map((flowClass) => (
                      <div class="relative h-[2px] w-full overflow-hidden bg-white/5">
                        <div class:list={[
                          "absolute h-full w-12 bg-gradient-to-r from-transparent via-[#3CCD7F] to-transparent",
                          flowClass,
                        ]}></div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="relative h-32 overflow-hidden p-4">
                    <div class="absolute inset-x-4 top-4 h-[1px] bg-gradient-to-r from-transparent via-white/15 to-transparent"></div>
                    <div class="absolute inset-y-5 right-4 w-[1px] bg-white/10"></div>
                    <div class="flex h-full items-end gap-2">
                      {[0, 1, 2, 3, 4].map((index) => (
                        <div class="relative h-full flex-1 overflow-hidden rounded-[2px] border border-border-strong bg-white/5">
                          <div
                            class="absolute inset-x-0 bottom-0 h-[28%] bg-gradient-to-t from-[#3CCD7F]/65 via-[#3CCD7F]/35 to-transparent motion-safe:animate-[signalRise_2.8s_cubic-bezier(0.16,1,0.3,1)_infinite] motion-reduce:animate-none"
                            style={`animation-delay:${index * 160}ms;`}
                          ></div>
                        </div>
                      ))}
                    </div>
                    <div class="absolute left-0 top-0 h-full w-[1px] bg-gradient-to-b from-transparent via-[#3CCD7F] to-transparent shadow-primary motion-safe:animate-[signalSweep_2.6s_cubic-bezier(0.16,1,0.3,1)_infinite] motion-reduce:animate-none"></div>
                  </div>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Option D Physics: The Drop & Snap */
  @keyframes tileIn {
    0%, 10% { transform: scale(1.5) translateY(-20px); opacity: 0; }
    25%, 75% { transform: scale(1) translateY(0); opacity: 1; }
    90%, 100% { transform: scale(0.8) translateY(10px); opacity: 0; }
  }

  /* Option E Physics: The High-Speed Flow */
  @keyframes flow {
    0% { left: -20%; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { left: 120%; opacity: 0; }
  }

  /* Option F Precision: Signal Monitor */
  @keyframes signalRise {
    0%, 100% { height: 24%; opacity: 0.45; }
    35% { height: 82%; opacity: 1; }
    70% { height: 48%; opacity: 0.8; }
  }

  @keyframes signalSweep {
    0% { transform: translateX(0%); opacity: 0; }
    8% { opacity: 0.8; }
    92% { opacity: 0.8; }
    100% { transform: translateX(560px); opacity: 0; }
  }
</style>