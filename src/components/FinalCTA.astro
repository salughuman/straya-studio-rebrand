---
// FinalCTA.astro — Straya Studio [IMMERSIVE]
// Full-width CTA with large kinetic headline, availability badge, dual CTAs.
// GEMINI §13: max one primary CTA per viewport, magnetic CTA, z-depth-2.
// GEMINI §5: light mode tokens, no bold fonts, 0px radius.

import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";

const baseUrl = import.meta.env.BASE_URL;

const currentMonth = new Date().toLocaleString("en-US", { month: "long", year: "numeric" });
---

<section
  id="final-cta"
  aria-label="Start your project with Straya Studio"
  class="section-frosted relative overflow-hidden"
>
  <!-- Ghost wordmark — above global glow; opacity boosted when cursor is near (GlobalSpatialEffect) -->
  <div
    class="absolute inset-0 z-[1] flex items-center justify-center pointer-events-none select-none overflow-hidden"
    aria-hidden="true"
  >
    <span
      class="ghost-wordmark font-display font-medium text-white uppercase transition-[opacity] duration-200 ease-out"
      data-ghost-base="0.03"
      data-ghost-range="0.14"
      data-ghost-falloff="380"
      style="font-size: clamp(8rem, 25vw, 22rem); letter-spacing: -0.04em; line-height: 1; white-space: nowrap; opacity: 0.03;"
    >
      STRAYA
    </span>
  </div>

  <div class="main-container relative z-10 py-24 lg:py-32">
    <div class="flex flex-col items-start gap-12">

      <!-- Section index tag -->
      <span class="inline-block px-3 py-1 bg-brand-text-primary text-background font-mono text-xs uppercase tracking-widest -rotate-2 mb-2">
        <span class="text-accent">[10]</span> / Let's Build
      </span>

      <!-- Availability badge -->
      <div class="flex items-center gap-2 rounded-lg bg-white/5 px-4 py-2 shadow-[0_14px_36px_-16px_rgba(0,0,0,0.5),inset_0_0_0_1px_rgba(255,255,255,0.06)]" role="status">
        <span class="w-1.5 h-1.5 rounded-full bg-accent cta-dot" aria-hidden="true"></span>
        <span class="type-label text-accent">1 spot open for {currentMonth}</span>
      </div>

      <!-- Headline — large, kinetic -->
      <div class="cta-headline max-w-4xl">
        <h2
          class="type-h2 text-white uppercase"
        >
          Ready to build<br/>
          <span class="text-accent">something</span><br/>
          that performs?
        </h2>
      </div>

      <!-- Description + CTAs row -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-10 w-full  pt-10">

        <p class="type-body text-white/60 max-w-md leading-relaxed">
          Share your brief and get a fixed quote — or book a 30-minute call to scope the project together. No commitments, no surprises.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 flex-shrink-0">
          <a
            href={`${baseUrl}contact`}
            class="btn-pill btn-pill-inverted magnetic-cta z-depth-2"
            aria-label="Start a project with Straya Studio"
          >
            Start a project
            <span class="btn-pill-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" style="color: #000000;" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </span>
          </a>
          <Button
            href={SITE_CONFIG.socials.calendly}
            label="Book a 30-min call"
            variant="text-link"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 rounded-md border-2 border-transparent text-white/60 hover:border-[#3CCD7F]/50 hover:text-white"
          >
          </Button>
        </div>

      </div>

      <!-- Bottom trust strip -->
      <div class="flex flex-wrap items-center gap-6 pt-4 w-full">
        {[
          "Fixed quotes — no surprises",
          "50% upfront, 50% on delivery",
          "2–3 projects at a time",
          "Direct line to the founder",
        ].map(trust => (
          <div class="flex items-center gap-2">
            <svg class="w-3 h-3 text-accent flex-shrink-0" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="type-label text-white/40">{trust}</span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Availability dot pulse ────────────────────────────────── */
  .cta-dot {
    animation: cta-dot-pulse 2.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes cta-dot-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(60,205,127,0); }
    50%       { opacity: 0.85; box-shadow: 0 0 8px 3px rgba(60,205,127,0.3); }
  }

  /* ── cta-headline — visible by default, no entrance animation  */

  @media (prefers-reduced-motion: reduce) {
    .cta-dot { animation: none; }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 900;
  const MARGIN   = '0px 0px -80px 0px';

  // cta-headline entrance animation removed — visible by default
</script>
