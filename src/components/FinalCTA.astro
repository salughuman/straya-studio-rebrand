---
// FinalCTA.astro — Straya Studio [IMMERSIVE]
// Full-width CTA with large kinetic headline, availability badge, dual CTAs.
// GEMINI §13: max one primary CTA per viewport, magnetic CTA, z-depth-2.
// GEMINI §5: light mode tokens, no bold fonts, 0px radius.

import { SITE_CONFIG } from "../data/site-config";

const baseUrl = import.meta.env.BASE_URL;

const currentMonth = new Date().toLocaleString("en-US", { month: "long", year: "numeric" });
---

<section
  id="final-cta"
  aria-label="Start your project with Straya Studio"
  class="relative bg-primary overflow-hidden border-b border-white/5"
>
  <!-- Ghost wordmark background -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <span
      class="font-display font-medium text-white uppercase"
      style="font-size: clamp(8rem, 25vw, 22rem); letter-spacing: -0.04em; opacity: 0.03; line-height: 1; white-space: nowrap;"
    >
      STRAYA
    </span>
  </div>

  <div class="main-container relative z-10 py-24 lg:py-32">
    <div class="flex flex-col items-start gap-12">

      <!-- Availability badge -->
      <div class="flex items-center gap-2 border border-white/10 bg-white/5 px-4 py-2" role="status">
        <span class="w-1.5 h-1.5 rounded-full bg-accent cta-dot" aria-hidden="true"></span>
        <span class="type-label text-accent">1 spot open for {currentMonth}</span>
      </div>

      <!-- Headline — large, kinetic -->
      <div class="cta-headline max-w-4xl">
        <h2
          class="font-display font-medium text-white uppercase leading-none"
          style="font-size: clamp(2.5rem, 7vw, 6rem); letter-spacing: -0.04em;"
        >
          Ready to build<br/>
          <span class="text-accent">something</span><br/>
          that performs?
        </h2>
      </div>

      <!-- Description + CTAs row -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-10 w-full  pt-10">

        <p class="type-body text-white/60 max-w-md leading-relaxed">
          Share your brief and get a fixed quote — or book a 15-minute call to scope the project together. No commitments, no surprises.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 flex-shrink-0">
          <a
            href={`${baseUrl}contact`}
            class="magnetic-cta z-depth-2 inline-flex items-center gap-3 type-button bg-accent text-primary px-8 py-4 hover:bg-white transition-colors duration-300"
            aria-label="Start a project with Straya Studio"
          >
            Start a project
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a
            href={SITE_CONFIG.socials.calendly}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 type-button text-white/60 border-b border-white/20 pb-px hover:text-white hover:border-white transition-colors duration-300"
          >
            Book a 15-min call
          </a>
        </div>

      </div>

      <!-- Bottom trust strip -->
      <div class="flex flex-wrap items-center gap-6 pt-4 border-t border-white/5 w-full">
        {[
          "Fixed quotes — no surprises",
          "50% upfront, 50% on delivery",
          "2–3 projects at a time",
          "Direct line to the founder",
        ].map(trust => (
          <div class="flex items-center gap-2">
            <svg class="w-3 h-3 text-accent flex-shrink-0" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="type-label text-white/40">{trust}</span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Availability dot pulse ────────────────────────────────── */
  .cta-dot {
    animation: cta-dot-pulse 2.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes cta-dot-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(60,205,127,0); }
    50%       { opacity: 0.85; box-shadow: 0 0 8px 3px rgba(60,205,127,0.3); }
  }

  /* ── cta-headline — visible by default, no entrance animation  */

  @media (prefers-reduced-motion: reduce) {
    .cta-dot { animation: none; }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 900;
  const MARGIN   = '0px 0px -80px 0px';

  // cta-headline entrance animation removed — visible by default
</script>
