---
// TrustGrid.astro — Platform Marquee
// Platform order per GEMINI.md §1: Framer → Webflow → Shopify → Wix → WordPress
// No bold fonts. 20s duration per design tokens.
---

<div
  class="relative overflow-hidden py-12 border-y border-black/5"
  aria-label="Platforms we build on"
>
  <!-- Fade edges -->
  <div class="absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-background to-transparent z-10 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-background to-transparent z-10 pointer-events-none" aria-hidden="true"></div>

  <div class="flex animate-marquee whitespace-nowrap" aria-hidden="true">
    <!-- Set 1 -->
    <div class="flex items-center gap-24 px-12">
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">Framer</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">Webflow</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">Shopify</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">Wix</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">WordPress</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">Astro</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
    </div>
    <!-- Set 2 (seamless loop) -->
    <div class="flex items-center gap-24 px-12">
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">Framer</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">Webflow</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">Shopify</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">Wix</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">WordPress</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
      <span class="font-display font-medium text-2xl uppercase tracking-tight text-on-background/20 hover:text-on-background transition-colors duration-300">Astro</span>
      <span class="w-1 h-1 rounded-full bg-black/10 flex-shrink-0"></span>
    </div>
  </div>
</div>
