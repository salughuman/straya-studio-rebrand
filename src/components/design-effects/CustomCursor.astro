---
// CustomCursor — editorial “optical” cursor: crisp dot + lagging wire ring + soft bloom (fine pointer only).
---

<div id="custom-cursor-root" class="custom-cursor-root" hidden aria-hidden="true">
  <div class="custom-cursor-ambient" aria-hidden="true"></div>
  <div class="custom-cursor-ring" aria-hidden="true"></div>
  <div class="custom-cursor-core" aria-hidden="true"></div>
</div>

<style is:global>
  .custom-cursor-root {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
    --cc-mx: 0px;
    --cc-my: 0px;
    --cc-rx: 0px;
    --cc-ry: 0px;
  }

  /* Wide, soft bloom — follows the ring for a lit-film feel */
  .custom-cursor-ambient {
    position: absolute;
    left: var(--cc-rx);
    top: var(--cc-ry);
    width: 120px;
    height: 120px;
    margin: -60px 0 0 -60px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(225, 224, 204, 0.07) 0%,
      rgba(60, 205, 127, 0.09) 38%,
      transparent 62%
    );
    opacity: 0.75;
    filter: blur(14px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: left, top, opacity;
  }

  /* Hollow sight — no fill, no tilt */
  .custom-cursor-ring {
    position: absolute;
    left: var(--cc-rx);
    top: var(--cc-ry);
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border-radius: 50%;
    border: 1px solid rgba(225, 224, 204, 0.5);
    background: transparent;
    box-shadow:
      0 0 24px -10px rgba(60, 205, 127, 0.35),
      0 0 0 1px rgba(0, 0, 0, 0.25) inset;
    transition:
      width 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      margin 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s ease,
      box-shadow 0.4s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: left, top, width, height;
  }

  /* Pin-sharp tracking point */
  .custom-cursor-core {
    position: absolute;
    left: var(--cc-mx);
    top: var(--cc-my);
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: #e1e0cc;
    box-shadow:
      0 0 12px rgba(60, 205, 127, 0.45),
      0 0 2px rgba(0, 0, 0, 0.85);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, background 0.25s ease;
    will-change: left, top, transform;
  }

  .custom-cursor-root.is-hover .custom-cursor-ambient {
    opacity: 1;
    transform: scale(1.05);
  }

  .custom-cursor-root.is-hover .custom-cursor-ring {
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    border-color: rgba(60, 205, 127, 0.78);
    box-shadow:
      0 0 36px -8px rgba(60, 205, 127, 0.5),
      0 0 0 1px rgba(60, 205, 127, 0.12) inset;
  }

  .custom-cursor-root.is-hover .custom-cursor-core {
    transform: scale(1.35);
    background: #f5f4e8;
    box-shadow:
      0 0 18px rgba(60, 205, 127, 0.55),
      0 0 3px rgba(0, 0, 0, 0.9);
  }

  .custom-cursor-root.is-down:not(.is-hover) .custom-cursor-ring {
    transform: scale(0.88);
  }

  .custom-cursor-root.is-down:not(.is-hover) .custom-cursor-core {
    transform: scale(0.75);
  }

  .custom-cursor-root.is-hover.is-down .custom-cursor-ring {
    transform: scale(0.94);
  }

  .custom-cursor-root.is-hover.is-down .custom-cursor-core {
    transform: scale(1.15);
  }
</style>

<script>
  const HOVER_SELECTOR =
    "a[href],button:not([disabled]),[role='button']:not([disabled]),input,textarea,select,summary,.cursor-pointer,[data-cursor-hover]";

  const canUseCustomCursor = () =>
    window.matchMedia("(hover: hover)").matches &&
    window.matchMedia("(pointer: fine)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const setup = () => {
    if (!canUseCustomCursor()) return;

    const root = document.getElementById("custom-cursor-root");
    if (!root) return;

    let active = false;
    let mx = -100;
    let my = -100;
    let rx = -100;
    let ry = -100;
    let raf = 0;
    let hover = false;

    const setVars = () => {
      root.style.setProperty("--cc-mx", `${mx}px`);
      root.style.setProperty("--cc-my", `${my}px`);
      root.style.setProperty("--cc-rx", `${rx}px`);
      root.style.setProperty("--cc-ry", `${ry}px`);
    };

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    const tick = () => {
      /* Slower lag = heavier, more “premium” follow */
      const lag = hover ? 0.17 : 0.1;
      rx = lerp(rx, mx, lag);
      ry = lerp(ry, my, lag);
      setVars();
      raf = requestAnimationFrame(tick);
    };

    const updateHover = (target: EventTarget | null) => {
      const el = target instanceof Element ? target : null;
      const next = !!(el && (el.closest(HOVER_SELECTOR) || el.matches(HOVER_SELECTOR)));
      if (next === hover) return;
      hover = next;
      root.classList.toggle("is-hover", hover);
    };

    const onMove = (e: MouseEvent) => {
      if (!active) {
        active = true;
        document.documentElement.classList.add("straya-cursor-active");
        root.removeAttribute("hidden");
        rx = e.clientX;
        ry = e.clientY;
        raf = requestAnimationFrame(tick);
      }
      mx = e.clientX;
      my = e.clientY;
      updateHover(e.target);
    };

    const onDown = () => root.classList.add("is-down");
    const onUp = () => root.classList.remove("is-down");

    document.addEventListener("mousemove", onMove, { passive: true });
    document.addEventListener("mousedown", onDown);
    document.addEventListener("mouseup", onUp);
    window.addEventListener("blur", onUp);

    document.addEventListener(
      "visibilitychange",
      () => {
        if (document.hidden) onUp();
      },
      { passive: true },
    );
  };

  setup();
</script>
