---
/**
 * ScrollPrimitive.astro
 * Lenis smooth scroll — single source of scroll state for the entire site.
 * ScrollSmoother was removed because it applies CSS transforms to the content
 * element, which breaks position:sticky on all child elements.
 * Lenis uses native scroll position so sticky works correctly.
 *
 * - Initialises Lenis smooth scroll
 * - Sets --scroll-progress (0→1) on <html> every rAF
 * - Re-initialises on Astro View Transitions (astro:after-swap)
 * Included once in BaseLayout.astro — never in individual components.
 */
---
<script>
  import Lenis from '@studio-freight/lenis';

  let lenis: InstanceType<typeof Lenis> | null = null;
  let rafId = 0;

  function initLenis() {
    if (lenis) { lenis.destroy(); lenis = null; }
    if (rafId)  { cancelAnimationFrame(rafId); rafId = 0; }

    // Remove native smooth scroll — Lenis handles it
    document.documentElement.style.scrollBehavior = 'auto';
    document.body.style.scrollBehavior = 'auto';

    lenis = new Lenis({
      duration:    1.8,
      easing:      (t: number) => t === 1 ? 1 : 1 - Math.pow(2, -10 * t), // expo ease-out, gentler tail
      orientation: 'vertical',
      smoothWheel: true,
    });

    const html = document.documentElement;

    function raf(time: number) {
      lenis!.raf(time);
      const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      html.style.setProperty('--scroll-progress', (window.scrollY / max).toFixed(4));
      rafId = requestAnimationFrame(raf);
    }

    rafId = requestAnimationFrame(raf);
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced) {
    const html = document.documentElement;
    const update = () => {
      const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      html.style.setProperty('--scroll-progress', (window.scrollY / max).toFixed(4));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  } else {
    initLenis();
    document.addEventListener('astro:after-swap', initLenis);
  }
</script>
