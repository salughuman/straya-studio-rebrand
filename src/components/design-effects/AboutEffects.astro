---
// AboutEffects.astro — Straya Studio
// Primary Interaction Layer for 'The Spatial Archive' — Scroll-Linked Beam
---

<div class="about-fx absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
  <!-- Primary Layer: Scroll-Linked Beam -->
  <div class="fx-dynamic-beam absolute top-[-50%] left-1/2 -translate-x-1/2 w-[150vw] h-[200vh] opacity-20"></div>
  
  <!-- Secondary Layer: Interaction Spotlight (handled via card tilt in main section) -->
</div>

<style>
  .fx-dynamic-beam {
    background: conic-gradient(
      from 180deg at 50% 0%,
      transparent 150deg,
      rgba(60, 205, 127, 0.15) 175deg,
      rgba(255, 255, 255, 0.4) 180deg,
      rgba(60, 205, 127, 0.15) 185deg,
      transparent 210deg
    );
    filter: blur(80px);
    mix-blend-mode: screen;
    will-change: transform;
  }

  /* Accessibility: Reduce motion if requested */
  @media (prefers-reduced-motion: reduce) {
    .fx-dynamic-beam {
      display: none;
    }
  }
</style>

<script>
  /**
   * Scroll-Linked Interaction (Pillar 4: Primary Layer)
   * Shifts the heavenly beam vertically based on scroll progress.
   */
  const setupScrollBeam = () => {
    const beam = document.querySelector('.fx-dynamic-beam') as HTMLElement;
    const section = document.getElementById('about');
    
    if (!beam || !section) return;

    window.addEventListener('scroll', () => {
      const { top, height } = section.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      
      // Calculate scroll progress through the section
      const scrollProgress = (viewportHeight - top) / (viewportHeight + height);
      const clampedProgress = Math.min(Math.max(scrollProgress, 0), 1);
      
      // Shift beam vertically based on progress (Pillar 4.5)
      // Range: -50% to 50% (vertical travel)
      const translateY = (clampedProgress - 0.5) * 60; 
      beam.style.transform = `translate3d(-50%, ${translateY}%, 0) rotate(${(clampedProgress - 0.5) * 10}deg)`;
    }, { passive: true });
  };

  setupScrollBeam();
  document.addEventListener('astro:after-swap', setupScrollBeam);
</script>
