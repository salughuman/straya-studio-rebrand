---
// HeroEffects.astro — Straya Studio
// Premium layered "Heavenly Beam" background effects for the hero section.
// Drop this INSIDE the hero <section>, before any content.
//
// Layers (bottom to top):
//   1. Ambient Glow — Soft environmental light at the source
//   2. Heavenly Ray — Volumetric conic beam (White core -> Accent edges)
//   3. Core Ray — Intense inner spotlight for depth
//   4. Mouse-reactive gradient orb — follows cursor with easing
//
// Zero layout impact. All layers are position: absolute + pointer-events: none.
// Respects prefers-reduced-motion (disables mouse tracking).
---

<div class="hero-fx" aria-hidden="true">
    <div class="fx-ambient-glow"></div>
    <div class="fx-heaven-ray"></div>
    <div class="fx-core-ray"></div>
</div>

<style>
    /* Container locks the effects to the section */
    .hero-fx {
        position: fixed; /* Locked to viewport to stay visible on scroll */
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        display: flex;
        justify-content: center;
        z-index: 400;
    }

    /* ── Layer 1: Ambient Glow ──
       A soft pool of light at the absolute top center to ground the beam. */
    .fx-ambient-glow {
        position: absolute;
        top: -20%;
        left: 50%;
        transform: translateX(-50%);
        width: 80vw;
        height: 60vh;
        background: radial-gradient(
            ellipse at center,
            rgba(var(--accent-rgb), 0.4) 0%,
            rgba(var(--accent-rgb), 0.15) 40%,
            transparent 70%
        );
        filter: blur(60px);
        animation: glowPulse 8s ease-in-out infinite alternate;
    }

    /* ── Layer 2: The Heavenly Ray ──
       Volumetric wide beam pointing straight down.
       White in the middle, fading to brand green, then transparent. */
    .fx-heaven-ray {
        position: absolute;
        top: -10%;
        width: 150vw;
        height: 140vh;
        background: conic-gradient(
            from 180deg at 50% -10%,
            transparent 130deg,
            rgba(var(--accent-rgb), 0.12) 150deg,
            rgba(255, 255, 255, 0.35) 170deg,
            rgba(255, 255, 255, 0.65) 180deg,
            rgba(255, 255, 255, 0.35) 190deg,
            rgba(var(--accent-rgb), 0.12) 210deg,
            transparent 230deg
        );
        filter: blur(48px);
        transform-origin: 50% 0;
        /* Fades the light out vertically so it doesn't hard-cut at the bottom */
        mask-image: linear-gradient(to bottom, black 10%, transparent 80%);
        -webkit-mask-image: linear-gradient(
            to bottom,
            black 10%,
            transparent 80%
        );
        animation: raySway 14s ease-in-out infinite alternate;
        mix-blend-mode: screen;
    }

    /* ── Layer 3: The Core Ray ──
       An intense, narrow shaft of light in the dead center to give the beam structure. */
    .fx-core-ray {
        position: absolute;
        top: -5%;
        width: 60vw;
        height: 120vh;
        background: conic-gradient(
            from 180deg at 50% -5%,
            transparent 165deg,
            rgba(255, 255, 255, 0.4) 175deg,
            rgba(255, 255, 255, 0.9) 180deg,
            rgba(255, 255, 255, 0.4) 185deg,
            transparent 195deg
        );
        filter: blur(24px);
        transform-origin: 50% 0;
        mask-image: linear-gradient(to bottom, black 0%, transparent 60%);
        -webkit-mask-image: linear-gradient(
            to bottom,
            black 0%,
            transparent 60%
        );
        animation: corePulse 6s ease-in-out infinite alternate;
        mix-blend-mode: screen;
    }

    /* Mobile Adjustments */
    @media (max-width: 809px) {
        .fx-heaven-ray {
            width: 250vw;
            top: -5%;
            filter: blur(32px);
        }
        .fx-core-ray {
            width: 120vw;
            filter: blur(16px);
        }
    }

    /* ── Ethereal Animations ── */
    @keyframes raySway {
        0% {
            transform: rotate(-3deg) scale(0.95);
            opacity: 0.8;
        }
        50% {
            transform: rotate(1deg) scale(1.02);
            opacity: 1;
        }
        100% {
            transform: rotate(-2deg) scale(0.98);
            opacity: 0.85;
        }
    }

    @keyframes corePulse {
        0% {
            transform: rotate(-1deg) scaleY(0.9);
            opacity: 0.7;
        }
        100% {
            transform: rotate(1deg) scaleY(1.05);
            opacity: 1;
        }
    }

    @keyframes glowPulse {
        0% {
            transform: translateX(-50%) scale(0.9);
            opacity: 0.7;
        }
        100% {
            transform: translateX(-50%) scale(1.1);
            opacity: 1;
        }
    }

    /* Accessibility: Pause animations if requested */
    @media (prefers-reduced-motion: reduce) {
        .fx-ambient-glow,
        .fx-heaven-ray,
        .fx-core-ray {
            animation: none !important;
            transform: none !important;
        }
    }
</style>
