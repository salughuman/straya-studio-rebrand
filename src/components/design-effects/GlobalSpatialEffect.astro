---
// GlobalSpatialEffect — subtle monochrome dust + ghost wordmark proximity.
// (Procedural snake lives in PremiumSnake.astro and replaces the old linefield.)
---

<div
  id="global-spatial-effect"
  class="fixed inset-0 z-[3] pointer-events-none overflow-hidden"
  aria-hidden="true"
>
  <div id="spatial-dust-container" class="absolute inset-0">
    {
      [...Array(18)].map((_, i) => (
        <div
          class="spatial-particle absolute rounded-full bg-[#E1E0CC]/[0.08] blur-[0.5px]"
          style={`
          width: ${Math.random() * 5 + 2}px;
          height: ${Math.random() * 5 + 2}px;
          top: ${Math.random() * 100}%;
          left: ${Math.random() * 100}%;
          opacity: ${Math.random() * 0.35 + 0.15};
        `}
          data-mass={Math.random() * 0.6 + 0.2}
        />
      ))
    }
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    #global-spatial-effect {
      display: none;
    }
  }
</style>

<script>
  const setupSpatialProjector = () => {
    const container = document.getElementById("global-spatial-effect");
    const particles = document.querySelectorAll(".spatial-particle");
    const ghosts = document.querySelectorAll<HTMLElement>(".ghost-wordmark");

    if (!container) return;
    if (container.dataset.initialized === "true") return;
    container.dataset.initialized = "true";

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      ghosts.forEach((el) => {
        const b = parseFloat(el.dataset.ghostBase ?? "0.04");
        el.style.opacity = String(b);
      });
      return;
    }

    let mouseX = 0;
    let mouseY = 0;
    let scrollY = window.scrollY;
    let targetScrollY = window.scrollY;

    const lerp = (a: number, b: number, n: number) => (1 - n) * a + n * b;

    const ghostProximity = (cx: number, cy: number) => {
      ghosts.forEach((el) => {
        const base = parseFloat(el.dataset.ghostBase ?? "0.04");
        const range = parseFloat(el.dataset.ghostRange ?? "0.11");
        const r = el.getBoundingClientRect();
        if (r.width === 0 || r.height === 0) {
          el.style.opacity = String(base);
          return;
        }
        const gx = r.left + r.width / 2;
        const gy = r.top + r.height / 2;
        const d = Math.hypot(cx - gx, cy - gy);
        const falloff = parseFloat(el.dataset.ghostFalloff ?? "340");
        const t = Math.max(0, 1 - d / falloff);
        const boost = t * t;
        el.style.opacity = String(base + range * boost);
      });
    };

    window.addEventListener(
      "mousemove",
      (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      },
      { passive: true },
    );

    window.addEventListener(
      "scroll",
      () => {
        targetScrollY = window.scrollY;
      },
      { passive: true },
    );

    const render = () => {
      scrollY = lerp(scrollY, targetScrollY, 0.1);

      particles.forEach((p) => {
        const mass = parseFloat(p.getAttribute("data-mass") || "0.5");
        (p as HTMLElement).style.transform = `translate3d(0, ${-(scrollY * mass * 0.1)}px, 0)`;
      });

      ghostProximity(mouseX, mouseY);

      requestAnimationFrame(render);
    };

    requestAnimationFrame(render);
  };

  setupSpatialProjector();
  document.addEventListener("astro:after-swap", setupSpatialProjector);
</script>
