---
// GlobalSpatialEffect — cursor radial (centered on pointer) + dust; lives under #main-content (z-0).
// Ghost wordmarks (.ghost-wordmark) brighten via proximity (they sit above this layer in each section).
---

<div
  id="global-spatial-effect"
  class="fixed inset-0 z-0 pointer-events-none overflow-hidden"
  aria-hidden="true"
>
  <!-- Cursor spotlight — center pinned to pointer (translate -50% -50% combined in JS) -->
  <div
    id="spatial-cursor-glow"
    class="absolute left-0 top-0 w-[min(100vw,420px)] h-[min(100vw,420px)] max-w-[420px] max-h-[420px] rounded-full bg-[radial-gradient(circle_at_center,_rgba(60,205,127,0.28)_0%,_transparent_68%)] blur-[120px] opacity-0 will-change-transform"
  >
  </div>

  <div id="spatial-dust-container" class="absolute inset-0">
    {
      [...Array(25)].map((_, i) => (
        <div
          class:list={[
            "spatial-particle absolute rounded-full blur-[1px]",
            i % 3 === 0 ? "bg-brand-secondary/20" : "bg-white/10",
          ]}
          style={`
          width: ${Math.random() * 8 + 4}px;
          height: ${Math.random() * 8 + 4}px;
          top: ${Math.random() * 100}%;
          left: ${Math.random() * 100}%;
          opacity: ${Math.random() * 0.5 + 0.3};
        `}
          data-mass={Math.random() * 0.6 + 0.2}
        />
      ))
    }
  </div>
</div>

<style>
  #global-spatial-effect {
    z-index: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    #global-spatial-effect {
      display: none;
    }
  }
</style>

<script>
  const setupSpatialProjector = () => {
    const container = document.getElementById("global-spatial-effect");
    const glow = document.getElementById("spatial-cursor-glow");
    const particles = document.querySelectorAll(".spatial-particle");
    const ghosts = document.querySelectorAll<HTMLElement>(".ghost-wordmark");

    if (!container || !glow) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      ghosts.forEach((el) => {
        const b = parseFloat(el.dataset.ghostBase ?? "0.04");
        el.style.opacity = String(b);
      });
      return;
    }

    let mouseX = 0;
    let mouseY = 0;
    let currentX = 0;
    let currentY = 0;
    let scrollY = window.scrollY;
    let targetScrollY = window.scrollY;

    const lerp = (a: number, b: number, n: number) => (1 - n) * a + n * b;

    const ghostProximity = (cx: number, cy: number) => {
      ghosts.forEach((el) => {
        const base = parseFloat(el.dataset.ghostBase ?? "0.04");
        const range = parseFloat(el.dataset.ghostRange ?? "0.11");
        const r = el.getBoundingClientRect();
        if (r.width === 0 || r.height === 0) {
          el.style.opacity = String(base);
          return;
        }
        const gx = r.left + r.width / 2;
        const gy = r.top + r.height / 2;
        const d = Math.hypot(cx - gx, cy - gy);
        const falloff = parseFloat(el.dataset.ghostFalloff ?? "340");
        const t = Math.max(0, 1 - d / falloff);
        const boost = t * t;
        el.style.opacity = String(base + range * boost);
      });
    };

    window.addEventListener(
      "mousemove",
      (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        glow.style.opacity = "1";
      },
      { passive: true },
    );

    window.addEventListener(
      "scroll",
      () => {
        targetScrollY = window.scrollY;
      },
      { passive: true },
    );

    const render = () => {
      currentX = lerp(currentX, mouseX, 0.1);
      currentY = lerp(currentY, mouseY, 0.1);
      // Center gradient on cursor: element top-left at (x,y) then shift by half size via % (relative to self)
      glow.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%)`;

      scrollY = lerp(scrollY, targetScrollY, 0.1);
      particles.forEach((p) => {
        const mass = parseFloat(p.getAttribute("data-mass") || "0.5");
        (p as HTMLElement).style.transform = `translate3d(0, ${-(scrollY * mass * 0.1)}px, 0)`;
      });

      ghostProximity(mouseX, mouseY);

      requestAnimationFrame(render);
    };

    requestAnimationFrame(render);
  };

  setupSpatialProjector();
  document.addEventListener("astro:after-swap", setupSpatialProjector);
</script>
