---
/**
 * Footer.astro — Straya Studio
 * Cream background, full-width STRAYA wordmark with hover light sweep
 */
import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";

const year = new Date().getFullYear();

const navLinks = [
  { label: "Work",     href: "/#work" },
  { label: "Services", href: "/#services" },
  { label: "Pricing",  href: "/#pricing" },
  { label: "FAQ",      href: "/#faq" },
];

const socialLinks = [
  { label: "LinkedIn", href: SITE_CONFIG.socials.agency_linkedin },
  { label: "Framer",   href: SITE_CONFIG.socials.framer },
  { label: "Contra",   href: SITE_CONFIG.socials.contra },
];
---

<footer aria-label="Site footer" class="footer-root relative">

  <!-- ── UPPER BLOCK ── -->
  <div class="main-container pt-20 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">

      <!-- Left: CTA -->
      <div class="lg:col-span-7 flex flex-col gap-8">
        <div class="flex items-center gap-3">
          <span class="w-4 h-px bg-accent"></span>
          <span class="font-mono text-xs uppercase tracking-[0.1em]" style="color: rgba(var(--fg-inverted-rgb), 0.4);">Let's build something</span>
        </div>

        <h2 class="font-display font-black leading-[0.92] tracking-[-0.04em]"
            style="font-size: clamp(3rem, 7vw, 6.5rem); color: var(--color-fg-inverted);">
          Ready when<br/>
          <span style="color: var(--color-accent);">you are.</span>
        </h2>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <Button
            href="/contact"
            label="Start a project"
            variant="hero-pill"
            class="footer-btn"
          />
          <a
            href={`mailto:${SITE_CONFIG.email}`}
            class="footer-link font-mono text-xs uppercase tracking-[0.08em]"
            style="color: rgba(var(--fg-inverted-rgb), 0.45);"
          >
            {SITE_CONFIG.email}
          </a>
        </div>
      </div>

      <!-- Right: nav + social -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-10 lg:pt-4">

        <nav aria-label="Footer navigation">
          <span class="font-mono text-[0.65rem] uppercase tracking-[0.1em] block mb-5" style="color: rgba(var(--fg-inverted-rgb), 0.25);">Pages</span>
          <ul class="flex flex-col gap-3.5 list-none p-0 m-0">
            {navLinks.map(link => (
              <li>
                <a href={link.href} class="footer-link font-mono text-xs uppercase tracking-[0.06em]" style="color: rgba(var(--fg-inverted-rgb), 0.5);">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label="Social links">
          <span class="font-mono text-[0.65rem] uppercase tracking-[0.1em] block mb-5" style="color: rgba(var(--fg-inverted-rgb), 0.25);">Connect</span>
          <ul class="flex flex-col gap-3.5 list-none p-0 m-0">
            {socialLinks.map(link => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-link font-mono text-xs uppercase tracking-[0.06em] inline-flex items-center gap-1.5 group"
                  style="color: rgba(var(--fg-inverted-rgb), 0.5);"
                >
                  {link.label}
                  <svg class="w-2 h-2 opacity-30 group-hover:opacity-60 transition-opacity" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M2 8L8 2M8 2H4M8 2V6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>

      </div>
    </div>
  </div>

  <!-- ── STRAYA WORDMARK — hover light sweep ── -->
  <!-- Blurred glow layer -->
  <p class="footer-wordmark footer-wordmark-glow font-display font-black leading-none whitespace-nowrap select-none"
     style="display: block; margin: 0; padding: 0; letter-spacing: -0.04em; line-height: 0.85; position: absolute; left: 0;"
     aria-hidden="true">
    STRAYA
  </p>
  <!-- Sharp text layer -->
  <p class="footer-wordmark font-display font-black leading-none whitespace-nowrap select-none"
     style="display: block; margin: 0; padding: 0; letter-spacing: -0.04em; line-height: 0.85; text-align: left;"
     aria-hidden="true">
    STRAYA
  </p>

  <!-- ── BOTTOM BAR ── -->
  <div style="border-top: 1px solid rgba(var(--fg-inverted-rgb), 0.08);">
    <div class="main-container py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">

      <div class="flex items-center gap-3">
        <span class="w-1.5 h-1.5 rounded-full footer-dot flex-shrink-0" style="background: var(--color-accent);" aria-hidden="true"></span>
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.08em]" style="color: var(--color-accent);">Accepting new briefs</span>
      </div>

      <div class="flex flex-wrap items-center gap-5">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.06em]" style="color: rgba(var(--fg-inverted-rgb), 0.2);">©{year} Straya Studio</span>
        <a href="/privacy"      class="footer-link font-mono text-[0.65rem] uppercase tracking-[0.06em]" style="color: rgba(var(--fg-inverted-rgb), 0.3);">Privacy</a>
        <a href="/terms"        class="footer-link font-mono text-[0.65rem] uppercase tracking-[0.06em]" style="color: rgba(var(--fg-inverted-rgb), 0.3);">Terms</a>
        <a href="/sitemap-page" class="footer-link font-mono text-[0.65rem] uppercase tracking-[0.06em]" style="color: rgba(var(--fg-inverted-rgb), 0.3);">Sitemap</a>
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.06em]" style="color: rgba(var(--fg-inverted-rgb), 0.15);">Lahore, Pakistan</span>
      </div>

    </div>
  </div>

</footer>

<style>
  /* ── Footer background ────────────────────────────────────── */
  .footer-root {
    background: var(--color-bg-inverted);
  }

  /* ── Links ────────────────────────────────────────────────── */
  .footer-link {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: color 240ms cubic-bezier(0.16,1,0.3,1), background-size 240ms cubic-bezier(0.16,1,0.3,1);
  }
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-fg-inverted) !important;
    background-size: 100% 1px;
  }
  .footer-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* ── STRAYA shine sweep ───────────────────────────────────── */
  /* Shared gradient for both layers */
  .footer-wordmark {
    background-image: linear-gradient(
      105deg,
      var(--color-fg-inverted) 0%,
      var(--color-fg-inverted) 28%,
      rgba(180, 90, 20, 0.25) 36%,
      rgba(255, 210, 140, 0.55) 43%,
      rgba(255, 245, 220, 0.92) 50%,
      #ffffff 50.5%,
      rgba(255, 245, 220, 0.92) 51%,
      rgba(255, 210, 140, 0.55) 57%,
      rgba(180, 90, 20, 0.25) 64%,
      var(--color-fg-inverted) 72%,
      var(--color-fg-inverted) 100%
    );
    background-size: 400% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: background-position 0s;
  }

  /* Blurred duplicate — only emits warm light, no dark spread */
  .footer-wordmark-glow {
    background-image: linear-gradient(
      105deg,
      transparent 0%,
      transparent 30%,
      rgba(220, 130, 40, 0.3) 38%,
      rgba(255, 210, 130, 0.7) 44%,
      rgba(255, 240, 200, 1) 50%,
      rgba(255, 255, 255, 1) 50.5%,
      rgba(255, 240, 200, 1) 51%,
      rgba(255, 210, 130, 0.7) 56%,
      rgba(220, 130, 40, 0.3) 62%,
      transparent 70%,
      transparent 100%
    ) !important;
    filter: blur(40px);
    opacity: 0;
    top: -60px;
    bottom: -20px;
    transition: background-position 0s, opacity 0.6s ease;
    pointer-events: none;
  }

  .footer-root:hover .footer-wordmark {
    background-position: 0% 0;
    transition: background-position 2.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .footer-root:hover .footer-wordmark-glow {
    background-position: 0% 0;
    opacity: 0.75;
    transition: background-position 2.8s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
  }

  /* ── Status dot pulse ─────────────────────────────────────── */
  .footer-dot {
    animation: footer-dot-pulse 3s cubic-bezier(0.4,0,0.6,1) infinite;
  }
  @keyframes footer-dot-pulse {
    0%,100% { opacity:1; box-shadow:0 0 0 0 rgba(var(--accent-rgb),0); }
    50%     { opacity:0.8; box-shadow:0 0 6px 2px rgba(var(--accent-rgb),0.25); }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link     { transition: none; }
    .footer-dot      { animation: none; }
    .footer-wordmark { transition: none; }
    .footer-wordmark-wrap:hover .footer-wordmark { transition: none; }
  }
</style>

<script>
  const fitWordmark = () => {
    const footer = document.querySelector<HTMLElement>('.footer-root');
    const els    = document.querySelectorAll<HTMLElement>('.footer-wordmark');
    if (!footer || !els.length) return;

    const sharp = document.querySelector<HTMLElement>('.footer-wordmark:not(.footer-wordmark-glow)');
    if (!sharp) return;
    sharp.style.fontSize = '200px';
    sharp.style.width    = 'max-content';
    const naturalWidth   = sharp.offsetWidth;
    sharp.style.width    = '';

    const size = (footer.clientWidth * 0.965 / naturalWidth * 200) + 'px';
    els.forEach(el => el.style.fontSize = size);
  };

  // Wait for fonts before first measurement
  document.fonts.ready.then(fitWordmark);
  window.addEventListener('resize', fitWordmark);
  document.addEventListener('astro:after-swap', () => {
    document.fonts.ready.then(fitWordmark);
    window.addEventListener('resize', fitWordmark);
  });
</script>
