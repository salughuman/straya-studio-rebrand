---
/**
 * Footer.astro — Straya Studio
 * Mode: Brutalism — closes the document with weight
 * Design: Full-bleed display type + asymmetric grid + hairlines
 */
import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";

const year = new Date().getFullYear();

const navLinks = [
  { label: "Work",     href: "/#work" },
  { label: "Services", href: "/#services" },
  { label: "Pricing",  href: "/#pricing" },
  { label: "FAQ",      href: "/#faq" },
];

const socialLinks = [
  { label: "LinkedIn", href: SITE_CONFIG.socials.agency_linkedin },
  { label: "Framer",   href: SITE_CONFIG.socials.framer },
  { label: "Contra",   href: SITE_CONFIG.socials.contra },
];
---

<footer aria-label="Site footer" class="section-frosted relative overflow-hidden">

  <!-- Top hairline -->
  <div class="h-px bg-on-background/8 w-full"></div>

  <!-- ── UPPER BLOCK — CTA + nav ── -->
  <div class="main-container pt-20 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">

      <!-- Left: closing statement + CTA -->
      <div class="lg:col-span-7 flex flex-col gap-8">
        <div class="flex items-center gap-3">
          <span class="w-4 h-px bg-accent"></span>
          <span class="font-mono text-xs uppercase tracking-[0.1em] text-on-background/40">Let's build something</span>
        </div>

        <h2 class="font-display font-black leading-[0.92] tracking-[-0.04em] text-on-background"
            style="font-size: clamp(3rem, 7vw, 6.5rem);">
          Ready when<br/>
          <span class="text-accent">you are.</span>
        </h2>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <Button
            href="/contact"
            label="Start a project"
            variant="hero-pill"
            iconCircle={true}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" style="color:#E1E0CC;" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </Button>
          <a
            href={`mailto:${SITE_CONFIG.email}`}
            class="footer-link font-mono text-xs uppercase tracking-[0.08em] text-on-background/50"
          >
            {SITE_CONFIG.email}
          </a>
        </div>
      </div>

      <!-- Right: nav + social stacked -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-10 lg:pt-4">

        <nav aria-label="Footer navigation">
          <span class="font-mono text-[0.65rem] uppercase tracking-[0.1em] text-on-background/25 block mb-5">Pages</span>
          <ul class="flex flex-col gap-3.5 list-none p-0">
            {navLinks.map(link => (
              <li>
                <a href={link.href} class="footer-link font-mono text-xs uppercase tracking-[0.06em] text-on-background/50">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label="Social links">
          <span class="font-mono text-[0.65rem] uppercase tracking-[0.1em] text-on-background/25 block mb-5">Connect</span>
          <ul class="flex flex-col gap-3.5 list-none p-0">
            {socialLinks.map(link => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-link font-mono text-xs uppercase tracking-[0.06em] text-on-background/50 inline-flex items-center gap-1.5 group"
                >
                  {link.label}
                  <svg class="w-2 h-2 opacity-30 group-hover:opacity-60 transition-opacity" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M2 8L8 2M8 2H4M8 2V6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>

      </div>
    </div>
  </div>

  <!-- ── LOWER BLOCK — full-bleed wordmark ── -->
  <div class="border-t border-on-background/8 overflow-hidden" aria-hidden="true">
    <p
      class="font-display font-black leading-none tracking-[-0.04em] text-on-background/[0.035] whitespace-nowrap select-none pointer-events-none"
      style="font-size: clamp(6rem, 22vw, 20rem); padding: 0 0.05em; margin-bottom: -0.12em;"
    >
      STRAYA
    </p>
  </div>

  <!-- ── BOTTOM BAR ── -->
  <div class="border-t border-on-background/8">
    <div class="main-container py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">

      <div class="flex items-center gap-3">
        <span class="w-1.5 h-1.5 rounded-full bg-accent footer-dot flex-shrink-0" aria-hidden="true"></span>
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-accent">Accepting new briefs</span>
      </div>

      <div class="flex flex-wrap items-center gap-5">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.06em] text-on-background/20">©{year} Straya Studio</span>
        <a href="/privacy"      class="footer-link font-mono text-[0.65rem] uppercase tracking-[0.06em] text-on-background/25">Privacy</a>
        <a href="/terms"        class="footer-link font-mono text-[0.65rem] uppercase tracking-[0.06em] text-on-background/25">Terms</a>
        <a href="/sitemap-page" class="footer-link font-mono text-[0.65rem] uppercase tracking-[0.06em] text-on-background/25">Sitemap</a>
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.06em] text-on-background/15">Lahore, Pakistan</span>
      </div>

    </div>
  </div>

</footer>

<style>
  /* PERMITTED: M3 underline draw + @keyframes */
  .footer-link {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: color 240ms cubic-bezier(0.16,1,0.3,1), background-size 240ms cubic-bezier(0.16,1,0.3,1);
  }
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-on-background, #E1E0CC);
    background-size: 100% 1px;
  }
  .footer-link:focus-visible {
    outline: 2px solid var(--color-accent, #DC5000);
    outline-offset: 3px;
  }

  .footer-dot {
    animation: footer-dot-pulse 3s cubic-bezier(0.4,0,0.6,1) infinite;
  }
  @keyframes footer-dot-pulse {
    0%,100% { opacity:1; box-shadow:0 0 0 0 rgba(220,80,0,0); }
    50%     { opacity:0.8; box-shadow:0 0 6px 2px rgba(220,80,0,0.25); }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link { transition: none; }
    .footer-dot  { animation: none; }
  }
</style>
