---
/**
 * Footer.astro — Straya Studio
 * Multi-column nav bar + newsletter + oversized wordmark. Inspired by editorial dark footers.
 */
import { SITE_CONFIG } from "../data/site-config";

const baseUrl = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const legalLinks = [
  { label: "Privacy Policy", href: `${baseUrl}privacy` },
  { label: "Terms of Service", href: `${baseUrl}terms` },
  { label: "Cookie Policy", href: `${baseUrl}privacy#cookies` },
];

const contactLinks = [
  { label: "LinkedIn", href: SITE_CONFIG.socials.linkedIn, external: true },
  {
    label: SITE_CONFIG.email,
    href: `mailto:${SITE_CONFIG.email}`,
    external: false,
  },
];

const serviceLinks = [
  { label: "Framer", href: `${baseUrl}services/framer` },
  { label: "Webflow", href: `${baseUrl}services/webflow` },
  { label: "Shopify", href: `${baseUrl}services/shopify` },
  { label: "Work", href: `${baseUrl}work` },
];
---

<footer
  aria-label="Site footer"
  class="relative overflow-hidden bg-background text-on-background"
>
  <!-- ── Top info bar ─────────────────────────────────────────────── -->
  <div
    class="border-b border-on-background/10 px-container-mobile pt-20 pb-8 md:px-container-desktop md:pt-44"
  >
    <div
      class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between"
    >
      <!-- Link columns -->
      <div class="flex flex-wrap gap-10 md:gap-14">
        <nav aria-label="Legal links" class="flex flex-col gap-[0.6rem]">
          {
            legalLinks.map((link) => (
              <a href={link.href} class="footer-nav-link">
                {link.label}
              </a>
            ))
          }
        </nav>

        <nav aria-label="Contact links" class="flex flex-col gap-[0.6rem]">
          {
            contactLinks.map((link) => (
              <a
                href={link.href}
                class="footer-nav-link"
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <nav aria-label="Service links" class="flex flex-col gap-[0.6rem]">
          {
            serviceLinks.map((link) => (
              <a href={link.href} class="footer-nav-link">
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- Newsletter -->
      <div class="flex flex-col gap-3 md:max-w-[22rem] md:flex-1">
        <span
          class="type-label-small font-semibold uppercase tracking-blueprint text-on-background"
        >
          Our Newsletter
        </span>
        <form
          class="flex items-center gap-4 border-b border-on-background/30 pb-2"
          novalidate
          aria-label="Newsletter signup"
        >
          <input
            type="email"
            placeholder="Email address here"
            aria-label="Email address"
            class="type-body-small min-w-0 flex-1 bg-transparent text-on-background placeholder:text-on-background/40 outline-none"
          />
          <button
            type="submit"
            class="type-label-small whitespace-nowrap uppercase tracking-blueprint text-on-background transition-colors duration-normal ease-luxury hover:text-accent"
          >
            Sign-Up
          </button>
        </form>
      </div>

      <!-- Copyright -->
      <p
        class="type-label-small uppercase tracking-blueprint text-on-background/60 md:self-start"
      >
        ©{year}
      </p>
    </div>
  </div>

  <!-- ── Giant wordmark ────────────────────────────────────────────── -->
  <div class="overflow-hidden" aria-hidden="true">
    <p
      id="footer-wordmark"
      class="select-none whitespace-nowrap font-display font-black leading-none text-on-background"
      style="font-size: clamp(8rem, 25vw, 48rem); line-height: 0.82; letter-spacing: -0.04em;"
    >
      Straya
    </p>
  </div>
</footer>

<script>
  function fitWordmark() {
    const el = document.getElementById("footer-wordmark");
    if (!el) return;

    // Measure in an unconstrained clone so overflow-hidden doesn't clamp the width
    const probe = el.cloneNode(true) as HTMLElement;
    const cs = getComputedStyle(el);
    probe.style.cssText = [
      "position:fixed",
      "top:-9999px",
      "left:-9999px",
      "visibility:hidden",
      "pointer-events:none",
      "white-space:nowrap",
      "font-size:200px",
      `font-family:${cs.fontFamily}`,
      `font-weight:${cs.fontWeight}`,
      "letter-spacing:-0.04em",
    ].join(";");
    document.body.appendChild(probe);
    const naturalWidth = probe.getBoundingClientRect().width;
    document.body.removeChild(probe);

    if (!naturalWidth) return;
    const scale = document.documentElement.clientWidth / naturalWidth;
    el.style.fontSize = 200 * scale + "px";
  }

  document.fonts.ready.then(fitWordmark);
  window.addEventListener("resize", fitWordmark);
</script>

<style>
  .footer-nav-link {
    font-family: var(--font-body);
    font-size: clamp(0.8rem, 0.75rem + 0.15vw, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 237, 215, 0.65);
    text-decoration: none;
    transition: color 240ms cubic-bezier(0.16, 1, 0.3, 1);
    /* Minimum tap target on mobile */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.25rem;
  }
  .footer-nav-link:hover {
    color: #ffedd7;
  }
  .footer-nav-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>
