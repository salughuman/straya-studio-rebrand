---
/**
 * TheStrayaMethod.astro — Straya Studio
 * Mode: Neobrutalism
 * Cards: sticky stack with scale + Phase-B-only blur
 * Zoom: original animation — words slide out, + drifts to centre and scales up
 */

const steps = [
  {
    num: "01",
    title: "Discovery",
    description: "We map your objectives, market position, and technical fit before a single pixel is placed. Decisions that hold up later are made here.",
    linkText: "How we scope",
    bg: "#E1E0CC",
    fg: "#050505",
  },
  {
    num: "02",
    title: "Architecture",
    description: "Platform, CMS, and performance strategy locked in week one. The system is decided before the design.",
    linkText: "Our stack",
    bg: "#3CCD7F",
    fg: "#050505",
  },
  {
    num: "03",
    title: "Engineering",
    description: "Sprint-based builds, milestone reviews, production-grade from day one. Every component ships ready.",
    linkText: "Our process",
    bg: "#E1E0CC",
    fg: "#050505",
  },
  {
    num: "04",
    title: "Optimisation",
    description: "Post-launch performance audit, SEO tuning, and analytics setup. We don't hand off and disappear.",
    linkText: "Post-launch",
    bg: "#3CCD7F",
    fg: "#050505",
  },
];
---

<section id="method" class="method section-frosted bg-background relative overflow-x-clip" data-mode="neobrutalism">

  <div class="method__cards-container main-container pt-24">

    <header class="method__header mb-16">
      <div class="method__eyebrow-wrap mb-6">
        <span class="method__eyebrow-rule" aria-hidden="true"></span>
        <span class="type-label text-on-background opacity-60">[04] / The Straya Method</span>
      </div>
      <h2 class="type-h2 text-on-background">
        <span class="block overflow-hidden">
          <span class="method__h2-el block">Four stages.</span>
        </span>
        <span class="block overflow-hidden">
          <span class="method__h2-el block" style="transition-delay:80ms">Zero shortcuts.</span>
        </span>
      </h2>
    </header>

    <div class="method__stack">
      {steps.map((step) => (
        <div
          class="method__step"
          data-step
          style={`background:${step.bg}; color:${step.fg};`}
        >
          <span class="method__numeral" aria-hidden="true" data-numeral
            style={`-webkit-text-stroke: 2px ${step.fg}18;`}
          >{step.num}</span>

          <div class="method__step-left">
            <span class="method__step-num">{step.num}</span>
            <h3 class="method__step-title">{step.title}</h3>
          </div>

          <div class="method__step-content">
            <p class="method__step-body">{step.description}</p>
            <a href="#" class="method__step-link" style={`color:${step.fg};`}>
              {step.linkText}
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="inline-block ml-1 align-middle">
                <path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="method__zoom-wrapper">
    <div class="method__zoom-sticky">
      <h3 class="method__liquid-title" aria-label="Clarity plus Performance">
        <span class="method__word">CLARITY</span>
        <span class="method__plus" aria-hidden="true">+</span>
        <span class="method__word">PERFORMANCE</span>
      </h3>
    </div>
  </div>

</section>

<style>
  .method {
    --m-ink:    #0A0A0A;
    --m-accent: #3CCD7F;
  }

  .method__cards-container {
    padding-bottom: 9.5rem;
  }

  /* ── Header ───────────────────────────────────────────────── */
  .method__eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
    opacity: 0;
    transform: translateX(-12px);
    transition: opacity 400ms cubic-bezier(0.16,1,0.3,1), transform 400ms cubic-bezier(0.16,1,0.3,1);
  }
  .method__eyebrow-rule {
    display: block;
    width: 0;
    height: 2px;
    background: var(--m-accent);
    transition: width 500ms cubic-bezier(0.16,1,0.3,1) 200ms;
  }
  .method__h2-el {
    transform: translateY(100%);
    transition: transform 720ms cubic-bezier(0.16,1,0.3,1);
  }
  .method-in-view .method__eyebrow-wrap { opacity: 1; transform: translateX(0); }
  .method-in-view .method__eyebrow-rule { width: 1rem; }
  .method-in-view .method__h2-el        { transform: translateY(0); }

  /* ── Stack ────────────────────────────────────────────────── */
  .method__stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  /* ── Card ─────────────────────────────────────────────────── */
  .method__step {
    position: sticky;
    top: 10vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    border: 2px solid rgba(5,5,5,0.18);
    min-height: 28vh;
    overflow: hidden;
    padding: 0;
    box-shadow: 6px 6px 0 rgba(5,5,5,0.22);
    --p: 0;
    --p-blur: 0;
    transform-origin: top center;
    transform: scale(calc(1 - var(--p) * 0.08));
    filter: blur(calc(var(--p-blur) * 6px));
  }

  .method__step:last-child {
    top: 0;
    transform: scale(1) !important;
    filter: blur(0) !important;
    box-shadow: 8px 8px 0 rgba(5,5,5,0.28);
  }

  .method__step[data-active="true"] {
    will-change: transform, filter;
  }

  /* ── Outline numeral ──────────────────────────────────────── */
  .method__numeral {
    position: absolute;
    right: -1rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display, 'Bricolage Grotesque', sans-serif);
    font-weight: 900;
    font-size: clamp(10rem, 22vw, 20rem);
    line-height: 0.75;
    letter-spacing: -0.02em;
    color: transparent;
    user-select: none;
    pointer-events: none;
    z-index: 0;
  }

  /* ── Left zone ────────────────────────────────────────────── */
  .method__step-left {
    position: relative;
    z-index: 1;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-right: 1px solid rgba(5,5,5,0.1);
    height: 100%;
    justify-content: center;
  }

  .method__step-num {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: clamp(0.694rem, 0.66rem + 0.17vw, 0.79rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.4;
    display: block;
  }

  .method__step-title {
    font-family: var(--font-display, 'Bricolage Grotesque', sans-serif);
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 5rem);
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 0;
  }

  /* ── Centre zone ──────────────────────────────────────────── */
  .method__step-content {
    position: relative;
    z-index: 1;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    height: 100%;
    justify-content: center;
  }

  .method__step-body {
    font-family: var(--font-body, 'Instrument Sans', sans-serif);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.14rem);
    line-height: 1.55;
    max-width: 38ch;
    margin: 0;
  }

  .method__step-link {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-weight: 500;
    text-transform: uppercase;
    font-size: clamp(0.694rem, 0.66rem + 0.17vw, 0.79rem);
    letter-spacing: 0.08em;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 240ms cubic-bezier(0.16,1,0.3,1);
  }
  .method__step-link:hover,
  .method__step-link:focus-visible { background-size: 100% 1px; }
  .method__step-link:focus-visible  { outline: 2px solid var(--m-accent); outline-offset: 3px; }

  /* ── Zoom takeover — original animation ──────────────────── */
  .method__zoom-wrapper {
    height: 200vh;
    position: relative;
    background-color: var(--m-ink);
    overflow-x: clip;
    --z: 0;
  }

  .method__zoom-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .method__liquid-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0 2vw;
    font-family: var(--font-display, 'Bricolage Grotesque', sans-serif);
    font-weight: 900;
    font-size: clamp(2.5rem, 9vw, 11rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    z-index: 10;
    margin: 0;
    color: #E1E0CC;
  }

  .method__word {
    flex: 0 1 auto;
    will-change: transform, opacity;
  }

  .method__plus {
    flex: 0 0 auto;
    color: var(--m-accent);
    transform-origin: center center;
    will-change: transform;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .method__eyebrow-wrap { transition: none; opacity: 1; transform: none; }
    .method__eyebrow-rule { transition: none; width: 1rem; }
    .method__h2-el        { transition: none; transform: none; }
    .method__step {
      --p: 0 !important; --p-blur: 0 !important;
      transform: scale(1) !important;
      filter: blur(0) !important;
      will-change: auto !important;
    }
    .method__plus { transform: none !important; }
    .method__word { opacity: 1 !important; transform: none !important; }
    .method__step-link { transition: none; }
  }

  /* ── Mobile ───────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .method__step {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .method__step-left {
      border-right: none;
      border-bottom: 1px solid rgba(5,5,5,0.1);
      padding: 2rem 1.5rem 1.5rem;
    }
    .method__step-content {
      align-items: flex-start;
      text-align: left;
      padding: 1.5rem;
    }
    .method__step-title { font-size: clamp(2rem, 10vw, 3rem); }
    .method__numeral    { font-size: 9rem; right: -0.5rem; }
    .method__liquid-title {
      flex-direction: column;
      gap: 1rem;
      font-size: clamp(2.5rem, 14vw, 6rem);
    }
  }
</style>

<script>
  (() => {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const root = document.querySelector<HTMLElement>(".method");
    if (!root) return;

    // ── Header reveal ──────────────────────────────────────────
    const headerObs = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) return;
      root.classList.add("method-in-view");
      headerObs.disconnect();
    }, { rootMargin: "0px 0px -80px 0px", threshold: 0 });
    headerObs.observe(root);

    if (reduced) return;

    const cards    = Array.from(root.querySelectorAll<HTMLElement>(".method__step"));
    const numerals = Array.from(root.querySelectorAll<HTMLElement>("[data-numeral]"));
    const wrapper  = root.querySelector<HTMLElement>(".method__zoom-wrapper");
    const plus     = root.querySelector<HTMLElement>(".method__plus");
    const wordEls  = Array.from(root.querySelectorAll<HTMLElement>(".method__word"));
    const lastIdx  = cards.length - 1;

    if (!cards.length || !wrapper || !plus) return;

    let vh          = window.innerHeight;
    let vw          = window.innerWidth;
    let stickyTop   = vh * 0.1;
    let raf         = 0;
    let plusOffsetX = 0;

    const clamp01 = (n: number) => (n < 0 ? 0 : n > 1 ? 1 : n);

    // Cache the natural offset from plus centre to viewport centre
    const cachePlusOffset = () => {
      plus.style.transform = "";
      const r = plus.getBoundingClientRect();
      plusOffsetX = vw / 2 - (r.left + r.width / 2);
    };

    const update = () => {
      raf = 0;

      // ── CARDS — two-phase progress ─────────────────────────────
      const screenCenter   = vh / 2;
      const PHASE_A_WEIGHT = 0.4;
      const PHASE_B_WEIGHT = 0.6;

      for (let i = 0; i < cards.length; i++) {
        const card = cards[i];
        if (i === lastIdx) {
          card.style.setProperty("--p", "0");
          card.style.setProperty("--p-blur", "0");
          card.dataset.active = "false";
          continue;
        }
        const rect = card.getBoundingClientRect();
        let progress = 0;
        if (rect.top <= stickyTop) {
          const next = cards[i + 1];
          if (next) {
            const span     = Math.max(rect.height, 1);
            const traveled = stickyTop + span - next.getBoundingClientRect().top;
            progress = PHASE_A_WEIGHT + clamp01(traveled / span) * PHASE_B_WEIGHT;
          } else {
            progress = PHASE_A_WEIGHT;
          }
        } else if (rect.top < screenCenter) {
          progress = clamp01((screenCenter - rect.top) / Math.max(screenCenter - stickyTop, 1)) * PHASE_A_WEIGHT;
        }
        card.style.setProperty("--p", progress.toFixed(3));
        const blurP = progress > PHASE_A_WEIGHT
          ? clamp01((progress - PHASE_A_WEIGHT) / PHASE_B_WEIGHT) : 0;
        card.style.setProperty("--p-blur", blurP.toFixed(3));
        card.dataset.active = (progress > 0.001 && progress < 0.999) ? "true" : "false";
      }

      // ── NUMERAL PARALLAX ──────────────────────────────────────
      numerals.forEach((num, i) => {
        const card = cards[i];
        if (!card) return;
        const rect = card.getBoundingClientRect();
        const p = clamp01((vh - rect.top) / (vh + rect.height));
        num.style.transform = `translateY(calc(-50% + ${((p - 0.5) * 40).toFixed(1)}px))`;
      });

      // ── ZOOM TAKEOVER — original logic ─────────────────────────
      const wRect = wrapper.getBoundingClientRect();

      if (wRect.top >= vh) {
        wordEls.forEach(w => { w.style.opacity = "1"; w.style.transform = ""; });
        plus.style.transform = "";
        return;
      }

      if (wRect.bottom <= 0) {
        wordEls.forEach(w => { w.style.opacity = "0"; });
        return;
      }

      const maxScroll = Math.max(wRect.height - vh, 1);
      const z = clamp01(Math.abs(Math.min(wRect.top, 0)) / maxScroll);

      // Words: fade out and slide to edges (gone by z ≈ 0.25)
      const wordOpacity = clamp01(1 - z * 4);
      const slideAmount = z * vw * 0.12;
      wordEls.forEach((w, idx) => {
        const dir = idx === 0 ? -1 : 1;
        w.style.opacity   = wordOpacity.toFixed(3);
        w.style.transform = `translateX(${(dir * slideAmount).toFixed(1)}px)`;
      });

      // +: drift to viewport centre then scale explosively
      const centerProgress = clamp01(z / 0.35);
      const tx = plusOffsetX * centerProgress;
      const scaleFactor = 1 + Math.pow(z, 2.2) * 220;
      plus.style.transform = `translateX(${tx.toFixed(1)}px) scale(${scaleFactor.toFixed(2)})`;
    };

    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    const onResize = () => {
      vh = window.innerHeight;
      vw = window.innerWidth;
      stickyTop = vh * 0.1;
      cachePlusOffset();
      update();
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });

    cachePlusOffset();
    update();
  })();
</script>
