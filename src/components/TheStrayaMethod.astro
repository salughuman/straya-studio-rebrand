---
const steps = [
  {
    num: "01",
    title: "Performance First",
    description: "I focus on building websites that load fast, and feel smooth from the first interaction. Performance is considered at every stage.",
    linkText: "My workflow ↗",
    bgClass: "bg-surface"
  },
  {
    num: "02",
    title: "Clean & Scalable Code",
    description: "I write clean, well-structured, and maintainable code with a strong focus on clarity and long-term scalability.",
    linkText: "My workflow ↗",
    bgClass: "bg-sage" 
  },
  {
    num: "03",
    title: "Modern UI & UX",
    description: "I design and build interfaces with clarity, usability, and consistency in mind for an intuitive user experience.",
    linkText: "Explore designs ↗",
    bgClass: "bg-surface" 
  },
];
---

<section id="method" class="method bg-background relative" data-mode="neobrutalism">
  
  <div class="method__cards-container main-container pb-32 pt-24">
    
    <header class="mb-16">
      <span class="inline-block px-3 py-1 bg-brand-text-primary text-background font-mono text-xs uppercase tracking-widest -rotate-2 mb-6">
        <span class="text-accent">[03]</span> / How we work
      </span>
      <h2 class="text-5xl md:text-7xl font-black uppercase tracking-tight text-on-background">
        The strategy behind<br/>the structure.
      </h2>
    </header>

    <div class="method__stack">
      {steps.map((step, i) => (
        <div class={`method__step ${step.bgClass}`} data-step>
          <div class="method__step-content relative z-10 flex flex-col items-center text-center">
            <h3 class="method__step-title">{step.title}</h3>
            <p class="method__step-body">{step.description}</p>
            <a href="#" class="method__step-link">{step.linkText}</a>
          </div>
          <span class="method__numeral" aria-hidden="true">{step.num}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="method__zoom-wrapper">
    <div class="method__zoom-sticky">
      <h3 class="method__liquid-title">
        <span class="method__word">CLARITY</span>
        <span class="method__plus text-accent">+</span>
        <span class="method__word">PERFORMANCE</span>
      </h3>
    </div>
  </div>

</section>

<style>
  .method {
    --m-ink: #0A0A0A;                
    --m-bg-raised: #F4F4F4; 
    --m-bg-sage: #84A98C; 
    --m-fg-strong: #111111;
    --m-accent: #2A4365; /* The color that will flood the screen */
    --m-hairline: rgba(0, 0, 0, 0.1);
  }

  .bg-surface { background: var(--m-bg-raised); color: var(--m-fg-strong); }
  .bg-sage { background: var(--m-bg-sage); color: var(--m-ink); }

  /* ─── Cards ──────────────────────────────────────────────────── */
  .method__stack {
    display: flex;
    flex-direction: column;
    /* Spacing between cards when scrolling normally */
    gap: 4rem; 
    margin-top: 4rem;
  }

  .method__step {
    /* Magic: Sticks to top of viewport, allowing next card to slide over */
    position: sticky;
    top: 10vh; 
    
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 2rem;
    border: 1px solid var(--m-hairline);
    min-height: 50vh;
    overflow: hidden;
    
    /* Smooth transform updates from JS */
    transform-origin: top center;
    will-change: transform, opacity;
  }

  .method__step-title {
    font-family: 'Impact', sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 6.5rem);
    text-transform: uppercase;
    line-height: 0.9;
    margin-bottom: 1.5rem;
  }

  .method__step-body {
    font-family: sans-serif;
    font-size: 1.125rem;
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .method__step-link {
    font-family: monospace;
    font-weight: 600;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .method__numeral {
    position: absolute;
    right: -2%;
    top: 50%;
    transform: translateY(-50%);
    font-family: sans-serif;
    font-weight: 900;
    font-size: clamp(15rem, 30vw, 35rem);
    line-height: 0.75;
    color: rgba(0, 0, 0, 0.04);
    z-index: 0;
  }

  /* ─── Zoom Takeover ──────────────────────────────────────────── */
  .method__zoom-wrapper {
    /* 300vh gives the user enough scroll distance to trigger the full zoom */
    height: 300vh;
    position: relative;
    background-color: var(--m-ink); /* Background behind the text */
  }

  .method__zoom-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .method__liquid-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2vw;
    font-family: 'Impact', sans-serif;
    font-size: clamp(2.5rem, 6vw, 8rem);
    color: #EDEDED;
    text-transform: uppercase;
    z-index: 10;
  }

  .method__plus {
    display: inline-block;
    color: var(--m-accent);
    /* Scale happens from the very center of the plus sign */
    transform-origin: center center;
    will-change: transform;
    /* Keeps the plus sharp as it scales infinitely */
    -webkit-font-smoothing: antialiased;
  }
</style>

<script>
  // Setup a high-performance scroll loop
  let scrollRaf;

  const updateAnimations = () => {
    // 1. STICKY CARDS SCALING DOWN
    const cards = document.querySelectorAll('.method__step');
    const stickyTop = window.innerHeight * 0.1; // Matches the top: 10vh in CSS

    cards.forEach((card) => {
      const rect = card.getBoundingClientRect();
      
      // If the card has hit the sticky point at the top of the screen
      if (rect.top <= stickyTop) {
        // Calculate how far past the sticky point we have scrolled
        const distancePastSticky = stickyTop - rect.top;
        // Normalize it against the screen height
        const progress = distancePastSticky / window.innerHeight;
        
        // Scale down from 1 to 0.9 slowly
        const scale = Math.max(0.9, 1 - progress * 0.15);
        // Fade out slightly
        const opacity = Math.max(0.4, 1 - progress * 1.2);
        
        card.style.transform = `scale(${scale})`;
        card.style.opacity = opacity.toString();
      } else {
        // Reset when scrolling back up
        card.style.transform = `scale(1)`;
        card.style.opacity = '1';
      }
    });

    // 2. MASSIVE PLUS TAKEOVER
    const wrapper = document.querySelector('.method__zoom-wrapper');
    const plus = document.querySelector('.method__plus');
    
    if (wrapper && plus) {
      const wrapperRect = wrapper.getBoundingClientRect();
      
      let zoomProgress = 0;
      // Start zooming only when the wrapper hits the top of the viewport
      if (wrapperRect.top < 0) {
        // Calculate progress from 0 to 1 over the 300vh scroll space
        const maxScroll = wrapperRect.height - window.innerHeight;
        zoomProgress = Math.min(1, Math.abs(wrapperRect.top) / maxScroll);
      }

      if (zoomProgress > 0) {
        // Exponential scale: starts slow, then shoots up incredibly fast
        // Scale factor of 250 is usually enough to cover a 4k monitor
        const scaleFactor = 1 + Math.pow(zoomProgress, 4) * 250;
        plus.style.transform = `scale(${scaleFactor})`;
      } else {
        plus.style.transform = `scale(1)`;
      }
    }
  };

  // Run on scroll and resize
  window.addEventListener('scroll', () => {
    if (!scrollRaf) {
      scrollRaf = requestAnimationFrame(() => {
        updateAnimations();
        scrollRaf = null;
      });
    }
  }, { passive: true });

  window.addEventListener('resize', updateAnimations);
  
  // Initial check on load
  updateAnimations();
</script>