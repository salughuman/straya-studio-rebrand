---
// TheStrayaMethod.astro — Straya Studio [IMMERSIVE]
// Scroll-driven process timeline. Each step enters sequentially.
// Active step highlighted with accent line + number scale.
// GEMINI §3: scroll-linked, unique interactive moment, spatial narrative.
// GEMINI §5: light mode tokens, no bold fonts, 0px radius.

const steps = [
  {
    num: "01",
    title: "Discovery",
    description: "We map your objectives, market position, and technical requirements before a single pixel is placed.",
    items: [
      "Project objectives & success metrics",
      "Brand, market, and competitor deep-dive",
      "Technical requirements and platform fit",
    ],
  },
  {
    num: "02",
    title: "Architecture",
    description: "Platform selection, CMS structure, and performance strategy — all decided before development begins.",
    items: [
      "Platform and technology stack selection",
      "CMS structure and content modeling",
      "Performance, SEO, and conversion strategy",
    ],
  },
  {
    num: "03",
    title: "Engineering",
    description: "Sprint-based builds with milestone reviews. Every component is production-grade from day one.",
    items: [
      "Sprint-based development with milestones",
      "Design system and component architecture",
      "Iteration review at every stage",
    ],
  },
  {
    num: "04",
    title: "Optimisation",
    description: "100/100 Lighthouse scores, Core Web Vitals, and post-launch support included as standard.",
    items: [
      "100/100 Lighthouse score tuning",
      "Core Web Vitals and technical SEO",
      "Post-launch monitoring and support",
    ],
  },
];
---

<section
  id="method"
  aria-label="The Straya Method — our process"
  class="section-y relative bg-background border-b border-black/5 overflow-hidden"
>
  <!-- Header -->
  <div class="main-container mb-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-black/5 pb-8">
      <div>
        <span class="type-label text-on-background/40 block mb-3">How we work</span>
        <h2 class="type-h2 text-on-background max-w-lg">
          The Straya Method — four stages, zero shortcuts.
        </h2>
      </div>
      <span class="type-label text-on-background/20 flex-shrink-0">V1.0.2 / SYSTEM_STATUS: STABLE</span>
    </div>
  </div>

  <!-- Steps -->
  <div class="main-container" id="method-steps">

    <!-- Progress bar — fills as steps become active -->
    <div class="relative mb-12 hidden md:block" aria-hidden="true">
      <div class="h-px bg-black/5 w-full"></div>
      <div id="method-progress" class="h-px bg-accent absolute top-0 left-0 transition-all duration-700 ease-luxury" style="width: 0%;"></div>
    </div>

    <!-- Step grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-black/5">
      {steps.map((step, i) => (
        <div
          class="method-step bg-background group relative overflow-hidden flex flex-col gap-8 card-pad"
          data-step={i}
        >
          <!-- Large background number -->
          <span
            class="method-step-num absolute top-6 right-6 font-display font-medium text-on-background/[0.04] select-none pointer-events-none transition-all duration-700"
            style={`font-size: clamp(4rem, 8vw, 6rem); line-height: 1;`}
            aria-hidden="true"
          >
            {step.num}
          </span>

          <!-- Step number + accent line -->
          <div class="flex items-center gap-3">
            <span
              class="method-step-index type-label text-on-background/30 transition-colors duration-500"
            >
              {step.num}
            </span>
            <div class="method-step-line h-px flex-1 bg-black/5 relative overflow-hidden">
              <div class="method-step-line-fill h-full bg-accent absolute left-0 top-0 w-0 transition-all duration-700 ease-luxury"></div>
            </div>
          </div>

          <!-- Title -->
          <h3 class="type-h3 text-on-background uppercase tracking-tight">{step.title}</h3>

          <!-- Description -->
          <p class="type-body-small text-on-surface-variant leading-relaxed">{step.description}</p>

          <!-- Deliverables list -->
          <ul class="flex flex-col gap-3 mt-auto" aria-label={`${step.title} deliverables`}>
            {step.items.map((item) => (
              <li class="flex items-start gap-3 type-body-small text-on-surface-variant">
                <span class="method-dot w-1 h-1 rounded-full bg-black/20 mt-1.5 shrink-0 transition-colors duration-500"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── Step entrance ─────────────────────────────────────────── */
  .method-step {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.4s ease;
  }

  .method-step.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Active step ───────────────────────────────────────────── */
  .method-step.is-active {
    background-color: theme('colors.surface-container-lowest');
  }

  .method-step.is-active .method-step-index {
    color: theme('colors.on-background');
  }

  .method-step.is-active .method-step-line-fill {
    width: 100%;
  }

  .method-step.is-active .method-step-num {
    color: rgba(0, 0, 0, 0.07);
    transform: scale(1.05);
    transform-origin: top right;
  }

  .method-step.is-active .method-dot {
    background-color: theme('colors.accent');
  }

  @media (prefers-reduced-motion: reduce) {
    .method-step {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .method-step-line-fill,
    #method-progress {
      transition: none;
    }
  }
</style>

<script>
  const steps    = document.querySelectorAll<HTMLElement>('.method-step');
  const progress = document.getElementById('method-progress');

  // ── Entrance observer ───────────────────────────────────────
  const entranceObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el    = entry.target as HTMLElement;
      const index = parseInt(el.dataset.step ?? '0');
      setTimeout(() => el.classList.add('is-visible'), index * 100);
      entranceObserver.unobserve(el);
    });
  }, { threshold: 0.15 });

  steps.forEach(s => entranceObserver.observe(s));

  // ── Active step on scroll ───────────────────────────────────
  // Each step becomes "active" when it enters the viewport centre
  const activeObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      const el    = entry.target as HTMLElement;
      const index = parseInt(el.dataset.step ?? '0');

      if (entry.isIntersecting) {
        el.classList.add('is-active');
        // Update progress bar — fills proportionally to active step
        if (progress) {
          const pct = ((index + 1) / steps.length) * 100;
          progress.style.width = `${pct}%`;
        }
      } else {
        el.classList.remove('is-active');
      }
    });
  }, {
    threshold: 0.4,
    rootMargin: '0px 0px -10% 0px',
  });

  steps.forEach(s => activeObserver.observe(s));
</script>
