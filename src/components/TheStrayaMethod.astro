---
// TheStrayaMethod.astro — Straya Studio [IMMERSIVE]
// Numbered process timeline with scroll-driven active states.
// Standard entrance animations (GEMINI §7).

const steps = [
  {
    num: "01",
    title: "Discovery",
    description: "We map your objectives, market position, and technical requirements before a single pixel is placed.",
    items: [
      "Project objectives & success metrics",
      "Brand, market, and competitor deep-dive",
      "Technical requirements and platform fit",
    ],
  },
  {
    num: "02",
    title: "Architecture",
    description: "Platform selection, CMS structure, and performance strategy — all decided before development begins.",
    items: [
      "Platform and technology stack selection",
      "CMS structure and content modeling",
      "Performance, SEO, and conversion strategy",
    ],
  },
  {
    num: "03",
    title: "Engineering",
    description: "Sprint-based builds with milestone reviews. Every component is production-grade from day one.",
    items: [
      "Sprint-based development with milestones",
      "Design system and component architecture",
      "Iteration review at every stage",
    ],
  },
  {
    num: "04",
    title: "Optimisation",
    description: "100/100 Lighthouse scores, Core Web Vitals, and post-launch support included as standard.",
    items: [
      "100/100 Lighthouse score tuning",
      "Core Web Vitals and technical SEO",
      "Post-launch monitoring and support",
    ],
  },
];
---

<section
  id="method"
  aria-label="The Straya Method — our process"
  class="section-y relative bg-background border-b border-black/5 overflow-hidden"
>
  <!-- Header -->
  <div class="main-container mb-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-black/5 pb-8">
      <div>
        <span class="m-el type-label text-on-background/40 block mb-3" data-delay="0">How we work</span>
        <h2 class="type-h2 text-on-background max-w-lg">
          <span class="m-line block overflow-hidden"><span class="m-el inline-block" data-delay="80">The Straya Method —</span></span>
          <span class="m-line block overflow-hidden"><span class="m-el inline-block" data-delay="140">four stages, zero shortcuts.</span></span>
        </h2>
      </div>
      <span class="m-el type-label text-on-background/20 flex-shrink-0" data-delay="240">V1.0.2 / SYSTEM_STATUS: STABLE</span>
    </div>
  </div>

  <!-- Progress track — desktop only -->
  <div class="main-container mb-0 hidden md:block" aria-hidden="true">
    <div class="relative h-px bg-black/5">
      <div id="method-progress" class="h-full bg-accent absolute left-0 top-0 transition-all duration-700 ease-luxury" style="width: 0%;"></div>
    </div>
  </div>

  <!-- Steps -->
  <div class="main-container" id="method-steps">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-black/5">
      {steps.map((step, i) => (
        <div
          class="method-step bg-background group relative overflow-hidden flex flex-col card-pad"
          data-step={i}
        >
          <!-- Ghost number -->
          <span
            class="method-num absolute top-4 right-4 font-display font-medium select-none pointer-events-none transition-all duration-700 text-on-background/[0.04]"
            style="font-size: clamp(3.5rem, 7vw, 5rem); line-height: 1;"
            aria-hidden="true"
          >
            {step.num}
          </span>

          <!-- Index + fill line -->
          <div class="flex items-center gap-3 mb-8">
            <span class="method-index type-label text-on-background/25 transition-colors duration-500 flex-shrink-0">
              {step.num}
            </span>
            <div class="h-px flex-1 bg-black/5 relative overflow-hidden">
              <div class="method-fill h-full bg-accent absolute left-0 top-0 w-0 transition-all duration-700 ease-luxury"></div>
            </div>
          </div>

          <!-- Title -->
          <h3 class="type-h3 text-on-background uppercase mb-4">{step.title}</h3>

          <!-- Description -->
          <p class="type-body-small text-on-surface-variant leading-relaxed mb-8">{step.description}</p>

          <!-- Items -->
          <ul class="flex flex-col gap-3 mt-auto border-t border-black/5 pt-6" aria-label={`${step.title} deliverables`}>
            {step.items.map(item => (
              <li class="flex items-start gap-3 type-body-small text-on-surface-variant">
                <span class="method-dot w-1 h-1 rounded-full bg-black/15 mt-[9px] shrink-0 transition-colors duration-500"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Header elements ───────────────────────────────────────── */
  .m-el {
    opacity: 0;
    transform: translateY(28px);
  }
  .m-line .m-el {
    transform: translateY(100%);
    opacity: 1;
  }

  /* ── Step entrance ─────────────────────────────────────────── */
  .method-step {
    opacity: 0;
    transform: translateY(28px);
  }

  /* ── Active step ───────────────────────────────────────────── */
  .method-step.is-active {
    background-color: theme('colors.surface-container-lowest');
  }
  .method-step.is-active .method-index {
    color: theme('colors.on-background');
  }
  .method-step.is-active .method-fill {
    width: 100%;
  }
  .method-step.is-active .method-num {
    color: rgba(0, 0, 0, 0.07);
    transform: scale(1.04);
    transform-origin: top right;
  }
  .method-step.is-active .method-dot {
    background-color: theme('colors.accent');
  }

  @media (prefers-reduced-motion: reduce) {
    .m-el { opacity: 1 !important; transform: none !important; }
    .method-step { opacity: 1; transform: none; }
    .method-fill, #method-progress { transition: none; }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 900;
  const MARGIN   = '0px 0px -80px 0px';

  // ── Header entrance ─────────────────────────────────────────
  const headerEls = document.querySelectorAll<HTMLElement>('#method .m-el');

  const headerObs = new IntersectionObserver(entries => {
    if (!entries[0].isIntersecting) return;
    headerEls.forEach(el => {
      const delay  = parseInt(el.dataset.delay ?? '0');
      const isLine = el.closest('.m-line') !== null;
      el.animate(
        isLine
          ? [{ transform: 'translateY(100%)' }, { transform: 'translateY(0%)' }]
          : [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
        { duration: DURATION, delay, easing: EASE, fill: 'forwards' }
      );
    });
    headerObs.disconnect();
  }, { rootMargin: MARGIN, threshold: 0 });

  const section = document.getElementById('method');
  if (section) headerObs.observe(section);

  // ── Step entrance ────────────────────────────────────────────
  const steps    = document.querySelectorAll<HTMLElement>('.method-step');
  const progress = document.getElementById('method-progress');

  const entranceObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el  = entry.target as HTMLElement;
      const idx = parseInt(el.dataset.step ?? '0');
      el.animate(
        [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
        { duration: DURATION, delay: 360 + idx * 80, easing: EASE, fill: 'forwards' }
      );
      entranceObs.unobserve(el);
    });
  }, { rootMargin: MARGIN, threshold: 0 });

  steps.forEach(s => entranceObs.observe(s));

  // ── Active step on scroll ────────────────────────────────────
  const activeObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      const el  = entry.target as HTMLElement;
      const idx = parseInt(el.dataset.step ?? '0');
      if (entry.isIntersecting) {
        el.classList.add('is-active');
        if (progress) progress.style.width = `${((idx + 1) / steps.length) * 100}%`;
      } else {
        el.classList.remove('is-active');
      }
    });
  }, { threshold: 0.4, rootMargin: '0px 0px -10% 0px' });

  steps.forEach(s => activeObs.observe(s));
</script>
