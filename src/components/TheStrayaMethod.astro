---
const steps = [
  {
    num: "01",
    title: "Discovery",
    description: "We map your objectives, market position, and technical fit before a single pixel is placed. Decisions that hold up later are made here.",
    linkText: "How we scope ↗",
    bgClass: "bg-surface"
  },
  {
    num: "02",
    title: "Architecture",
    description: "Platform, CMS, and performance strategy locked in week one. The system is decided before the design.",
    linkText: "Our stack ↗",
    bgClass: "bg-sage"
  },
  {
    num: "03",
    title: "Engineering",
    description: "Sprint-based builds, milestone reviews, production-grade from day one. Every component ships ready.",
    linkText: "Our process ↗",
    bgClass: "bg-surface"
  },
];
---

<section id="method" class="method bg-background relative" data-mode="neobrutalism">

  <div class="method__cards-container main-container pt-24 pb-8">

    <header class="mb-16">
      <span class="inline-block px-3 py-1 bg-brand-text-primary text-background font-mono text-xs uppercase tracking-widest -rotate-2 mb-6">
        <span class="text-accent">[03]</span> / The Straya Method
      </span>
      <h2 class="text-5xl md:text-7xl font-black uppercase tracking-tight text-on-background">
        Four stages.<br/>Zero shortcuts.
      </h2>
    </header>

    <div class="method__stack">
      {steps.map((step, i) => (
        <div class={`method__step ${step.bgClass}`} data-step>
          <h3 class="method__step-title">{step.title}</h3>
          <div class="method__step-content">
            <p class="method__step-body">{step.description}</p>
            <a href="#" class="method__step-link">{step.linkText}</a>
          </div>
          <span class="method__numeral" aria-hidden="true">{step.num}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="method__zoom-wrapper">
    <div class="method__zoom-sticky">
      <h3 class="method__liquid-title">
        <span class="method__word">CLARITY</span>
        <span class="method__plus">+</span>
        <span class="method__word">PERFORMANCE</span>
      </h3>
    </div>
  </div>

</section>

<style>
  .method {
    --m-ink: #0A0A0A;
    --m-bg-raised: #F4F4F4;
    --m-bg-sage: #84A98C;
    --m-fg-strong: #111111;
    /* Accent is now the brutalist green (matches design system —color-accent). */
    --m-accent: #3CCD7F;
    --m-hairline: rgba(0, 0, 0, 0.15);
  }

  .bg-surface { background: var(--m-bg-raised); color: var(--m-fg-strong); }
  .bg-sage    { background: var(--m-bg-sage);   color: var(--m-ink); }

  /* ─── Stack ──────────────────────────────────────────────────── */
  .method__stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 4rem;
  }

  /* ─── Card — horizontal three-zone layout ────────────────────── */
  /* Layout (per the reference screenshot):
       [  TITLE  ][      body + link      ][  NUMERAL (outline)  ]
        left          centered, narrow             right edge
     min-height brought down to ~32vh (was 50vh). */
  .method__step {
    position: sticky;
    top: 10vh;

    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;

    padding: 2.5rem 3rem;
    border: 1px solid var(--m-hairline);
    min-height: 32vh;
    overflow: hidden;
    position: relative;

    /* JS writes one number per element per frame. Visual interpolation
       is handled by CSS via this --p variable. */
    --p: 0;

    transform-origin: top center;
    transform: scale(calc(1 - var(--p) * 0.10));
    filter: blur(calc(var(--p) * 8px));
    opacity: calc(1 - var(--p) * 0.55);
  }

  .method__step[data-active="true"] {
    will-change: transform, filter, opacity;
  }

  .method__step-title {
    font-family: 'Impact', 'Helvetica Neue', sans-serif;
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 5rem);
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: -0.02em;
    margin: 0;
    z-index: 2;
    position: relative;
  }

  .method__step-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    z-index: 2;
    position: relative;
  }

  .method__step-body {
    font-family: sans-serif;
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 42ch;
    margin: 0 0 1.25rem;
  }

  .method__step-link {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: inherit;
  }

  /* Outline numeral on the right (per screenshot — see-through stroke) */
  .method__numeral {
    position: absolute;
    right: -1rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: 'Impact', 'Helvetica Neue', sans-serif;
    font-weight: 900;
    font-size: clamp(8rem, 22vw, 18rem);
    line-height: 0.75;
    letter-spacing: -0.02em;
    z-index: 1;
    pointer-events: none;

    color: transparent;
    -webkit-text-stroke: 2px rgba(0, 0, 0, 0.18);
    text-stroke: 2px rgba(0, 0, 0, 0.18);
  }

  /* ─── Zoom Takeover — full width, accent green ───────────────── */
  /* Reduced from 300vh → 200vh. Closer to last card.
     Cards container pb reduced from pb-32 → pb-8 above too. */
  .method__zoom-wrapper {
    height: 200vh;
    position: relative;
    background-color: var(--m-ink);
    --z: 0;
  }

  .method__zoom-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0;
  }

  /* Full-width heading. Stretches edge to edge, accent green floods in. */
  .method__liquid-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0 4vw;

    font-family: 'Impact', 'Helvetica Neue', sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 12vw, 14rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    z-index: 10;
    margin: 0;

    /* Cream → accent (green) as zoom progresses. */
    color: color-mix(
      in oklab,
      #EDEDED calc((1 - var(--z)) * 100%),
      var(--m-accent) calc(var(--z) * 100%)
    );
  }

  .method__word {
    flex: 0 1 auto;
    letter-spacing: calc(-0.04em + var(--z) * -0.02em);
    transform: translateY(calc(var(--z) * -0.5vh));
  }

  .method__plus {
    flex: 0 0 auto;
    color: var(--m-accent);
    transform-origin: center center;
    -webkit-font-smoothing: antialiased;
    will-change: transform;
  }

  /* ─── Reduced motion ─────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .method__step,
    .method__plus,
    .method__liquid-title,
    .method__word {
      transition: none !important;
      animation: none !important;
    }
    .method__step {
      --p: 0 !important;
      transform: none !important;
      filter: none !important;
      opacity: 1 !important;
    }
    .method__plus {
      transform: none !important;
    }
  }

  /* ─── Mobile ─────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .method__step {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      gap: 1.5rem;
      padding: 2rem 1.5rem;
      min-height: 40vh;
      text-align: left;
    }
    .method__step-title {
      font-size: clamp(2rem, 10vw, 3rem);
    }
    .method__step-content {
      align-items: flex-start;
      text-align: left;
    }
    .method__numeral {
      font-size: 10rem;
      right: -1.5rem;
    }
    .method__liquid-title {
      flex-direction: column;
      gap: 1rem;
      font-size: clamp(2.5rem, 14vw, 6rem);
    }
  }
</style>

<script>
  (() => {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) return;

    const root = document.querySelector(".method");
    if (!root) return;

    const cards = Array.from(root.querySelectorAll(".method__step"));
    const wrapper = root.querySelector(".method__zoom-wrapper");
    const plus = root.querySelector(".method__plus");

    if (cards.length === 0) return;

    let vh = window.innerHeight;
    let stickyTop = vh * 0.1;
    let raf = 0;

    const clamp01 = (n) => (n < 0 ? 0 : n > 1 ? 1 : n);

    const update = () => {
      raf = 0;

      // ── CARDS ──
      // Two-phase progress model:
      //
      //   Phase A (approach):  card top crosses screen center → sticky line
      //     Card hasn't pinned yet, but starts scaling down anticipatorily.
      //     Contributes 0 → 0.4 of total progress.
      //
      //   Phase B (overlap):   card is sticky, next card slides over it
      //     Contributes 0.4 → 1.0.
      //
      // The card starts shrinking *before* it pins — that's the
      // "scale down as it crosses center of screen" behaviour.

      const screenCenter = vh / 2;
      const PHASE_A_WEIGHT = 0.4;
      const PHASE_B_WEIGHT = 0.6;

      for (let i = 0; i < cards.length; i++) {
        const card = cards[i];
        const rect = card.getBoundingClientRect();

        let progress = 0;

        if (rect.top > vh + 200 || rect.bottom < -200) {
          progress = 0;
        } else if (rect.top > stickyTop) {
          // Phase A — between screen center and sticky line
          if (rect.top < screenCenter) {
            const phaseA = clamp01(
              (screenCenter - rect.top) / (screenCenter - stickyTop)
            );
            progress = phaseA * PHASE_A_WEIGHT;
          } else {
            progress = 0;
          }
        } else {
          // Phase B — sticky-pinned, next card sliding over
          const next = cards[i + 1];
          if (next) {
            const nextRect = next.getBoundingClientRect();
            const span = rect.height;
            const traveled = stickyTop + span - nextRect.top;
            const phaseB = clamp01(traveled / span);
            progress = PHASE_A_WEIGHT + phaseB * PHASE_B_WEIGHT;
          } else if (wrapper) {
            // Last card — fade as zoom-wrapper approaches
            const wRect = wrapper.getBoundingClientRect();
            const distance = vh - wRect.top;
            const phaseB = clamp01(distance / vh) * 0.6;
            progress = PHASE_A_WEIGHT + phaseB * PHASE_B_WEIGHT;
          } else {
            progress = PHASE_A_WEIGHT;
          }
        }

        card.style.setProperty("--p", progress.toFixed(3));
        card.dataset.active =
          progress > 0.001 && progress < 0.999 ? "true" : "false";
      }

      // ── ZOOM TAKEOVER ──
      if (wrapper && plus) {
        const wRect = wrapper.getBoundingClientRect();
        let z = 0;

        if (wRect.top < 0) {
          const maxScroll = wRect.height - vh;
          z = clamp01(Math.abs(wRect.top) / maxScroll);
        }

        wrapper.style.setProperty("--z", z.toFixed(4));

        const scaleFactor = z > 0 ? 1 + Math.pow(z, 2.6) * 220 : 1;
        plus.style.transform = `scale(${scaleFactor.toFixed(2)})`;
      }
    };

    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(update);
    };

    const onResize = () => {
      vh = window.innerHeight;
      stickyTop = vh * 0.1;
      update();
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });

    update();
  })();
</script>
