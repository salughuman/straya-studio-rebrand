---
// Navbar — Straya Studio
// 'Canvass' inspired broad-centered layout with architectural responsive layer.
import { SITE_CONFIG } from "../data/site-config";
import NavButton from "./ui/buttons/NavButton.astro";
import NavLink from "./ui/links/NavLink.astro";

const navLinks = [
  { label: "Services", href: "/#services" },
  { label: "Work", href: "/#work" },
  { label: "Pricing", href: "/#pricing" },
];
---
<header
  id="navbar-header"
  class="fixed top-0 inset-x-0 mx-auto z-50 pointer-events-none transition-all duration-300 ease-luxury"
>
  <nav
    id="navbar"
    class="w-full mx-auto min-h-[72px] lg:h-[72px] flex flex-wrap lg:flex-nowrap items-center justify-between px-[var(--gutter-mobile)] md:px-[var(--gutter-tablet)] lg:pr-[16px] rounded-b-[var(--radius-md)] pointer-events-auto transition-all duration-300 ease-luxury border border-black/15 border-t-0 bg-brand-secondary/95 backdrop-blur-3xl shadow-[0_14px_30px_rgba(0,0,0,0.25)]"
  >
    <!-- 1. Brand Mark (Left) -->
    <a
      href="/"
      class="flex items-center gap-2 group no-underline rounded-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#3CCD7F]"
      aria-label="Straya Studio Home"
    >
      <span class="type-h5 text-[#05210f] font-bold tracking-tighter uppercase tabular-nums leading-none">Straya</span>
      <span class="type-h5 text-white font-bold tracking-tighter uppercase tabular-nums italic leading-none">Studio</span>
    </a>

    <!-- 2. Navigation Links (Center — Desktop Only) -->
    <div class="hidden lg:flex items-center gap-7">
      {
        navLinks.map((link) => (
          <NavLink
            href={link.href}
            label={link.label}
            variant="main"
            tone="navbar"
            class="nav-link"
          />
        ))
      }
    </div>

    <!-- 3. Actions (Right) -->
    <div class="flex items-center">
      <!-- Desktop CTA -->
      <div class="hidden lg:block">
        <NavButton
          href={SITE_CONFIG.socials.calendly}
          label="Book a call"
          variant="frosted"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 hover:-translate-y-1 !bg-[#050505] !text-white !border-black/20 hover:!bg-[#0f1115] hover:!text-white hover:!shadow-none"
        />
      </div>

      <!-- Mobile/Tablet Trigger (<1200px) -->
      <button
        id="menu-trigger"
        class="lg:hidden text-[#05210f] label-mono font-medium tracking-tight h-[72px] flex items-center cursor-pointer bg-transparent border-none appearance-none outline-none relative z-50 rounded-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#3CCD7F]"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="transition-opacity duration-300 ease-luxury leading-none">Menu</span>
      </button>
    </div>
    <!-- Mobile Menu (expands inside parent navbar container) -->
    <div
      id="mobile-menu"
      class="lg:hidden basis-full w-full overflow-hidden"
    >
    <div class="px-0 py-10 flex flex-col items-start gap-6">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link text-[32px] md:text-[24px] font-medium text-[#05210f]/90 hover:text-white transition-colors duration-300 ease-luxury no-underline tracking-tighter rounded-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#3CCD7F]"
          >
            {link.label}
          </a>
        ))
      }

      <!-- Subtle Divider -->
      <div class="w-full h-px bg-black/15 my-2"></div>

      <!-- Mobile Primary CTA -->
      <a
        href={SITE_CONFIG.socials.calendly}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full h-14 flex items-center justify-center bg-[#050505] text-white font-bold text-sm rounded-sm no-underline hover:bg-[#0f1115] transition-[transform,border-color,background-color,color,box-shadow] duration-300 ease-luxury shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#3CCD7F]"
      >
        Book a call
      </a>

      <div class="w-full flex flex-col gap-1">
        <p class="type-caption text-[#05210f]/70">50% upfront, 50% on delivery</p>
        <p class="type-caption text-[#05210f]/70">2–3 active projects at a time</p>
      </div>

    </div>
    </div>
  </nav>
</header>

<style>
  #navbar {
    max-width: calc(var(--container-max) - (var(--gutter-mobile) * 2));
  }

  @media (min-width: 810px) {
    #navbar {
      max-width: calc(var(--container-max) - (var(--gutter-tablet) * 2));
    }
  }

  @media (min-width: 1200px) {
    #navbar {
      max-width: calc(var(--container-max) - (var(--gutter-desktop) * 2));
    }
  }

  #mobile-menu {
    max-height: 0;
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition:
      max-height 820ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 560ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Header State Styles */
  #navbar.scrolled {
    background-color: rgba(60, 205, 127, 0.92);
    border-color: rgba(0, 0, 0, 0.26);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.32);
  }

  #navbar.menu-open {
    box-shadow: 0 22px 46px rgba(0, 0, 0, 0.28);
  }

  /* Transition for Mobile Menu */
  #mobile-menu.active {
    max-height: 36rem;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Custom cubic-bezier timing utility if needed */
  .cubic-bezier {
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  const header = document.getElementById('navbar-header');
  const nav = document.getElementById('navbar');
  const menuBtn = document.getElementById('menu-trigger');
  const menuPanel = document.getElementById('mobile-menu');
  const menuText = menuBtn?.querySelector('span');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  // 1. Scroll State Interaction (Threshold: 40px)
  const handleScroll = () => {
    if (window.scrollY > 40) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });

  // 2. Mobile Menu Logic
  const toggleMenu = (forceClose = false) => {
    const isNowOpen = forceClose ? true : menuBtn?.getAttribute('aria-expanded') === 'true';
    const nextState = !isNowOpen;

    menuBtn?.setAttribute('aria-expanded', String(nextState));
    
    // Smooth Opacity Text Transition
    if (menuText) {
      menuText.style.opacity = '0';
      setTimeout(() => {
        menuText.innerText = nextState ? 'Close' : 'Menu';
        menuText.style.opacity = '1';
      }, 280);
    }

    if (nextState) {
      menuPanel?.classList.add('active');
      nav?.classList.add('menu-open');
    } else {
      menuPanel?.classList.remove('active');
      nav?.classList.remove('menu-open');
    }
  };

  menuBtn?.addEventListener('click', () => toggleMenu());

  // 3. Auto-close Behaviors
  // ESC key closure
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
      toggleMenu();
    }
  });

  // Link click closure
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      toggleMenu(true); // Close immediately
    });
  });
</script>
