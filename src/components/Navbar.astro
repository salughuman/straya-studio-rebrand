---
/**
 * Navbar.astro — Straya Studio
 * Mode: Brutalism (fixed, hairline border, mono labels)
 * Responsive: pill nav on desktop, full-screen slide-down on mobile
 * Compliance: design-system.md §10 nav tokens | micro-interactions.md M3, M4
 */
import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";
const baseUrl = import.meta.env.BASE_URL;

const navLinks = [
  { label: "Work",     href: `${baseUrl}#work` },
  { label: "Process",  href: `${baseUrl}#method` },
  { label: "Services", href: `${baseUrl}#services` },
  { label: "FAQ",      href: `${baseUrl}#faq` },
];
---

<!-- Desktop / tablet navbar — centered pill (original structure) -->
<nav
  id="navbar"
  aria-label="Main navigation"
  class="fixed top-0 w-full z-50 flex justify-center"
>
  <div
    class="flex items-center gap-3 rounded-b-2xl border border-on-background/10 bg-surface-dim/80 px-4 py-2 shadow-[0_8px_32px_-8px_rgba(0,0,0,0.5),inset_0_1px_0_rgba(255,237,215,0.06)] backdrop-blur-xl sm:gap-5 md:gap-6 md:rounded-b-3xl md:px-8"
  >
    {navLinks.map(link => (
      <a
        href={link.href}
        data-nav-link
        class="global-nav-link hidden font-mono text-xs tracking-[0.06em] uppercase transition-colors duration-200 md:block md:text-sm"
        style="color: rgba(var(--fg-rgb), 0.7);"
      >
        {link.label}
      </a>
    ))}
    <a
      href={`${baseUrl}contact`}
      class="text-[10px] font-medium transition-colors duration-200 hover:text-on-background hidden md:block sm:text-xs md:text-sm"
      style="color: rgba(var(--fg-rgb), 0.9);"
    >
      Start a project
    </a>
    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      type="button"
      class="nav-icon-btn inline-flex md:hidden w-8 h-8 relative"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      style="color: rgba(var(--fg-rgb), 0.8);"
    >
      <span class="nav-toggle-face nav-toggle-face--menu" aria-hidden="true">
        <svg class="nav-toggle-svg" viewBox="0 0 24 24" width="20" height="20" fill="none">
          <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="nav-toggle-face nav-toggle-face--close" aria-hidden="true">
        <svg class="nav-toggle-svg" viewBox="0 0 24 24" width="20" height="20" fill="none">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
    </button>
  </div>
</nav>

<!-- Mobile menu — full screen, slides down -->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="false"
  aria-hidden="true"
  aria-labelledby="mobile-menu-title"
  class="fixed inset-x-0 top-0 z-40 bg-surface-dim flex flex-col md:hidden"
  style="height: 100dvh;"
>
  <h2 id="mobile-menu-title" class="sr-only">Site menu</h2>

  <!-- Header row -->
  <div class="main-container flex flex-shrink-0 items-center justify-between border-b border-on-background/10 py-4">
    <img
      src={`${baseUrl}logo.svg`}
      alt="Straya Studio"
      class="h-[20px] w-auto"
      loading="eager"
      decoding="async"
    />
    <button
      id="nav-close"
      type="button"
      class="inline-flex items-center justify-center w-10 h-10 text-on-background/70 hover:text-on-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      aria-label="Close menu"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Links -->
  <nav class="flex-1 flex flex-col justify-start gap-0 pt-4 pb-3 overflow-y-auto px-5 md:px-12" aria-label="Mobile navigation">
    {navLinks.map((link, i) => (
      <a
        href={link.href}
        class="mobile-link block w-full border-b border-on-background/8 last:border-0 py-5"
        data-nav-link
        data-i={i}
      >
        <div class="flex items-center justify-between">
          <span class="font-display font-black text-on-background" style="font-size: clamp(1.8rem, 7vw, 2.5rem); letter-spacing: -0.04em;">
            {link.label}
          </span>
          <svg class="w-4 h-4 text-on-background/20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    ))}
  </nav>

  <!-- Footer CTA -->
  <div class="px-5 md:px-12 pb-10 flex-shrink-0 flex flex-col gap-3">
    <Button
      href={`${baseUrl}contact`}
      label="Start a project"
      variant="hero-pill"
      class="w-full justify-center"
    />
    <a
      href={`mailto:${SITE_CONFIG.email}`}
      class="font-mono text-xs uppercase tracking-[0.08em] text-on-background/30 text-center hover:text-on-background transition-colors duration-300"
    >
      {SITE_CONFIG.email}
    </a>
  </div>
</div>

<style>
  /* PERMITTED: backdrop-filter, clip-path animation, @keyframes */

  /* ── Pill container ────────────────────────────────────────── */
  .nav-pill {
    background: rgba(var(--bg-dim-rgb), 0.85);
    border: 1px solid rgba(var(--fg-rgb), 0.1);
    border-radius: 9999px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 4px 24px rgba(var(--black-rgb), 0.3), inset 0 1px 0 rgba(var(--fg-rgb), 0.06);
  }

  /* Global nav link style */
  .global-nav-link:hover { color: rgba(var(--fg-rgb), 0.95) !important; }
  .global-nav-link.is-active {
    color: var(--color-fg) !important;
    box-shadow: inset 0 -2px 0 rgba(var(--accent-rgb), 0.7);
  }

  /* ── Hamburger toggle faces ────────────────────────────────── */
  #nav-toggle,
  #nav-close {
    -webkit-tap-highlight-color: transparent;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }
  #nav-close { display: inline-flex; }
  .nav-toggle-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  #nav-toggle .nav-toggle-face--close { display: none; }
  #nav-toggle.is-open .nav-toggle-face--menu { display: none; }
  #nav-toggle.is-open .nav-toggle-face--close { display: flex; }

  /* ── Mobile menu slide ─────────────────────────────────────── */
  #mobile-menu {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  #mobile-menu.is-open {
    clip-path: inset(0 0 0% 0);
    pointer-events: auto;
  }

  /* ── Mobile link stagger ───────────────────────────────────── */
  .mobile-link {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.2s ease;
    text-decoration: none;
    color: var(--color-on-background, #FFEDD7);
  }
  #mobile-menu.is-open .mobile-link { opacity: 1; transform: translateY(0); }
  #mobile-menu.is-open .mobile-link[data-i="0"] { transition-delay: 0.10s; }
  #mobile-menu.is-open .mobile-link[data-i="1"] { transition-delay: 0.15s; }
  #mobile-menu.is-open .mobile-link[data-i="2"] { transition-delay: 0.20s; }
  #mobile-menu.is-open .mobile-link[data-i="3"] { transition-delay: 0.25s; }

  .mobile-link.is-active span { color: var(--color-accent, #DC5000); }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu { transition: none; }
    .mobile-link { transition: none; opacity: 1; transform: none; }
  }
</style>

<script>
  const initNavbar = () => {
    const toggle      = document.getElementById('nav-toggle');
    const menu        = document.getElementById('mobile-menu');
    const closeBtn    = document.getElementById('nav-close');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    const open = () => {
      menu?.classList.add('is-open');
      menu?.setAttribute('aria-hidden', 'false');
      menu?.setAttribute('aria-modal', 'true');
      toggle?.classList.add('is-open');
      toggle?.setAttribute('aria-expanded', 'true');
      toggle?.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      menu?.classList.remove('is-open');
      menu?.setAttribute('aria-hidden', 'true');
      menu?.setAttribute('aria-modal', 'false');
      toggle?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
    };

    toggle?.addEventListener('click', () => menu?.classList.contains('is-open') ? close() : open());
    closeBtn?.addEventListener('click', close);
    mobileLinks.forEach(l => l.addEventListener('click', close));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

    // ── Active section tracking ───────────────────────────────
    const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const sectionIds  = Array.from(allNavLinks)
      .map(l => l.getAttribute('href')?.split('#')[1])
      .filter(Boolean) as string[];

    const setActive = (id: string) => {
      allNavLinks.forEach(link => {
        link.classList.toggle('is-active', (link.getAttribute('href') ?? '').endsWith(`#${id}`));
      });
    };

    const sectionObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => { if (entry.isIntersecting) setActive(entry.target.id); });
    }, { rootMargin: '-10% 0px -60% 0px', threshold: 0 });

    sectionIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) sectionObserver.observe(el);
    });

    const hash = window.location.hash.slice(1);
    if (hash) setActive(hash);
  };

  initNavbar();
  document.addEventListener('astro:after-swap', initNavbar);
</script>
