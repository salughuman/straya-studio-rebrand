---
import { SITE_CONFIG } from "../data/site-config";
import NavButton from "./ui/buttons/NavButton.astro";
const baseUrl = import.meta.env.BASE_URL;

const navLinks = [
  { label: "Services", href: `${baseUrl}#services` },
  { label: "Process",  href: `${baseUrl}#method` },
  { label: "Pricing",  href: `${baseUrl}#pricing` },
  { label: "About",    href: `${baseUrl}#about` },
  { label: "FAQ",      href: `${baseUrl}#faq` },
];
---

<!-- Navbar -->
<nav
  id="navbar"
  aria-label="Main navigation"
  class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-xl border-b border-black/5"
>
  <div class="main-container flex justify-between items-center py-4">

    <!-- Logo -->
    <a href={baseUrl} aria-label="Straya Studio — Home" class="no-underline flex-shrink-0 z-10">
      <span class="font-display font-medium text-xl tracking-tight text-on-background uppercase">
        STRAYA STUDIO
      </span>
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          data-nav-link
          class="nav-link type-label text-on-background/40 hover:text-on-background transition-colors duration-300"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Right side -->
    <div class="flex items-center gap-3">
      <!-- CTA — desktop only -->
      <div class="hidden md:block">
        <NavButton href={SITE_CONFIG.socials.calendly} label="Initiate Project" variant="primary" />
      </div>

      <!-- Hamburger — mobile only -->
      <button
        id="nav-toggle"
        class="md:hidden w-10 h-10 flex flex-col justify-center items-center gap-[6px]"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
      </button>
    </div>

  </div>
</nav>

<!-- Mobile menu — full screen, slides down from top -->
<div
  id="mobile-menu"
  aria-hidden="true"
  class="fixed inset-x-0 top-0 z-40 bg-background flex flex-col md:hidden"
  style="height: 100dvh;"
>
  <!-- Header row (mirrors navbar) -->
  <div class="main-container flex justify-between items-center py-4 border-b border-black/5 flex-shrink-0">
    <span class="font-display font-medium text-xl tracking-tight text-on-background uppercase">
      STRAYA STUDIO
    </span>
    <button
      id="nav-close"
      class="w-10 h-10 relative"
      aria-label="Close menu"
    >
      <span class="xbar" aria-hidden="true"></span>
      <span class="xbar" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Links — top-left aligned -->
  <nav class="flex-1 flex flex-col justify-start items-start gap-0 pt-5 pb-3 overflow-y-auto px-5 md:px-12" aria-label="Mobile navigation">
    {navLinks.map((link, i) => (
      <a
        href={link.href}
        class="mobile-link nav-link block w-full border-b border-black/5 last:border-0 py-4"
        data-nav-link
        data-i={i}
      >
        <div class="flex items-center justify-between">
          <span class="font-display font-medium text-on-background" style="font-size: clamp(1.6rem, 6.5vw, 2.25rem); letter-spacing: -0.03em;">
            {link.label}
          </span>
          <svg class="w-4 h-4 text-on-background/20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    ))}
  </nav>

  <!-- Footer -->
  <div class="px-5 md:px-12 pb-8 flex-shrink-0 flex flex-col gap-3">
    <a
      href={SITE_CONFIG.socials.calendly}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full flex items-center justify-center type-button bg-primary text-on-primary py-4 hover:bg-accent transition-colors duration-300"
    >
      Initiate Project
    </a>
    <a
      href={`mailto:${SITE_CONFIG.email}`}
      class="type-label text-on-background/30 text-center hover:text-on-background transition-colors duration-300"
    >
      {SITE_CONFIG.email}
    </a>
  </div>
</div>

<style>
  /* Navbar backdrop */
  #navbar { -webkit-backdrop-filter: blur(24px); }

  /* Mobile icons */
  #nav-toggle, #nav-close { -webkit-tap-highlight-color: transparent; }

  .bar {
    display: block;
    height: 2px;
    width: 22px;
    background: theme('colors.on-background');
    border-radius: 999px;
    transform-origin: center;
    transition: transform 0.32s cubic-bezier(0.19,1,0.22,1), opacity 0.2s ease;
  }
  .bar:nth-of-type(3) {
    width: 14px;
    /* Keep right edge visually aligned with 22px bars */
    transform: translateX(4px);
  }

  .xbar {
    display: block;
    height: 2px;
    width: 22px;
    background: theme('colors.on-background');
    border-radius: 999px;
    transform-origin: center;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  #nav-close .xbar:nth-of-type(1) { transform: translate(-50%, -50%) rotate(45deg); }
  #nav-close .xbar:nth-of-type(2) { transform: translate(-50%, -50%) rotate(-45deg); }

  /* Mobile menu — hidden by default via clip-path */
  #mobile-menu {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  #mobile-menu.is-open {
    clip-path: inset(0 0 0% 0);
    pointer-events: auto;
  }

  /* Link stagger */
  .mobile-link {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.2s ease;
  }
  #mobile-menu.is-open .mobile-link {
    opacity: 1;
    transform: translateY(0);
  }
  #mobile-menu.is-open .mobile-link[data-i="0"] { transition-delay: 0.12s; }
  #mobile-menu.is-open .mobile-link[data-i="1"] { transition-delay: 0.17s; }
  #mobile-menu.is-open .mobile-link[data-i="2"] { transition-delay: 0.22s; }
  #mobile-menu.is-open .mobile-link[data-i="3"] { transition-delay: 0.27s; }
  #mobile-menu.is-open .mobile-link[data-i="4"] { transition-delay: 0.32s; }
  #mobile-menu.is-open .mobile-link[data-i="5"] { transition-delay: 0.37s; }

  /* Active nav link */
  .nav-link.is-active {
    color: theme('colors.on-background') !important;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  /* Mobile active — accent color on the label */
  .mobile-link.is-active span {
    color: theme('colors.accent');
  }
  #nav-toggle.is-open .bar:nth-of-type(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #nav-toggle.is-open .bar:nth-of-type(2) {
    transform: translateY(-8px) rotate(-45deg);
  }
  #nav-toggle.is-open .bar:nth-of-type(3) {
    opacity: 0;
    transform: scaleX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu { transition: none; }
    .mobile-link { transition: none; opacity: 1; transform: none; }
    .bar { transition: none; }
  }
</style>

<script>
  const toggle  = document.getElementById('nav-toggle');
  const menu    = document.getElementById('mobile-menu');
  const closeBtn= document.getElementById('nav-close');
  const links   = document.querySelectorAll('.mobile-link');

  function open() {
    menu?.classList.add('is-open');
    menu?.setAttribute('aria-hidden', 'false');
    toggle?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Close menu');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    menu?.classList.remove('is-open');
    menu?.setAttribute('aria-hidden', 'true');
    toggle?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () =>
    menu?.classList.contains('is-open') ? close() : open()
  );
  closeBtn?.addEventListener('click', close);
  links.forEach(l => l.addEventListener('click', close));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

  // ── Active section tracking ─────────────────────────────────
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  const sectionIds = Array.from(navLinks)
    .map(l => l.getAttribute('href')?.split('#')[1])
    .filter(Boolean) as string[];

  function setActive(id: string) {
    navLinks.forEach(link => {
      const href = link.getAttribute('href') ?? '';
      const isActive = href.endsWith(`#${id}`);
      link.classList.toggle('is-active', isActive);
    });
  }

  // Use IntersectionObserver — activate when section is ≥20% in view
  const sectionObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        setActive(entry.target.id);
      }
    });
  }, {
    rootMargin: '-10% 0px -60% 0px',
    threshold: 0,
  });

  sectionIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) sectionObserver.observe(el);
  });

  // Set active on page load based on hash
  const hash = window.location.hash.slice(1);
  if (hash) setActive(hash);
</script>
