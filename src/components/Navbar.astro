---
// Navbar.astro — Straya Studio
// GEMINI §14: fixed, backdrop-blur-xl, max 6 links, hamburger on mobile.
// Padding matches main-container: 2rem mobile → 4rem desktop (md breakpoint = 810px).
import { SITE_CONFIG } from "../data/site-config";
import NavButton from "./ui/buttons/NavButton.astro";
const baseUrl = import.meta.env.BASE_URL;

const navLinks = [
  { label: "Work",      href: `${baseUrl}#work` },
  { label: "Framework", href: `${baseUrl}#framework` },
  { label: "Studio",    href: `${baseUrl}#studio` },
  { label: "Archive",   href: `${baseUrl}#archive` },
];
---

<nav
  id="navbar"
  aria-label="Main navigation"
  class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-xl border-b border-black/5 transition-all duration-300"
>
  <!-- Inner wrapper — uses main-container class for pixel-perfect alignment with all sections -->
  <div class="main-container flex justify-between items-center py-4">

    <!-- Logo -->
    <a href={baseUrl} aria-label="Straya Studio — Home" class="no-underline flex-shrink-0">
      <span class="font-display font-medium text-xl tracking-tight text-on-background uppercase">
        STRAYA STUDIO
      </span>
    </a>

    <!-- Desktop Links (hidden below md = 810px) -->
    <div class="hidden md:flex items-center gap-10" role="list">
      {navLinks.map((link, i) => (
        <a
          role="listitem"
          href={link.href}
          class:list={[
            "type-label transition-all duration-300 hover:scale-[1.02]",
            i === 0
              ? "text-on-background border-b border-on-background pb-px"
              : "text-on-background/40 hover:text-on-background"
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Right: CTA + Mobile Toggle -->
    <div class="flex items-center gap-4">
      <!-- CTA — visible on all screens -->
      <NavButton
        href={SITE_CONFIG.socials.calendly}
        label="Initiate Project"
        variant="primary"
      />

      <!-- Hamburger — visible below md only -->
      <button
        id="nav-toggle"
        class="md:hidden flex flex-col justify-center items-center gap-[5px] w-8 h-8 text-on-background flex-shrink-0"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-bar block w-5 h-px bg-current transition-all duration-300 custom-bezier origin-center"></span>
        <span class="nav-bar block w-5 h-px bg-current transition-all duration-300 custom-bezier origin-center"></span>
      </button>
    </div>

  </div>
</nav>

<!-- Mobile Menu overlay -->
<div
  id="mobile-menu"
  role="dialog"
  aria-label="Mobile navigation"
  aria-modal="true"
  class="fixed inset-0 z-40 bg-background flex flex-col justify-center px-8 gap-6 translate-y-full transition-transform duration-500 custom-bezier md:hidden"
>
  <!-- Close button -->
  <button
    id="nav-close"
    class="absolute top-5 right-8 type-label text-on-background/40 hover:text-on-background transition-colors duration-300"
    aria-label="Close mobile menu"
  >
    Close
  </button>

  <!-- Mobile nav links -->
  <nav aria-label="Mobile navigation links">
    {navLinks.map(link => (
      <a
        href={link.href}
        class="block type-h2 text-on-background hover:text-on-background/40 transition-colors duration-300 nav-mobile-link py-3 border-b border-black/5 last:border-0"
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Mobile CTA -->
  <div class="mt-4">
    <NavButton
      href={SITE_CONFIG.socials.calendly}
      label="Initiate Project"
      variant="primary"
      class="w-full justify-center py-4"
    />
  </div>
</div>

<style>
  #navbar {
    -webkit-backdrop-filter: blur(24px);
  }

  /* Mobile menu open state */
  #mobile-menu.is-open {
    transform: translateY(0);
  }

  /* Hamburger → X */
  #nav-toggle.is-open .nav-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #nav-toggle.is-open .nav-bar:nth-child(2) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    .nav-bar {
      transition: none !important;
    }
  }
</style>

<script>
  const toggle      = document.getElementById('nav-toggle');
  const menu        = document.getElementById('mobile-menu');
  const closeBtn    = document.getElementById('nav-close');
  const mobileLinks = menu?.querySelectorAll('.nav-mobile-link');

  function openMenu() {
    menu?.classList.add('is-open');
    toggle?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.remove('is-open');
    toggle?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    menu?.classList.contains('is-open') ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);
  mobileLinks?.forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
</script>
