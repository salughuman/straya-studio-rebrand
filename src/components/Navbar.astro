---
/**
 * Navbar.astro — Straya Studio
 * Full-width strip: no nav background; logo left, links + Hero CTA right.
 * Mobile: logo left, menu toggle right; drawer keeps Hero pill CTA.
 */
import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";

const baseUrl = import.meta.env.BASE_URL;

/** Order matches `src/pages/index.astro` main scroll sections (after Hero). */
const navLinks = [
  { label: "About",         href: `${baseUrl}#about` },
  { label: "Work",          href: `${baseUrl}#work` },
  { label: "Testimonials",  href: `${baseUrl}#testimonials` },
  { label: "Services",      href: `${baseUrl}#services` },
  { label: "Offer",         href: `${baseUrl}#why` },
  { label: "FAQ",           href: `${baseUrl}#faq` },
];

const navCtaLabel = "Start a project";
---

<!-- Transparent bar: logo left, links + Hero pill CTA right (toggle only on mobile) -->
<nav
  id="navbar"
  aria-label="Main navigation"
  class="pointer-events-none fixed inset-x-0 top-2 z-50 w-full"
>
  <div
    class="main-container pointer-events-auto flex items-center justify-between gap-6 py-3 sm:py-4"
  >
    <a
      href={baseUrl}
      class="shrink-0 rounded-sm outline-none transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      aria-label={SITE_CONFIG.name}
    >
      <span class="font-display inline-flex items-baseline gap-0 font-semibold tracking-tight text-on-background" aria-hidden="true">
        <span class="text-4xl leading-[0.85] sm:text-5xl">S</span>
        <span class="text-2xl leading-none text-accent sm:text-3xl translate-y-[0.22em]">.</span>
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-3 sm:gap-4 md:gap-6">
      <div class="hidden items-center gap-5 md:flex md:gap-8 lg:gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link
            class="global-nav-link whitespace-nowrap  py-2 font-mono text-sm font-medium tracking-[0.06em] uppercase text-on-background/90 transition-colors duration-200 hover:text-on-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            {link.label}
          </a>
        ))}
        <Button
          href={`${baseUrl}contact`}
          label={navCtaLabel}
          variant="hero-pill"
          class="!py-2.5 !px-6 text-xs sm:!py-3 sm:!px-8"
        />
      </div>

      <button
        id="nav-toggle"
        type="button"
        class="nav-icon-btn relative inline-flex h-10 w-10 rounded-md text-on-background transition-colors hover:text-on-background/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-toggle-face nav-toggle-face--menu" aria-hidden="true">
          <svg class="nav-toggle-svg" viewBox="0 0 24 24" width="20" height="20" fill="none">
            <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="nav-toggle-face nav-toggle-face--close" aria-hidden="true">
          <svg class="nav-toggle-svg" viewBox="0 0 24 24" width="20" height="20" fill="none">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu — full screen, slides down -->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="false"
  aria-hidden="true"
  aria-labelledby="mobile-menu-title"
  class="fixed inset-x-0 top-0 z-40 bg-surface-dim flex flex-col md:hidden h-dvh"
>
  <h2 id="mobile-menu-title" class="sr-only">Site menu</h2>

  <!-- Header row — logo left, close right (matches main nav) -->
  <div class="main-container flex flex-shrink-0 items-center justify-between border-b border-on-background/20 py-4">
    <a
      href={baseUrl}
      class="shrink-0 rounded-sm outline-none transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-dim"
      aria-label={SITE_CONFIG.name}
    >
      <span class="font-display inline-flex items-baseline gap-0 font-semibold tracking-tight text-on-background" aria-hidden="true">
        <span class="text-4xl leading-[0.85] sm:text-5xl">S</span>
        <span class="text-2xl leading-none text-accent sm:text-3xl translate-y-[0.22em]">.</span>
      </span>
    </a>
    <button
      id="nav-close"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-on-background transition-colors hover:text-on-background/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-dim"
      aria-label="Close menu"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Links -->
  <nav class="flex-1 flex flex-col justify-start gap-0 pt-4 pb-3 overflow-y-auto px-5 md:px-12" aria-label="Mobile navigation">
    {navLinks.map((link, i) => (
      <a
        href={link.href}
        class="mobile-link block w-full border-b border-on-background/15 last:border-0 py-5 outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent"
        data-nav-link
        data-i={i}
      >
        <div class="flex items-center justify-between">
          <span class="font-display font-normal tracking-tight text-on-background" style="font-size: clamp(1.8rem, 7vw, 2.5rem);">
            {link.label}
          </span>
          <svg class="h-4 w-4 text-on-background/45" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    ))}
  </nav>

  <!-- Footer CTA -->
  <div class="px-5 md:px-12 pb-10 flex-shrink-0 flex flex-col gap-3">
    <Button
      href={`${baseUrl}contact`}
      label={navCtaLabel}
      variant="hero-pill"
      class="w-full justify-center"
    />
    <a
      href={`mailto:${SITE_CONFIG.email}`}
      class="font-mono text-xs uppercase tracking-[0.08em] text-on-background/70 text-center underline decoration-on-background/30 underline-offset-2 transition-colors duration-200 hover:text-on-background hover:decoration-on-background/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-dim rounded-sm"
    >
      {SITE_CONFIG.email}
    </a>
  </div>
</div>

<style>
  /* PERMITTED: backdrop-filter, clip-path animation, @keyframes */

  /* Global nav link style */
  .global-nav-link.is-active {
    @apply text-on-background;
    box-shadow: inset 0 -2px 0 rgba(var(--accent-rgb), 0.95);
  }

  /* ── Hamburger toggle faces ────────────────────────────────── */
  #nav-toggle,
  #nav-close {
    -webkit-tap-highlight-color: transparent;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }
  #nav-close { display: inline-flex; }
  .nav-toggle-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  #nav-toggle .nav-toggle-face--close { display: none; }
  #nav-toggle.is-open .nav-toggle-face--menu { display: none; }
  #nav-toggle.is-open .nav-toggle-face--close { display: flex; }

  /* ── Mobile menu slide ─────────────────────────────────────── */
  #mobile-menu {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  #mobile-menu.is-open {
    clip-path: inset(0 0 0% 0);
    pointer-events: auto;
  }

  /* ── Mobile link stagger ───────────────────────────────────── */
  .mobile-link {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.2s ease;
    text-decoration: none;
    @apply text-on-background;
  }
  #mobile-menu.is-open .mobile-link { opacity: 1; transform: translateY(0); }
  #mobile-menu.is-open .mobile-link[data-i="0"] { transition-delay: 0.10s; }
  #mobile-menu.is-open .mobile-link[data-i="1"] { transition-delay: 0.15s; }
  #mobile-menu.is-open .mobile-link[data-i="2"] { transition-delay: 0.20s; }
  #mobile-menu.is-open .mobile-link[data-i="3"] { transition-delay: 0.25s; }
  #mobile-menu.is-open .mobile-link[data-i="4"] { transition-delay: 0.30s; }
  #mobile-menu.is-open .mobile-link[data-i="5"] { transition-delay: 0.35s; }

  .mobile-link.is-active span.font-display { @apply text-accent; }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu { transition: none; }
    .mobile-link { transition: none; opacity: 1; transform: none; }
  }
</style>

<script>
  const initNavbar = () => {
    const toggle      = document.getElementById('nav-toggle');
    const menu        = document.getElementById('mobile-menu');
    const closeBtn    = document.getElementById('nav-close');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    const open = () => {
      menu?.classList.add('is-open');
      menu?.setAttribute('aria-hidden', 'false');
      menu?.setAttribute('aria-modal', 'true');
      toggle?.classList.add('is-open');
      toggle?.setAttribute('aria-expanded', 'true');
      toggle?.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      menu?.classList.remove('is-open');
      menu?.setAttribute('aria-hidden', 'true');
      menu?.setAttribute('aria-modal', 'false');
      toggle?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
    };

    toggle?.addEventListener('click', () => menu?.classList.contains('is-open') ? close() : open());
    closeBtn?.addEventListener('click', close);
    mobileLinks.forEach(l => l.addEventListener('click', close));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

    // ── Active section tracking ───────────────────────────────
    const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const seenIds = new Set<string>();
    const sectionIds: string[] = [];
    allNavLinks.forEach((link) => {
      const id = link.getAttribute('href')?.split('#')[1];
      if (id && !seenIds.has(id)) {
        seenIds.add(id);
        sectionIds.push(id);
      }
    });

    const setActive = (id: string) => {
      allNavLinks.forEach((link) => {
        const href = link.getAttribute('href') ?? '';
        const active = href.endsWith(`#${id}`);
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const sectionObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => { if (entry.isIntersecting) setActive(entry.target.id); });
    }, { rootMargin: '-10% 0px -60% 0px', threshold: 0 });

    sectionIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) sectionObserver.observe(el);
    });

    const hash = window.location.hash.slice(1);
    if (hash) setActive(hash);
  };

  initNavbar();
  document.addEventListener('astro:after-swap', initNavbar);
</script>
