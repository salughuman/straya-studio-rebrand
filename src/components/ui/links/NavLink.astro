---
// NavLink.astro — Straya Studio
// Slide-up hover animation. Uses token classes only — no hardcoded hex values.
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href: string;
  label: string;
  variant?: "main" | "social";
  tone?: "navbar" | "footer";
}

const {
  href,
  label,
  variant = "main",
  tone = "footer",
  class: className,
  ...rest
} = Astro.props;

const isSocial   = variant === "social";
const isNavbar   = tone === "navbar";
---

<a
  href={href}
  class:list={[
    "relative block h-6 no-underline group overflow-hidden",
    !isSocial && "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/80 focus-visible:ring-offset-2",
    className,
  ]}
  data-navlink
  aria-label={rest["aria-label"] ?? label}
  {...rest}
>
  <!-- Default state -->
  <span
    class:list={[
      "navlink-normal h-full w-full flex items-center justify-center transition-transform duration-300 ease-luxury",
      isSocial ? "type-body-small text-on-surface-variant" : "type-label",
      isNavbar ? "text-on-background" : "text-on-surface-variant",
    ]}
  >
    {label}
  </span>

  <!-- Hover state (slides up from below) -->
  <span
    class:list={[
      "navlink-hover absolute top-0 left-0 h-full w-full flex items-center justify-center translate-y-full transition-transform duration-300 ease-luxury italic",
      isSocial ? "type-body-small text-accent" : "type-label",
      isNavbar ? "text-accent" : "text-accent",
    ]}
  >
    {label}
  </span>
</a>

<style>
  [data-navlink] .navlink-normal {
    transform: translateY(0);
  }
  [data-navlink] .navlink-hover {
    transform: translateY(100%);
  }
  [data-navlink]:is(:hover, :focus-visible) .navlink-normal {
    transform: translateY(-100%);
  }
  [data-navlink]:is(:hover, :focus-visible) .navlink-hover {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-navlink] .navlink-normal,
    [data-navlink] .navlink-hover {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
