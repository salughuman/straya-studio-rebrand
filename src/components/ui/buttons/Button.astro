---
// Button.astro — Straya Studio (Cinematic)
// Flagship Button component using PP Mori typography and Material Design 3 logic.
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'hero-pill' | 'text-link';
  size?: 'sm' | 'md' | 'lg';
  iconCircle?: boolean;
}

const {
  href,
  label,
  variant = 'primary',
  size = 'md',
  iconCircle = false,
  class: className,
  ...rest
} = Astro.props;
---

{variant === 'hero-pill' ? (
  <a
    href={href}
    {...rest}
    class:list={[
      // design token `primary` is brand black; hero pill must use brand cream (see tokenArchitecture / headline #E1E0CC) so label is not black-on-black
      "group inline-flex items-center gap-2 self-start rounded-full bg-[#E1E0CC] py-1 pl-5 pr-1 text-sm font-medium text-[#0A0A0A] transition-all hover:gap-3 sm:text-base no-underline",
      className,
    ]}
  >
    {label}
    {iconCircle ? (
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-black transition-transform group-hover:scale-110 sm:h-10 sm:w-10">
        <slot />
      </span>
    ) : (
      <slot />
    )}
  </a>
) : (
  <a
    href={href}
    {...rest}
    class:list={[
      "group relative inline-flex items-center justify-center font-medium uppercase tracking-[0.05em] transition-all duration-300 ease-custom select-none no-underline rounded-none border",
      variant === 'primary' && "bg-primary text-on-primary border-primary hover:bg-secondary hover:border-secondary shadow-sm",
      variant === 'secondary' && "bg-secondary text-on-secondary border-secondary hover:brightness-110",
      variant === 'outline' && "bg-transparent border-on-background/10 text-on-background hover:bg-on-background/5",
      variant === 'ghost' && "bg-transparent border-transparent text-on-background/60 hover:text-on-background",
      variant === 'text-link' && "bg-transparent border-transparent text-on-background/70 hover:text-on-background border-b border-transparent hover:border-on-background/20 pb-px px-0",
      // Sizes (text-link controls its own geometry)
      variant !== 'text-link' && size === 'sm' && "px-4 py-1.5 text-[0.625rem]",
      variant !== 'text-link' && size === 'md' && "px-6 py-2.5 text-[0.6875rem]",
      variant !== 'text-link' && size === 'lg' && "px-10 py-4 text-base",
      className,
    ]}
  >
    <span class="flex items-center justify-center gap-2 z-10">
      <span>{label}</span>
      <slot />
    </span>
  </a>
)}

<style>
  a {
    -webkit-tap-highlight-color: transparent;
  }
</style>
