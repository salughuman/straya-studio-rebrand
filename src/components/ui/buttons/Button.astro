---
// Button.astro — Straya Studio (Cinematic)
// Flagship Button component using PP Mori typography and Material Design 3 logic.
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
}

const { href, label, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;
---

<a
  href={href}
  {...rest}
  class:list={[
    "group relative inline-flex items-center justify-center font-display font-medium uppercase transition-all duration-300 ease-custom select-none no-underline",
    "tracking-tight",
    // Geometry
    "rounded-none border", // Mockup uses 0px corners
    // Multi-variants
    variant === 'primary' && "bg-primary text-on-primary border-primary hover:bg-secondary hover:border-secondary shadow-sm",
    variant === 'secondary' && "bg-secondary text-on-secondary border-secondary hover:brightness-110",
    variant === 'outline' && "bg-transparent border-on-background/10 text-on-background hover:bg-on-background/5",
    variant === 'ghost' && "bg-transparent border-transparent text-on-background/60 hover:text-on-background",
    // Sizes
    size === 'sm' && "px-4 py-1.5 text-[0.625rem]",
    size === 'md' && "px-6 py-2.5 text-[0.6875rem]",
    size === 'lg' && "px-10 py-4 text-base",
    className
  ]}
>
  <span class="flex items-center justify-center z-10">
    {label}
    <slot />
  </span>
</a>

<style>
  a {
    -webkit-tap-highlight-color: transparent;
  }
</style>
