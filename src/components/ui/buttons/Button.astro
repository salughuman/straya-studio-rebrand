---
/**
 * Button.astro — Straya Studio
 * Single source of truth for all CTAs.
 * Variants: hero-pill | hero-pill-inverted | text-link | primary | secondary | outline | ghost
 * hero-pill        — cream pill on dark bg (hero, FinalCTA)
 * hero-pill-inverted — dark pill on light bg (pricing, light sections)
 */
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'hero-pill' | 'hero-pill-inverted' | 'text-link';
  size?: 'sm' | 'md' | 'lg';
  iconCircle?: boolean;
}

const {
  href,
  label,
  variant = 'primary',
  size = 'md',
  iconCircle = false,
  class: className,
  ...rest
} = Astro.props;

const isPill = variant === 'hero-pill' || variant === 'hero-pill-inverted';
---

{isPill ? (
  <a
    href={href}
    {...rest}
    class:list={[
      "btn-pill-lusion group inline-flex items-center justify-center self-start rounded-full py-3.5 px-8 text-sm font-medium no-underline select-none tracking-[0.04em]",
      "active:scale-[0.98]",
      "disabled:pointer-events-none disabled:opacity-[0.64]",
      "sm:text-base sm:py-4 sm:px-10",
      "bg-[#5A3A24] text-[#FFEDD7]",
      "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#DC5000] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1C1008]",
      className,
    ]}
  >
    {label}
    <slot />
  </a>
) : variant === 'text-link' ? (
  <a
    href={href}
    {...rest}
    class:list={[
      "group inline-flex items-center gap-2 px-0 pb-px",
      "font-medium text-sm tracking-[0.04em] uppercase no-underline select-none",
      "text-on-background/60",
      "bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-no-repeat bg-[position:0_100%]",
      "transition-[color,background-size] duration-[240ms] ease-[cubic-bezier(0.16,1,0.3,1)]",
      "hover:text-on-background hover:bg-[length:100%_1px]",
      "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background",
      "disabled:pointer-events-none disabled:opacity-[0.64]",
      className,
    ]}
  >
    <span class="flex items-center gap-2">
      <span>{label}</span>
      <slot />
    </span>
  </a>
) : (
  <a
    href={href}
    {...rest}
    class:list={[
      "btn-base group relative inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-lg border font-medium no-underline select-none",
      "transition-shadow duration-150 ease-[cubic-bezier(0.16,1,0.3,1)]",
      "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-1 focus-visible:ring-offset-background",
      "disabled:pointer-events-none disabled:opacity-[0.64]",
      "before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(0.5rem-1px)]",
      variant === 'primary' && [
        "border-primary bg-primary text-on-primary",
        "shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_1px_3px_rgba(0,0,0,0.24)]",
        "hover:bg-primary/90",
        "active:shadow-[inset_0_1px_0_rgba(0,0,0,0.08)]",
      ],
      variant === 'secondary' && [
        "border-secondary bg-secondary text-on-secondary",
        "shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_1px_3px_rgba(0,0,0,0.24)]",
        "hover:bg-secondary/90",
        "active:shadow-[inset_0_1px_0_rgba(0,0,0,0.08)]",
      ],
      variant === 'outline' && [
        "border-on-background/12 bg-background text-on-background",
        "shadow-[0_1px_2px_rgba(0,0,0,0.06)] before:shadow-[inset_0_1px_0_rgba(0,0,0,0.06)]",
        "hover:bg-on-background/5 hover:border-on-background/20",
        "active:shadow-none",
      ],
      variant === 'ghost' && [
        "border-transparent bg-transparent text-on-background",
        "hover:bg-on-background/8",
        "active:bg-on-background/12",
      ],
      size === 'sm' && "h-8 gap-1.5 px-[calc(0.625rem-1px)] text-xs tracking-[0.04em] uppercase",
      size === 'md' && "h-9 px-[calc(0.75rem-1px)] text-sm tracking-[0.04em] uppercase sm:h-8",
      size === 'lg' && "h-10 px-[calc(0.875rem-1px)] text-base tracking-[0.03em] uppercase sm:h-9",
      className,
    ]}
  >
    <span class="relative z-10 flex items-center justify-center gap-2">
      <span>{label}</span>
      <slot />
    </span>
  </a>
)}

<style>
  a { -webkit-tap-highlight-color: transparent; }

  /* Pill button — inset glow expands from zero on hover */
  .btn-pill-lusion {
    box-shadow:
      0 0 0 1px rgba(255, 237, 215, 0.08),
      0 2px 8px rgba(0, 0, 0, 0.5),
      0 0 0 0 rgba(220, 80, 0, 0),
      inset 0 0 0 0 rgba(220, 80, 0, 0),
      inset 0 0 0 0 rgba(220, 80, 0, 0);
    transition: box-shadow 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-pill-lusion:hover {
    box-shadow:
      0 0 0 1px rgba(255, 237, 215, 0.08),
      0 2px 8px rgba(0, 0, 0, 0.5),
      0 0 0 1.5px #DC5000,
      inset 0 0 20px 6px rgba(220, 80, 0, 0.30),
      inset 0 0 48px 16px rgba(220, 80, 0, 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-pill-lusion { transition: none; }
  }
</style>
