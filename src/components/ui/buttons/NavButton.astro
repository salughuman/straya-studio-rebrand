---
// NavButton.astro — Straya Studio
// GEMINI §13: primary uses bg-primary, hover transitions to bg-accent (#DC5000).
// type-button: 0.75rem, font-medium (500), blueprint tracking (0.05em), uppercase.
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href: string;
  label: string;
  variant?: 'primary' | 'ghost';
}

const { href, label, variant = 'primary', class: className, ...rest } = Astro.props;
---

<a
  href={href}
  {...rest}
  class:list={[
    "inline-flex items-center justify-center px-6 py-2 type-button transition-all duration-300 ease-custom no-underline select-none magnetic-cta",
    variant === 'primary' && "bg-primary text-on-primary hover:bg-accent",
    variant === 'ghost'   && "bg-transparent text-on-background/40 hover:text-on-background border-b border-transparent hover:border-on-background/20 pb-px px-0",
    className
  ]}
>
  {label}
</a>
