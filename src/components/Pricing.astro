---
// Pricing.astro — Straya Studio [SIMPLE]
// Horizontal comparison table with card-per-tier on mobile.
// GEMINI §4: project-based, no retainers, 3 tiers.
// GEMINI §5: light mode tokens, no bold fonts, 0px radius.

import { PRICING_TIERS, PRICING_BADGE, PRICING_TRUST_LINE, PRICING_FOOTER } from "../data/pricing";
import { SITE_CONFIG } from "../data/site-config";

const baseUrl = import.meta.env.BASE_URL;

// All unique features across tiers for comparison rows
const allFeatures = [
  "Custom design — no templates, ever",
  "Mobile-first responsive build",
  "On-page SEO setup",
  "Launch support and file handoff",
  "Up to 10 custom-designed pages",
  "CMS setup and content architecture",
  "Custom interactions and animations",
  "Performance tuning — 90+ Lighthouse",
  "Unlimited revisions until sign-off",
  "Discovery workshop and technical strategy",
  "Unlimited pages and custom components",
  "Advanced SEO and analytics integration",
  "Graphic design — social kits, pitch decks",
  "Dedicated Slack channel",
  "60 days post-launch support",
];

// Explicit inclusion per tier — avoids fuzzy string matching failures
// Starter = rows 0-3, Growth = rows 0-8, Premium = all
const tierInclusion: boolean[][] = [
  // Starter
  [true,  true,  true,  true,  false, false, false, false, false, false, false, false, false, false, false],
  // Growth (includes everything in Starter + rows 4-8)
  [true,  true,  true,  true,  true,  true,  true,  true,  true,  false, false, false, false, false, false],
  // Premium (includes everything in Growth + rows 9-14)
  [true,  true,  true,  true,  true,  true,  true,  true,  true,  true,  true,  true,  true,  true,  true],
];
---

<section
  id="pricing"
  aria-label="Project pricing"
  class="section-y relative bg-primary border-b border-white/5 overflow-hidden"
>
  <div class="main-container">

    <!-- Header -->
    <header class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-white/5 pb-8">
      <div>
        <span class="pr-el type-label text-white/40 block mb-3" data-delay="0">Investment</span>
        <h2 class="type-h2 text-white max-w-lg">
          <span class="pr-line block overflow-hidden"><span class="pr-el inline-block" data-delay="80">Transparent pricing,</span></span>
          <span class="pr-line block overflow-hidden"><span class="pr-el inline-block" data-delay="140">no retainers required.</span></span>
        </h2>
        <p class="pr-el type-body-small text-white/60 mt-3 max-w-md leading-relaxed" data-delay="240">
          Every engagement is scoped, priced, and delivered as a complete project.
        </p>
      </div>
      <!-- Availability badge — FinalCTA chip -->
      <div class="pr-el flex items-center gap-2 flex-shrink-0 border border-white/10 bg-white/5 px-4 py-2" role="status" data-delay="300">
        <span class="w-1.5 h-1.5 rounded-full bg-accent availability-dot" aria-hidden="true"></span>
        <span class="type-label text-accent">{PRICING_BADGE}</span>
      </div>
    </header>

    <!-- ── Mobile: stacked cards ── -->
    <div class="flex flex-col gap-px bg-white/5 lg:hidden mb-12">
      {PRICING_TIERS.map((tier, i) => (
        <article
          class:list={[
            "pricing-card flex flex-col",
            tier.popular ? "bg-white/10" : "bg-white/5"
          ]}
          data-index={i}
          aria-label={`${tier.name} pricing tier`}
        >
          <!-- Tier header -->
          <div class="relative p-8 border-b border-white/5">
            {tier.popular && (
              <span class="type-label text-accent absolute top-6 right-6">Most popular</span>
            )}
            <h3 class="type-h3 text-white mb-1">{tier.name}</h3>
            <p class="type-body-small text-white/60 mb-6">{tier.tagline}</p>
            <!-- Price -->
            <div class="flex items-baseline gap-2 mb-1">
              <span class="type-label text-white/40">From</span>
              <span class="font-display font-medium text-3xl text-white tracking-tight">
                {tier.price.replace(/^From\s*\$?/i, "$")}
              </span>
            </div>
            <span class="type-label text-white/40">{tier.timeline}</span>
          </div>
          <!-- Features -->
          <ul class="p-8 flex flex-col gap-3" aria-label={`${tier.name} features`}>
            {tier.included.map((feature, fi) => (
              <li class="flex items-start gap-3 type-body-small text-white/60">
                <svg class="w-3.5 h-3.5 text-accent mt-0.5 flex-shrink-0" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2.5 7.5L5.5 10.5L11.5 4.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
          <!-- CTA -->
          <div class="px-8 pb-8">
            <a
              href={i < 2
                ? `${baseUrl}contact?source=pricing&tier=${encodeURIComponent(tier.name.toLowerCase())}`
                : SITE_CONFIG.socials.calendly}
              target={i >= 2 ? "_blank" : undefined}
              rel={i >= 2 ? "noopener noreferrer" : undefined}
              class:list={[
                "magnetic-cta z-depth-2 w-full flex items-center justify-center gap-3 type-button py-4 transition-colors duration-300",
                tier.popular
                  ? "bg-accent text-primary hover:bg-white"
                  : "border border-white/20 text-white/60 hover:border-white hover:text-white hover:bg-white/5"
              ]}
            >
              {tier.ctaLabel}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- ── Desktop: comparison grid exposed as a table for assistive tech ── -->
    <div
      class="hidden lg:block"
      role="table"
      aria-label="Pricing features compared across Starter, Growth, and Premium tiers"
    >
      <p class="sr-only">
        Pricing comparison table across three tiers. Starter from $2,000 (1–2 weeks): custom design, development, mobile-first build, SEO, 2 revision rounds. Growth from $4,000 (2–4 weeks): everything in Starter plus up to 10 pages, CMS, interactions, brand identity, 90+ Lighthouse, unlimited revisions. Premium from $9,500 (4–8 weeks): everything in Growth plus discovery workshop, unlimited pages, advanced SEO, graphic design, dedicated Slack, and 60 days post-launch support.
      </p>
      <!-- Tier headers -->
      <div class="grid grid-cols-4 gap-px bg-white/5 mb-px" role="row">
        <!-- Empty label column -->
        <div class="bg-white/5 p-8 flex items-end border-r border-white/5" role="columnheader">
          <span class="type-label text-white/40">What's included</span>
        </div>
        <!-- Tier columns -->
        {PRICING_TIERS.map((tier, i) => (
          <div
            class:list={[
              "pricing-card relative flex flex-col gap-4 card-pad",
              tier.popular ? "bg-white/10" : "bg-white/5"
            ]}
            data-index={i}
            role="columnheader"
          >
            {tier.popular && (
              <span class="type-label text-accent absolute top-6 right-6">Most popular</span>
            )}
            <div>
              <h3 class="type-h3 text-white mb-1">{tier.name}</h3>
              <p class="type-body-small text-white/60">{tier.tagline}</p>
            </div>
            <!-- Price -->
            <div>
              <div class="flex items-baseline gap-1.5 mb-0.5">
                <span class="type-label text-white/40">From</span>
                <span class="font-display font-medium text-3xl text-white tracking-tight">
                  {tier.price.replace(/^From\s*\$?/i, "$")}
                </span>
              </div>
              <span class="type-label text-white/40">{tier.timeline}</span>
            </div>
            <!-- CTA -->
            <a
              href={i < 2
                ? `${baseUrl}contact?source=pricing&tier=${encodeURIComponent(tier.name.toLowerCase())}`
                : SITE_CONFIG.socials.calendly}
              target={i >= 2 ? "_blank" : undefined}
              rel={i >= 2 ? "noopener noreferrer" : undefined}
              class:list={[
                "magnetic-cta z-depth-2 mt-auto flex items-center justify-center gap-2 type-button py-3.5 transition-colors duration-300",
                tier.popular
                  ? "bg-accent text-primary hover:bg-white"
                  : "border border-white/20 text-white/60 hover:border-white hover:text-white hover:bg-white/5"
              ]}
            >
              {tier.ctaLabel}
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        ))}
      </div>

      <!-- Feature rows -->
      {allFeatures.map((feature, fi) => (
        <div class="grid grid-cols-4 gap-px bg-white/5 mb-px feature-row" data-row={fi} role="row">
          <!-- Feature label -->
          <div class="bg-white/5 px-8 py-4 flex items-center border-r border-white/5" role="rowheader">
            <span class="type-body-small text-white/80">{feature}</span>
          </div>
          <!-- Tier cells -->
          {PRICING_TIERS.map((tier, ti) => {
            const included = tierInclusion[ti]?.[fi] ?? false;
            return (
              <div
                class:list={[
                  "px-8 py-4 flex items-center justify-center",
                  tier.popular ? "bg-white/10" : "bg-white/5"
                ]}
                role="cell"
              >
                {included ? (
                  <svg class="w-4 h-4 text-accent" viewBox="0 0 16 16" fill="none" aria-label="Included" role="img">
                    <path d="M3.5 8.5L6.5 11.5L12.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                ) : (
                  <span class="inline-flex items-center justify-center" role="img" aria-label="Not included">
                    <span class="w-3 h-px bg-white/20 block" aria-hidden="true"></span>
                  </span>
                )}
              </div>
            );
          })}
        </div>
      ))}
    </div>

    <!-- Footer CTA strip -->
    <div class="mt-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 border border-white/5 p-8 bg-white/5">
      <div class="max-w-md">
        <h3 class="type-h3 text-white mb-2">{PRICING_FOOTER.title}</h3>
        <p class="type-body-small text-white/60 leading-relaxed">{PRICING_FOOTER.description}</p>
      </div>
      <a
        href={SITE_CONFIG.socials.calendly}
        target="_blank"
        rel="noopener noreferrer"
        class="magnetic-cta z-depth-2 flex-shrink-0 inline-flex items-center gap-3 type-button bg-accent text-primary px-8 py-4 hover:bg-white transition-colors duration-300"
      >
        {PRICING_FOOTER.ctaLabel}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Trust line -->
    <p class="mt-8 text-center type-caption text-white/40">
      {PRICING_TRUST_LINE}
    </p>

  </div>
</section>

<style>
  /* ── Header elements ───────────────────────────────────────── */
  .pr-el { opacity: 0; transform: translateY(28px); }
  .pr-line .pr-el { transform: translateY(100%); opacity: 1; }

  /* ── pricing-card — visible by default, no entrance animation  */
  /* ── feature-row — visible by default, no entrance animation  */

  /* ── Availability dot pulse ────────────────────────────────── */
  .availability-dot {
    animation: pulse-dot 2.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(60,205,127,0); }
    50%       { opacity: 0.85; box-shadow: 0 0 8px 3px rgba(60,205,127,0.3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .availability-dot { animation: none; }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 900;
  const MARGIN   = '0px 0px -80px 0px';

  // ── Header entrance ─────────────────────────────────────────
  const headerEls = document.querySelectorAll<HTMLElement>('#pricing .pr-el');
  const headerObs = new IntersectionObserver(entries => {
    if (!entries[0].isIntersecting) return;
    headerEls.forEach(el => {
      const delay  = parseInt(el.dataset.delay ?? '0');
      const isLine = el.closest('.pr-line') !== null;
      el.animate(
        isLine
          ? [{ transform: 'translateY(100%)' }, { transform: 'translateY(0%)' }]
          : [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
        { duration: DURATION, delay, easing: EASE, fill: 'forwards' }
      );
    });
    headerObs.disconnect();
  }, { rootMargin: MARGIN, threshold: 0 });
  const pricingSection = document.getElementById('pricing');
  if (pricingSection) headerObs.observe(pricingSection);

  // pricing-card and feature-row entrance animations removed — visible by default
</script>
