---
// Pricing.astro — Straya Studio (v5 — Premium Polish)
// 3-card grid preserved. Popular card physically taller.
// Progression glow intensifies left→right. Top features highlighted.

import {
  PRICING_BADGE,
  PRICING_FOOTER,
  PRICING_HEADLINE,
  PRICING_SUBTITLE,
  PRICING_TIERS,
  PRICING_TRUST_LINE,
} from "../data/pricing";
import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";

// Number of features to highlight (brighter) per card
const HIGHLIGHT_COUNT = 3;

const pricingHeadlineLines = PRICING_HEADLINE.replace(/\.$/, "").split(",");
const pricingHeadlineTop = `${pricingHeadlineLines[0]?.trim() ?? ""},`;
const pricingHeadlineBottom = pricingHeadlineLines.slice(1).join(",").trim();
const pricingSubtitleShort = PRICING_SUBTITLE.replace(/\s*—\s*not a monthly drip\.?$/, "");

// Progression glow per tier (subtle → medium → strong) — used as class strings (no inline style)
const tierGlowClass = [
  "bg-[radial-gradient(ellipse_at_50%_0%,rgba(60,205,127,0.03),transparent_70%)]",
  "bg-[radial-gradient(ellipse_at_50%_0%,rgba(60,205,127,0.05),transparent_70%)]",
  "bg-[radial-gradient(ellipse_at_50%_0%,rgba(60,205,127,0.08),transparent_70%)]",
];

// Accent line width grows per tier
const tierLineClass = ["w-1/4", "w-1/2", "w-full"];
const START_PROJECT_TIERS = 2;
const baseUrl = import.meta.env.BASE_URL;
---

<section
  id="pricing"
  class="section-y relative z-10 bg-bg-surface text-text-primary"
  aria-label="Project pricing"
>
  <div class="main-container">

    <!-- ── Header ── -->
    <header class="mb-12 md:mb-16">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div class="flex max-w-[34rem] flex-col gap-3">
          <p class="type-label">Investment</p>
          <h2 class="type-h2">
            {pricingHeadlineTop}<br class="hidden md:inline" />
            {pricingHeadlineBottom}.
          </h2>
          <p class="type-body text-text-secondary">{pricingSubtitleShort}</p>
        </div>
        <div
          class="flex w-fit items-center gap-2 self-start rounded-md border border-brand-secondary/30 bg-[rgba(60,205,127,0.06)] px-3 py-1.5 md:self-auto"
          role="status"
        >
          <span class="availability-dot h-1.5 w-1.5 rounded-full bg-[#3CCD7F]" aria-hidden="true"></span>
          <span class="text-xs font-semibold tracking-wide text-brand-secondary">{PRICING_BADGE}</span>
        </div>
      </div>
    </header>

    <!-- ── Tier grid ── -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:items-end md:gap-4">
      {
        PRICING_TIERS.map((tier, i) => (
          <article
            class:list={[
                  "pricing-card group relative flex flex-col overflow-hidden rounded-md border",
              // Height control: cards 1 & 3 match height; popular card can be taller
              tier.popular ? "md:min-h-[44rem]" : "md:min-h-[40rem]",
              "transition-[transform,box-shadow,border-color,opacity] duration-300 ease-luxury",
              "hover:-translate-y-1 hover:shadow-lg",
              "motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none",
              tier.popular
                ? "is-popular border-brand-secondary/30 md:-mt-4"
                : "border-border-default",
            ]}
          >
            {/* ── Background glow (progression: gets brighter per tier) ── */}
            <div
              class:list={[
                "pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 ease-luxury group-hover:opacity-100 motion-reduce:hidden",
                tierGlowClass[i] ?? tierGlowClass[0],
              ]}
              aria-hidden="true"
            />

            {/* ── Accent line at top (full width, opacity increases per tier on hover) ── */}
            <div
              class:list={[
                "h-[2px] w-full bg-gradient-to-r from-[#3CCD7F] via-[#3CCD7F]/25 to-transparent transition-opacity duration-300 ease-luxury group-hover:opacity-100",
                i === 0 ? "opacity-[0.04]" : i === 1 ? "opacity-50" : "opacity-90",
              ]}
              aria-hidden="true"
            />

            {/* ── Popular ribbon ── */}
            {tier.popular && (
              <div class="relative z-[1] flex items-center justify-center bg-[rgba(60,205,127,0.06)] px-4 py-2.5">
                <span class="text-[0.625rem] font-bold uppercase tracking-[0.14em] text-[#3CCD7F]">
                  Recommended
                </span>
              </div>
            )}

            {/* ── Card body ── */}
            <div class="relative z-[1] flex flex-1 flex-col p-6 md:p-8">

              {/* ── Tier name + tagline ── */}
              <h3 class="type-h3 mb-1">{tier.name}</h3>
              <p class="mb-6 text-[0.8125rem] leading-relaxed text-text-muted">{tier.tagline}</p>

              {/* ── Price block (elevated surface) ── */}
              <div class="mb-6 rounded-md bg-bg-surface border border-border-default px-5 py-4">
                <div class="flex items-baseline gap-2">
                  <span class="text-[0.625rem] font-semibold uppercase tracking-[0.12em] text-text-muted">
                    From
                  </span>
                  <span class="font-display text-[clamp(2rem,4vw,2.75rem)] font-semibold leading-none tracking-tight">
                    <span class="text-brand-secondary">$</span>
                    <span class="text-text-primary">{tier.price.replace(/^From\s*\$?/i, "")}</span>
                  </span>
                </div>
                <div class="mt-3 flex items-center gap-2">
                  <svg class="h-3.5 w-3.5 text-[#3CCD7F]/60 motion-safe:animate-[clockTick_2.8s_cubic-bezier(0.16,1,0.3,1)_infinite] motion-reduce:animate-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 6v6l4 2" />
                  </svg>
                  <span class="text-xs text-text-secondary">{tier.timeline}</span>
                </div>
              </div>

              {/* ── Best for ── */}
              <p class="mb-5 text-[0.8125rem] leading-relaxed text-text-muted">{tier.bestFor}</p>

              {/* ── Divider ── */}
              <div class="mb-5 h-px bg-[rgba(255,255,255,0.05)]" aria-hidden="true" />

              {/* ── Features ── */}
              <ul class="flex flex-1 flex-col gap-2.5" aria-label={`Features in ${tier.name}`}>
                {tier.included.map((feature, fi) => {
                  const isInherit = fi === 0 && i > 0;
                  const isHighlighted = fi < HIGHLIGHT_COUNT;

                  return (
                    <li
                      class:list={[
                        "flex items-start gap-2.5 text-[0.8125rem] leading-snug",
                        isInherit
                          ? "font-medium text-[#3CCD7F]"
                          : isHighlighted
                            ? "text-[#D1D5DB]"
                            : "text-[#9CA3AF]",
                      ]}
                    >
                      <svg
                        class:list={[
                          "mt-0.5 h-3.5 w-3.5 shrink-0",
                          isInherit
                            ? "text-[#3CCD7F]"
                            : isHighlighted
                              ? "text-[#3CCD7F]/80"
                              : "text-[#3CCD7F]/40",
                        ]}
                        viewBox="0 0 16 16"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M3.5 8.5L6.5 11.5L12.5 5.5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  );
                })}
              </ul>

              {/* ── CTA ── */}
              <Button
                href={
                  i < START_PROJECT_TIERS
                    ? `${baseUrl}contact?source=pricing-card&tier=${encodeURIComponent(tier.name.toLowerCase())}`
                    : SITE_CONFIG.socials.calendly
                }
                target={i < START_PROJECT_TIERS ? undefined : "_blank"}
                rel={i < START_PROJECT_TIERS ? undefined : "noopener noreferrer"}
                label={tier.ctaLabel}
                variant={tier.ctaPrimary ? "primary" : "light"}
                class:list={[
                  "group mt-8 !rounded-md !px-5 !py-3.5 !text-sm",
                  tier.ctaPrimary
                    ? "shadow-[0_0_20px_rgba(60,205,127,0.15)] hover:!bg-[#2FB96D] hover:!border-[#2FB96D]"
                    : "!border-border-strong !text-text-primary hover:!border-border-strong hover:!bg-bg-overlay",
                ]}
              >
                <svg
                  class="h-4 w-4 transition-transform duration-300 ease-luxury group-hover:translate-x-0.5 motion-reduce:transition-none"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </Button>
            </div>
          </article>
        ))
      }
    </div>

    
    <!-- ── Footer CTA ── -->
    <div class="glass-surface mt-10 flex flex-col gap-5 rounded-md p-6 md:mt-12 md:flex-row md:items-center md:justify-between md:p-8">
      <div class="max-w-[32rem]">
        <h3 class="type-h3 mb-1.5">{PRICING_FOOTER.title}</h3>
        <p class="type-body text-text-secondary">{PRICING_FOOTER.description}</p>
      </div>
      <Button
        href={SITE_CONFIG.socials.calendly}
        target="_blank"
        rel="noopener noreferrer"
        label={PRICING_FOOTER.ctaLabel}
        variant="primary"
        class="group !w-fit !rounded-md !px-5 !py-3 !text-sm hover:!bg-[#2FB96D] hover:!border-[#2FB96D]"
      >
        <svg
          class="h-4 w-4 transition-transform duration-300 ease-luxury group-hover:translate-x-0.5 motion-reduce:transition-none"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </Button>
    </div>

    <!-- ── Trust line ── -->
    <p class="mx-auto mt-10 max-w-[38rem] text-center type-caption text-text-muted">
      {PRICING_TRUST_LINE}
    </p>

    

  </div>
</section>

<style>
  /* GEMINI §5.F — keyframes only */
  .availability-dot {
    animation: pulse-dot 2.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(60, 205, 127, 0); }
    50% { opacity: 0.85; box-shadow: 0 0 8px 2px rgba(60, 205, 127, 0.35); }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .availability-dot {
      animation: none;
    }
  }
</style>