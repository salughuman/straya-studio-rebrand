---
/**
 * Pricing.astro — Straya Studio
 * Premium dark editorial pricing — tier icons, oversized price, accent featured card.
 */
import {
  PRICING_TIERS,
  PRICING_BADGE,
  PRICING_HEADLINE,
  PRICING_SUBTITLE,
} from "../data/pricing";
import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";

const baseUrl = import.meta.env.BASE_URL;

const tierSlug = (name: string) =>
  name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");

const tierCtaHref = (tierName: string, index: number) => {
  if (index === 2) return SITE_CONFIG.socials.calendly;
  return `${baseUrl}contact?source=pricing&tier=${encodeURIComponent(tierSlug(tierName))}`;
};

const trustLine = (index: number) =>
  index === 2 ? "Free 30-min discovery call" : "No retainers · Pay per project";
---

<section
  id="pricing"
  aria-label="Project pricing tiers"
  class="relative bg-background text-on-background overflow-hidden"
>
  <p class="sr-only">
    Straya Studio offers three project-based pricing tiers with no retainers or subscriptions.
    Landing Page from $2,500 (1–2 weeks). Growth Website from $5,000 (2–5 weeks), most popular.
    Digital Product System is a custom engagement (4–8+ weeks) for complex platforms.
  </p>

  <!-- Section header -->
  <div class="main-container pt-20 pb-14 md:pt-28 md:pb-16">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-16">
      <div class="flex-1">
        <p class="type-label-small mb-5 inline-flex items-center gap-2 uppercase tracking-blueprint text-on-background/50" role="status">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          {PRICING_BADGE}
        </p>
        <h2 class="type-h2 m-0 max-w-2xl text-on-background">
          {PRICING_HEADLINE}
        </h2>
      </div>
      <p class="type-body m-0 max-w-[44ch] text-on-background/60 md:text-right leading-relaxed">
        {PRICING_SUBTITLE}
      </p>
    </div>
  </div>

  <!-- Cards -->
  <div class="main-container py-0">
    <div class="grid grid-cols-1 gap-3 md:grid-cols-3 md:gap-4" role="list">
      {
        PRICING_TIERS.map((tier, i) => {
          const featured = Boolean(tier.popular);
          const href = tierCtaHref(tier.name, i);
          const external = i === 2;
          return (
            <article
              class:list={[
                "pricing-card group relative flex flex-col transition-[background] duration-300 ease-luxury",
                featured
                  ? "bg-accent/10"
                  : "bg-on-background/[0.04] hover:bg-on-background/[0.07]",
              ]}
              role="listitem"
              aria-label={`${tier.name} — ${tier.price}`}
              data-pricing-card
              data-pricing-i={i}
              style={`transition-delay: ${i * 80}ms`}
            >
              <!-- Card inner -->
              <div class="flex flex-1 flex-col p-6 md:p-8">

                <!-- Icon + badge row -->
                <div class="flex items-start justify-between mb-5">
                  {i === 0 && (
                    <span class="tier-icon tier-icon--ring text-on-background/30" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.1" stroke-dasharray="3 2.4" stroke-linecap="round"/>
                      </svg>
                    </span>
                  )}
                  {i === 1 && (
                    <span class="tier-icon tier-icon--star text-accent" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10 1.5 L11.55 8.45 L18.5 10 L11.55 11.55 L10 18.5 L8.45 11.55 L1.5 10 L8.45 8.45 Z"/>
                      </svg>
                    </span>
                  )}
                  {i === 2 && (
                    <span class="tier-icon tier-icon--asterisk text-on-background/30" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                        <line x1="10" y1="2.5" x2="10" y2="17.5"/>
                        <line x1="2.5" y1="10" x2="17.5" y2="10"/>
                        <line x1="4.4" y1="4.4" x2="15.6" y2="15.6"/>
                        <line x1="15.6" y1="4.4" x2="4.4" y2="15.6"/>
                      </svg>
                    </span>
                  )}
                  {featured && (
                    <span class="font-body text-[0.65rem] font-semibold uppercase tracking-widest text-accent border border-accent/35 px-2.5 py-1 leading-none">
                      Most Popular
                    </span>
                  )}
                </div>

                <!-- Name & tagline -->
                <div class="mb-5">
                  <h3
                    class:list={[
                      "font-display font-semibold leading-tight tracking-tight mb-1.5 text-2xl md:text-3xl",
                      featured ? "text-on-background" : "text-on-background/90",
                    ]}
                  >
                    {tier.name}
                  </h3>
                  <p class="type-body-small m-0 text-on-background/55 leading-relaxed">
                    {tier.tagline}
                  </p>
                </div>

                <!-- Hook line -->
                <p class="type-label-small m-0 mb-5 uppercase tracking-blueprint text-accent/75">
                  {tier.hook}
                </p>

                <!-- Price block -->
                <div class="mb-5 pb-5 border-b border-on-background/[0.08]">
                  <p
                    class:list={[
                      "pricing-price font-display font-black leading-none tracking-tight m-0",
                      featured ? "text-on-background" : "text-on-background/85",
                    ]}
                  >
                    {tier.price}
                  </p>
                  <p class="type-label-small mt-2.5 uppercase tracking-blueprint text-on-background/50 m-0">
                    {tier.timeline}
                  </p>
                </div>

                <!-- Features -->
                <ul class="m-0 flex flex-1 list-none flex-col gap-2.5 p-0 mb-5" aria-label={`${tier.name} includes`}>
                  {
                    tier.included.map((feature) => (
                      <li class="flex items-start gap-3">
                        <span class="mt-0.5 shrink-0 flex items-center justify-center text-accent" aria-hidden="true">
                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                        <span class="type-body-small text-on-background/75 leading-snug">
                          {feature}
                        </span>
                      </li>
                    ))
                  }
                </ul>

                <!-- CTA -->
                <div class="mt-auto">
                  <Button
                    href={href}
                    label={tier.ctaLabel}
                    variant={featured ? "hero-pill" : "hero-pill-inverted"}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                    class="w-full justify-center"
                    aria-label={`${tier.ctaLabel} — ${tier.name}`}
                  />
                  <p class="type-label-small m-0 mt-3 text-center tracking-blueprint text-on-background/30">
                    {trustLine(i)}
                  </p>
                </div>

              </div>
            </article>
          );
        })
      }
    </div>
  </div>

  <div class="pb-16 md:pb-24"></div>

</section>

<script>
  /* ~0.4KB — scroll-reveal with IntersectionObserver */
  const initPricingReveal = () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const cards = document.querySelectorAll<HTMLElement>("[data-pricing-card]");
    if (!cards.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const card = entry.target as HTMLElement;
          card.classList.add("is-visible");
          observer.unobserve(card);
        });
      },
      { rootMargin: "-5% 0px -8% 0px", threshold: 0.05 }
    );

    cards.forEach((card) => observer.observe(card));
  };

  initPricingReveal();
  document.addEventListener("astro:after-swap", initPricingReveal);
  document.addEventListener("astro:before-swap", () => {});
</script>

<style>
  /*
   * <style> justified: @keyframes for tier icons + scroll-reveal blur/translate,
   * ::before pseudo for accent top-line on featured card,
   * and fluid clamp() font-size not expressible as a token.
   */

  /* Tier icons — @keyframes + inline-flex centering */
  .tier-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }
  .tier-icon--ring svg    { animation: tier-spin     10s  linear        infinite; }
  .tier-icon--star svg    { animation: tier-pulse    2.8s ease-in-out   infinite; }
  .tier-icon--asterisk svg { animation: tier-spin-rev 8s  linear        infinite; }

  @keyframes tier-spin     { to { transform: rotate(360deg);  } }
  @keyframes tier-spin-rev { to { transform: rotate(-360deg); } }
  @keyframes tier-pulse {
    0%, 100% { transform: scale(1);    opacity: 1;    }
    50%      { transform: scale(1.22); opacity: 0.75; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tier-icon svg { animation: none; }
  }

  /* Scroll-reveal — multi-property transition with blur; transition-delay set inline */
  [data-pricing-card] {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
    transition:
      opacity   700ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1),
      filter    600ms cubic-bezier(0.16, 1, 0.3, 1),
      background 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-pricing-card].is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-pricing-card] {
      opacity: 1;
      transform: none;
      filter: none;
      transition: background 300ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  /* ::before accent gradient line — pseudo-elements require <style> */
  .pricing-card.bg-accent\/10 { position: relative; }
  .pricing-card.bg-accent\/10::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, rgba(220, 80, 0, 0.9) 40%, rgba(220, 80, 0, 0.4) 100%);
  }

  /* Fluid price — clamp() not expressible as a design token class */
  .pricing-price {
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: -0.04em;
  }
</style>
