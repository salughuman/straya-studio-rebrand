---
// Pricing.astro — Straya Studio [SIMPLE]
// Horizontal comparison table with card-per-tier on mobile.
// GEMINI §4: project-based, no retainers, 3 tiers.
// GEMINI §5: light mode tokens, no bold fonts, 0px radius.

import { PRICING_TIERS, PRICING_BADGE, PRICING_TRUST_LINE, PRICING_FOOTER } from "../data/pricing";
import { SITE_CONFIG } from "../data/site-config";

const baseUrl = import.meta.env.BASE_URL;

// All unique features across tiers for comparison rows
const allFeatures = [
  "Custom design — no templates, ever",
  "Mobile-first responsive build",
  "On-page SEO setup",
  "Launch support and file handoff",
  "Up to 10 custom-designed pages",
  "CMS setup and content architecture",
  "Custom interactions and animations",
  "Performance tuning — 90+ Lighthouse",
  "Unlimited revisions until sign-off",
  "Discovery workshop and technical strategy",
  "Unlimited pages and custom components",
  "Advanced SEO and analytics integration",
  "Graphic design — social kits, pitch decks",
  "Dedicated Slack channel",
  "60 days post-launch support",
];

// Explicit inclusion per tier — avoids fuzzy string matching failures
// Starter = rows 0-3, Growth = rows 0-8, Premium = all
const tierInclusion: boolean[][] = [
  // Starter
  [true,  true,  true,  true,  false, false, false, false, false, false, false, false, false, false, false],
  // Growth (includes everything in Starter + rows 4-8)
  [true,  true,  true,  true,  true,  true,  true,  true,  true,  false, false, false, false, false, false],
  // Premium (includes everything in Growth + rows 9-14)
  [true,  true,  true,  true,  true,  true,  true,  true,  true,  true,  true,  true,  true,  true,  true],
];
---

<section
  id="pricing"
  aria-label="Project pricing"
  class="section-y relative bg-background border-b border-black/5 overflow-hidden"
>
  <div class="main-container">

    <!-- Header -->
    <header class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-black/5 pb-8">
      <div>
        <span class="type-label text-on-background/40 block mb-3">Investment</span>
        <h2 class="type-h2 text-on-background max-w-lg">
          Transparent pricing, no retainers required.
        </h2>
        <p class="type-body-small text-on-surface-variant mt-3 max-w-md leading-relaxed">
          Every engagement is scoped, priced, and delivered as a complete project.
        </p>
      </div>
      <!-- Availability badge -->
      <div class="flex items-center gap-2 flex-shrink-0 border border-accent/20 bg-accent/5 px-4 py-2" role="status">
        <span class="w-1.5 h-1.5 rounded-full bg-accent availability-dot" aria-hidden="true"></span>
        <span class="type-label text-accent">{PRICING_BADGE}</span>
      </div>
    </header>

    <!-- ── Mobile: stacked cards ── -->
    <div class="flex flex-col gap-px bg-black/5 lg:hidden mb-12">
      {PRICING_TIERS.map((tier, i) => (
        <article
          class="pricing-card bg-background flex flex-col"
          data-index={i}
          aria-label={`${tier.name} pricing tier`}
        >
          <!-- Tier header -->
          <div class:list={[
            "relative p-8 border-b border-black/5",
            tier.popular ? "bg-surface-container-lowest" : ""
          ]}>
            {tier.popular && (
              <span class="type-label text-accent absolute top-6 right-6">Most popular</span>
            )}
            <h3 class="type-h3 text-on-background mb-1">{tier.name}</h3>
            <p class="type-body-small text-on-surface-variant mb-6">{tier.tagline}</p>
            <!-- Price -->
            <div class="flex items-baseline gap-2 mb-1">
              <span class="type-label text-on-background/40">From</span>
              <span class="font-display font-medium text-3xl text-on-background tracking-tight">
                {tier.price.replace(/^From\s*\$?/i, "$")}
              </span>
            </div>
            <span class="type-label text-on-background/40">{tier.timeline}</span>
          </div>
          <!-- Features -->
          <ul class="p-8 flex flex-col gap-3" aria-label={`${tier.name} features`}>
            {tier.included.map((feature, fi) => (
              <li class="flex items-start gap-3 type-body-small text-on-surface-variant">
                <svg class="w-3.5 h-3.5 text-accent mt-0.5 flex-shrink-0" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2.5 7.5L5.5 10.5L11.5 4.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
          <!-- CTA -->
          <div class="px-8 pb-8">
            <a
              href={i < 2
                ? `${baseUrl}contact?source=pricing&tier=${encodeURIComponent(tier.name.toLowerCase())}`
                : SITE_CONFIG.socials.calendly}
              target={i >= 2 ? "_blank" : undefined}
              rel={i >= 2 ? "noopener noreferrer" : undefined}
              class:list={[
                "magnetic-cta w-full flex items-center justify-center gap-3 type-button py-4 transition-colors duration-300",
                tier.popular
                  ? "bg-primary text-on-primary hover:bg-accent"
                  : "border border-black/10 text-on-background hover:border-on-background"
              ]}
            >
              {tier.ctaLabel}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- ── Desktop: comparison table ── -->
    <div class="hidden lg:block">
      <!-- Tier headers -->
      <div class="grid grid-cols-4 gap-px bg-black/5 mb-px">
        <!-- Empty label column -->
        <div class="bg-surface-container-low p-8 flex items-end border-r border-black/5">
          <span class="type-label text-on-background/50">What's included</span>
        </div>
        <!-- Tier columns -->
        {PRICING_TIERS.map((tier, i) => (
          <div
            class:list={[
              "pricing-card relative flex flex-col gap-4 p-8",
              tier.popular ? "bg-surface-container-lowest" : "bg-background"
            ]}
            data-index={i}
          >
            {tier.popular && (
              <span class="type-label text-accent absolute top-6 right-6">Most popular</span>
            )}
            <div>
              <h3 class="type-h3 text-on-background mb-1">{tier.name}</h3>
              <p class="type-body-small text-on-surface-variant">{tier.tagline}</p>
            </div>
            <!-- Price -->
            <div>
              <div class="flex items-baseline gap-1.5 mb-0.5">
                <span class="type-label text-on-background/40">From</span>
                <span class="font-display font-medium text-3xl text-on-background tracking-tight">
                  {tier.price.replace(/^From\s*\$?/i, "$")}
                </span>
              </div>
              <span class="type-label text-on-background/40">{tier.timeline}</span>
            </div>
            <!-- CTA -->
            <a
              href={i < 2
                ? `${baseUrl}contact?source=pricing&tier=${encodeURIComponent(tier.name.toLowerCase())}`
                : SITE_CONFIG.socials.calendly}
              target={i >= 2 ? "_blank" : undefined}
              rel={i >= 2 ? "noopener noreferrer" : undefined}
              class:list={[
                "magnetic-cta mt-auto flex items-center justify-center gap-2 type-button py-3.5 transition-colors duration-300",
                tier.popular
                  ? "bg-primary text-on-primary hover:bg-accent"
                  : "border border-black/10 text-on-background hover:border-on-background"
              ]}
            >
              {tier.ctaLabel}
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        ))}
      </div>

      <!-- Feature rows -->
      {allFeatures.map((feature, fi) => (
        <div class="grid grid-cols-4 gap-px bg-black/5 mb-px feature-row" data-row={fi}>
          <!-- Feature label -->
          <div class="bg-surface-container-low px-8 py-4 flex items-center border-r border-black/5">
            <span class="type-body-small text-on-background">{feature}</span>
          </div>
          <!-- Tier cells -->
          {PRICING_TIERS.map((tier, ti) => {
            const included = tierInclusion[ti]?.[fi] ?? false;
            return (
              <div
                class:list={[
                  "px-8 py-4 flex items-center justify-center",
                  tier.popular ? "bg-surface-container-lowest" : "bg-background"
                ]}
              >
                {included ? (
                  <svg class="w-4 h-4 text-accent" viewBox="0 0 16 16" fill="none" aria-label="Included" role="img">
                    <path d="M3.5 8.5L6.5 11.5L12.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                ) : (
                  <span class="w-3 h-px bg-black/10 block" aria-label="Not included" role="img"></span>
                )}
              </div>
            );
          })}
        </div>
      ))}
    </div>

    <!-- Footer CTA strip -->
    <div class="mt-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 border border-black/5 p-8 bg-surface-container-lowest">
      <div class="max-w-md">
        <h3 class="type-h3 text-on-background mb-2">{PRICING_FOOTER.title}</h3>
        <p class="type-body-small text-on-surface-variant leading-relaxed">{PRICING_FOOTER.description}</p>
      </div>
      <a
        href={SITE_CONFIG.socials.calendly}
        target="_blank"
        rel="noopener noreferrer"
        class="magnetic-cta z-depth-1 flex-shrink-0 inline-flex items-center gap-3 type-button bg-primary text-on-primary px-8 py-4 hover:bg-accent transition-colors duration-300"
      >
        {PRICING_FOOTER.ctaLabel}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Trust line -->
    <p class="mt-8 text-center type-caption text-on-background/30">
      {PRICING_TRUST_LINE}
    </p>

  </div>
</section>

<style>
  /* ── Card entrance ─────────────────────────────────────────── */
  .pricing-card {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pricing-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Feature row entrance ──────────────────────────────────── */
  .feature-row {
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .feature-row.is-visible {
    opacity: 1;
  }

  /* ── Availability dot pulse ────────────────────────────────── */
  .availability-dot {
    animation: pulse-dot 2.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(60,205,127,0); }
    50%       { opacity: 0.85; box-shadow: 0 0 8px 3px rgba(60,205,127,0.25); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-card, .feature-row {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .availability-dot { animation: none; }
  }
</style>

<script>
  // Cards entrance
  const cards = document.querySelectorAll('.pricing-card');
  const cardObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el  = entry.target as HTMLElement;
      const idx = parseInt(el.dataset.index ?? '0');
      setTimeout(() => el.classList.add('is-visible'), idx * 80);
      cardObserver.unobserve(el);
    });
  }, { threshold: 0.1 });
  cards.forEach(c => cardObserver.observe(c));

  // Feature rows staggered entrance
  const rows = document.querySelectorAll('.feature-row');
  const rowObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el  = entry.target as HTMLElement;
      const idx = parseInt(el.dataset.row ?? '0');
      setTimeout(() => el.classList.add('is-visible'), idx * 30);
      rowObserver.unobserve(el);
    });
  }, { threshold: 0.05 });
  rows.forEach(r => rowObserver.observe(r));
</script>
