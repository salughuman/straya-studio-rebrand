---
/**
 * Pricing.astro — Straya Studio
 * Premium dark editorial pricing — tier indices, oversized price, accent featured card.
 */
import {
  PRICING_TIERS,
  PRICING_BADGE,
  PRICING_HEADLINE,
  PRICING_SUBTITLE,
  PRICING_TRUST_LINE,
} from "../data/pricing";
import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";

const baseUrl = import.meta.env.BASE_URL;

const tierSlug = (name: string) =>
  name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");

const tierCtaHref = (tierName: string, index: number) => {
  if (index === 2) return SITE_CONFIG.socials.calendly;
  return `${baseUrl}contact?source=pricing&tier=${encodeURIComponent(tierSlug(tierName))}`;
};

const indices = ["01", "02", "03"];
---

<section
  id="pricing"
  aria-label="Project pricing tiers"
  class="relative bg-background text-on-background overflow-hidden"
>
  <p class="sr-only">
    Straya Studio offers three project-based pricing tiers with no retainers or subscriptions.
    Landing Page from $2,500 (1–2 weeks). Growth Website from $5,000 (2–5 weeks), most popular.
    Digital Product System is a custom engagement (4–8+ weeks) for complex platforms.
  </p>

  <!-- Section header -->
  <div class="main-container pt-20 pb-14 md:pt-28 md:pb-16">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-16">

      <div class="flex-1">
        <p class="type-label-small mb-5 inline-flex items-center gap-2 uppercase tracking-blueprint text-on-background/50" role="status">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          {PRICING_BADGE}
        </p>
        <h2 class="type-h2 m-0 max-w-2xl tracking-tight text-on-background">
          {PRICING_HEADLINE}
        </h2>
      </div>

      <p class="type-body m-0 max-w-[44ch] text-on-background/60 md:text-right leading-relaxed">
        {PRICING_SUBTITLE}
      </p>

    </div>
  </div>

  <!-- Divider -->
  <div class="main-container">
    <div class="pricing-rule"></div>
  </div>

  <!-- Cards -->
  <div class="main-container py-0">
    <div class="grid grid-cols-1 md:grid-cols-3" role="list">
      {
        PRICING_TIERS.map((tier, i) => {
          const featured = Boolean(tier.popular);
          const href = tierCtaHref(tier.name, i);
          const external = i === 2;
          return (
            <article
              class:list={[
                "pricing-card group relative flex flex-col",
                featured ? "pricing-card--featured" : "",
                i < PRICING_TIERS.length - 1 ? "pricing-card--bordered" : "",
              ]}
              role="listitem"
              aria-label={`${tier.name} — ${tier.price}`}
              data-pricing-card
              data-pricing-i={i}
            >
              <!-- Card inner -->
              <div class="flex flex-1 flex-col px-8 pt-8 pb-8 md:px-10 md:pt-10 md:pb-10">

                <!-- Index + name row -->
                <div class="flex items-start justify-between mb-8">
                  <span class="pricing-index">{indices[i]}</span>
                  {featured && (
                    <span class="pricing-badge">Most Popular</span>
                  )}
                </div>

                <!-- Name & tagline -->
                <div class="mb-8">
                  <h3 class:list={[
                    "font-display font-semibold leading-tight tracking-tight mb-2",
                    "text-[clamp(1.5rem,2.2vw,2rem)]",
                    featured ? "text-on-background" : "text-on-background/90",
                  ]}>
                    {tier.name}
                  </h3>
                  <p class="type-body-small m-0 text-on-background/65 leading-relaxed">
                    {tier.tagline}
                  </p>
                </div>

                <!-- Price block -->
                <div class="mb-8 pb-8 pricing-price-block">
                  <p class="type-label-small mb-3 uppercase tracking-blueprint text-on-background/55">Starting from</p>
                  <p class:list={[
                    "pricing-price font-display font-black leading-none tracking-tight m-0",
                    featured ? "text-on-background" : "text-on-background/85",
                  ]}>
                    {tier.price}
                  </p>
                  <p class="type-label-small mt-3 uppercase tracking-blueprint text-on-background/60 m-0">
                    {tier.timeline}
                  </p>
                </div>

                <!-- Best for -->
                <p class="type-body-small m-0 mb-6 text-on-background/70 leading-relaxed">
                  {tier.bestFor}
                </p>

                <!-- Features -->
                <ul class="m-0 flex flex-1 list-none flex-col gap-3 p-0 mb-10" aria-label={`${tier.name} includes`}>
                  {
                    tier.included.map((feature) => (
                      <li class="flex items-start gap-3">
                        <span class="pricing-check-icon mt-0.5 shrink-0" aria-hidden="true">
                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                        <span class="type-body-small text-on-background/75 leading-snug">
                          {feature}
                        </span>
                      </li>
                    ))
                  }
                </ul>

                <!-- CTA -->
                <div class="mt-auto">
                  <Button
                    href={href}
                    label={tier.ctaLabel}
                    variant={featured ? "hero-pill" : "hero-pill-inverted"}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                    class="w-full justify-center"
                    aria-label={`${tier.ctaLabel} — ${tier.name}`}
                  />
                </div>

              </div>
            </article>
          );
        })
      }
    </div>
  </div>

  <!-- Trust line -->
  <div class="main-container pb-16 md:pb-24">
    <div class="pricing-rule mb-8"></div>
    <p class="type-caption m-0 text-center text-on-background/55">{PRICING_TRUST_LINE}</p>
  </div>

</section>

<script>
  const initPricingReveal = () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const cards = document.querySelectorAll<HTMLElement>("[data-pricing-card]");
    if (!cards.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const card = entry.target as HTMLElement;
          const i = parseInt(card.dataset.pricingI ?? "0", 10);
          setTimeout(() => card.classList.add("is-visible"), i * 80);
          observer.unobserve(card);
        });
      },
      { rootMargin: "-5% 0px -8% 0px", threshold: 0.05 }
    );

    cards.forEach((card) => observer.observe(card));
  };

  initPricingReveal();
  document.addEventListener("astro:after-swap", initPricingReveal);
</script>

<style>
  /* ── Scroll-reveal ────────────────────────────────────────── */
  [data-pricing-card] {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
    transition:
      opacity 700ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 600ms cubic-bezier(0.16, 1, 0.3, 1),
      background 300ms cubic-bezier(0.16, 1, 0.30, 1);
  }
  [data-pricing-card].is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-pricing-card] {
      opacity: 1;
      transform: none;
      filter: none;
      transition: background 300ms cubic-bezier(0.16, 1, 0.30, 1);
    }
  }

  .pricing-rule {
    height: 1px;
    background: rgba(255, 237, 215, 0.08);
  }

  /* Card base */
  .pricing-card {
    border-top: 1px solid rgba(255, 237, 215, 0.08);
    transition: background 300ms cubic-bezier(0.16, 1, 0.30, 1);
  }

  /* Vertical divider between cards */
  .pricing-card--bordered {
    border-right: 1px solid rgba(255, 237, 215, 0.08);
  }

  /* Featured / popular card */
  .pricing-card--featured {
    background: rgba(255, 237, 215, 0.035);
    border-top: 1px solid rgba(220, 80, 0, 0.6);
    position: relative;
  }

  .pricing-card--featured::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(220, 80, 0, 0.9) 40%, rgba(220, 80, 0, 0.4) 100%);
  }

  /* Hover lift for non-featured */
  .pricing-card:not(.pricing-card--featured):hover {
    background: rgba(255, 237, 215, 0.02);
  }

  /* Tier index */
  .pricing-index {
    font-family: var(--font-body);
    font-size: clamp(0.625rem, 0.6rem + 0.12vw, 0.72rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 237, 215, 0.25);
  }

  /* Popular badge */
  .pricing-badge {
    font-family: var(--font-body);
    font-size: clamp(0.6rem, 0.58rem + 0.1vw, 0.68rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #DC5000;
    border: 1px solid rgba(220, 80, 0, 0.35);
    padding: 0.25rem 0.6rem;
    line-height: 1;
  }

  /* Price */
  .pricing-price {
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    letter-spacing: -0.04em;
  }

  /* Separator below price block */
  .pricing-price-block {
    border-bottom: 1px solid rgba(255, 237, 215, 0.07);
  }

  /* Check icon */
  .pricing-check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #DC5000;
  }
</style>
