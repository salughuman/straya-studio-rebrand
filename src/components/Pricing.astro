---
/**
 * Pricing.astro — project tiers on primary cream band (aligned with StrayaOffer).
 * Light / dark card tones, gutter grid, static depth — no scroll-driven motion.
 */
import {
  PRICING_TIERS,
  PRICING_BADGE,
  PRICING_HEADLINE,
  PRICING_SUBTITLE,
  PRICING_TRUST_LINE,
} from "../data/pricing";
import { SITE_CONFIG } from "../data/site-config";
import Button from "./ui/buttons/Button.astro";

const baseUrl = import.meta.env.BASE_URL;

const tierSlug = (name: string) =>
  name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");

const tierCtaHref = (tierName: string, index: number) => {
  if (index === 2) return SITE_CONFIG.socials.calendly;
  return `${baseUrl}contact?source=pricing&tier=${encodeURIComponent(tierSlug(tierName))}`;
};
---

<section
  id="pricing"
  aria-label="Project pricing tiers"
  class="relative overflow-hidden bg-primary text-inverse-on-surface pt-16 pb-16 md:pt-20 md:pb-20"
>
  <p class="sr-only">
    Straya Studio offers three project-based pricing tiers with no retainers or subscriptions.
    Landing Page from $2,500 (1–2 weeks). Growth Website from $5,000 (2–5 weeks), most popular.
    Digital Product System is a custom engagement (4–8+ weeks) for complex platforms.
  </p>

  <div class="main-container">
    <header class="mb-12 flex flex-col gap-8 md:mb-14 md:flex-row md:items-end md:justify-between md:gap-10">
      <div class="max-w-3xl">
        <h2 class="type-h2 m-0 max-w-5xl tracking-tight">
          {PRICING_HEADLINE}
        </h2>
        <p
          class="type-label-small mt-5 inline-flex items-center gap-2 font-mono uppercase tracking-[0.1em] text-inverse-on-surface/62"
          role="status"
        >
          <span class="h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          {PRICING_BADGE}
        </p>
      </div>
      <div class="flex flex-col gap-5 md:max-w-md md:items-end md:text-right lg:max-w-lg">
        <p class="type-body text-left max-w-[52ch] leading-relaxed text-inverse-on-surface/78">
          {PRICING_SUBTITLE}
        </p>
      </div>
    </header>

    <div class="grid grid-cols-1 gap-[var(--grid-gutter)] md:grid-cols-3" role="list">
      {
        PRICING_TIERS.map((tier, i) => {
          const dark = Boolean(tier.popular);
          const href = tierCtaHref(tier.name, i);
          const external = i === 2;
          return (
            <article
              class:list={[
                "pricing-card group relative flex min-h-0 flex-col overflow-hidden",
                dark ? "bg-surface-container text-on-background" : "bg-inverse-panel text-inverse-on-surface",
              ]}
              data-pricing-tone={dark ? "dark" : "light"}
              role="listitem"
              aria-label={`${tier.name} — ${tier.price}`}
            >
              <div class="flex-shrink-0 px-[var(--spacing-card-padding)] pb-0 pt-5 md:pt-6">
                
              </div>

              <div class="flex-shrink-0 px-[var(--spacing-card-padding)] pt-3 md:pt-4">
                <h3
                  class:list={[
                    "font-display line-clamp-2 font-semibold leading-[1.12] tracking-tight",
                    "text-[clamp(1.35rem,2vw,1.85rem)]",
                    dark ? "text-on-background" : "text-inverse-on-surface",
                  ]}
                >
                  {tier.name}
                </h3>
                <p
                  class:list={[
                    "type-body-small m-0 mt-2 leading-relaxed",
                    dark ? "text-on-background/65" : "text-inverse-on-surface/72",
                  ]}
                >
                  {tier.tagline}
                </p>
              </div>

              <div
                class="pricing-vis relative flex min-h-[7.5rem] flex-shrink-0 flex-col justify-center px-[var(--spacing-card-padding)] py-5 md:min-h-[8.5rem] md:py-6"
                aria-hidden="true"
              >
                <span
                  class:list={[
                    "type-label-small mb-2 block font-mono uppercase tracking-[0.1em]",
                    dark ? "text-on-background/45" : "text-inverse-on-surface/50",
                  ]}
                >
                  From
                </span>
                <p
                  class:list={[
                    "pricing-price m-0 font-display font-medium leading-[0.95] tracking-tight",
                    dark ? "text-on-background" : "text-inverse-on-surface",
                  ]}
                >
                  {tier.price}
                </p>
                <p
                  class:list={[
                    "type-label-small m-0 mt-3 font-mono uppercase tracking-[0.08em]",
                    dark ? "text-on-background/50" : "text-inverse-on-surface/55",
                  ]}
                >
                  {tier.timeline}
                </p>
                <div class="pricing-vis-rule mt-4" aria-hidden="true"></div>
              </div>

              <div class="flex flex-1 flex-col px-[var(--spacing-card-padding)] pb-5 pt-1 md:pb-6">
                <p
                  class:list={[
                    "type-body-small m-0 mb-5 leading-relaxed",
                    dark ? "text-on-background/70" : "text-inverse-on-surface/78",
                  ]}
                >
                  {tier.bestFor}
                </p>
                <ul class="m-0 flex flex-1 list-none flex-col gap-2.5 p-0" aria-label={`${tier.name} includes`}>
                  {
                    tier.included.map((feature) => (
                      <li class="flex items-start gap-2.5">
                        <svg
                          class="mt-0.5 h-3 w-3 shrink-0 text-accent"
                          viewBox="0 0 12 12"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="M2 6.5L4.5 9L10 3.5"
                            stroke="currentColor"
                            stroke-width="1.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        <span
                          class:list={[
                            "type-body-small leading-snug",
                            dark ? "text-on-background/85" : "text-inverse-on-surface/88",
                          ]}
                        >
                          {feature}
                        </span>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div class="mt-auto flex-shrink-0 px-[var(--spacing-card-padding)] pb-5 md:pb-6">
                <Button
                  href={href}
                  label={tier.ctaLabel}
                  variant={dark ? "hero-pill" : "hero-pill-inverted"}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class="w-full justify-center"
                  aria-label={`${tier.ctaLabel} — ${tier.name}`}
                />
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="type-caption m-0 mt-8 text-center text-inverse-on-surface/55">{PRICING_TRUST_LINE}</p>
  </div>
</section>

<style>
  .pricing-card {
    box-shadow:
      0 1px 0 rgba(var(--outline-variant-rgb), 0.06),
      0 6px 20px rgba(var(--outline-variant-rgb), 0.06),
      inset 0 1px 0 rgba(var(--fg-rgb), 0.04);
  }

  [data-pricing-tone="light"].pricing-card {
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.05),
      0 8px 26px rgba(0, 0, 0, 0.09),
      inset 0 1px 0 rgba(255, 255, 255, 0.75);
  }

  .pricing-price {
    font-size: clamp(1.65rem, 2.4vw, 2.35rem);
  }

  .pricing-vis-rule {
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(var(--accent-rgb), 0.55) 0%,
      rgba(var(--accent-rgb), 0.08) 55%,
      transparent 100%
    );
  }

  [data-pricing-tone="dark"] .pricing-vis-rule {
    background: linear-gradient(
      90deg,
      rgba(var(--accent-rgb), 0.75) 0%,
      rgba(255, 237, 215, 0.12) 55%,
      transparent 100%
    );
  }

</style>
