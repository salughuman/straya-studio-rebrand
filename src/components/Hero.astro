---
/**
 * Hero.astro — full-bleed home hero
 * Title: semantic `h1` + `.type-h1` (`typography.h1` via Tailwind).
 * Scrims → `hero.imageScrimTransparentUntil` + global.css classes.
 */
import Button from "./ui/buttons/Button.astro";

interface Props {
  headline?: string;
  tagline?: string;
  ctaLabel?: string;
}

const baseUrl = import.meta.env.BASE_URL;
const {
  headline = `Build\nabove\nthe noise`,
  tagline = "Straya is a digital studio building brand-defining websites and product experiences for ambitious teams. We design, build and ship - end to end.",
  ctaLabel = "Start a project",
} = Astro.props as Props;
---

<section
  id="hero"
  aria-label="Straya Studio hero"
  class="relative isolate z-10 box-border w-full"
  style="height: 100svh;"
>
  <div class="relative isolate h-full overflow-hidden bg-surface-dim">
  <p class="sr-only">
    Straya Studio hero section with background image, headline,
    supporting positioning statement, and a direct call to start a project.
  </p>

  <img
    src="/images/Hero/straya-hero-image.webp"
    alt=""
    aria-hidden="true"
    width="2880"
    height="1620"
    class="absolute inset-0 z-0 h-full w-full object-cover opacity-90"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />

  <div
    class="hero-image-grain pointer-events-none absolute inset-0 z-10"
    aria-hidden="true"
  ></div>

  <div
    class="hero-image-scrim pointer-events-none absolute inset-0 z-20"
    aria-hidden="true"
  ></div>


  <div
    class="absolute bottom-0 left-0 right-0 z-30 pb-card-padding lg:pb-2"
  >
    <div class="main-container w-full pb-2 sm:pb-4 lg:pb-10">
      <div class="grid grid-cols-12 items-end gap-4 lg:gap-6">
        <div class="col-span-12 lg:col-span-8">
          <h1 class="hero-headline type-h1 whitespace-pre-line text-on-background">
            {headline}
          </h1>
        </div>

        <div
          class="col-span-12 flex flex-col gap-5 lg:col-span-4"
        >
          <p class="type-body max-w-md text-pretty text-on-surface-variant">
            {tagline}
          </p>

          <Button
            href={`${baseUrl}contact`}
            label={ctaLabel}
            variant="hero-pill"
            class="self-start"
          />
        </div>
      </div>
    </div>
  </div>
  </div>
  </div>
</section>

<style>
  /* Subtle vertical fade — softer toward the top, full strength at the baseline (over hero scrim) */
  .hero-headline {
    background-image: linear-gradient(
      180deg,
      rgba(var(--fg-rgb), 0.48) 0%,
      rgba(var(--fg-rgb), 0.78) 32%,
      rgba(var(--fg-rgb), 0.96) 68%,
      rgb(var(--fg-rgb)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  @supports not ((-webkit-background-clip: text) or (background-clip: text)) {
    .hero-headline {
      color: var(--color-on-background);
      background: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-headline {
      background-image: linear-gradient(
        180deg,
        rgba(var(--fg-rgb), 0.82) 0%,
        rgb(var(--fg-rgb)) 100%
      );
    }
  }
</style>
