---
// Hero.astro — Straya Studio
// Compliant with GEMINI.md: light mode, no bold fonts, magnetic CTA,
// 4-col grid background, z-depth, blueprint tracking, semantic HTML + SEO.
import TrustGrid from "./TrustGrid.astro";
---

<section
  id="hero"
  aria-label="Straya Studio — Cinematic Digital Deployments"
  class="relative border-b border-black/5 overflow-hidden perspective-1k"
>
  <!-- 4-column baseline grid (0.06 opacity) -->
  <div class="absolute inset-0 grid grid-cols-4 pointer-events-none" aria-hidden="true">
    <div class="border-r border-black/[0.06]"></div>
    <div class="border-r border-black/[0.06]"></div>
    <div class="border-r border-black/[0.06]"></div>
    <div></div>
  </div>

  <div class="relative z-10 main-container pt-32 pb-20 lg:pt-40 lg:pb-24">

    <!-- Headline + Description row -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-12 mb-16">

      <!-- Left: Headline -->
      <div class="z-depth-1">
        <span class="type-label text-on-background/40 mb-4 block">
          EST. 2024 / MELBOURNE
        </span>
        <h1 class="type-h1 text-on-background uppercase">
          Cinematic<br />Digital<br />Deployments
        </h1>
      </div>

      <!-- Right: Description + Founder -->
      <div class="max-w-md text-left md:text-right z-depth-1">
        <p class="type-body text-on-surface-variant mb-6">
          Designing &amp; developing ideas into icons. From Framer to Shopify — we
          engineer platforms that load faster, convert higher, and look like
          nothing else in your market.
        </p>
        <div class="flex items-center justify-start md:justify-end gap-2">
          <span class="type-label text-on-background">SALMAN ALI</span>
          <span class="w-8 h-px bg-black/10" aria-hidden="true"></span>
          <span class="type-label text-on-background/40">Founder / Framer Expert</span>
        </div>
      </div>
    </div>

    <!-- Metrics Grid -->
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16"
      aria-label="Studio metrics"
    >
      <div class="p-8 border border-black/5 bg-surface-container-lowest group hover:bg-surface transition-colors duration-500">
        <div class="type-h2 mb-1" aria-label="100 plus deployments">100+</div>
        <div class="type-label text-on-background/40">Deployments</div>
      </div>
      <div class="p-8 border border-black/5 bg-surface-container-lowest group hover:bg-surface transition-colors duration-500">
        <div class="type-h2 mb-1" aria-label="5 point 0 star rating">5.0</div>
        <div class="type-label text-on-background/40">Rating</div>
      </div>
      <div class="p-8 border border-black/5 bg-surface-container-lowest group hover:bg-surface transition-colors duration-500">
        <div class="type-h2 mb-1">100%</div>
        <div class="type-label text-on-background/40">Quality</div>
      </div>
      <div class="p-8 border border-black/5 bg-primary group hover:bg-secondary transition-colors duration-300">
        <div class="type-h2 text-on-primary mb-1">Elite</div>
        <div class="type-label text-on-primary/60">Status</div>
      </div>
    </div>

    <!-- CTA Row -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-16">
      <a
        href="/contact"
        class="magnetic-cta z-depth-2 inline-flex items-center gap-3 bg-primary text-on-primary px-8 py-4 type-button hover:bg-accent transition-colors duration-300"
        aria-label="Start a project with Straya Studio"
      >
        Initiate Project
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a
        href="#work"
        class="inline-flex items-center gap-2 type-label text-on-background/40 hover:text-on-background transition-colors duration-300 border-b border-transparent hover:border-on-background/20 pb-px"
      >
        View Selected Work
      </a>
    </div>

    <!-- Platform Marquee -->
    <TrustGrid />

  </div>
</section>
