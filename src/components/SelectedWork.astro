---
import { SELECTED_PROJECTS } from "../data/selected-work";

const baseUrl = import.meta.env.BASE_URL;
---

<section
  id="work"
  aria-label="Selected work"
  class="section-frosted relative"
>
  <img
    src="/images/work/Work-bg.webp"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover"
    loading="lazy"
    decoding="async"
  />
  <!-- Readability wash over photo -->
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-background/60"
    aria-hidden="true"
  ></div>
  <div class="relative z-10">
    <p class="sr-only">
      Selected work section with left and right project image cards and a sticky
      center project title that updates as each project enters view.
    </p>

    <div class="w-full pt-16 pb-12 md:pt-20 md:pb-32">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-0"
        data-work-rows
      >
        <div
          class="hidden lg:block lg:col-span-4 space-y-64 lg:pl-0 lg:pr-3"
          data-left-rail
        >
          {
            SELECTED_PROJECTS.map((project, i) => (
              <div
                class={`work-media ${i % 2 === 0 ? "" : "invisible pointer-events-none"}`}
                data-work-media-slot
                data-work-index={i}
              >
                {i % 2 === 0 && (
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="media-card media-card--edge media-card--edge-left"
                    aria-label={`View ${project.title} project`}
                  >
                    <div class="aspect-[4/5] bg-[#151522] overflow-hidden">
                      {project.thumbnail ? (
                        <img
                          src={`${baseUrl}${project.thumbnail.replace(/^\//, "")}`}
                          alt=""
                          width="960"
                          height="1200"
                          class="h-full w-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="h-full w-full flex items-center justify-center type-label text-[#E1E0CC]/45">
                          {project.title}
                        </div>
                      )}
                    </div>
                  </a>
                )}
              </div>
            ))
          }
        </div>

        <div class="hidden lg:block lg:col-span-4">
          <div
            class="sticky top-0 h-screen flex items-center justify-center text-center px-4 sm:px-6 md:px-8"
            data-work-center
          >
            <div class="w-full max-w-lg">
              <ul
                class="flex flex-col items-center gap-3 md:gap-4"
                aria-label="Project titles"
              >
                {
                  SELECTED_PROJECTS.map((project, i) => (
                    <li
                      class="work-title-item w-full text-center font-display font-normal tracking-tight leading-[0.88] text-[clamp(2.5rem,5.5vw,5.5rem)] uppercase text-[#E1E0CC]/26 transition-all duration-300"
                      data-work-title-item
                      data-index={i}
                    >
                      {project.title}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <div
          class="hidden lg:block lg:col-span-4 space-y-64 lg:pr-0 lg:pl-3"
          data-right-rail
        >
          {
            SELECTED_PROJECTS.map((project, i) => (
              <div
                class={`work-media ${i % 2 !== 0 ? "" : "invisible pointer-events-none"}`}
                data-work-media-slot
                data-work-index={i}
              >
                {i % 2 !== 0 && (
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="media-card media-card--edge media-card--edge-right"
                    aria-label={`View ${project.title} project`}
                  >
                    <div class="aspect-[4/5] bg-[#151522] overflow-hidden">
                      {project.thumbnail ? (
                        <img
                          src={`${baseUrl}${project.thumbnail.replace(/^\//, "")}`}
                          alt=""
                          width="960"
                          height="1200"
                          class="h-full w-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="h-full w-full flex items-center justify-center type-label text-[#E1E0CC]/45">
                          {project.title}
                        </div>
                      )}
                    </div>
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>

      <!-- Mobile work list — editorial card stack -->
      <div class="lg:hidden">
        <!-- Section header -->
        <div class="main-container pb-8 pt-0">
          <p class="mobile-work-eyebrow">Selected Work</p>
          <h2 class="mobile-work-heading">Projects<br/>that define us.</h2>
        </div>

        <!-- Card list -->
        <div>
          {
            SELECTED_PROJECTS.map((project, i) => (
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mobile-work-card main-container block border-b border-on-background/10 pb-8 pt-0 mb-0"
                aria-label={`View ${project.title} project`}
              >
                <!-- Image -->
                <div class="mobile-work-img aspect-[3/2] overflow-hidden mb-5 bg-[#151522]">
                  {project.thumbnail ? (
                    <img
                      src={`${baseUrl}${project.thumbnail.replace(/^\//, "")}`}
                      alt={project.title}
                      width="960"
                      height="640"
                      class="h-full w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="h-full w-full flex items-center justify-center text-[#E1E0CC]/40 text-sm tracking-widest uppercase">
                      {project.title}
                    </div>
                  )}
                </div>

                <!-- Info row -->
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-3 mb-2">
                      <span class="mobile-work-index">0{i + 1}</span>
                      <span class="mobile-work-sector">{project.sector}</span>
                    </div>
                    <h3 class="mobile-work-title">{project.title}</h3>
                  </div>
                  <div class="mobile-work-arrow shrink-0 mt-1">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                      <path d="M3 9h12M11 5l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Mobile work layout ───────────────────────────────────── */
  .mobile-work-eyebrow {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(225, 224, 204, 0.4);
    margin: 0 0 1rem;
  }
  .mobile-work-heading {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 9vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: #e1e0cc;
    margin: 0;
  }
  .mobile-work-card {
    text-decoration: none;
    display: block;
    padding-top: 1.75rem;
    transition: opacity 200ms ease;
  }
  .mobile-work-card:first-of-type {
    border-top: 1px solid rgba(225, 224, 204, 0.10);
  }
  .mobile-work-img {
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }
  .mobile-work-card:hover .mobile-work-img img {
    transform: scale(1.03);
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-work-index {
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: rgba(225, 224, 204, 0.28);
    text-transform: uppercase;
  }
  .mobile-work-sector {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #dc5000;
    border: 1px solid rgba(220, 80, 0, 0.3);
    padding: 0.15rem 0.5rem;
    line-height: 1.4;
  }
  .mobile-work-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 6vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #e1e0cc;
    margin: 0;
  }
  .mobile-work-arrow {
    color: rgba(225, 224, 204, 0.35);
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1), color 200ms ease;
  }
  .mobile-work-card:hover .mobile-work-arrow {
    color: #dc5000;
    transform: translate(3px, -3px);
  }

  .sw-kicker {
    color: rgba(225, 224, 204, 0.62);
    letter-spacing: 0.08em;
  }
  .media-card {
    display: block;
    width: 100%;
    max-width: 320px;
    border: none;
    border-radius: 0;
    overflow: hidden;
    background: linear-gradient(
      160deg,
      rgba(15, 15, 26, 0.96) 0%,
      rgba(9, 9, 16, 0.96) 100%
    );
    box-shadow:
      0 16px 34px rgba(0, 0, 0, 0.45),
      0 4px 14px rgba(0, 0, 0, 0.25),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  @media (min-width: 1024px) {
    .media-card--edge {
      max-width: none;
      width: 50%;
    }
    .media-card--edge-left,
    .media-card--edge-right {
      border-radius: 0;
    }
  }
  .work-media {
    min-height: 280px;
  }
  @media (min-width: 1024px) {
    .work-media {
      min-height: 220px;
    }
  }
  [data-left-rail] .work-media {
    display: flex;
    justify-content: flex-start;
  }
  [data-right-rail] .work-media {
    display: flex;
    justify-content: flex-end;
  }
  .work-title-item.is-active {
    color: var(--color-accent, #dc5000);
    transform: translateY(-1px) scale(1.01);
  }
  @media (prefers-reduced-motion: reduce) {
    .media-card {
      transition: none !important;
      transform: none !important;
    }
    .work-title-item {
      transition: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const rows = gsap.utils
    .toArray<HTMLElement>("[data-work-media-slot]")
    .filter((el) => !el.classList.contains("invisible"));
  const titleItems = gsap.utils.toArray<HTMLElement>("[data-work-title-item]");

  const setActive = (index: number) => {
    titleItems.forEach((el, i) => {
      el.classList.toggle("is-active", i === index);
    });
  };

  setActive(0);

  let ticking = false;
  const syncActiveFromViewport = () => {
    const midY = window.innerHeight * 0.5;
    let bestIdx = 0;
    let bestDist = Number.POSITIVE_INFINITY;

    rows.forEach((row) => {
      const rect = row.getBoundingClientRect();
      const center = rect.top + rect.height * 0.5;
      const dist = Math.abs(center - midY);
      const idx = Number(row.dataset.workIndex ?? "-1");
      if (idx >= 0 && dist < bestDist) {
        bestDist = dist;
        bestIdx = idx;
      }
    });

    setActive(bestIdx);
    ticking = false;
  };

  const onScrollOrResize = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(syncActiveFromViewport);
  };

  window.addEventListener("scroll", onScrollOrResize, { passive: true });
  window.addEventListener("resize", onScrollOrResize);
  syncActiveFromViewport();
</script>
