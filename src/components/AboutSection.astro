<section
  id="about"
  class="section-y relative overflow-hidden"
  aria-label="About Straya Studio"
  data-about-effects
  data-mode="brutalism"
  style="background: var(--color-bg);"
>
  <!-- Warm radial glow — behind content, z-0 so frosted layer sits above -->
  <div
    class="pointer-events-none absolute top-0 left-0 right-0 h-[48rem] z-0"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 110% 130% at 50% -25%, rgba(var(--accent-rgb),0.042) 0%, rgba(var(--accent-rgb),0.032) 18%, rgba(var(--accent-rgb),0.020) 35%, rgba(var(--accent-rgb),0.010) 52%, rgba(var(--accent-rgb),0.004) 68%, rgba(var(--accent-rgb),0.001) 82%, transparent 100%); filter: blur(48px);"
  ></div>
  <p class="sr-only">
    About Straya Studio section summarising who we are and how we work: a
    senior-led boutique studio founded by Salman Ali, taking on only two to
    three projects at a time, delivering web design, web development, and
    graphic design for teams across the US, Canada, UK, Europe, and Australia.
  </p>

  <div
    class="main-container relative z-10 grid grid-cols-12 items-start gap-4 md:gap-6"
  >
    <div class="col-span-12 md:col-span-2" aria-hidden="true">
      <span
        class="a-eyebrow type-label-small font-mono uppercase tracking-[0.08em] text-on-background/60"
      >
        [02] About
      </span>
      <span class="a-eyebrow-rule mt-2 block h-[2px] bg-accent" data-a-rule
      ></span>
    </div>

    <header class="col-span-12 md:col-span-9 md:col-start-2">
      <h2
        data-index="02"
        class="type-h2 m-0 max-w-5xl text-on-background"
        style="letter-spacing:-0.04em;word-spacing:-0.3em"
        data-words-reveal
        aria-label="Senior-led by design. Selective by model."
      >
        <span class="wpu-word inline-block" style="--i:0;margin-right:0.25em" aria-hidden="true">Senior-led</span>
        <span class="wpu-word inline-block" style="--i:1;margin-right:0.25em" aria-hidden="true">by</span>
        <span class="wpu-word inline-block" style="--i:2;margin-right:0.25em" aria-hidden="true">design.</span>
        <span class="wpu-word inline-block" style="--i:3;margin-right:0.25em" aria-hidden="true">Selective</span>
        <span class="wpu-word inline-block" style="--i:4;margin-right:0.25em" aria-hidden="true">by</span>
        <span class="wpu-word inline-block" style="--i:5" aria-hidden="true">model.</span>
      </h2>
    </header>

    <div
      class="col-span-12 grid max-w-3xl gap-4 md:col-span-6 md:col-start-4 md:mt-5"
    >
      <p class="about-body-el type-body m-0 text-on-background/90">
        Straya Studio is a boutique technical studio led by Salman Ali, taking
        on only two to three projects at a time so every decision stays close to
        the brief.
      </p>
      <p class="about-body-el type-body m-0 text-on-background/90">
        We deliver web design, web development, and graphic design across
        Framer, Webflow, and Shopify for founders and teams in the US, Canada,
        UK, Europe, and Australia.
      </p>

      <a
        href="#method"
        class="cta-accent mt-6 inline-flex items-center gap-3 type-label uppercase tracking-[0.08em] self-start"
      >
        <span class="cta-accent__label">Explore the method</span>
        <span class="cta-accent__arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <aside
      class="col-span-12 mt-4 grid gap-3 md:col-span-3 md:col-start-10 md:mt-8 md:justify-self-end md:text-right"
      aria-label="Key credentials"
    >
      <p
        class="type-label-small m-0 font-mono uppercase tracking-[0.08em] text-on-background/70"
      >
        Official Certified Framer Expert
      </p>
      <p
        class="type-label-small m-0 font-mono uppercase tracking-[0.08em] text-on-background/70"
      >
        <span data-count-to="100">0</span>+ deployments
      </p>
      <p
        class="type-label-small m-0 font-mono uppercase tracking-[0.08em] text-on-background/70"
      >
        Project-based, no retainers
      </p>
    </aside>
  </div>
</section>

<style>
  /* PERMITTED: CSS variable arithmetic for word stagger */
  .wpu-word {
    opacity: 0;
    filter: blur(12px);
    transform: translateY(16px);
    transition:
      opacity    700ms cubic-bezier(0.16,1,0.3,1) calc(var(--i,0) * 60ms),
      filter     700ms cubic-bezier(0.16,1,0.3,1) calc(var(--i,0) * 60ms),
      transform  700ms cubic-bezier(0.16,1,0.3,1) calc(var(--i,0) * 60ms);
  }
  [data-words-reveal].is-revealed .wpu-word {
    opacity: 1; filter: blur(0); transform: translateY(0);
  }

  .a-eyebrow-rule {
    width: 0;
    transition: width 720ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .a-eyebrow-rule.in-view { width: 32px; }

  /* Scroll-driven body paragraphs */
  .about-body-el {
    opacity: 0;
    transform: translateY(20px);
    filter: blur(4px);
  }

  /* Ghost CTA — M3 underline-draw + M4 focus halo */
  .cta-accent {
    text-decoration: none;
    background: transparent;
    color: var(--color-accent, #DC5000);
    line-height: 1;
    padding-bottom: 2px;
    transition: color 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cta-accent .cta-accent__label {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 240ms cubic-bezier(0.16, 1, 0.3, 1);
    padding-bottom: 2px;
  }
  .cta-accent .cta-accent__arrow {
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cta-accent:hover .cta-accent__label,
  .cta-accent:focus-visible .cta-accent__label { background-size: 100% 1px; }
  .cta-accent:hover .cta-accent__arrow,
  .cta-accent:focus-visible .cta-accent__arrow { transform: translateX(4px); }
  .cta-accent:focus-visible { outline: 2px solid var(--color-accent, #DC5000); outline-offset: 6px; }

  @media (prefers-reduced-motion: reduce) {
    .wpu-word { opacity:1!important; filter:none!important; transform:none!important; transition:none!important; }
    .a-eyebrow-rule { transition: none!important; }
    .about-body-el { opacity:1!important; filter:none!important; transform:none!important; }
    .cta-accent, .cta-accent .cta-accent__arrow { transition: none!important; }
  }
</style>

<script>
  const setupAboutEffects = () => {
    const root = document.querySelector<HTMLElement>('[data-about-effects]');
    if (!root) return;
    if (root.dataset.aboutFxReady === 'true') return;
    root.dataset.aboutFxReady = 'true';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const heading  = root.querySelector<HTMLElement>('[data-words-reveal]');
    const ruleEl   = root.querySelector<HTMLElement>('[data-a-rule]');
    const counters = root.querySelectorAll<HTMLElement>('[data-count-to]');
    const bodyEls  = root.querySelectorAll<HTMLElement>('.about-body-el');

    if (reduced) {
      if (heading) heading.classList.add('is-revealed');
      if (ruleEl)  ruleEl.classList.add('in-view');
      counters.forEach(el => { el.textContent = el.dataset.countTo ?? el.textContent; });
      bodyEls.forEach(el => { el.style.opacity = '1'; el.style.filter = 'none'; el.style.transform = 'none'; });
      return;
    }

    // Heading — one-time entry trigger (§8.3)
    if (heading) {
      const obs = new IntersectionObserver(entries => {
        if (!entries[0].isIntersecting) return;
        heading.classList.add('is-revealed');
        obs.disconnect();
      }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
      obs.observe(heading);
    }

    // Eyebrow rule — one-time entry
    if (ruleEl) {
      const obs = new IntersectionObserver(entries => {
        if (!entries[0].isIntersecting) return;
        ruleEl.classList.add('in-view');
        obs.disconnect();
      }, { threshold: 0.2 });
      obs.observe(ruleEl);
    }

    // Body paragraphs + credentials — scroll-progress coupled (§8.5)
    let raf = 0;
    const vh = () => window.innerHeight;

    const updateBodyEls = () => {
      raf = 0;
      bodyEls.forEach(el => {
        const rect = el.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh() - rect.top) / (vh() * 0.6)));
        el.style.opacity   = p.toFixed(3);
        el.style.filter    = `blur(${((1 - p) * 4).toFixed(1)}px)`;
        el.style.transform = `translateY(${((1 - p) * 20).toFixed(1)}px)`;
      });
    };

    const onScroll = () => { if (!raf) raf = requestAnimationFrame(updateBodyEls); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateBodyEls();

    // B5 counters — scroll-progress coupled
    const updateCounters = () => {
      counters.forEach(el => {
        const r = el.getBoundingClientRect();
        const p = Math.max(0, Math.min(1, 1 - (r.top + r.height) / (vh() + r.height)));
        const target = parseFloat(el.dataset.countTo ?? '0');
        el.textContent = String(Math.round((1 - Math.pow(1 - p, 3)) * target));
      });
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(updateCounters); }, { passive: true });
    updateCounters();
  };

  setupAboutEffects();
  document.addEventListener('astro:after-swap', setupAboutEffects);
</script>
