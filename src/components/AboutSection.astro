---
// AboutSection — simple scroll-highlighted narrative (replaces multi-node 400vh scroll).
---

<section
  id="about"
  class="section-y relative bg-background border-b border-black/5 overflow-hidden"
  aria-label="About Straya Studio"
>
  <!-- Ghost wordmark — above global glow; opacity boosted when cursor is near -->
  <div
    class="absolute inset-0 z-[1] flex items-center justify-center pointer-events-none select-none overflow-hidden"
    aria-hidden="true"
  >
    <span
      class="ghost-wordmark font-display font-medium text-on-background uppercase transition-[opacity] duration-200 ease-out"
      data-ghost-base="0.035"
      data-ghost-range="0.12"
      data-ghost-falloff="360"
      style="font-size: clamp(8rem, 22vw, 18rem); letter-spacing: -0.04em; line-height: 1; white-space: nowrap; opacity: 0.035;"
    >
      STRAYA
    </span>
  </div>

  <div class="main-container relative z-10 max-w-4xl mx-auto text-center">
    <p class="sr-only">
      About Straya Studio: a boutique technical studio taking on 2–3 projects at a time, founded in Pakistan by Salman Ali, serving clients globally. Official Certified Framer Expert, Advanced Webflow Architect, and Shopify developer.
    </p>

    <p class="about-lead font-sans font-normal text-on-background leading-relaxed">
      <span class="about-frag" data-frag>Straya Studio is a boutique web partner—engineered for depth, not volume.</span>
      <span class="about-frag" data-frag> We intentionally cap work at two to three active projects so every interface and commit stays founder-led.</span>
      <span class="about-frag" data-frag> Based in Pakistan, we deploy for teams across the US, UK, Europe, and Australia.</span>
      <span class="about-frag" data-frag> Framer, Webflow, and Shopify builds where craft and performance match the brief.</span>
    </p>

    <p class="mt-12 md:mt-14 flex justify-center">
      <a
        href="#method"
        class="magnetic-cta type-label text-on-background/50 border-b border-on-background/15 pb-px hover:text-on-background hover:border-on-background transition-colors duration-300"
      >
        Explore the method
      </a>
    </p>
  </div>
</section>

<style>
  .about-lead {
    font-size: clamp(1.25rem, 2.8vw + 0.6rem, 1.875rem);
    line-height: 1.55;
    letter-spacing: -0.01em;
  }

  @media (min-width: 810px) {
    .about-lead {
      line-height: 1.5;
    }
  }

  /* --about-w: 0…1 set by scroll script; eases from muted to full ink */
  .about-frag {
    --about-w: 0;
    display: inline;
    color: rgba(26, 28, 28, calc(0.22 + 0.78 * var(--about-w)));
    transition: color 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .about-frag {
      transition: none;
      color: rgba(26, 28, 28, 0.92);
    }
  }
</style>

<script>
  const setupAboutHighlight = () => {
    const section = document.getElementById('about');
    const frags = section?.querySelectorAll<HTMLElement>('[data-frag]');
    if (!section || !frags?.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      frags.forEach((el) => el.style.setProperty('--about-w', '1'));
      return;
    }

    const ease = (t: number) => 1 - Math.pow(1 - t, 2);

    const update = () => {
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight;
      const enter = vh * 0.9;
      const exit = -rect.height * 0.4;
      const span = Math.max(1, enter - exit);
      const raw = (enter - rect.top) / span;
      const progress = Math.max(0, Math.min(1, ease(raw)));

      const n = frags.length;
      frags.forEach((el, i) => {
        const start = i / n;
        const end = (i + 1) / n;
        let w = 0;
        if (progress >= end) w = 1;
        else if (progress > start) w = (progress - start) / (end - start);
        el.style.setProperty('--about-w', w.toFixed(4));
      });
    };

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  };

  setupAboutHighlight();
  document.addEventListener('astro:after-swap', setupAboutHighlight);
</script>
