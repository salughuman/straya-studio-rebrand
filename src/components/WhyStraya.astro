---
/**
 * WhyStraya2.astro — Straya Studio (alternate)
 * Concept: Horizontal scroll cinema — 5 full-viewport panels, pinned scroll
 * M0: Scene choreography — each panel is a scene with bg/mid/fg depth layers
 * M10: Staggered reveal on panel entry
 * M12: Perspective cursor tilt on each panel
 * Scroll-driven: all motion tied to scroll progress, reversible
 * GSAP ScrollTrigger: one orchestrated pin (micro-interactions.md §9, §11)
 */
import Button from "./ui/buttons/Button.astro";
const baseUrl = import.meta.env.BASE_URL;

const offers = [
  {
    num: "01",
    stat: "Discovery",
    label: "Stage one",
    heading: "Map the terrain.\nBefore we build.",
    body: "We map your objectives, market position, and technical fit before a single pixel is placed. Decisions that hold up later are made here.",
    accent: "#DC5000",
    bg: "#080605",
  },
  {
    num: "02",
    stat: "Architecture",
    label: "Stage two",
    heading: "System decided.\nBefore design.",
    body: "Platform, CMS, and performance strategy locked in week one. The system is decided before the design — so nothing gets rebuilt later.",
    accent: "#FFEDD7",
    bg: "#140E09",
  },
  {
    num: "03",
    stat: "Engineering",
    label: "Stage three",
    heading: "Production-grade.\nFrom day one.",
    body: "Sprint-based builds, milestone reviews, production-grade from day one. Every component ships ready — no cleanup pass after launch.",
    accent: "#DC5000",
    bg: "#080605",
  },
  {
    num: "04",
    stat: "Optimisation",
    label: "Stage four",
    heading: "We don't hand off.\nAnd disappear.",
    body: "Post-launch performance audit, SEO tuning, and analytics setup. The work isn't done when the site goes live — it's done when it performs.",
    accent: "#FFEDD7",
    bg: "#140E09",
  },
];
---

<section
  id="why2"
  aria-label="The Straya offer"
  class="relative"
  data-why2-root
>
  <p class="sr-only">
    The Straya Method: four stages — Discovery (map objectives and technical fit), Architecture (lock platform and CMS strategy), Engineering (sprint-based production-grade builds), Optimisation (post-launch performance and SEO).
  </p>

  <!-- Sticky viewport — GSAP pins this -->
  <div class="why2-sticky" data-why2-sticky>

    <!-- Track — slides horizontally -->
    <div class="why2-track" data-why2-track>
      {offers.map((offer, i) => (
        <div
          class="why2-panel"
          data-panel={i}
          style={`--panel-accent: ${offer.accent}; --panel-bg: ${offer.bg};`}
        >
          <!-- M0 Background layer (depth 0.6) -->
          <div class="why2-bg" style={`--depth: 0.6; background: ${offer.bg};`} aria-hidden="true">
            <!-- Oversized outline number — typographic device -->
            <span class="why2-bg-num" style={`color: transparent; -webkit-text-stroke: 1px ${offer.accent}12;`}>
              {offer.num}
            </span>
          </div>

          <!-- M0 Midground layer (depth 1) — main content -->
          <div class="why2-mid" style="--depth: 1;">

            <!-- Eyebrow row: label + rule + stage name -->
            <div class="why2-eyebrow-row" data-mid-el style={`--el-i: 0;`}>
              <span class="why2-label" style={`color: ${offer.accent};`}>
                [{offer.num}] / {offer.label}
              </span>
              <div class="why2-rule" style={`background: ${offer.accent};`} aria-hidden="true"></div>
              <span class="why2-stage-name" style={`color: ${offer.accent};`}>{offer.stat}</span>
            </div>

            <!-- Content row: heading left, body right -->
            <div class="why2-content-row">
              <h3 class="why2-heading" data-mid-el style={`--el-i: 1;`} aria-label={offer.heading.replace('\n', ' ')}>
                {offer.heading.split('\n').map((line, li) => (
                  <span class="why2-heading-line">
                    {line.split(' ').map((word, wi) => (
                      <span
                        class="why2-word"
                        style={`--wi: ${li * 4 + wi};`}
                        aria-hidden="true"
                      >{word}{wi < line.split(' ').length - 1 ? '\u00a0' : ''}</span>
                    ))}
                    </span>
                ))}
              </h3>

              <div class="why2-body-col">
                <p class="why2-body" data-mid-el style={`--el-i: 2;`}>
                  {offer.body}
                </p>

                {i === offers.length - 1 && (
                  <div class="why2-cta" data-mid-el style="--el-i: 3;">
                    <Button
                      href="/contact"
                      label="Start a project"
                      variant="hero-pill"
                    />
                  </div>
                )}
              </div>
            </div>

          </div>


        </div>
      ))}
    </div>

    <!-- Progress bar -->
    <div class="why2-progress-track" aria-hidden="true">
      <div class="why2-progress-fill" data-why2-progress></div>
    </div>

    <!-- Panel dots -->
    <div class="why2-dots" aria-hidden="true">
      {offers.map((_, i) => (
        <button class="why2-dot" data-dot={i} tabindex="-1" aria-hidden="true"></button>
      ))}
    </div>

  </div>


</section>

<style>
  /* PERMITTED: CSS variable depth system, @keyframes, perspective transforms */

  /* ── Section ──────────────────────────────────────────────── */
  [data-why2-root] {
    background: #080605;
  }

  /* ── Sticky container ─────────────────────────────────────── */
  .why2-sticky {
    position: relative;
    z-index: 10;
    height: 100vh;
    overflow: hidden;
  }
  /* ── Horizontal track ─────────────────────────────────────── */
  .why2-track {
    display: flex;
    height: 100%;
    will-change: transform;
  }

  /* ── Panel ────────────────────────────────────────────────── */
  .why2-panel {
    position: relative;
    flex: 0 0 100vw;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    /* M12 perspective */
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  /* ── M0 Background layer ──────────────────────────────────── */
  .why2-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    will-change: transform;
  }

  .why2-bg-num {
    font-family: var(--font-display, 'Bricolage Grotesque', sans-serif);
    font-weight: 900;
    font-size: clamp(20rem, 40vw, 50rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    user-select: none;
    pointer-events: none;
    padding-right: 2vw;
    will-change: transform;
  }

  /* ── M0 Midground layer ───────────────────────────────────── */
  .why2-mid {
    position: relative;
    z-index: 1;
    padding: 0 8vw;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    will-change: transform;
  }

  /* ── Eyebrow row ──────────────────────────────────────────── */
  .why2-eyebrow-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    opacity: 0;
    transform: translateY(16px);
    filter: blur(6px);
  }

  .why2-label {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: clamp(0.694rem, 0.66rem + 0.17vw, 0.79rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .why2-rule {
    flex: 1;
    height: 1px;
    opacity: 0.25;
  }

  .why2-stage-name {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: clamp(0.694rem, 0.66rem + 0.17vw, 0.79rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── Content row ──────────────────────────────────────────── */
  .why2-content-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 6vw;
  }

  /* ── Body col ─────────────────────────────────────────────── */
  .why2-body-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 0.5rem;
  }

  /* ── Heading ──────────────────────────────────────────────── */
  .why2-heading {
    font-family: var(--font-display, 'Bricolage Grotesque', sans-serif);
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #FFEDD7;
    margin: 0;
  }
  .why2-heading-line { display: block; }
  .why2-word {
    display: inline-block;
    opacity: 0;
    filter: blur(16px);
    transform: translateY(20px);
  }

  /* ── Body ─────────────────────────────────────────────────── */
  .why2-body {
    font-family: var(--font-body, 'Instrument Sans', sans-serif);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.6;
    color: rgba(225,224,204,0.55);
    max-width: 44ch;
    margin: 0;
    opacity: 0;
    transform: translateY(16px);
    filter: blur(4px);
  }

  /* ── M0 Foreground layer ──────────────────────────────────── */
  .why2-fg {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem 8vw;
    gap: 1rem;
    will-change: transform;
  }

  .why2-accent-line {
    width: 0;
    height: 2px;
    transition: width 600ms cubic-bezier(0.16,1,0.3,1);
  }
  .why2-panel.is-active .why2-accent-line {
    width: 4rem;
  }

  .why2-panel-counter {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: clamp(0.694rem, 0.66rem + 0.17vw, 0.79rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ── Progress bar ─────────────────────────────────────────── */
  .why2-progress-track {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(225,224,204,0.08);
    z-index: 10;
  }
  .why2-progress-fill {
    height: 100%;
    background: var(--color-accent, #DC5000);
    width: 0%;
    transition: width 60ms linear;
  }

  /* ── Panel dots ───────────────────────────────────────────── */
  .why2-dots {
    position: absolute;
    bottom: 2rem;
    right: 8vw;
    display: flex;
    gap: 0.5rem;
    z-index: 10;
  }
  .why2-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(225,224,204,0.2);
    border: none;
    cursor: pointer;
    transition: background 300ms ease, transform 300ms ease;
    padding: 0;
  }
  .why2-dot.is-active {
    background: var(--color-accent, #DC5000);
    transform: scale(1.4);
  }

  /* ── CTA inside panel 4 ──────────────────────────────────── */
  .why2-cta {
    opacity: 0;
    transform: translateY(16px);
    filter: blur(8px);
    overflow: visible;
  }

  /* ── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .why2-word,
    .why2-eyebrow-row,
    .why2-body,
    .why2-cta {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
      transition: none !important;
    }
    .why2-accent-line { transition: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const initWhy2 = () => {
    const root    = document.querySelector<HTMLElement>('[data-why2-root]');
    const sticky  = root?.querySelector<HTMLElement>('[data-why2-sticky]');
    const track   = root?.querySelector<HTMLElement>('[data-why2-track]');
    const panels  = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-panel]')) : [];
    const progress= root?.querySelector<HTMLElement>('[data-why2-progress]');
    const dots    = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-dot]')) : [];

    if (!root || !sticky || !track || !panels.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const panelCount = panels.length;

    // ── Reveal all content immediately if reduced motion ────────
    if (reduced) {
      panels.forEach(panel => {
        panel.querySelectorAll<HTMLElement>('.why2-word, .why2-eyebrow-row, .why2-body, .why2-cta').forEach(el => {
          el.style.opacity = '1';
          el.style.filter = 'none';
          el.style.transform = 'none';
        });
        panel.classList.add('is-active');
      });
      return;
    }

    // Track which panels have been revealed
    const revealed = new Set<number>();

    const revealPanel = (idx: number) => {
      if (revealed.has(idx)) return;
      revealed.add(idx);
      const panel = panels[idx];
      if (!panel) return;

      const eyebrow = panel.querySelector<HTMLElement>('.why2-eyebrow-row');
      const words   = Array.from(panel.querySelectorAll<HTMLElement>('.why2-word'));
      const body    = panel.querySelector<HTMLElement>('.why2-body');
      const cta     = panel.querySelector<HTMLElement>('.why2-cta');

      const tl = gsap.timeline();
      if (eyebrow)      tl.to(eyebrow, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.5, ease: 'power2.out' }, 0);
      if (words.length) tl.to(words,   { opacity: 1, y: 0, filter: 'blur(0px)', stagger: 0.04, duration: 0.5, ease: 'power2.out' }, 0.15);
      if (body)         tl.to(body,    { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.5, ease: 'power2.out' }, 0.4);
      if (cta)          tl.to(cta,     { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.5, ease: 'power2.out' }, 0.6);
    };

    // Reveal first panel immediately
    revealPanel(0);

    // ── GSAP horizontal scroll pin ──────────────────────────────
    ScrollTrigger.create({
      trigger: root,
      start: 'top top',
      end: `+=${panelCount * 100}%`,
      pin: sticky,
      anticipatePin: 1,
      scrub: 0.6,
      onUpdate: (self) => {
        // Progress bar
        if (progress) progress.style.width = `${self.progress * 100}%`;

        // Active panel index
        const rawIdx   = self.progress * (panelCount - 1);
        const activeIdx = Math.round(rawIdx);

        dots.forEach((dot, i)   => dot.classList.toggle('is-active', i === activeIdx));
        panels.forEach((panel, i) => panel.classList.toggle('is-active', i === activeIdx));

        // Slide track
        gsap.set(track, { x: `-${rawIdx * 100}vw` });

        // Reveal panel when it becomes active
        revealPanel(activeIdx);

        // M0 background parallax — bg num drifts opposite to scroll
        panels.forEach((panel, i) => {
          const bgNum = panel.querySelector<HTMLElement>('.why2-bg-num');
          if (!bgNum) return;
          const offset = (rawIdx - i) * -6; // ±6vw drift
          gsap.set(bgNum, { x: `${offset}vw` });
        });
      },
    });

    // ── M12 Perspective cursor tilt ────────────────────────────
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      panels.forEach(panel => {
        const mid = panel.querySelector<HTMLElement>('.why2-mid');
        if (!mid) return;

        panel.addEventListener('mousemove', (e: MouseEvent) => {
          const r  = panel.getBoundingClientRect();
          const cx = r.left + r.width  / 2;
          const cy = r.top  + r.height / 2;
          const rx = ((e.clientY - cy) / (r.height / 2)) * -4;
          const ry = ((e.clientX - cx) / (r.width  / 2)) *  4;
          mid.style.transform = `perspective(1200px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
          mid.style.transition = 'transform 80ms linear';
        });

        panel.addEventListener('mouseleave', () => {
          mid.style.transform = '';
          mid.style.transition = 'transform 600ms cubic-bezier(0.16,1,0.3,1)';
        });
      });
    }
  };

  initWhy2();
  document.addEventListener('astro:after-swap', () => {
    ScrollTrigger.killAll();
    initWhy2();
  });
</script>
