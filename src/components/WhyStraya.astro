---
// WhyStraya.astro — Straya Studio [IMMERSIVE]
// Bento grid with platform-faithful UI mockups (Framer, Webflow, Shopify).
// GEMINI §3: scroll-linked entrance, unique interactive moment per card.
// GEMINI §5: light mode tokens, no bold fonts, 0px radius.
import Button from "./ui/buttons/Button.astro";
const baseUrl = import.meta.env.BASE_URL;
---

<section
  id="why"
  aria-label="The Straya offer"
  class="section-y relative bg-background border-b border-black/5 overflow-hidden"
>
  <div class="main-container">

    <!-- Header -->
    <header class="mb-14 flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-black/5 pb-8">
      <div>
        <span class="ws-el type-label text-on-background/40 block mb-3" data-delay="0">The Straya offer</span>
        <h2 class="type-h2 text-on-background max-w-lg">
          <span class="ws-line block overflow-hidden"><span class="ws-el inline-block" data-delay="80">Engineered for founders</span></span>
          <span class="ws-line block overflow-hidden"><span class="ws-el inline-block" data-delay="140">who ship fast.</span></span>
        </h2>
      </div>
      <a
        href="#pricing"
        class="ws-el magnetic-cta z-depth-1 inline-flex items-center gap-3 type-button text-on-background border-b border-on-background/20 pb-px hover:border-on-background transition-colors duration-300 flex-shrink-0"
        data-delay="240"
      >
        Start a project
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </header>

    <!-- Bento grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-px bg-black/5">
      <p class="sr-only">
        The Straya offer covers five key advantages: launch-ready delivery in days not months, pixel-perfect builds hand-checked across all breakpoints, 90+ Lighthouse performance scores, direct communication with the founder throughout the project, and full ownership of all deliverables with no lock-in.
      </p>

      <!-- Card 1: Speed — Framer canvas mockup (wide) -->
      <article
        class="why-card md:col-span-7 bg-background flex flex-col overflow-hidden group"
        aria-label="Launch-ready in days, not months"
      >
        <!-- Mockup: Framer canvas -->
        <div class="why-mockup flex-1 relative overflow-hidden bg-surface-container-low border-b border-black/5 min-h-[220px]">
          <!-- Framer-style toolbar -->
          <div class="absolute top-0 inset-x-0 flex items-center justify-between px-3 py-2 bg-surface-container-lowest border-b border-black/5 z-10">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-black/10"></div>
              <span class="text-[9px] font-medium tracking-wide text-on-background/30 uppercase">Framer</span>
            </div>
            <div class="flex items-center gap-1.5">
              <div class="px-2 py-0.5 bg-accent/10 border border-accent/20 text-[8px] text-accent font-medium tracking-wide">Preview</div>
              <div class="px-2 py-0.5 bg-primary text-on-primary text-[8px] font-medium tracking-wide">Publish</div>
            </div>
          </div>
          <!-- Canvas area -->
          <div class="absolute inset-0 pt-8 flex items-center justify-center">
            <!-- Grid dots -->
            <div class="absolute inset-0 framer-grid opacity-30" aria-hidden="true"></div>
            <!-- Animated frame being built -->
            <div class="relative w-48 h-28">
              <div class="framer-frame absolute inset-0 border border-accent/40 bg-surface-container-lowest shadow-sm">
                <!-- Simulated component blocks -->
                <div class="framer-block absolute top-3 left-3 right-3 h-3 bg-black/8 framer-anim" style="animation-delay:0ms"></div>
                <div class="framer-block absolute top-9 left-3 w-16 h-2 bg-black/5 framer-anim" style="animation-delay:120ms"></div>
                <div class="framer-block absolute top-9 right-3 w-10 h-2 bg-accent/20 framer-anim" style="animation-delay:240ms"></div>
                <div class="framer-block absolute bottom-3 left-3 w-20 h-5 bg-primary framer-anim" style="animation-delay:360ms"></div>
              </div>
              <!-- Selection handles -->
              <div class="framer-handle absolute -top-1 -left-1 w-2 h-2 bg-white border border-accent shadow-sm framer-anim" style="animation-delay:480ms"></div>
              <div class="framer-handle absolute -top-1 -right-1 w-2 h-2 bg-white border border-accent shadow-sm framer-anim" style="animation-delay:480ms"></div>
              <div class="framer-handle absolute -bottom-1 -left-1 w-2 h-2 bg-white border border-accent shadow-sm framer-anim" style="animation-delay:480ms"></div>
              <div class="framer-handle absolute -bottom-1 -right-1 w-2 h-2 bg-white border border-accent shadow-sm framer-anim" style="animation-delay:480ms"></div>
              <!-- Tooltip -->
              <div class="framer-tooltip absolute -top-7 left-0 px-2 py-1 bg-primary text-on-primary text-[8px] whitespace-nowrap framer-anim" style="animation-delay:600ms">
                Hero Section · 768 × 480
              </div>
            </div>
          </div>
          <!-- Left panel: layers -->
          <div class="absolute left-0 top-8 bottom-0 w-24 bg-surface-container-lowest border-r border-black/5 p-2 flex flex-col gap-1">
            {["Page", "Hero", "Navbar", "CTA", "Footer"].map((layer, i) => (
              <div
                class="flex items-center gap-1.5 px-1.5 py-1 text-[8px] text-on-background/40 framer-layer"
                style={`animation-delay: ${i * 80}ms`}
              >
                <div class="w-1.5 h-1.5 border border-black/20 flex-shrink-0"></div>
                {layer}
              </div>
            ))}
          </div>
        </div>
        <!-- Text -->
        <div class="p-8 flex flex-col gap-3">
          <h3 class="type-h3 text-on-background">Launch-ready in days, not months</h3>
          <p class="type-body-small text-on-surface-variant leading-relaxed">We move fast without cutting corners. Most projects go from kickoff to live deployment within 2–4 weeks.</p>
        </div>
      </article>

      <!-- Card 2: Quality — Webflow designer mockup (narrow) -->
      <article
        class="why-card md:col-span-5 bg-background flex flex-col overflow-hidden group"
        aria-label="Pixel-perfect, every time"
      >
        <!-- Mockup: Webflow designer -->
        <div class="why-mockup flex-1 relative overflow-hidden bg-surface-container-low border-b border-black/5 min-h-[220px]">
          <!-- Webflow toolbar -->
          <div class="absolute top-0 inset-x-0 flex items-center gap-2 px-3 py-2 bg-surface-container-lowest border-b border-black/5 z-10">
            <div class="w-2 h-2 rounded-full bg-[#146EF5]/60"></div>
            <span class="text-[9px] font-medium tracking-wide text-on-background/30 uppercase">Webflow</span>
            <div class="ml-auto flex gap-1">
              {["D", "T", "M"].map((bp, i) => (
                <div class={`px-1.5 py-0.5 text-[8px] font-medium border ${i === 0 ? 'bg-primary text-on-primary border-primary' : 'border-black/10 text-on-background/30'}`}>{bp}</div>
              ))}
            </div>
          </div>
          <!-- Style panel right -->
          <div class="absolute right-0 top-8 bottom-0 w-28 bg-surface-container-lowest border-l border-black/5 p-2 flex flex-col gap-2">
            <div class="text-[8px] text-on-background/30 font-medium uppercase tracking-wide mb-1">Style</div>
            {[
              { label: "Width", val: "100%" },
              { label: "Height", val: "auto" },
              { label: "Padding", val: "48px" },
              { label: "Font", val: "PP Mori" },
            ].map((prop, i) => (
              <div class="flex justify-between items-center webflow-prop" style={`animation-delay: ${i * 100}ms`}>
                <span class="text-[8px] text-on-background/30">{prop.label}</span>
                <span class="text-[8px] text-on-background/60 bg-surface-container px-1 py-0.5">{prop.val}</span>
              </div>
            ))}
            <!-- Colour swatch -->
            <div class="mt-1 flex items-center gap-1.5">
              <div class="w-4 h-4 border border-black/10 bg-primary flex-shrink-0"></div>
              <span class="text-[8px] text-on-background/40">#000000</span>
            </div>
          </div>
          <!-- Canvas -->
          <div class="absolute inset-0 top-8 right-28 flex items-center justify-center p-4">
            <div class="w-full max-w-[140px] flex flex-col gap-2">
              <div class="webflow-el h-4 bg-black/8 w-3/4"></div>
              <div class="webflow-el h-2 bg-black/5 w-full" style="animation-delay:80ms"></div>
              <div class="webflow-el h-2 bg-black/5 w-5/6" style="animation-delay:160ms"></div>
              <div class="webflow-el h-7 bg-primary w-1/2 mt-1" style="animation-delay:240ms"></div>
            </div>
          </div>
        </div>
        <div class="p-8 flex flex-col gap-3">
          <h3 class="type-h3 text-on-background">Pixel-perfect, every time</h3>
          <p class="type-body-small text-on-surface-variant leading-relaxed">Every build is hand-checked across breakpoints.</p>
        </div>
      </article>

      <!-- Card 3: Performance — Lighthouse scores (full width) -->
      <article
        class="why-card md:col-span-12 bg-background flex flex-col md:flex-row overflow-hidden group"
        aria-label="Built for performance and scale"
      >
        <!-- Mockup: Lighthouse report -->
        <div class="why-mockup relative overflow-hidden bg-surface-container-low border-b md:border-b-0 md:border-r border-black/5 min-h-[200px] md:w-1/2">
          <div class="absolute top-0 inset-x-0 flex items-center gap-2 px-3 py-2 bg-surface-container-lowest border-b border-black/5 z-10">
            <div class="w-2 h-2 rounded-full bg-[#F4B400]/60"></div>
            <span class="text-[9px] font-medium tracking-wide text-on-background/30 uppercase">Lighthouse Report</span>
          </div>
          <div class="absolute inset-0 top-8 flex items-center justify-center gap-6 px-6">
            {[
              { label: "Performance", score: 99, color: "#3CCD7F" },
              { label: "Accessibility", score: 100, color: "#3CCD7F" },
              { label: "Best Practices", score: 100, color: "#3CCD7F" },
              { label: "SEO", score: 100, color: "#3CCD7F" },
            ].map((metric, i) => (
              <div class="flex flex-col items-center gap-2 lighthouse-score" style={`animation-delay: ${i * 150}ms`}>
                <div class="relative w-12 h-12">
                  <svg class="w-full h-full -rotate-90" viewBox="0 0 36 36" aria-hidden="true">
                    <circle cx="18" cy="18" r="15.9" fill="none" stroke="rgba(0,0,0,0.06)" stroke-width="2.5"/>
                    <circle
                      cx="18" cy="18" r="15.9" fill="none"
                      stroke={metric.color} stroke-width="2.5"
                      stroke-linecap="round"
                      class="lighthouse-ring"
                      data-score={metric.score}
                      style={`animation-delay: ${i * 150 + 200}ms`}
                    />
                  </svg>
                  <span class="absolute inset-0 flex items-center justify-center text-[11px] font-medium text-on-background">{metric.score}</span>
                </div>
                <span class="text-[7.5px] text-on-background/40 text-center leading-tight whitespace-nowrap">{metric.label}</span>
              </div>
            ))}
          </div>
        </div>
        <!-- Text -->
        <div class="p-8 md:w-1/2 flex flex-col justify-center gap-3">
          <h3 class="type-h3 text-on-background">Built for performance and scale</h3>
          <p class="type-body-small text-on-surface-variant leading-relaxed">Sub-second loads, 90+ Lighthouse scores, and infrastructure that handles traffic spikes without breaking.</p>
          <div class="flex gap-4 mt-2">
            {[["< 1s", "FCP"], ["≤ 0.05", "CLS"], ["< 150ms", "TBT"]].map(([val, label]) => (
              <div>
                <div class="type-h4 text-on-background">{val}</div>
                <div class="type-label text-on-background/30">{label}</div>
              </div>
            ))}
          </div>
        </div>
      </article>

      <!-- Card 4: Communication — Slack-style thread (narrow) -->
      <article
        class="why-card md:col-span-5 bg-background flex flex-col overflow-hidden group"
        aria-label="Direct line to the engineers"
      >
        <div class="why-mockup flex-1 relative overflow-hidden bg-surface-container-low border-b border-black/5 min-h-[200px]">
          <div class="absolute top-0 inset-x-0 flex items-center gap-2 px-3 py-2 bg-surface-container-lowest border-b border-black/5 z-10">
            <div class="w-2 h-2 rounded-full bg-[#4A154B]/40"></div>
            <span class="text-[9px] font-medium tracking-wide text-on-background/30 uppercase"># straya-project</span>
          </div>
          <div class="absolute inset-0 top-8 flex flex-col gap-2 p-3 overflow-hidden">
            {[
              { from: "Salman", msg: "Hero section is live — check preview link", time: "9:41 AM", self: false },
              { from: "You", msg: "Looks great! Can we adjust the CTA colour?", time: "9:43 AM", self: true },
              { from: "Salman", msg: "Done — pushed to staging ✓", time: "9:44 AM", self: false },
            ].map((msg, i) => (
              <div
                class={`flex flex-col gap-0.5 chat-msg ${msg.self ? 'items-end' : 'items-start'}`}
                style={`animation-delay: ${i * 300}ms`}
              >
                <span class="text-[8px] text-on-background/30 px-1">{msg.from} · {msg.time}</span>
                <div class={`px-2.5 py-1.5 max-w-[80%] text-[9px] leading-relaxed ${msg.self ? 'bg-surface-container text-on-background/60' : 'bg-surface-container-lowest border border-black/5 text-on-background/70'}`}>
                  {msg.msg}
                </div>
              </div>
            ))}
            <!-- Typing indicator -->
            <div class="flex items-center gap-1 px-1 mt-1 chat-typing">
              <span class="text-[8px] text-on-background/30">Salman is typing</span>
              <div class="flex gap-0.5">
                {[0,1,2].map(i => (
                  <span class="w-1 h-1 rounded-full bg-on-background/20 typing-dot" style={`animation-delay: ${i * 150}ms`}></span>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="p-8 flex flex-col gap-3">
          <h3 class="type-h3 text-on-background">Direct line to the engineers building your platform</h3>
          <p class="type-body-small text-on-surface-variant leading-relaxed">No account managers or ticket queues. You work with the same senior engineers from discovery through launch.</p>
        </div>
      </article>

      <!-- Card 5: Ownership — Shopify admin mockup (wide) -->
      <article
        class="why-card md:col-span-7 bg-background flex flex-col overflow-hidden group"
        aria-label="Full ownership of every deliverable"
      >
        <div class="why-mockup flex-1 relative overflow-hidden bg-surface-container-low border-b border-black/5 min-h-[200px]">
          <div class="absolute top-0 inset-x-0 flex items-center gap-2 px-3 py-2 bg-surface-container-lowest border-b border-black/5 z-10">
            <div class="w-2 h-2 rounded-full bg-[#96BF48]/60"></div>
            <span class="text-[9px] font-medium tracking-wide text-on-background/30 uppercase">Shopify Admin</span>
            <div class="ml-auto text-[8px] text-accent font-medium">● Live</div>
          </div>
          <!-- Sidebar -->
          <div class="absolute left-0 top-8 bottom-0 w-20 bg-surface-container-lowest border-r border-black/5 flex flex-col gap-0.5 p-1.5">
            {["Dashboard", "Orders", "Products", "Customers", "Analytics"].map((item, i) => (
              <div
                class={`px-2 py-1 text-[8px] shopify-nav ${i === 0 ? 'bg-surface-container text-on-background/70' : 'text-on-background/30'}`}
                style={`animation-delay: ${i * 60}ms`}
              >
                {item}
              </div>
            ))}
          </div>
          <!-- Main content -->
          <div class="absolute inset-0 top-8 left-20 p-3 flex flex-col gap-2">
            <div class="grid grid-cols-3 gap-1.5">
              {[
                { label: "Revenue", val: "$12,480" },
                { label: "Orders", val: "84" },
                { label: "Conversion", val: "3.2%" },
              ].map((stat, i) => (
                <div class="bg-surface-container-lowest border border-black/5 p-2 shopify-stat" style={`animation-delay: ${i * 100}ms`}>
                  <div class="text-[8px] text-on-background/30 mb-0.5">{stat.label}</div>
                  <div class="text-[11px] font-medium text-on-background">{stat.val}</div>
                </div>
              ))}
            </div>
            <!-- Mini chart -->
            <div class="flex-1 bg-surface-container-lowest border border-black/5 p-2 flex items-end gap-0.5">
              {[30,55,40,70,60,85,75,90,65,95].map((h, i) => (
                <div
                  class="flex-1 bg-accent/20 shopify-bar"
                  style={`height: ${h}%; animation-delay: ${i * 60}ms`}
                ></div>
              ))}
            </div>
          </div>
        </div>
        <div class="p-8 flex flex-col gap-3">
          <h3 class="type-h3 text-on-background">Full ownership of every deliverable</h3>
          <p class="type-body-small text-on-surface-variant leading-relaxed">Clean, documented, optimised code on your infrastructure. No lock-in. Every asset, token and component is yours.</p>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  /* ── Header elements ───────────────────────────────────────── */
  .ws-el { opacity: 0; transform: translateY(28px); }
  .ws-line .ws-el { transform: translateY(100%); opacity: 1; }

  /* ── why-card — visible by default, no entrance animation ──── */

  /* ── Framer canvas ─────────────────────────────────────────── */
  .framer-grid {
    background-image: radial-gradient(circle, rgba(0,0,0,0.12) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  @keyframes framer-build {
    0%, 10% { opacity: 0; transform: scaleX(0.8); }
    30%, 80% { opacity: 1; transform: scaleX(1); }
    95%, 100% { opacity: 0; transform: scaleX(0.8); }
  }

  .framer-anim {
    animation: framer-build 4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .framer-layer {
    animation: framer-build 4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  /* ── Webflow designer ──────────────────────────────────────── */
  @keyframes webflow-appear {
    0%, 10% { opacity: 0; transform: translateY(4px); }
    30%, 80% { opacity: 1; transform: translateY(0); }
    95%, 100% { opacity: 0; transform: translateY(4px); }
  }

  .webflow-el, .webflow-prop {
    animation: webflow-appear 4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  /* ── Lighthouse rings ──────────────────────────────────────── */
  @keyframes ring-99 {
    0%, 15%  { stroke-dasharray: 0 100; opacity: 0; }
    50%, 85% { stroke-dasharray: 99 100; opacity: 1; }
    100%     { stroke-dasharray: 99 100; opacity: 0; }
  }
  @keyframes ring-100 {
    0%, 15%  { stroke-dasharray: 0 100; opacity: 0; }
    50%, 85% { stroke-dasharray: 100 100; opacity: 1; }
    100%     { stroke-dasharray: 100 100; opacity: 0; }
  }

  .lighthouse-ring[data-score="99"] {
    stroke-dasharray: 0 100;
    animation: ring-99 3.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .lighthouse-ring[data-score="100"] {
    stroke-dasharray: 0 100;
    animation: ring-100 3.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .lighthouse-score {
    animation: webflow-appear 3.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  /* ── Chat messages ─────────────────────────────────────────── */
  @keyframes chat-in {
    0%, 5% { opacity: 0; transform: translateY(6px); }
    20%, 75% { opacity: 1; transform: translateY(0); }
    90%, 100% { opacity: 0; transform: translateY(-4px); }
  }

  .chat-msg {
    animation: chat-in 5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.3; }
    30% { transform: translateY(-2px); opacity: 0.8; }
  }

  .typing-dot {
    animation: typing-bounce 1.2s ease infinite;
  }

  .chat-typing {
    animation: chat-in 5s 1.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  /* ── Shopify bars ──────────────────────────────────────────── */
  @keyframes bar-rise {
    0%, 10% { transform: scaleY(0); opacity: 0; }
    35%, 80% { transform: scaleY(1); opacity: 1; }
    95%, 100% { transform: scaleY(0); opacity: 0; }
  }

  .shopify-bar {
    transform-origin: bottom;
    animation: bar-rise 4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .shopify-stat, .shopify-nav {
    animation: webflow-appear 4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .framer-anim, .framer-layer,
    .webflow-el, .webflow-prop,
    .lighthouse-ring, .lighthouse-score,
    .chat-msg, .chat-typing, .typing-dot,
    .shopify-bar, .shopify-stat, .shopify-nav {
      animation: none !important;
      opacity: 1;
    }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 900;
  const MARGIN   = '0px 0px -80px 0px';

  // ── Header entrance ─────────────────────────────────────────
  const headerEls = document.querySelectorAll<HTMLElement>('#why .ws-el');
  const headerObs = new IntersectionObserver(entries => {
    if (!entries[0].isIntersecting) return;
    headerEls.forEach(el => {
      const delay  = parseInt(el.dataset.delay ?? '0');
      const isLine = el.closest('.ws-line') !== null;
      el.animate(
        isLine
          ? [{ transform: 'translateY(100%)' }, { transform: 'translateY(0%)' }]
          : [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
        { duration: DURATION, delay, easing: EASE, fill: 'forwards' }
      );
    });
    headerObs.disconnect();
  }, { rootMargin: MARGIN, threshold: 0 });
  const whySection = document.getElementById('why');
  if (whySection) headerObs.observe(whySection);

  // why-card entrance animation removed — cards visible by default
</script>
