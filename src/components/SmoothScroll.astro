---
/**
 * SmoothScroll.astro — Lenis smooth scroll, site-wide.
 * Natural feel: moderate lerp, no over-dampening.
 * Disabled on reduced-motion preference.
 * RAF loop integrates with Lenis's own ticker for correct timing.
 */
---

<script>
  /* ~4.2KB gz — Lenis smooth scroll + hash-link interception */
  import Lenis from "lenis";

  // Wrap in object to keep the reference mutable without fighting Lenis's Window type augmentation
  const state: { lenis: ReturnType<typeof createLenis> | null; raf: number } = { lenis: null, raf: 0 };

  function createLenis() {
    return new Lenis({
      duration: 1.15,
      easing: (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      wheelMultiplier: 0.9,
      touchMultiplier: 1.8,
      infinite: false,
      autoRaf: false,
    });
  }

  function destroy() {
    if (state.lenis) { state.lenis.destroy(); state.lenis = null; }
    cancelAnimationFrame(state.raf);
    state.raf = 0;
  }

  const handleHashClick = (e: MouseEvent) => {
    const anchor = (e.target as Element).closest<HTMLAnchorElement>("a[href]");
    if (!anchor) return;
    const href = anchor.getAttribute("href") ?? "";
    const url = new URL(href, window.location.href);
    const isSamePage = url.pathname === window.location.pathname || url.pathname === "/";
    if (!url.hash || !isSamePage) return;
    const target = document.querySelector(url.hash);
    if (!target) return;
    e.preventDefault();
    state.lenis?.scrollTo(target as HTMLElement, {
      offset: 0,
      duration: 1.4,
      easing: (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t)),
    });
  };

  const init = () => {
    destroy();
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    state.lenis = createLenis();

    const tick = (time: number) => {
      state.lenis!.raf(time);
      state.raf = requestAnimationFrame(tick);
    };
    state.raf = requestAnimationFrame(tick);

    document.addEventListener("click", handleHashClick);
  };

  init();
  document.addEventListener("astro:after-swap", init);
  document.addEventListener("astro:before-swap", () => {
    destroy();
    document.removeEventListener("click", handleHashClick);
  });
</script>
