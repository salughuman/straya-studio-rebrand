---
/**
 * words-pull-up.astro
 * Blur-to-clear word-by-word reveal, scroll-progress coupled.
 * micro-interactions.md §8.3 — stagger by word, never by line.
 * Each word: blur(20px) + opacity(0) + translateY(16px) → clear.
 * One-time IntersectionObserver entry trigger (headings only, per §8.3).
 */

interface Segment {
  text: string;
  className?: string;
}

interface Props {
  text?: string;
  segments?: Segment[];
  class?: string;
  className?: string;
  showAsterisk?: boolean;
  delay?: number;
  centered?: boolean;
  spectral?: boolean;
}

const {
  text = "",
  segments = [],
  class: classProp = "",
  className = "",
  showAsterisk = false,
  delay = 0,
  centered = false,
  spectral = false,
} = Astro.props as Props;

const words =
  segments.length > 0
    ? segments.flatMap((segment) =>
        segment.text
          .split(" ")
          .filter(Boolean)
          .map((word) => ({ word, className: segment.className ?? "" })),
      )
    : text
        .split(" ")
        .filter(Boolean)
        .map((word) => ({ word, className: "" }));

const wrapperClass = [
  "inline-flex flex-wrap",
  centered ? "justify-center" : "",
  spectral ? "words-pull-up--spectral" : "",
  classProp,
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div
  class={wrapperClass}
  data-words-pull-up
  data-delay={String(delay)}
>
  {
    words.map((entry, i) => {
      const isLast = i === words.length - 1;
      return (
        <span
          class={`wpu-word inline-block relative ${entry.className}`.trim()}
          style={[
            isLast ? "" : "margin-right:0.25em",
            `--i:${i}`,
          ].filter(Boolean).join(";")}
          data-word
          aria-hidden="false"
        >
          {entry.word}
          {showAsterisk && isLast && (
            <span class="absolute top-[0.65em] -right-[0.3em] text-[0.31em] drop-shadow-[0_0_14px_rgba(244,114,182,0.85)]">
              *
            </span>
          )}
        </span>
      );
    })
  }
</div>

<style>
  /* PERMITTED: CSS variable arithmetic (--i stagger) has no Tailwind equivalent */
  .wpu-word {
    opacity: 0;
    filter: blur(20px);
    transform: translateY(16px);
    transition:
      opacity    700ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 60ms),
      filter     700ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 60ms),
      transform  700ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 60ms);
    will-change: opacity, filter, transform;
  }

  [data-words-pull-up].is-revealed .wpu-word {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .wpu-word {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const initWordsPullUp = () => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-words-pull-up]').forEach(container => {
      if (container.dataset.wpuReady === 'true') return;
      container.dataset.wpuReady = 'true';

      if (reduced) {
        container.classList.add('is-revealed');
        return;
      }

      // One-time entry trigger for headings (micro-interactions.md §8.3)
      const obs = new IntersectionObserver(entries => {
        if (!entries[0].isIntersecting) return;
        const extraDelay = Number(container.dataset.delay || 0);
        if (extraDelay > 0) {
          setTimeout(() => container.classList.add('is-revealed'), extraDelay);
        } else {
          container.classList.add('is-revealed');
        }
        obs.disconnect();
      }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });

      obs.observe(container);
    });
  };

  initWordsPullUp();
  document.addEventListener('astro:after-swap', initWordsPullUp);
</script>
