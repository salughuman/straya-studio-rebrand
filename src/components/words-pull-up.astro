---
/**
 * words-pull-up.astro
 * Blur-to-clear word-by-word reveal, scroll-progress coupled.
 * micro-interactions.md §8.3 — stagger by word, never by line.
 * Each word: blur(20px) + opacity(0) + translateY(16px) → clear.
 * One-time IntersectionObserver entry trigger (headings only, per §8.3).
 */

interface Segment {
  text: string;
  className?: string;
}

interface Props {
  text?: string;
  segments?: Segment[];
  class?: string;
  className?: string;
  showAsterisk?: boolean;
  delay?: number;
  centered?: boolean;
  spectral?: boolean;
}

const {
  text = "",
  segments = [],
  class: classProp = "",
  className = "",
  showAsterisk = false,
  delay = 0,
  centered = false,
  spectral = false,
} = Astro.props as Props;

const words =
  segments.length > 0
    ? segments.flatMap((segment) =>
        segment.text
          .split(" ")
          .filter(Boolean)
          .map((word) => ({ word, className: segment.className ?? "" })),
      )
    : text
        .split(" ")
        .filter(Boolean)
        .map((word) => ({ word, className: "" }));

const wrapperClass = [
  "inline-flex flex-wrap",
  centered ? "justify-center" : "",
  spectral ? "words-pull-up--spectral" : "",
  classProp,
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div
  class={wrapperClass}
  data-words-pull-up
  data-delay={String(delay)}
>
  {
    words.map((entry, i) => {
      const isLast = i === words.length - 1;
      return (
        <span
          class={`wpu-word inline-block relative ${entry.className}`.trim()}
          style={[
            isLast ? "" : "margin-right:0.25em",
            `--i:${i}`,
          ].filter(Boolean).join(";")}
          data-word
          aria-hidden="false"
        >
          {entry.word}
          {showAsterisk && isLast && (
            <span class="absolute top-[0.65em] -right-[0.3em] text-[0.31em] drop-shadow-[0_0_14px_rgba(244,114,182,0.85)]">
              *
            </span>
          )}
        </span>
      );
    })
  }
</div>

<style>
  /* PERMITTED: initial hidden state — scroll engine drives reveals, not transitions */
  .wpu-word {
    opacity: 0;
    filter: blur(20px);
    transform: translateY(16px);
    will-change: opacity, filter, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .wpu-word {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  // micro-interactions.md §2.5, §3, M10
  // Scroll-driven reveal: all motion tied to scroll position, reversible, scrub-coupled.
  // No IntersectionObserver triggers — progress is computed every rAF from getBoundingClientRect.

  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

  let rafId = 0;

  const tick = () => {
    const vh = window.innerHeight;
    document.querySelectorAll<HTMLElement>('[data-words-pull-up]').forEach(container => {
      const rect = container.getBoundingClientRect();
      // p=0 when element is below fold, p=1 when well in view.
      // +0.2 offset ensures above-fold elements start at p=1 immediately.
      const p = clamp01((vh * 1.2 - rect.top) / (vh * 0.8));

      container.querySelectorAll<HTMLElement>('[data-word]').forEach((word, i) => {
        // M10 stagger: pItem = clamp01(p - index * 0.08)
        const wp = clamp01(p - i * 0.08);
        word.style.opacity      = String(wp);
        word.style.filter       = wp >= 1 ? '' : `blur(${((1 - wp) * 20).toFixed(1)}px)`;
        word.style.transform    = wp >= 1 ? '' : `translateY(${((1 - wp) * 16).toFixed(1)}px)`;
      });
    });

    rafId = requestAnimationFrame(tick);
  };

  const initWordsPullUp = () => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      document.querySelectorAll<HTMLElement>('[data-word]').forEach(w => {
        w.style.opacity = '1';
        w.style.filter = 'none';
        w.style.transform = 'none';
      });
      return;
    }

    if (rafId) cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(tick);
  };

  initWordsPullUp();
  document.addEventListener('astro:after-swap', initWordsPullUp);
</script>
