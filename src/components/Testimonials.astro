---
// Testimonials.astro — Straya Studio
// Utility-first masonry testimonial section (GEMINI §5/§6)
import Button from "./ui/buttons/Button.astro";

interface Testimonial {
  quote: string;
  name: string;
  gender: "male" | "female";
  country: string;
  role?: string;
  company?: string;
  featured?: boolean;
  video?: string;
  stars?: number;
  // Optional explicit avatar override. If omitted, we default to:
  // `/images/testimonials/${toSlug(name)}.webp`
  avatar?: string;
}

const testimonials: Testimonial[] = [
  {
    quote:
      "Salman helped develop my Framer website, building complex animations and ensuring flawless functionality. He's a hard worker with a strong problem-solving mindset and great flexibility. Goes above and beyond to deliver quality results. Check out his excellent work at www.likeahuman.ai. Would definitely work with him again!",
    name: "Stefan Luttik",
    gender: "male",
    country: "",
    role: "",
    company: "Like a Human",
    stars: 5,
  },
  {
    quote:
      "I greatly appreciated this collaboration: attentiveness, availability, and professionalism were evident at every stage. The work was carried out with seriousness and care, while remaining simple and pleasant. The final result perfectly meets my expectations, and I highly recommend it.",
    name: "Elliot Wilson",
    gender: "male",
    country: "",
    role: "",
    company: "",
    stars: 5,
  },
  {
    quote:
      "I've worked with Salman on several website projects using Framer, and the experience has been consistently excellent. The results have exceeded expectations, and communication throughout each project has been clear, timely, and professional. I highly recommend Salman for any web design or development work; especially if you're looking for high-quality results and a smooth collaboration.",
    name: "Hector Alvarez",
    gender: "male",
    country: "",
    role: "",
    company: "All Around Express Solutions",
    stars: 5,
  },
  {
    quote:
      "He is very professional. Responds immediately and always is done with his work before the deadline. He is a nice communicator, does things really professionally and is supportive to every project. I recommend him and have used his services more than 5 times already! If you're looking for someone who can help you with anything related to your Framer/Webflow project → Salman Ali is your man and not expensive compared to other developers.",
    name: "Dimitar Petrov",
    gender: "male",
    country: "",
    role: "",
    company: "",
    stars: 5,
  },
  {
    quote:
      "Salman was great to work with. He pushed the website designs to perfection. I appreciated his quick responses and willingness to meet over Zoom. I look forward to working with him again!",
    name: "Oliver Montgomery",
    gender: "male",
    country: "",
    role: "",
    company: "",
    stars: 5,
  },
  {
    quote:
      "Working with Ali was one of the best experiences I've ever had with a web developer. He has a true talent for the small details, cares about the project, and pays attention to best practices.",
    name: "Sam Sarvas",
    gender: "male",
    country: "",
    role: "",
    company: "CompleteCRO",
    stars: 5,
  },
  {
    quote:
      "Been working with Salman for a while now, never disappoints! Great work as always. Definitely a developer worth your money.",
    name: "Renez Van Autreve",
    gender: "male",
    country: "",
    role: "",
    company: "WARPCO",
    stars: 5,
  },
  {
    quote:
      "Working with Salman has been an amazing experience. He's hardworking, communicative, and always overdelivers. His web design and animations are top-notch—creative, polished, and exactly what I envisioned. Salman's positive energy makes collaboration effortless and enjoyable. I highly recommend him to anyone looking for high-quality work and a reliable partner. Looking forward to working with him again!",
    name: "Sergio Apollo",
    gender: "male",
    country: "",
    role: "CEO",
    company: "Better Match",
    stars: 5,
    featured: true,
    video: "https://youtu.be/Aq2wnh6KRz0",
  },
];

// Ensure the video testimonial is always the first item in the center column.
// This avoids the mobile layout where the "center" column was rendered second.
const videoTestimonial = testimonials.find((t) => Boolean(t.video));
const remainingTestimonials = testimonials.filter((t) => t !== videoTestimonial);

let leftColumn: Testimonial[] = [];
let centerColumn: Testimonial[] = videoTestimonial ? [videoTestimonial] : [];
let rightColumn: Testimonial[] = [];

remainingTestimonials.forEach((t, index) => {
  const mod = index % 3;
  if (mod === 0) leftColumn.push(t);
  else if (mod === 1) rightColumn.push(t);
  else centerColumn.push(t);
});

// User-requested placement: keep "Dimitar Petrov" in the third (right) column.
const dimitar = remainingTestimonials.find((t) => t.name === "Dimitar Petrov");
if (dimitar) {
  leftColumn = leftColumn.filter((t) => t.name !== "Dimitar Petrov");
  centerColumn = centerColumn.filter((t) => t.name !== "Dimitar Petrov");
  rightColumn = rightColumn.filter((t) => t.name !== "Dimitar Petrov");
  rightColumn.push(dimitar);
}

// User-requested placement: move "Sam Sarvas" into the first (left) column.
const samSarvas = remainingTestimonials.find((t) => t.name === "Sam Sarvas");
if (samSarvas) {
  leftColumn = leftColumn.filter((t) => t.name !== "Sam Sarvas");
  centerColumn = centerColumn.filter((t) => t.name !== "Sam Sarvas");
  rightColumn = rightColumn.filter((t) => t.name !== "Sam Sarvas");
  leftColumn.push(samSarvas);
}

const toSlug = (name: string) =>
  name
    .toLowerCase()
    .replace(/['’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const getAvatarSrc = (t: Testimonial) =>
  t.avatar ?? `/images/testimonials/${toSlug(t.name)}.webp`;

const getFallbackAvatarSrc = (t: Testimonial) =>
  t.gender === "female"
    ? "/images/avatars/fallback-female.svg"
    : "/images/avatars/fallback-male.svg";

const getPrimaryMeta = (t: Testimonial) =>
  [t.role, t.company].filter(Boolean).join(", ");

const getYouTubeId = (url: string) => {
  const shortMatch = url.match(/youtu\.be\/([a-zA-Z0-9_-]{6,})/);
  if (shortMatch?.[1]) return shortMatch[1];

  const watchMatch = url.match(/[?&]v=([a-zA-Z0-9_-]{6,})/);
  if (watchMatch?.[1]) return watchMatch[1];

  const embedMatch = url.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]{6,})/);
  if (embedMatch?.[1]) return embedMatch[1];

  return null;
};

const getVimeoId = (url: string) => {
  const match = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  return match?.[1] ?? null;
};

const getVideoSource = (url: string) => {
  const youtubeId = getYouTubeId(url);
  if (youtubeId) {
    return {
      type: "iframe" as const,
      src: `https://www.youtube.com/embed/${youtubeId}?rel=0`,
    };
  }

  const vimeoId = getVimeoId(url);
  if (vimeoId) {
    return {
      type: "iframe" as const,
      src: `https://player.vimeo.com/video/${vimeoId}`,
    };
  }

  return {
    type: "video" as const,
    src: url,
  };
};

const baseUrl = import.meta.env.BASE_URL;
---

