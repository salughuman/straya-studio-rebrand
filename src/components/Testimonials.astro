---
const baseUrl = import.meta.env.BASE_URL;

const featured = {
  name: "Sergio Apollo",
  role: "CEO, Better Match",
  quote:
    "From kickoff to launch, every decision felt intentional. The quality of execution and communication stayed consistent the whole way through.",
  videoSrc: `${baseUrl}videos/testimonials/sergio-apollo.webm`,
};

const escapeHtml = (input: string) =>
  input
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

const highlightQuote = (quote: string) => {
  const safe = escapeHtml(quote);
  const highlightPattern =
    /\b(professional(?:ism)?|responsive|communication|quality|recommend(?:ed)?|timelines?|delivery|helpful|patient|committed|outcome|vision)\b/gi;
  return safe.replace(highlightPattern, '<span class="t-keyword">$1</span>');
};

const preferredTestimonials = [
  {
    quote:
      "One of the best web designers and developers I have worked with. I would recommend Straya Studio to anyone serious about quality.",
    name: "Dejan Djokovic",
    role: "Founder",
    country: "Canada",
    company: "",
  },
  {
    quote:
      "Helpful from the initial brief through delivery. Timelines and feedback were always respected and the final result matched the vision.",
    name: "Luca Sartorello",
    role: "Founder",
    country: "Italy",
    company: "",
  },
  {
    quote:
      "Strong communication under pressure. Every revision sharpened the product instead of adding noise.",
    name: "Oliver Montgomery",
    role: "Founder",
    country: "United States",
    company: "Bluefin Studio",
  },
  {
    quote:
      "Patient, dependable, and committed from kickoff to launch. The process felt senior-led from day one.",
    name: "Omar Bran",
    role: "Founder",
    country: "Australia",
    company: "",
  },
];
---

<section
  id="testimonials"
  aria-labelledby="testimonials-heading"
  class="section-y t-accent-section relative overflow-hidden"
  data-mode="brutalism"
  data-testimonials-root
>
  <p class="sr-only">
    Testimonials section on an accent background with a featured founder video and an infinite
    carousel of founder quotes moving from right to left.
  </p>

  <div class="main-container relative z-10">
    <header class="mb-10 md:mb-14">
      <p
        class="m-0 type-label-small font-mono uppercase tracking-[0.08em] text-[#0A0A0A]/65"
        aria-hidden="true"
      >
        [06] / Testimonials
      </p>
      <h2
        id="testimonials-heading"
        class="m-0 mt-3 max-w-[16ch] text-[#0A0A0A]"
        style="font-size: clamp(2.2rem, 6.3vw, 5rem); font-weight: 900; line-height: 0.92; letter-spacing: -0.04em;"
      >
        Founder proof,<br />in motion.
      </h2>
    </header>

    <div class="t-stage relative">
      <figure
        class="t-featured-card relative z-20 m-0"
        aria-label={`Featured video testimonial from ${featured.name}, ${featured.role}`}
      >
        <div class="t-video-frame relative overflow-hidden bg-[#070707]">
          <video
            class="absolute inset-0 h-full w-full object-cover"
            controls
            preload="metadata"
            playsinline
            aria-label={`Video testimonial from ${featured.name}`}
            data-asset-category="portrait"
            data-asset-id="testimonial-sergio-apollo-video"
            data-placeholder="true"
            data-asset-spec="Founder video testimonial — talking head, three-quarter framing, neutral background, natural daylight, mid-conversation"
          >
            <source src={featured.videoSrc} type="video/webm" />
            Your browser does not support HTML5 video.
          </video>
          <div class="t-video-slate" aria-hidden="true"></div>
          <div class="t-video-vignette" aria-hidden="true"></div>
          <div class="t-frame-identity" aria-hidden="true">
            <p class="m-0 t-frame-name">{featured.name}</p>
            <p class="m-0 t-frame-role">{featured.role}</p>
          </div>
        </div>
      </figure>

      <div class="t-carousel-shell relative z-10" aria-hidden="true">
        <div class="t-carousel-track">
          <div class="t-carousel-group">
            {preferredTestimonials.map((item) => (
              <article class="t-card">
                <p class="m-0 t-card-quote">
                  <span set:html={`&ldquo;${highlightQuote(item.quote)}&rdquo;`}></span>
                </p>
                <footer class="t-card-meta mt-5">
                  <p class="m-0 t-card-name type-label">{item.name}</p>
                  <div class="t-card-submeta">
                    <p class="m-0 t-card-role type-label-small font-mono uppercase tracking-[0.08em]">
                      {item.company ? `${item.role}, ${item.company}` : item.role}
                    </p>
                    <p class="m-0 t-card-country type-label-small font-mono uppercase tracking-[0.08em]">
                      {item.country}
                    </p>
                  </div>
                </footer>
              </article>
            ))}
          </div>
          <div class="t-carousel-group">
            {preferredTestimonials.map((item) => (
              <article class="t-card">
                <p class="m-0 t-card-quote">
                  <span set:html={`&ldquo;${highlightQuote(item.quote)}&rdquo;`}></span>
                </p>
                <footer class="t-card-meta mt-5">
                  <p class="m-0 t-card-name type-label">{item.name}</p>
                  <div class="t-card-submeta">
                    <p class="m-0 t-card-role type-label-small font-mono uppercase tracking-[0.08em]">
                      {item.company ? `${item.role}, ${item.company}` : item.role}
                    </p>
                    <p class="m-0 t-card-country type-label-small font-mono uppercase tracking-[0.08em]">
                      {item.country}
                    </p>
                  </div>
                </footer>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 md:mt-10 flex justify-end">
      <a
        href={`${baseUrl}testimonials`}
        class="t-cta inline-flex items-center gap-2 type-label-small font-mono uppercase tracking-[0.08em]"
      >
        <span class="t-cta__label">View all testimonials</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .t-accent-section {
    background: var(--color-accent, #3ccd7f);
    position: relative;
    z-index: 2;
  }

  @media (min-width: 1024px) {
    /* C2 color carry — overlap with TheStrayaMethod's hard-edge accent takeover */
    .t-accent-section {
      margin-top: -6rem;
    }
  }

  .t-stage {
    min-height: clamp(30rem, 56vw, 40rem);
  }

  .t-featured-card {
    width: min(100%, 23rem);
  }

  .t-video-frame {
    aspect-ratio: 3 / 4;
    box-shadow:
      0 18px 42px rgba(10, 10, 10, 0.35),
      inset 0 0 0 1px rgba(225, 224, 204, 0.2);
  }

  .t-frame-identity {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    color: rgba(225, 224, 204, 0.92);
    background: rgba(10, 10, 10, 0.58);
    backdrop-filter: blur(3px);
    padding: 0.45rem 0.6rem;
    z-index: 3;
  }

  .t-frame-name {
    font-size: 0.78rem;
    line-height: 1;
    letter-spacing: -0.01em;
    font-weight: 700;
  }

  .t-frame-role {
    margin-top: 0.2rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.62rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(225, 224, 204, 0.78);
  }

  .t-video-slate {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(120% 80% at 18% 8%, rgba(225, 224, 204, 0.08) 0%, rgba(225, 224, 204, 0) 45%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.22) 0%, rgba(10, 10, 10, 0.02) 38%, rgba(10, 10, 10, 0.22) 100%);
    z-index: 1;
  }

  .t-video-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(7, 7, 7, 0.38) 0%, rgba(7, 7, 7, 0.05) 32%, rgba(7, 7, 7, 0.22) 100%);
    z-index: 2;
  }

  .t-carousel-shell {
    margin-top: 2rem;
    position: relative;
    overflow: hidden;
  }

  .t-carousel-shell::before,
  .t-carousel-shell::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(4rem, 10vw, 8rem);
    pointer-events: none;
    z-index: 15;
  }

  .t-carousel-shell::before {
    left: 0;
    background: linear-gradient(
      90deg,
      var(--color-accent, #3ccd7f) 0%,
      rgba(60, 205, 127, 0.92) 24%,
      rgba(60, 205, 127, 0.62) 52%,
      rgba(60, 205, 127, 0) 100%
    );
  }

  .t-carousel-shell::after {
    right: 0;
    width: clamp(1.4rem, 3.8vw, 2.6rem);
    background: linear-gradient(
      270deg,
      rgba(60, 205, 127, 0.46) 0%,
      rgba(60, 205, 127, 0.22) 34%,
      rgba(60, 205, 127, 0.08) 62%,
      rgba(60, 205, 127, 0) 100%
    );
  }

  .t-carousel-track {
    display: flex;
    width: max-content;
    align-items: stretch;
    animation: testimonials-marquee 44.2s linear infinite;
    will-change: transform;
  }

  .t-carousel-group {
    display: flex;
    gap: 1rem;
    padding-right: 1rem;
  }

  .t-card {
    position: relative;
    width: clamp(16rem, 24vw, 21rem);
    min-height: 12.5rem;
    background: rgba(10, 10, 10, 0.94);
    color: #e1e0cc;
    padding: 1.1rem 1.15rem;
    box-shadow:
      0 10px 20px rgba(0, 0, 0, 0.24),
      inset 0 0 0 1px rgba(225, 224, 204, 0.11);
  }

  .t-card-quote {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  :global(.t-keyword) {
    color: #e1e0cc;
    background-image: linear-gradient(
      180deg,
      rgba(60, 205, 127, 0) 0%,
      rgba(60, 205, 127, 0) 62%,
      rgba(60, 205, 127, 0.35) 62%,
      rgba(60, 205, 127, 0.35) 100%
    );
    background-repeat: no-repeat;
    background-size: 0% 100%;
    text-decoration: underline;
    text-decoration-color: rgba(60, 205, 127, 0.82);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    transition:
      background-size 560ms cubic-bezier(0.16, 1, 0.3, 1),
      text-decoration-color 300ms ease;
  }

  .t-accent-section.is-inview :global(.t-keyword) {
    background-size: 100% 100%;
    text-decoration-color: rgba(60, 205, 127, 0.98);
  }

  .t-card-meta {
    padding-top: 0.35rem;
    display: grid;
    gap: 0.3rem;
  }

  .t-card-submeta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .t-card-name {
    color: #e1e0cc;
  }

  .t-card-role {
    color: rgba(225, 224, 204, 0.66);
  }

  .t-card-country {
    color: rgba(225, 224, 204, 0.92);
    text-align: right;
    white-space: nowrap;
    letter-spacing: 0.1em;
    line-height: 1.1;
    font-weight: 600;
    position: relative;
    padding-left: 0.55rem;
  }

  .t-card-country::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.3rem;
    height: 1px;
    background: rgba(60, 205, 127, 0.95);
    transform: translateY(-50%);
  }

  .t-cta {
    text-decoration: none;
    color: #0a0a0a;
    background: rgba(225, 224, 204, 0.88);
    padding: 0.55rem 0.75rem;
    transition: background-color 220ms cubic-bezier(0.16, 1, 0.3, 1),
      color 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .t-cta__label {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 220ms cubic-bezier(0.16, 1, 0.3, 1);
    padding-bottom: 2px;
  }

  .t-cta:hover,
  .t-cta:focus-visible {
    background: #0a0a0a;
    color: #e1e0cc;
  }

  .t-cta:hover .t-cta__label,
  .t-cta:focus-visible .t-cta__label {
    background-size: 100% 1px;
  }

  .t-cta:focus-visible {
    outline: 2px solid #0a0a0a;
    outline-offset: 4px;
  }

  @media (min-width: 1024px) {
    .t-stage {
      --t-featured-width: 23rem;
      --t-featured-height: calc(var(--t-featured-width) * 4 / 3);
      display: grid;
      grid-template-columns: var(--t-featured-width) 1fr;
      align-items: start;
      gap: 0;
    }

    .t-featured-card {
      position: relative;
      height: var(--t-featured-height);
    }

    .t-video-frame {
      height: 100%;
      aspect-ratio: auto;
    }

    .t-carousel-shell {
      margin-top: 0;
      margin-left: -5.5rem;
      padding-left: 5.5rem;
      height: var(--t-featured-height);
      align-self: stretch;
    }

    .t-carousel-track,
    .t-carousel-group {
      height: 100%;
    }

    .t-card {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
  }

  @keyframes testimonials-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .t-carousel-track {
      animation: none;
      transform: none;
    }
    :global(.t-keyword) {
      transition: none !important;
      background-size: 100% 100%;
    }
    .t-cta,
    .t-cta__label {
      transition: none !important;
    }
  }
</style>

<script>
  const setupTestimonialsEnterFx = () => {
    const root = document.querySelector<HTMLElement>("[data-testimonials-root]");
    if (!root) return;
    if (root.dataset.enterFxReady === "true") return;
    root.dataset.enterFxReady = "true";

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      root.classList.add("is-inview");
      return;
    }

    const trigger = () => {
      root.classList.add("is-inview");
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          trigger();
          io.disconnect();
        });
      },
      { threshold: 0.2, rootMargin: "0px 0px -10% 0px" }
    );

    io.observe(root);

    // Fallback for cases where observer timing misses initial viewport state.
    const rect = root.getBoundingClientRect();
    const vh = window.innerHeight;
    const alreadyInView = rect.top < vh * 0.82 && rect.bottom > vh * 0.2;
    if (alreadyInView) {
      trigger();
      io.disconnect();
    }
  };

  setupTestimonialsEnterFx();
  document.addEventListener("astro:after-swap", setupTestimonialsEnterFx);
</script>
