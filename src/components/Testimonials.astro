---
// Testimonials.astro — Straya Studio [IMMERSIVE]
// Scroll-driven featured quote + dual-direction infinite ticker.
// Animation: standard entrance system (GEMINI §7 — power3.out, 900ms, -80px rootMargin).

const baseUrl = import.meta.env.BASE_URL;

interface Testimonial {
  quote: string;
  name: string;
  role?: string;
  company?: string;
  stars?: number;
  featured?: boolean;
  video?: string;
}

const testimonials: Testimonial[] = [
  {
    quote: "Working with Ali was one of the best experiences I've ever had with a web developer. He has a true talent for the small details, cares about the project, and pays attention to best practices.",
    name: "Sam Sarvas",
    company: "CompleteCRO",
    stars: 5,
    featured: true,
  },
  {
    quote: "Salman helped develop my Framer website, building complex animations and ensuring flawless functionality. Goes above and beyond to deliver quality results.",
    name: "Stefan Luttik",
    company: "Like a Human",
    stars: 5,
  },
  {
    quote: "I've worked with Salman on several website projects using Framer, and the experience has been consistently excellent. Results exceeded expectations.",
    name: "Hector Alvarez",
    company: "All Around Express Solutions",
    stars: 5,
  },
  {
    quote: "Working with Salman has been an amazing experience. He's hardworking, communicative, and always overdelivers. His web design and animations are top-notch.",
    name: "Sergio Apollo",
    role: "CEO",
    company: "Better Match",
    stars: 5,
    featured: true,
    video: "https://youtu.be/Aq2wnh6KRz0",
  },
  {
    quote: "He is very professional. Responds immediately and always done before the deadline. I have used his services more than 5 times already.",
    name: "Dimitar Petrov",
    stars: 5,
  },
  {
    quote: "Salman was great to work with. He pushed the website designs to perfection. I appreciated his quick responses and willingness to meet over Zoom.",
    name: "Oliver Montgomery",
    stars: 5,
  },
  {
    quote: "Been working with Salman for a while now, never disappoints! Great work as always. Definitely a developer worth your money.",
    name: "Renez Van Autreve",
    company: "WARPCO",
    stars: 5,
  },
  {
    quote: "I greatly appreciated this collaboration: attentiveness, availability, and professionalism were evident at every stage.",
    name: "Elliot Wilson",
    stars: 5,
  },
];

const featured = testimonials.filter(t => t.featured);
const ticker   = testimonials.filter(t => !t.featured);

const getYouTubeId = (url: string) => {
  const m = url.match(/youtu\.be\/([a-zA-Z0-9_-]{6,})/) || url.match(/[?&]v=([a-zA-Z0-9_-]{6,})/);
  return m?.[1] ?? null;
};
---

<section
  id="testimonials"
  aria-label="Client testimonials"
  class="section-y relative overflow-hidden bg-background border-b border-black/5"
>
  <!-- Section header -->
  <div class="main-container mb-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-black/5 pb-8">
      <div>
        <span class="t-el type-label text-on-background/40 block mb-3" data-delay="0">Social Proof</span>
        <h2 class="type-h2 text-on-background max-w-lg">
          <span class="t-line block overflow-hidden"><span class="t-el inline-block" data-delay="80">Trusted by founders</span></span>
          <span class="t-line block overflow-hidden"><span class="t-el inline-block" data-delay="140">who demand the best.</span></span>
        </h2>
      </div>
      <div class="t-el flex items-center gap-3 flex-shrink-0" data-delay="240">
        <span class="w-2 h-2 rounded-full bg-accent" aria-hidden="true"></span>
        <span class="type-label text-on-background/40">5.0 ★ — 100+ deployments</span>
      </div>
    </div>
  </div>

  <!-- Featured quotes -->
  <div class="main-container mb-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-px bg-black/5">
      {featured.map((t, i) => (
        <article
          class="t-card bg-background card-pad flex flex-col justify-between gap-8 md:gap-10 group cursor-default"
          data-index={i}
          aria-label={`Testimonial from ${t.name}`}
        >
          <!-- Stars -->
          <div class="flex gap-1" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map((_, si) => (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"
                class="text-accent" aria-hidden="true">
                <path d="M6 0L7.35 4.18H11.71L8.18 6.77L9.53 10.95L6 8.36L2.47 10.95L3.82 6.77L0.29 4.18H4.65L6 0Z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="flex-1">
            <p class="type-h3 text-on-background leading-snug font-medium">
              "{t.quote}"
            </p>
          </blockquote>

          <!-- Video embed — custom player, loads iframe on click -->
          {t.video && getYouTubeId(t.video) && (
            <div
              class="video-player relative overflow-hidden bg-surface-container aspect-video cursor-pointer group/video"
              data-video-id={getYouTubeId(t.video)}
              role="button"
              tabindex="0"
              aria-label={`Play video testimonial from ${t.name}`}
            >
              <!-- YouTube thumbnail (maxresdefault) -->
              <img
                src={`https://i.ytimg.com/vi/${getYouTubeId(t.video)}/maxresdefault.jpg`}
                alt={`Video testimonial from ${t.name}`}
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale group-hover/video:grayscale-0 transition-all duration-700 group-hover/video:scale-[1.02]"
              />
              <!-- Dark overlay -->
              <div class="absolute inset-0 bg-primary/30 group-hover/video:bg-primary/20 transition-colors duration-300"></div>
              <!-- Play button -->
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-14 h-14 bg-background flex items-center justify-center group-hover/video:bg-accent group-hover/video:scale-110 transition-all duration-300 shadow-lg">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M5 3.5L14.5 9L5 14.5V3.5Z" fill="currentColor" class="text-on-background group-hover/video:text-primary transition-colors duration-300"/>
                  </svg>
                </div>
              </div>
              <!-- Duration badge -->
              <div class="absolute bottom-3 right-3 bg-primary/80 px-2 py-0.5">
                <span class="type-label text-on-primary text-[10px]">Watch</span>
              </div>
            </div>
          )}

          <!-- Attribution -->
          <footer class="border-t border-black/5 pt-5 md:pt-6">
            <cite class="not-italic flex items-center justify-between">
              <div>
                <span class="type-label text-on-background block">{t.name}</span>
                {(t.role || t.company) && (
                  <span class="type-label text-on-background/40 block mt-0.5">
                    {[t.role, t.company].filter(Boolean).join(", ")}
                  </span>
                )}
              </div>
              <svg
                width="20" height="20" viewBox="0 0 20 20" fill="none"
                class="text-on-background/20 group-hover:text-accent group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300"
                aria-hidden="true"
              >
                <path d="M4 16L16 4M16 4H8M16 4V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </cite>
          </footer>
        </article>
      ))}
    </div>
  </div>

  <!-- Ticker row 1 (left to right) -->
  <div class="relative overflow-hidden mb-px border-y border-black/5 py-5" aria-hidden="true">
    <div class="ticker-ltr flex whitespace-nowrap gap-0">
      {[...ticker, ...ticker].map((t) => (
        <div class="inline-flex items-center gap-6 px-8 flex-shrink-0">
          <span class="type-body-small text-on-background/60 max-w-xs truncate">"{t.quote}"</span>
          <span class="type-label text-on-background/30 flex-shrink-0">— {t.name}{t.company ? `, ${t.company}` : ''}</span>
          <span class="w-px h-4 bg-black/10 flex-shrink-0" aria-hidden="true"></span>
        </div>
      ))}
    </div>
  </div>

  <!-- Ticker row 2 (right to left) -->
  <div class="relative overflow-hidden border-b border-black/5 py-5" aria-hidden="true">
    <div class="ticker-rtl flex whitespace-nowrap gap-0">
      {[...ticker, ...ticker].reverse().map((t) => (
        <div class="inline-flex items-center gap-6 px-8 flex-shrink-0">
          <span class="type-label text-on-background/30 flex-shrink-0">{t.name}{t.company ? `, ${t.company}` : ''} —</span>
          <span class="type-body-small text-on-background/60 max-w-xs truncate">"{t.quote}"</span>
          <span class="w-px h-4 bg-black/10 flex-shrink-0" aria-hidden="true"></span>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom CTA strip -->
  <div class="main-container mt-16">
    <div class="t-el flex flex-col md:flex-row items-start md:items-center justify-between gap-6 border-t border-black/5 pt-8" data-delay="0">
      <p class="type-body text-on-surface-variant max-w-sm">
        Every project is founder-led, scoped, and delivered as a complete build.
      </p>
      <a
        href={`${baseUrl}testimonials`}
        class="magnetic-cta z-depth-1 inline-flex items-center gap-3 type-button text-on-background border-b border-on-background/20 pb-px hover:border-on-background transition-colors duration-300"
      >
        Read all testimonials
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* ── Header elements ───────────────────────────────────────── */
  .t-el {
    opacity: 0;
    transform: translateY(28px);
  }
  .t-line .t-el {
    transform: translateY(100%);
    opacity: 1;
  }

  /* ── Featured cards ────────────────────────────────────────── */
  .t-card {
    opacity: 0;
    transform: translateY(28px);
  }
  .t-card:hover {
    background-color: theme('colors.surface-container-lowest');
  }

  /* ── Tickers ───────────────────────────────────────────────── */
  @keyframes ticker-ltr {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes ticker-rtl {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }
  .ticker-ltr { animation: ticker-ltr 40s linear infinite; }
  .ticker-rtl { animation: ticker-rtl 50s linear infinite; }
  .ticker-ltr:hover, .ticker-rtl:hover { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .t-el, .t-card { opacity: 1 !important; transform: none !important; }
    .ticker-ltr, .ticker-rtl { animation: none; }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 900;
  const MARGIN   = '0px 0px -80px 0px';

  // ── Header entrance ─────────────────────────────────────────
  const headerEls = document.querySelectorAll<HTMLElement>('#testimonials .t-el');

  const headerObs = new IntersectionObserver(entries => {
    if (!entries[0].isIntersecting) return;
    headerEls.forEach(el => {
      const delay  = parseInt(el.dataset.delay ?? '0');
      const isLine = el.closest('.t-line') !== null;
      el.animate(
        isLine
          ? [{ transform: 'translateY(100%)' }, { transform: 'translateY(0%)' }]
          : [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
        { duration: DURATION, delay, easing: EASE, fill: 'forwards' }
      );
    });
    headerObs.disconnect();
  }, { rootMargin: MARGIN, threshold: 0 });

  const section = document.getElementById('testimonials');
  if (section) headerObs.observe(section);

  // ── Featured cards ───────────────────────────────────────────
  const cards = document.querySelectorAll<HTMLElement>('.t-card');

  const cardObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el  = entry.target as HTMLElement;
      const idx = parseInt(el.dataset.index ?? '0');
      el.animate(
        [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
        { duration: DURATION, delay: 360 + idx * 120, easing: EASE, fill: 'forwards' }
      );
      cardObs.unobserve(el);
    });
  }, { rootMargin: MARGIN, threshold: 0 });

  cards.forEach(c => cardObs.observe(c));

  // ── Video player — load iframe on click ─────────────────────
  document.querySelectorAll<HTMLElement>('.video-player').forEach(player => {
    const activate = () => {
      const id = player.dataset.videoId;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      iframe.title = player.getAttribute('aria-label') ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 w-full h-full border-0';
      // Fade out thumbnail, show iframe
      player.style.transition = 'opacity 0.3s ease';
      player.style.opacity = '0';
      setTimeout(() => {
        player.innerHTML = '';
        player.appendChild(iframe);
        player.style.opacity = '1';
        player.style.cursor = 'default';
      }, 300);
    };
    player.addEventListener('click', activate);
    player.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') activate(); });
  });
  const cta = document.querySelector<HTMLElement>('#testimonials .t-el[data-delay="0"]:last-of-type');
  if (cta) {
    const ctaObs = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) return;
      cta.animate(
        [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
        { duration: DURATION, easing: EASE, fill: 'forwards' }
      );
      ctaObs.disconnect();
    }, { rootMargin: MARGIN, threshold: 0 });
    ctaObs.observe(cta);
  }
</script>
