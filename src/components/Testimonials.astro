---
/**
 * Testimonials.astro — Straya Studio
 * Mode: Neobrutalism (accent green ground — design-system.md §1)
 * Compliance: design-system.md §1,§5,§8 | production-aesthetic.md A3 | micro-interactions.md §8.1,§8.3,§8.5 M3,M4,M7
 */

const baseUrl = import.meta.env.BASE_URL;

const featured = {
  name: "Sergio Apollo",
  role: "CEO, Better Match",
  quote:
    "From kickoff to launch, every decision felt intentional. The quality of execution and communication stayed consistent the whole way through.",
  videoSrc: `${baseUrl}videos/testimonials/sergio-apollo.webm`,
};

const escapeHtml = (input: string) =>
  input
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

const highlightQuote = (quote: string) => {
  const safe = escapeHtml(quote);
  const highlightPattern =
    /\b(professional(?:ism)?|responsive|communication|quality|recommend(?:ed)?|timelines?|delivery|helpful|patient|committed|outcome|vision)\b/gi;
  return safe.replace(highlightPattern, '<span class="t-keyword">$1</span>');
};

const preferredTestimonials = [
  {
    quote:
      "One of the best web designers and developers I have worked with. I would recommend Straya Studio to anyone serious about quality.",
    name: "Dejan Djokovic",
    role: "Founder",
    country: "Canada",
    company: "",
  },
  {
    quote:
      "Helpful from the initial brief through delivery. Timelines and feedback were always respected and the final result matched the vision.",
    name: "Luca Sartorello",
    role: "Founder",
    country: "Italy",
    company: "",
  },
  {
    quote:
      "Strong communication under pressure. Every revision sharpened the product instead of adding noise.",
    name: "Oliver Montgomery",
    role: "Founder",
    country: "United States",
    company: "Bluefin Studio",
  },
  {
    quote:
      "Patient, dependable, and committed from kickoff to launch. The process felt senior-led from day one.",
    name: "Omar Bran",
    role: "Founder",
    country: "Australia",
    company: "",
  },
];
---

<section
  id="testimonials"
  aria-labelledby="testimonials-heading"
  class="t-section pt-16 pb-16 md:pt-20 md:pb-20 relative overflow-hidden"
  data-mode="neobrutalism"
  data-testimonials-root
>
  <p class="sr-only">
    Testimonials section on an accent background with a featured founder video
    and an infinite carousel of founder quotes moving from right to left.
  </p>

  <div class="main-container relative z-10">
    <!-- Header -->
    <header class="mb-10 md:mb-14">
      <h2
        id="testimonials-heading"
        class="type-h2 m-0 max-w-[16ch] text-on-background"
      >
        Founder proof, in motion.
      </h2>
    </header>

    <!-- Stage -->
    <div class="t-stage relative">
      <!-- Featured video -->
      <figure
        class="t-featured-card relative z-20 m-0"
        aria-label={`Featured video testimonial from ${featured.name}, ${featured.role}`}
      >
        <div
          class="t-video-frame relative overflow-hidden bg-[#070707] shadow-[0_24px_48px_rgba(0,0,0,0.4),inset_0_0_0_1px_rgba(225,224,204,0.12)]"
        >
          <video
            class="absolute inset-0 h-full w-full object-cover"
            controls
            preload="metadata"
            playsinline
            aria-label={`Video testimonial from ${featured.name}`}
            data-asset-category="portrait"
            data-asset-id="testimonial-sergio-apollo-video"
            data-placeholder="true"
            data-asset-spec="Founder video testimonial — talking head, three-quarter framing, neutral background, natural daylight, mid-conversation"
          >
            <source src={featured.videoSrc} type="video/webm" />
            Your browser does not support HTML5 video.
          </video>
          <!-- Hard-edge linear scrim — no radial gradients (production-aesthetic.md A3) -->
          <div class="t-video-scrim" aria-hidden="true"></div>
          <div class="t-frame-identity" aria-hidden="true">
            <p class="m-0 t-frame-name">{featured.name}</p>
            <p class="m-0 t-frame-role">{featured.role}</p>
          </div>
        </div>
      </figure>

      <!-- Carousel — M7 marquee hover-pause (micro-interactions.md §2) -->
      <div class="t-carousel-shell relative z-10" aria-hidden="true">
        <div class="t-carousel-track" data-marquee-track>
          {
            [0, 1].map(() => (
              <div class="t-carousel-group">
                {preferredTestimonials.map((item) => (
                  <article class="t-card">
                    <p class="m-0 t-card-quote">
                      <span
                        set:html={`\u201c${highlightQuote(item.quote)}\u201d`}
                      />
                    </p>
                    <footer class="t-card-meta mt-5">
                      <p class="m-0 t-card-name type-label">{item.name}</p>
                      <div class="t-card-submeta">
                        <p class="m-0 t-card-role type-label font-mono uppercase tracking-[0.08em] opacity-60">
                          {item.company
                            ? `${item.role}, ${item.company}`
                            : item.role}
                        </p>
                        <p class="m-0 t-card-country type-label font-mono uppercase tracking-[0.1em]">
                          {item.country}
                        </p>
                      </div>
                    </footer>
                  </article>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- CTA — M3 underline draw (micro-interactions.md §2) -->
    <div class="mt-8 md:mt-10 flex justify-end">
      <a
        href={`${baseUrl}testimonials`}
        class="t-cta inline-flex items-center gap-2 type-label font-mono uppercase tracking-[0.08em] text-on-background/70 no-underline"
      >
        <span class="t-cta__label">View all testimonials</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* PERMITTED: complex pseudo-elements, :global, @keyframes — no Tailwind equivalent */

  /* ── Section ground — warm dark brown (#140E09) matching Straya Method stages 2 & 4 ── */
  .t-section {
    background: #140e09;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 1024px) {
    .t-section {
      margin-top: 0;
    }
  }

  /* ── Stage ────────────────────────────────────────────────── */
  .t-stage {
    min-height: clamp(20rem, 40vw, 28rem);
  }
  .t-featured-card {
    width: 100%;
  }

  .t-video-frame {
    aspect-ratio: 16 / 9;
  }

  /* Hard-edge linear scrim — no radial gradients (production-aesthetic.md A3) */
  .t-video-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(7, 7, 7, 0.4) 0%,
      rgba(7, 7, 7, 0) 35%,
      rgba(7, 7, 7, 0) 65%,
      rgba(7, 7, 7, 0.3) 100%
    );
    z-index: 1;
  }

  .t-frame-identity {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    color: rgba(225, 224, 204, 0.92);
    background: rgba(10, 10, 10, 0.58);
    backdrop-filter: blur(3px);
    padding: 0.45rem 0.6rem;
    z-index: 3;
  }
  .t-frame-name {
    font-size: 0.78rem;
    line-height: 1;
    letter-spacing: -0.01em;
    font-weight: 700;
  }
  .t-frame-role {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(225, 224, 204, 0.78);
  }

  /* ── Carousel — M7 marquee hover-pause ───────────────────── */
  .t-carousel-shell {
    margin-top: 2rem;
    position: relative;
    overflow: hidden;
    --marquee-state: running;
  }

  /* Fade edges — hard-edge linear gradients only (A3) */
  .t-carousel-shell::before,
  .t-carousel-shell::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 15;
  }
  .t-carousel-shell::before {
    left: 0;
    width: clamp(4rem, 10vw, 8rem);
    background: linear-gradient(90deg, #140e09 0%, rgba(20, 14, 9, 0) 100%);
  }
  .t-carousel-shell::after {
    right: 0;
    width: clamp(2rem, 5vw, 4rem);
    background: linear-gradient(270deg, #140e09 0%, rgba(20, 14, 9, 0) 100%);
  }

  /* M7 — pause on hover */
  .t-carousel-shell:hover {
    --marquee-state: paused;
  }

  .t-carousel-track {
    display: flex;
    width: max-content;
    align-items: stretch;
    animation: testimonials-marquee 44.2s linear infinite;
    animation-play-state: var(--marquee-state);
    will-change: transform;
  }

  .t-carousel-group {
    display: flex;
    gap: 1rem;
    padding-right: 1rem;
  }

  /* ── Cards — soft shadow, no hard offset ─────────────────── */
  .t-card {
    position: relative;
    width: clamp(16rem, 24vw, 21rem);
    min-height: 12.5rem;
    background: rgba(10, 10, 10, 0.92);
    color: #e1e0cc;
    padding: 1.1rem 1.15rem;
    /* Soft shadow + inset highlight — no hard offset (design-system.md §7) */
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(225, 224, 204, 0.08);
  }

  .t-card-quote {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  /* Keyword highlight — scroll-progress coupled (§8.5) */
  :global(.t-keyword) {
    color: #e1e0cc;
    background-image: linear-gradient(
      180deg,
      rgba(220, 80, 0, 0) 62%,
      rgba(220, 80, 0, 0.35) 62%
    );
    background-repeat: no-repeat;
    background-size: 0% 100%;
    text-decoration: underline;
    text-decoration-color: rgba(220, 80, 0, 0.82);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    transition: background-size 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .t-section.is-inview :global(.t-keyword) {
    background-size: 100% 100%;
  }

  .t-card-meta {
    padding-top: 0.35rem;
    display: grid;
    gap: 0.3rem;
  }
  .t-card-submeta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .t-card-name {
    color: #e1e0cc;
  }
  .t-card-role {
    color: rgba(225, 224, 204, 0.66);
  }
  .t-card-country {
    color: rgba(225, 224, 204, 0.92);
    text-align: right;
    white-space: nowrap;
    position: relative;
    padding-left: 0.55rem;
  }
  .t-card-country::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.3rem;
    height: 1px;
    background: rgba(220, 80, 0, 0.95);
    transform: translateY(-50%);
  }

  /* ── CTA — M3 underline draw ──────────────────────────────── */
  .t-cta {
    text-decoration: none;
  }
  .t-cta__label {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 240ms cubic-bezier(0.16, 1, 0.3, 1);
    padding-bottom: 2px;
  }
  .t-cta:hover .t-cta__label,
  .t-cta:focus-visible .t-cta__label {
    background-size: 100% 1px;
  }
  .t-cta:focus-visible {
    outline: 2px solid var(--color-accent, #dc5000);
    outline-offset: 4px;
  }

  /* ── Desktop layout ───────────────────────────────────────── */
  @media (min-width: 1024px) {
    .t-stage {
      --t-featured-width: 18rem;
      --t-featured-height: calc(var(--t-featured-width) * 4 / 3);
      display: grid;
      grid-template-columns: var(--t-featured-width) 1fr;
      align-items: start;
    }
    .t-featured-card {
      position: relative;
      height: var(--t-featured-height);
    }
    .t-video-frame {
      height: 100%;
      aspect-ratio: auto;
    }
    .t-carousel-shell {
      margin-top: 0;
      margin-left: -5.5rem;
      padding-left: 5.5rem;
      height: var(--t-featured-height);
      align-self: stretch;
    }
    .t-carousel-track,
    .t-carousel-group {
      height: 100%;
    }
    .t-card {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
  }

  @keyframes testimonials-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .t-carousel-track {
      animation: none;
      transform: none;
    }
    :global(.t-keyword) {
      transition: none !important;
      background-size: 100% 100%;
    }
    .t-cta__label {
      transition: none !important;
    }
  }
</style>

<script>
  const setup = () => {
    const root = document.querySelector<HTMLElement>(
      "[data-testimonials-root]",
    );
    if (!root || root.dataset.tReady === "true") return;
    root.dataset.tReady = "true";

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // ── Keyword highlight — scroll-progress coupled (§8.5) ─────
    if (reduced) {
      root.classList.add("is-inview");
    } else {
      let raf = 0;
      const update = () => {
        raf = 0;
        const rect = root.getBoundingClientRect();
        const p = Math.min(
          1,
          Math.max(
            0,
            (window.innerHeight - rect.top) / (window.innerHeight * 0.8),
          ),
        );
        if (p > 0.1) root.classList.add("is-inview");
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!raf) raf = requestAnimationFrame(update);
        },
        { passive: true },
      );
      update();
    }
  };

  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
