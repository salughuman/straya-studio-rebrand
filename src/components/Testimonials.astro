        <svg
          class="ml-2 h-4 w-4 transition-transform duration-300 ease-luxury group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </Button>
    </header>

    <div class="flex flex-col gap-4 lg:grid lg:grid-cols-3 lg:gap-4">
      {/* On mobile the center column must come first so the video card is always at the top. */}
      <div class="order-2 lg:order-none lg:col-start-1 flex flex-col gap-4">
        {leftColumn.map((t) => (
          <article
            class:list={[
              "rounded-md border border-[rgba(255,255,255,0.05)] bg-[#0A0A0A] p-6 md:p-7",
              "transition-[transform,border-color,box-shadow] duration-300 ease-luxury",
              "hover:-translate-y-1 hover:border-[rgba(255,255,255,0.1)] hover:shadow-[0_8px_24px_rgba(0,0,0,0.35),0_16px_48px_rgba(0,0,0,0.2)]",
              "motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none",
              t.featured
                ? "border-[rgba(60,205,127,0.22)] bg-[linear-gradient(135deg,rgba(60,205,127,0.08)_0%,#0A0A0A_62%)]"
                : "",
            ]}
          >
            {t.video && (
              <div class="mb-5 overflow-hidden rounded-xs border border-[rgba(255,255,255,0.08)] bg-[#050505]">
                {getVideoSource(t.video).type === "iframe" ? (
                  <iframe
                    src={getVideoSource(t.video).src}
                    title={`Video testimonial from ${t.name}`}
                    class="aspect-video w-full border-0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                  />
                ) : (
                  <video class="aspect-video w-full" controls playsinline preload="metadata">
                    <source src={getVideoSource(t.video).src} />
                    Your browser does not support the video tag.
                  </video>
                )}
              </div>
            )}

            <div
              class="mb-4 flex gap-0.5 text-[#3CCD7F]"
              aria-label={`${t.stars || 5} out of 5 stars`}
            >
              {Array.from({ length: t.stars || 5 }).map((_, si) => (
                <svg
                  class="h-3.5 w-3.5 motion-safe:animate-[starShimmer_3s_cubic-bezier(0.16,1,0.3,1)_infinite] motion-reduce:animate-none"
                  style={`animation-delay:${si * 150}ms;`}
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M7 0.5L8.764 4.764L13.5 5.291L9.955 8.486L10.928 13.136L7 10.9L3.072 13.136L4.045 8.486L0.5 5.291L5.236 4.764L7 0.5Z" />
                </svg>
              ))}
            </div>

            <blockquote
              class:list={[
                "type-body m-0 leading-relaxed text-[#9CA3AF]",
                t.featured ? "text-[#FFFFFF]" : "",
              ]}
            >
              “{t.quote}”
            </blockquote>

            <footer class="mt-5 border-t border-[rgba(255,255,255,0.05)] pt-4">
              <cite class="not-italic">
                <div class="flex items-center gap-3">
                  <img
                    src={getAvatarSrc(t)}
                    alt={`${t.name} profile photo`}
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                    class="h-10 w-10 rounded-xs border border-[rgba(255,255,255,0.08)] object-cover bg-[#0F1115]"
                    onerror={`this.onerror=null;this.src='${getFallbackAvatarSrc(t)}';`}
                  />
                  <span>
                    <span class="block type-body font-medium text-[#FFFFFF]">{t.name}</span>
                    {getPrimaryMeta(t) ? (
                      <>
                        <span class="block type-caption">{getPrimaryMeta(t)}</span>
                        <span class="block type-caption">{t.country}</span>
                      </>
                    ) : (
                      <span class="block type-caption">{t.country}</span>
                    )}
                  </span>
                </div>
              </cite>
            </footer>
          </article>
        ))}
      </div>

      <div class="order-first lg:order-none lg:col-start-2 flex flex-col gap-4">
        {centerColumn.map((t) => (
          <article
