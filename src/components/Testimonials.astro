    <header class="mb-12 flex flex-col items-center justify-between gap-6 text-center md:mb-16 md:flex-row md:items-end md:text-left">
      <div class="flex flex-col items-center gap-3 md:items-start">
        <p class="type-label mb-0">What our clients say</p>
        <h2 class="type-h2">Trusted by founders and teams who demand the best.</h2>
      </div>

      <Button
        href={`${baseUrl}testimonials`}
        label="View testimonials"
        variant="ghost"
        class="group !w-fit !px-5 !py-3 !text-sm"
