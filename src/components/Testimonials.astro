---
// Testimonials.astro — Straya Studio [IMMERSIVE]
// Scroll-driven featured quote + dual-direction infinite ticker.
// Animation: standard entrance system (GEMINI §7 — power3.out, 900ms, -80px rootMargin).

const baseUrl = import.meta.env.BASE_URL;

interface Testimonial {
  quote: string;
  name: string;
  role?: string;
  company?: string;
  stars?: number;
  featured?: boolean;
  videoSrc?: string;
  videoPoster?: string;
}

const testimonials: Testimonial[] = [
  {
    quote: "Working with Ali was one of the best experiences I've ever had with a web developer. He has a true talent for the small details, cares about the project, and pays attention to best practices.",
    name: "Sam Sarvas",
    company: "CompleteCRO",
    stars: 5,
    featured: true,
  },
  {
    quote: "Salman helped develop my Framer website, building complex animations and ensuring flawless functionality. Goes above and beyond to deliver quality results.",
    name: "Stefan Luttik",
    company: "Like a Human",
    stars: 5,
  },
  {
    quote: "I've worked with Salman on several website projects using Framer, and the experience has been consistently excellent. Results exceeded expectations.",
    name: "Hector Alvarez",
    company: "All Around Express Solutions",
    stars: 5,
  },
  {
    quote: "Working with Salman has been an amazing experience. He's hardworking, communicative, and always overdelivers. His web design and animations are top-notch.",
    name: "Sergio Apollo",
    role: "CEO",
    company: "Better Match",
    stars: 5,
    featured: true,
    videoSrc: `${baseUrl}videos/testimonials/sergio-apollo.webm`,
    videoPoster: `${baseUrl}images/testimonials/sergio-apollo-poster.png`,
  },
  {
    quote: "He is very professional. Responds immediately and always done before the deadline. I have used his services more than 5 times already.",
    name: "Dimitar Petrov",
    stars: 5,
  },
  {
    quote: "Salman was great to work with. He pushed the website designs to perfection. I appreciated his quick responses and willingness to meet over Zoom.",
    name: "Oliver Montgomery",
    stars: 5,
  },
  {
    quote: "Been working with Salman for a while now, never disappoints! Great work as always. Definitely a developer worth your money.",
    name: "Renez Van Autreve",
    company: "WARPCO",
    stars: 5,
  },
  {
    quote: "I greatly appreciated this collaboration: attentiveness, availability, and professionalism were evident at every stage.",
    name: "Elliot Wilson",
    stars: 5,
  },
];

const featured = testimonials.filter(t => t.featured);
const ticker   = testimonials.filter(t => !t.featured);

---

<section
  id="testimonials"
  aria-label="Client testimonials"
  class="section-y pt-10 md:pt-16 relative overflow-hidden bg-primary border-b border-white/5"
>
  <!-- Section header — same black-band language as FinalCTA -->
  <div class="main-container mb-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/5">
      <div>
        <span class="t-el type-label text-white/40 block mb-3" data-delay="0">Social Proof</span>
        <h2 class="type-h2 text-white max-w-lg">
          <span class="t-line block overflow-hidden"><span class="t-el inline-block" data-delay="80">Trusted by founders</span></span>
          <span class="t-line block overflow-hidden"><span class="t-el inline-block" data-delay="140">who demand the best.</span></span>
        </h2>
      </div>
      <div class="t-el flex items-center gap-3 flex-shrink-0" data-delay="240">
        <span class="w-2 h-2 rounded-full bg-accent" aria-hidden="true"></span>
        <p class="type-label text-white/40 m-0">
          <span class="sr-only">Average client rating 5.0 out of 5 stars.</span>
          <span aria-hidden="true">5.0 ★ — 100+ deployments</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Featured quotes -->
  <div class="main-container mb-20">
    <p class="sr-only">
      Featured client testimonials from Sam Sarvas of CompleteCRO and Sergio Apollo, CEO of Better Match, praising the quality of work, attention to detail, and communication throughout their Framer and web development projects.
    </p>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-px bg-white/5">
      {featured.map((t, i) => (
        <article
          class="t-card bg-white/5 card-pad flex flex-col justify-between gap-8 md:gap-10 group cursor-default"
          data-index={i}
          aria-label={`Testimonial from ${t.name}`}
        >
          <!-- Stars -->
          <div class="flex gap-1" role="img" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map((_, si) => (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"
                class="text-accent" aria-hidden="true">
                <path d="M6 0L7.35 4.18H11.71L8.18 6.77L9.53 10.95L6 8.36L2.47 10.95L3.82 6.77L0.29 4.18H4.65L6 0Z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="flex-1">
            <p class="type-h3 text-white leading-snug font-medium">
              "{t.quote}"
            </p>
          </blockquote>

          <!-- Video embed — custom local video player -->
          {t.videoSrc && (
            <div
              class="video-player relative overflow-hidden bg-black/30 aspect-video border border-white/10"
              data-video-player
              aria-label={`Video testimonial from ${t.name}`}
            >
              <video
                class="video-el w-full h-full object-cover"
                preload="metadata"
                playsinline
                poster={t.videoPoster ?? `${baseUrl}og-testimonials.png`}
                aria-label={`Video testimonial from ${t.name}`}
              >
                <source src={t.videoSrc} type="video/webm" />
                Your browser does not support HTML5 video.
              </video>

              <button
                type="button"
                class="video-play absolute inset-0 flex items-center justify-center"
                data-video-play
                aria-label={`Play video testimonial from ${t.name}`}
              >
                <span class="video-play-chip w-14 h-14 bg-white text-primary flex items-center justify-center shadow-lg transition-all duration-300">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M5 3.5L14.5 9L5 14.5V3.5Z" fill="currentColor"/>
                  </svg>
                </span>
              </button>

              <div class="video-controls absolute inset-x-0 bottom-0 p-3">
                <div class="video-controls-inner flex items-center gap-3 bg-primary/70 text-on-primary px-3 py-2 backdrop-blur-sm">
                  <button
                    type="button"
                    class="video-ctrl-btn"
                    data-video-toggle
                    aria-label={`Toggle playback for ${t.name}`}
                  >
                    <span data-video-toggle-icon>Play</span>
                  </button>
                  <span class="type-label text-on-primary/80 tabular-nums text-[10px]" data-video-time>0:00 / 0:00</span>
                  <input
                    class="video-progress flex-1"
                    data-video-progress
                    type="range"
                    min="0"
                    max="100"
                    value="0"
                    aria-label={`Seek video testimonial from ${t.name}`}
                  />
                  <button
                    type="button"
                    class="video-ctrl-btn"
                    data-video-mute
                    aria-label={`Mute video testimonial from ${t.name}`}
                  >
                    Sound
                  </button>
                </div>
              </div>
            </div>
          )}

          <!-- Attribution -->
          <footer class="border-t border-white/5 pt-5 md:pt-6">
            <cite class="not-italic flex items-center justify-between">
              <div>
                <span class="type-label text-white block">{t.name}</span>
                {(t.role || t.company) && (
                  <span class="type-label text-white/40 block mt-0.5">
                    {[t.role, t.company].filter(Boolean).join(", ")}
                  </span>
                )}
              </div>
              <svg
                width="20" height="20" viewBox="0 0 20 20" fill="none"
                class="text-white/25 group-hover:text-accent group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300"
                aria-hidden="true"
              >
                <path d="M4 16L16 4M16 4H8M16 4V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </cite>
          </footer>
        </article>
      ))}
    </div>
  </div>

  <!-- Bottom CTA strip -->
  <div class="main-container mt-16">
    <div class="t-el flex flex-col md:flex-row items-start md:items-center justify-between gap-6 border-t border-white/5 pt-8" data-delay="0">
      <p class="type-body text-white/60 max-w-sm">
        Every project is founder-led, scoped, and delivered as a complete build.
      </p>
      <a
        href={`${baseUrl}testimonials`}
        class="magnetic-cta z-depth-1 inline-flex items-center gap-3 type-button text-white/60 border-b border-white/20 pb-px hover:text-white hover:border-white transition-colors duration-300"
      >
        Read all testimonials
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* ── Header elements ───────────────────────────────────────── */
  .t-el {
    opacity: 0;
    transform: translateY(28px);
  }
  .t-line .t-el {
    transform: translateY(100%);
    opacity: 1;
  }

  /* ── Featured cards ────────────────────────────────────────── */
  /* t-card: visible by default — no entrance animation */
  .t-card:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .video-play {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.36), rgba(0, 0, 0, 0.08));
    transition: opacity 250ms ease;
  }
  .video-play-chip:hover {
    transform: scale(1.06);
    background-color: theme('colors.accent');
    color: theme('colors.primary');
  }
  .video-player.is-playing .video-play {
    opacity: 0;
    pointer-events: none;
  }

  .video-controls-inner {
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .video-ctrl-btn {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.85);
    transition: color 200ms ease;
  }
  .video-ctrl-btn:hover {
    color: #fff;
  }
  .video-progress {
    appearance: none;
    height: 2px;
    background: rgba(255, 255, 255, 0.25);
    outline: none;
  }
  .video-progress::-webkit-slider-thumb {
    appearance: none;
    width: 10px;
    height: 10px;
    background: #fff;
    border-radius: 999px;
    border: none;
  }
  .video-progress::-moz-range-thumb {
    width: 10px;
    height: 10px;
    background: #fff;
    border-radius: 999px;
    border: none;
  }
  .video-progress::-moz-range-track {
    height: 2px;
    background: rgba(255, 255, 255, 0.25);
  }

  /* ── Tickers ───────────────────────────────────────────────── */

  @media (prefers-reduced-motion: reduce) {
    .t-el { opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 900;
  const MARGIN   = '0px 0px -80px 0px';

  // ── Header entrance ─────────────────────────────────────────
  const headerEls = document.querySelectorAll<HTMLElement>('#testimonials .t-el');

  const headerObs = new IntersectionObserver(entries => {
    if (!entries[0].isIntersecting) return;
    headerEls.forEach(el => {
      const delay  = parseInt(el.dataset.delay ?? '0');
      const isLine = el.closest('.t-line') !== null;
      el.animate(
        isLine
          ? [{ transform: 'translateY(100%)' }, { transform: 'translateY(0%)' }]
          : [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
        { duration: DURATION, delay, easing: EASE, fill: 'forwards' }
      );
    });
    headerObs.disconnect();
  }, { rootMargin: MARGIN, threshold: 0 });

  const section = document.getElementById('testimonials');
  if (section) headerObs.observe(section);

  // t-card entrance animation removed — cards visible by default

  // ── Video player — local HTML5 video with custom controls ───
  const formatTime = (seconds: number) => {
    if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${String(secs).padStart(2, '0')}`;
  };

  document.querySelectorAll<HTMLElement>('[data-video-player]').forEach(player => {
    const video = player.querySelector<HTMLVideoElement>('.video-el');
    const playOverlay = player.querySelector<HTMLButtonElement>('[data-video-play]');
    const toggleBtn = player.querySelector<HTMLButtonElement>('[data-video-toggle]');
    const toggleIcon = player.querySelector<HTMLElement>('[data-video-toggle-icon]');
    const muteBtn = player.querySelector<HTMLButtonElement>('[data-video-mute]');
    const progress = player.querySelector<HTMLInputElement>('[data-video-progress]');
    const time = player.querySelector<HTMLElement>('[data-video-time]');

    if (!video || !playOverlay || !toggleBtn || !toggleIcon || !muteBtn || !progress || !time) return;

    const syncUi = () => {
      const current = video.currentTime || 0;
      const duration = video.duration || 0;
      const percent = duration > 0 ? (current / duration) * 100 : 0;
      progress.value = String(percent);
      time.textContent = `${formatTime(current)} / ${formatTime(duration)}`;
      toggleIcon.textContent = video.paused ? 'Play' : 'Pause';
      muteBtn.textContent = video.muted ? 'Muted' : 'Sound';
      player.classList.toggle('is-playing', !video.paused);
    };

    const togglePlay = () => {
      if (video.paused) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    };

    playOverlay.addEventListener('click', togglePlay);
    video.addEventListener('click', togglePlay);
    toggleBtn.addEventListener('click', togglePlay);
    muteBtn.addEventListener('click', () => {
      video.muted = !video.muted;
      syncUi();
    });
    progress.addEventListener('input', () => {
      const duration = video.duration || 0;
      const next = (Number(progress.value) / 100) * duration;
      if (Number.isFinite(next)) video.currentTime = next;
    });

    video.addEventListener('play', syncUi);
    video.addEventListener('pause', syncUi);
    video.addEventListener('timeupdate', syncUi);
    video.addEventListener('loadedmetadata', syncUi);
    video.addEventListener('ended', () => {
      video.currentTime = 0;
      syncUi();
    });

    syncUi();
  });
  // bottom CTA strip uses .t-el — handled by header observer above
</script>
