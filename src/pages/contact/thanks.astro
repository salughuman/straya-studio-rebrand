---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/buttons/Button.astro";
import FAQ from "../../components/FAQ.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import Footer from "../../components/Footer.astro";

const title = "Thanks | Straya Studio";
const description =
  "Thanks for sending your project brief. Straya Studio will review and respond with next steps.";
const homeHref = import.meta.env.BASE_URL;
---

<BaseLayout title={title} description={description}>
  <section
    class="section-y relative z-10 bg-[#0A0A0A] text-[#FFFFFF]"
    aria-label="Project brief submitted"
  >
    <div class="main-container">
      <div class="mx-auto flex max-w-[42rem] flex-col items-center gap-4 text-center">
        <p class="type-label">Brief received</p>
        <h1 class="type-h2">Thanks. We will review and reply soon.</h1>
        <p class="type-body text-[#9CA3AF]">
          Your submission is in. The studio will review your project details and send next
          steps by email.
        </p>
        <div class="mt-4">
          <Button href={homeHref} label="Back to home" variant="primary" class="!w-fit !px-6 !py-3 !text-sm" />
        </div>
      </div>
    </div>
  </section>
  <FAQ />
  <FinalCTA />
  <Footer />
</BaseLayout>
