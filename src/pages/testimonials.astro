---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { SITE_CONFIG } from "../data/site-config";
import { testimonialsPageTestimonials, type TestimonialsPageTestimonial } from "../data/testimonials-page";

const title       = "Client Testimonials | Straya Studio";
const description = "Client testimonials from founders and teams across Framer, Webflow, Shopify, and WordPress builds.";
const image       = "/og-testimonials.png";
const pageUrl     = `${SITE_CONFIG.url}/testimonials/`;
const baseUrl     = import.meta.env.BASE_URL;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title, description, url: pageUrl,
  isPartOf: { "@type": "WebSite", name: SITE_CONFIG.name, url: `${SITE_CONFIG.url}/` },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",         item: `${SITE_CONFIG.url}/` },
    { "@type": "ListItem", position: 2, name: "Testimonials", item: pageUrl },
  ],
};

const toSlug = (name: string) =>
  name.toLowerCase().replace(/['']/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");

const getAvatarSrc = (t: TestimonialsPageTestimonial) =>
  t.avatar ?? `${baseUrl}images/testimonials/${toSlug(t.name)}.webp`;

const getFallback = (t: TestimonialsPageTestimonial) =>
  t.gender === "female"
    ? `${baseUrl}images/avatars/fallback-female.svg`
    : `${baseUrl}images/avatars/fallback-male.svg`;

const total = testimonialsPageTestimonials.length;
// Simple alternating layout — every 7th tile is wide (col-span-8),
// rest are col-span-4. Rows always sum to 12, no gaps.
const getSpan = (_t: TestimonialsPageTestimonial, i: number) =>
  i % 7 === 0 ? "md:col-span-8" : "md:col-span-4";
---

<BaseLayout title={title} description={description} image={image}>

  <!-- Page hero -->
  <section
    class="relative bg-background border-b border-black/5 overflow-hidden"
    aria-label="Testimonials page header"
  >
    <!-- 4-col grid -->
    <div class="absolute inset-0 grid grid-cols-4 pointer-events-none" aria-hidden="true">
      <div class="border-r border-black/[0.04]"></div>
      <div class="border-r border-black/[0.04]"></div>
      <div class="border-r border-black/[0.04]"></div>
      <div></div>
    </div>

    <div class="main-container pt-36 pb-20 relative z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div>
          <span class="type-label text-on-background/40 block mb-4">Testimonials</span>
          <h1 class="type-h2 text-on-background uppercase max-w-2xl">
            Client proof across real delivery.
          </h1>
        </div>
        <div class="flex flex-col gap-3 flex-shrink-0 md:text-right">
          <div class="type-h2 text-on-background">{total}</div>
          <div class="type-label text-on-background/40">Verified reviews</div>
          <div class="flex items-center gap-2 md:justify-end mt-1">
            <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            <span class="type-label text-accent">5.0★ average</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Testimonials grid -->
  <section
    class="section-y bg-background border-b border-black/5"
    aria-label="All client testimonials"
  >
    <p class="sr-only">
      Full grid of client testimonials from founders and teams across Framer, Webflow, Shopify, and WordPress builds.
    </p>

    <div class="main-container">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-px bg-black/5">
        {testimonialsPageTestimonials.map((t, i) => {
          const span = getSpan(t, i);
          const meta = [t.role, t.company].filter(Boolean).join(", ");
          return (
            <article
              class:list={[
                "testimonial-tile bg-background flex flex-col p-6 md:p-8 group",
                span,
              ]}
              data-index={i}
              aria-label={`Testimonial from ${t.name}`}
            >
              <!-- Stars -->
              <div class="flex gap-1 mb-5" aria-label={`${t.stars ?? 5} out of 5 stars`}>
                {Array.from({ length: t.stars ?? 5 }).map((_, si) => (
                  <svg class="w-3 h-3 text-accent" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                    <path d="M6 0L7.35 4.18H11.71L8.18 6.77L9.53 10.95L6 8.36L2.47 10.95L3.82 6.77L0.29 4.18H4.65L6 0Z"/>
                  </svg>
                ))}
              </div>

              <!-- Quote -->
              <blockquote class="flex-1 m-0">
                <p class="type-body text-on-surface-variant leading-relaxed">"{t.quote}"</p>
              </blockquote>

              <!-- Attribution -->
              <footer class="mt-6 pt-5 border-t border-black/5">
                <cite class="not-italic flex items-center gap-3">
                  <img
                    src={getAvatarSrc(t)}
                    alt={`${t.name} profile photo`}
                    width="36"
                    height="36"
                    loading="lazy"
                    decoding="async"
                    class="w-9 h-9 object-cover bg-surface-container flex-shrink-0"
                    onerror={`this.onerror=null;this.src='${getFallback(t)}';`}
                  />
                  <div>
                    <span class="type-label text-on-background block">{t.name}</span>
                    {meta && <span class="type-label text-on-background/40 block mt-0.5">{meta}</span>}
                    {t.country && <span class="type-label text-on-background/30 block mt-0.5">{t.country}</span>}
                  </div>
                </cite>
              </footer>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <FAQ />
  <FinalCTA />
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>

<style>
  /* ── Ticker ────────────────────────────────────────────────── */
  @keyframes ticker-ltr {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .ticker-ltr {
    animation: ticker-ltr 30s linear infinite;
  }

  /* ── Tile entrance ─────────────────────────────────────────── */
  .testimonial-tile {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .testimonial-tile.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-ltr { animation: none; }
    .testimonial-tile { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const tiles = document.querySelectorAll('.testimonial-tile');

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el  = entry.target as HTMLElement;
      const idx = parseInt(el.dataset.index ?? '0');
      // Stagger in batches of 3 to avoid too much delay on large grids
      setTimeout(() => el.classList.add('is-visible'), (idx % 6) * 60);
      observer.unobserve(el);
    });
  }, { threshold: 0.05 });

  tiles.forEach(t => observer.observe(t));
</script>
