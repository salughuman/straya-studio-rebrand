---
// Human-readable sitemap page (distinct from /sitemap.xml generated by @astrojs/sitemap)
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { SITE_CONFIG } from "../data/site-config";

const title       = "Sitemap | Straya Studio";
const description = "All pages on the Straya Studio website.";

const sections = [
  {
    label: "Main",
    links: [
      { label: "Home",         href: "/" },
      { label: "Testimonials", href: "/testimonials" },
      { label: "Contact",      href: "/contact" },
    ],
  },
  {
    label: "Sections",
    links: [
      { label: "Selected Work",    href: "/#work" },
      { label: "Services",         href: "/#services" },
      { label: "The Straya Method",href: "/#method" },
      { label: "Why Straya",       href: "/#why" },
      { label: "Pricing",          href: "/#pricing" },
      { label: "About",            href: "/#about" },
      { label: "FAQ",              href: "/#faq" },
    ],
  },
  {
    label: "Legal",
    links: [
      { label: "Privacy Policy",     href: "/privacy" },
      { label: "Terms & Conditions", href: "/terms" },
      { label: "Sitemap (XML)",      href: "/sitemap-index.xml" },
    ],
  },
  {
    label: "Connect",
    links: [
      { label: "LinkedIn",  href: SITE_CONFIG.socials.linkedIn,       external: true },
      { label: "Framer",    href: SITE_CONFIG.socials.framer,         external: true },
      { label: "Contra",    href: SITE_CONFIG.socials.contra,         external: true },
      { label: "Fiverr",    href: SITE_CONFIG.socials.fiverr,         external: true },
      { label: "Book a call", href: SITE_CONFIG.socials.calendly,     external: true },
    ],
  },
];
---

<BaseLayout title={title} description={description} noindex={false}>

  <section
    aria-label="Sitemap"
    class="relative bg-background border-b border-black/5"
  >
    <div class="main-container pt-36 pb-24">

      <header class="mb-16 border-b border-black/5 pb-10">
        <span class="type-label text-on-background/40 block mb-3">Navigation</span>
        <h1 class="type-h2 text-on-background">Sitemap</h1>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-black/5">
        {sections.map(section => (
          <div class="bg-background card-pad flex flex-col gap-6">
            <span class="type-label text-on-background/40">{section.label}</span>
            <ul class="flex flex-col gap-4 list-none p-0">
              {section.links.map(link => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class="type-body-small text-on-surface-variant hover:text-on-background transition-colors duration-300 inline-flex items-center gap-2 group"
                  >
                    {link.label}
                    {link.external && (
                      <svg class="w-2.5 h-2.5 text-on-background/20 group-hover:text-on-background/50 transition-colors duration-300" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                        <path d="M2 8L8 2M8 2H4M8 2V6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>
  </section>

  <Footer />
</BaseLayout>
