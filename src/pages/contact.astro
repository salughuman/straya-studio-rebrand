---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_CONFIG } from "../data/site-config";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";

const title       = "Start a Project | Straya Studio";
const description = "Share your project brief with Straya Studio. We review every submission and reply with a clear fixed quote — no surprises.";
const image       = "/og-contact.png";
const pageUrl     = `${SITE_CONFIG.url}/contact/`;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title, description, url: pageUrl,
  isPartOf: { "@type": "WebSite", name: SITE_CONFIG.name, url: `${SITE_CONFIG.url}/` },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",    item: `${SITE_CONFIG.url}/` },
    { "@type": "ListItem", position: 2, name: "Contact", item: pageUrl },
  ],
};
---

<BaseLayout title={title} description={description} image={image}>

  <section
    id="contact"
    aria-label="Start a project"
    class="relative bg-background border-b border-black/5 overflow-hidden"
  >
    <div class="main-container pt-36 pb-24 relative z-10">

      <!-- Page header -->
      <header class="mb-16 border-b border-black/5 pb-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div>
            <span class="cp-el type-label text-on-background/40 block mb-3" data-delay="0">Start a project</span>
            <h1 class="type-h2 text-on-background max-w-lg">
              <span class="cp-line block overflow-hidden"><span class="cp-el inline-block" data-delay="80">Send your brief and</span></span>
              <span class="cp-line block overflow-hidden"><span class="cp-el inline-block" data-delay="140">get a fixed quote.</span></span>
            </h1>
            <p class="cp-el type-body-small text-on-surface-variant mt-3 max-w-md leading-relaxed" data-delay="240">
              Tell us what you're building, what success looks like, and any constraints. We review every brief directly and reply with the next best step.
            </p>
          </div>
          <!-- Calendly alternative -->
          <div class="cp-el flex-shrink-0 flex flex-col gap-3 md:text-right" data-delay="320">
            <span class="type-label text-on-background/40">Prefer a call?</span>
            <a
              href={SITE_CONFIG.socials.calendly}
              target="_blank"
              rel="noopener noreferrer"
              class="magnetic-cta inline-flex items-center gap-2 type-button text-on-background border-b border-on-background/20 pb-px hover:border-on-background transition-colors duration-300"
            >
              Book 30-min scoping call
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 11L11 3M11 3H6M11 3V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </header>

      <!-- Two-column layout: form left, info right -->
      <div class="cp-el grid grid-cols-1 lg:grid-cols-12 gap-px bg-black/5" data-delay="440">

        <!-- Form -->
        <div class="lg:col-span-8 bg-background card-pad">
          <form
            action={`https://formsubmit.co/${SITE_CONFIG.contactEmail}`}
            method="POST"
            id="project-brief-form"
            data-calendly={SITE_CONFIG.socials.calendly}
            class="flex flex-col gap-6"
          >
            <!-- Hidden fields -->
            <input type="hidden" name="_subject"  value="New Project Brief — Straya Studio"/>
            <input type="hidden" name="_captcha"  value="false"/>
            <input type="hidden" name="_template" value="table"/>
            <input type="hidden" name="_next"     value={`${SITE_CONFIG.url}/contact`}/>
            <input type="hidden" name="leadSource" value="contact-page"/>
            <input type="hidden" name="cta_source" id="cta-source" value="direct"/>
            <input type="hidden" name="cta_tier"   id="cta-tier"   value="unknown"/>
            <input type="hidden" name="tier"        id="tier-hidden" value="unknown"/>
            <input type="text"   name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true"/>

            <!-- Name + Email row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <label class="flex flex-col gap-2">
                <span class="type-label text-on-background/60">Full name <span class="text-accent" aria-hidden="true">*</span></span>
                <input
                  required name="name" type="text" autocomplete="name"
                  placeholder="Alex Morgan"
                  class="contact-input"
                />
              </label>
              <label class="flex flex-col gap-2">
                <span class="type-label text-on-background/60">Email <span class="text-accent" aria-hidden="true">*</span></span>
                <input
                  required name="email" type="email" autocomplete="email"
                  placeholder="you@example.com"
                  class="contact-input"
                />
              </label>
            </div>

            <!-- Platform -->
            <label class="flex flex-col gap-2">
              <span class="type-label text-on-background/60">Platform preference</span>
              <select name="platform" class="contact-input">
                <option value="">Not sure yet</option>
                <option value="Framer">Framer</option>
                <option value="Webflow">Webflow</option>
                <option value="Shopify">Shopify</option>
                <option value="Wix">Wix</option>
                <option value="WordPress">WordPress</option>
              </select>
            </label>

            <!-- Budget -->
            <label class="flex flex-col gap-2">
              <span class="type-label text-on-background/60">Budget range</span>
              <select name="budget" class="contact-input">
                <option value="">Select a range</option>
                <option value="$1,500–$2,000">$1,500 – $2,000 (Starter)</option>
                <option value="$3,500–$4,500">$3,500 – $4,500 (Growth)</option>
                <option value="$9,000+">$9,000+ (Premium)</option>
                <option value="Not sure">Not sure yet</option>
              </select>
            </label>

            <!-- Brief -->
            <label class="flex flex-col gap-2">
              <span class="type-label text-on-background/60">Project brief <span class="text-accent" aria-hidden="true">*</span></span>
              <textarea
                required name="brief" rows={6} autocomplete="off"
                placeholder="Share your goals, scope, platform preference, and any deadline constraints."
                class="contact-input resize-none"
              ></textarea>
            </label>

            <!-- Submit -->
            <div class="flex flex-col gap-3">
              <button
                type="submit"
                id="submit-btn"
                class="magnetic-cta w-full flex items-center justify-center gap-3 type-button bg-primary text-on-primary py-4 hover:bg-accent transition-colors duration-300"
              >
                <span id="submit-label">Send project brief</span>
                <svg id="submit-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <p id="form-status" class="type-label text-center hidden" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>

        <!-- Info sidebar -->
        <div class="lg:col-span-4 bg-surface-container-low flex flex-col gap-0">

          <!-- What happens next -->
          <div class="p-8 border-b border-black/5">
            <span class="type-label text-on-background/40 block mb-5">What happens next</span>
            <ol class="flex flex-col gap-5 list-none p-0">
              {[
                { n: "01", text: "We review your brief within 24 hours." },
                { n: "02", text: "We confirm scope fit and platform recommendation." },
                { n: "03", text: "You receive a fixed quote — no surprises." },
                { n: "04", text: "Kickoff call scheduled within 48 hours of acceptance." },
              ].map(step => (
                <li class="flex items-start gap-4">
                  <span class="type-label text-on-background/20 flex-shrink-0 w-6 tabular-nums">{step.n}</span>
                  <span class="type-body-small text-on-surface-variant leading-relaxed">{step.text}</span>
                </li>
              ))}
            </ol>
          </div>

          <!-- Trust signals -->
          <div class="p-8 border-b border-black/5">
            <span class="type-label text-on-background/40 block mb-5">Why Straya Studio</span>
            <ul class="flex flex-col gap-3 list-none p-0">
              {[
                "Fixed quotes — no hourly billing",
                "Direct line to the founder",
                "2–3 projects at a time",
                "100+ five-star deployments",
                "Certified Framer Expert",
              ].map(item => (
                <li class="flex items-center gap-3">
                  <svg class="w-3 h-3 text-accent flex-shrink-0" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="type-body-small text-on-surface-variant">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Contact direct -->
          <div class="p-8">
            <span class="type-label text-on-background/40 block mb-4">Or reach out directly</span>
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              class="type-label text-on-background hover:text-accent transition-colors duration-300 block mb-2"
            >
              {SITE_CONFIG.email}
            </a>
            <a
              href={SITE_CONFIG.socials.calendly}
              target="_blank"
              rel="noopener noreferrer"
              class="type-label text-on-background/40 hover:text-on-background transition-colors duration-300 block"
            >
              Book a 30-min call →
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>

  <FAQ />
  <FinalCTA />
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <script is:inline>
    (() => {
      // Pre-fill from URL params
      const params   = new URLSearchParams(window.location.search);
      const source   = params.get('source');
      const tier     = params.get('tier');
      const srcField = document.getElementById('cta-source');
      const tierField= document.getElementById('cta-tier');
      const tierHid  = document.getElementById('tier-hidden');

      if (source && srcField)  srcField.value  = source;
      if (tier   && tierField) {
        const n = tier.toLowerCase();
        tierField.value = n;
        if (tierHid) {
          if (n === 'starter') tierHid.value = 'Starter';
          if (n === 'growth')  tierHid.value = 'Growth';
          if (n === 'premium') tierHid.value = 'Premium';
        }
        // Pre-select budget
        const budgetSelect = document.querySelector('select[name="budget"]');
        if (budgetSelect) {
          if (n === 'starter') budgetSelect.value = '$1,500–$2,000';
          if (n === 'growth')  budgetSelect.value = '$3,500–$4,500';
          if (n === 'premium') budgetSelect.value = '$9,000+';
        }
      }

      // Form submission
      const form   = document.getElementById('project-brief-form');
      const btn    = document.getElementById('submit-btn');
      const label  = document.getElementById('submit-label');
      const arrow  = document.getElementById('submit-arrow');
      const status = document.getElementById('form-status');

      if (!(form instanceof HTMLFormElement)) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (btn instanceof HTMLButtonElement) btn.disabled = true;
        if (label) label.textContent = 'Sending…';
        if (arrow) arrow.style.display = 'none';

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error();

          if (label) label.textContent = 'Brief sent ✓';
          if (status) {
            status.textContent = 'Thank you — we\'ll review your brief and reply within 24 hours.';
            status.style.color = '#3CCD7F';
            status.classList.remove('hidden');
          }
          form.reset();
        } catch {
          if (label) label.textContent = 'Send project brief';
          if (arrow) arrow.style.display = '';
          if (btn instanceof HTMLButtonElement) btn.disabled = false;
          if (status) {
            status.textContent = 'Something went wrong. Please email us directly.';
            status.style.color = '#BA1A1A';
            status.classList.remove('hidden');
          }
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  /* ── Contact page entrance ─────────────────────────────────── */
  .cp-el { opacity: 0; transform: translateY(28px); }
  .cp-line .cp-el { transform: translateY(100%); opacity: 1; }

  .contact-input {
    width: 100%;
    background: theme('colors.surface-container-lowest');
    border: 1px solid rgba(0, 0, 0, 0.1);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-family: 'Instrument Sans', sans-serif;
    color: theme('colors.on-background');
    outline: none;
    transition: border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 0;
    appearance: none;
  }
  .contact-input::placeholder { color: rgba(0, 0, 0, 0.25); }
  .contact-input:focus {
    border-color: #3CCD7F;
    box-shadow: 0 0 0 3px rgba(60, 205, 127, 0.08);
  }
  select.contact-input {
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 7L11 1' stroke='%23777777' stroke-width='1.2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    padding-right: 2.5rem;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .cp-el { opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  const EASE     = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const DURATION = 900;

  // Above-the-fold — double rAF like hero
  const cpEls = document.querySelectorAll<HTMLElement>('.cp-el');
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      cpEls.forEach(el => {
        const delay  = parseInt(el.dataset.delay ?? '0');
        const isLine = el.closest('.cp-line') !== null;
        el.animate(
          isLine
            ? [{ transform: 'translateY(100%)' }, { transform: 'translateY(0%)' }]
            : [{ opacity: 0, transform: 'translateY(28px)' }, { opacity: 1, transform: 'translateY(0px)' }],
          { duration: DURATION, delay, easing: EASE, fill: 'forwards' }
        );
      });
    });
  });
</script>
