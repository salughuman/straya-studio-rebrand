---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_CONFIG } from "../data/site-config";
import Footer from "../components/Footer.astro";

const title = "Start a Project | Straya Studio";
const description =
  "Share your project brief with Straya Studio. We review every submission and reply with a clear fixed quote — no surprises.";
const image = "/og-contact.png";
const pageUrl = `${SITE_CONFIG.url}/contact/`;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: pageUrl,
  isPartOf: { "@type": "WebSite", name: SITE_CONFIG.name, url: `${SITE_CONFIG.url}/` },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_CONFIG.url}/` },
    { "@type": "ListItem", position: 2, name: "Contact", item: pageUrl },
  ],
};

const projectTiers = [
  { value: "Landing Page ($2,500)", label: "Landing Page", price: "$2,500", time: "1–2 wks" },
  { value: "Growth Website ($5,000)", label: "Growth Website", price: "$5,000", time: "2–5 wks", popular: true },
  { value: "Digital Product (Custom)", label: "Digital Product", price: "Custom", time: "4–8+ wks" },
];

const steps = [
  { n: "01", text: "We review your brief within 24 hours." },
  { n: "02", text: "You receive a fixed scope and quote." },
  { n: "03", text: "Kickoff call within 48 hours of acceptance." },
];

const trustPoints = [
  "Fixed quote — no hourly billing",
  "Direct line to the founder, always",
  "Certified Framer Expert · 100+ deployments",
  "2–3 active projects at a time — focused attention",
];
---

<BaseLayout title={title} description={description} image={image}>
  <section
    id="contact"
    aria-label="Start a project"
    class="section-frosted relative overflow-hidden pt-28 pb-0 md:pt-36"
  >
    <div class="main-container relative z-10">

      <!-- ── Headline ─────────────────────────────────────────── -->
      <div class="mb-14 md:mb-16 max-w-3xl">
        <p class="cp-el type-label-small mb-5 inline-flex items-center gap-2 uppercase tracking-blueprint text-on-background/50" data-delay="0">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          Currently taking on new projects
        </p>
        <h1 class="m-0 font-display font-semibold text-on-background" style="font-size: clamp(2.8rem, 1.2rem + 5vw, 5.5rem); line-height: 1.04; letter-spacing: -0.018em;">
          <span class="cp-line block overflow-hidden">
            <span class="cp-el inline-block" data-delay="60">Tell us what</span>
          </span>
          <span class="cp-line block overflow-hidden">
            <span class="cp-el inline-block text-accent" data-delay="140">you're building.</span>
          </span>
        </h1>
        <p class="cp-el type-body m-0 mt-6 max-w-[44ch] text-on-background/55 leading-relaxed" data-delay="260">
          Send a brief — we respond with a clear scope and fixed quote. No obligation, no hourly rates.
        </p>
      </div>

      <!-- ── Grid ────────────────────────────────────────────── -->
      <div class="cp-el grid grid-cols-1 gap-4 lg:grid-cols-12 lg:gap-5 pb-20 md:pb-28" data-delay="360">

        <!-- ── Form ─────────────────────────────────────────── -->
        <div class="lg:col-span-7 bg-on-background/[0.04] border border-on-background/[0.07] p-6 md:p-10">
          <form
            action={`https://formsubmit.co/${SITE_CONFIG.contactEmail}`}
            method="POST"
            id="project-brief-form"
            class="flex flex-col gap-6"
          >
            <!-- Tracking fields -->
            <input type="hidden" name="_subject"  value="New Project Brief — Straya Studio" />
            <input type="hidden" name="_captcha"  value="false" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_next"     value={`${SITE_CONFIG.url}/contact`} />
            <input type="hidden" name="leadSource" value="contact-page" />
            <input type="hidden" name="cta_source" id="cta-source" value="direct" />
            <input type="hidden" name="cta_tier"   id="cta-tier"   value="unknown" />
            <input type="text"   name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

            <!-- Name + Email -->
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div class="cf-field">
                <label class="cf-label" for="contact-name">
                  Name <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <input
                  id="contact-name"
                  required
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder="Alex Morgan"
                  class="cf-input"
                />
              </div>
              <div class="cf-field">
                <label class="cf-label" for="contact-email">
                  Email <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <input
                  id="contact-email"
                  required
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="you@example.com"
                  class="cf-input"
                />
              </div>
            </div>

            <!-- Project type chips -->
            <fieldset class="border-0 m-0 p-0">
              <legend class="cf-label mb-3 block">Project type</legend>
              <div class="grid grid-cols-3 gap-2" role="group" aria-label="Select a project type">
                {projectTiers.map((tier) => (
                  <label class="chip-option relative cursor-pointer select-none">
                    <input
                      type="radio"
                      name="budget"
                      value={tier.value}
                      data-tier-slug={tier.label.toLowerCase().replace(/\s+/g, "-")}
                      class="sr-only"
                    />
                    {tier.popular && (
                      <span class="chip-badge absolute -top-px left-3 right-3 h-px bg-accent/70" aria-hidden="true"></span>
                    )}
                    <span class="chip-body flex flex-col gap-1 p-3 md:p-4">
                      <span class="chip-name font-body text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-on-background/75 leading-none">
                        {tier.label}
                      </span>
                      <span class="chip-price font-display font-bold text-on-background leading-none" style="font-size: clamp(1rem, 1.6vw, 1.25rem);">
                        {tier.price}
                      </span>
                      <span class="chip-time font-body text-[0.62rem] uppercase tracking-[0.06em] text-on-background/40 leading-none">
                        {tier.time}
                      </span>
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>

            <!-- Brief -->
            <div class="cf-field">
              <div class="flex items-baseline justify-between mb-2">
                <label class="cf-label" for="contact-brief">
                  Brief <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <span id="brief-count" class="font-mono text-[0.6rem] tracking-widest text-on-background/25 tabular-nums" aria-live="polite">0 / 800</span>
              </div>
              <textarea
                id="contact-brief"
                required
                name="brief"
                rows={5}
                maxlength={800}
                autocomplete="off"
                placeholder="What are you building? Goals, timeline, references — anything that helps us quote accurately."
                class="cf-input cf-textarea resize-none"
              ></textarea>
            </div>

            <!-- Submit -->
            <div class="flex flex-col gap-3">
              <button type="submit" id="submit-btn" class="cf-submit">
                <span id="submit-label">Get a fixed quote</span>
                <svg id="submit-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="ml-2 transition-transform duration-300 group-hover:translate-x-1">
                  <path d="M2.5 8h11M9 3.5L13.5 8 9 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <p id="form-status" class="type-label-small hidden text-center" role="status" aria-live="polite"></p>
              <p class="type-label-small m-0 text-center tracking-blueprint text-on-background/30">
                No commitment · Reply within 24 hours
              </p>
            </div>

          </form>
        </div>

        <!-- ── Sidebar ────────────────────────────────────────── -->
        <aside class="lg:col-span-5 flex flex-col gap-4" aria-label="Why Straya Studio">

          <!-- What happens next -->
          <div class="bg-on-background/[0.04] border border-on-background/[0.07] px-6 py-7 md:px-8 md:py-8">
            <p class="type-label-small mb-5 font-mono uppercase tracking-[0.12em] text-on-background/45 m-0">
              What happens next
            </p>
            <ol class="m-0 list-none p-0 flex flex-col">
              {steps.map(({ n, text }) => (
                <li class="flex items-start gap-4 py-4 border-b border-on-background/[0.07] last:border-0 last:pb-0 first:pt-0">
                  <span class="font-mono text-[0.65rem] font-semibold tabular-nums text-accent shrink-0 mt-px">{n}</span>
                  <span class="type-body-small text-on-background/70 leading-relaxed">{text}</span>
                </li>
              ))}
            </ol>
          </div>

          <!-- Trust -->
          <div class="bg-on-background/[0.04] border border-on-background/[0.07] px-6 py-7 md:px-8 md:py-8 flex-1">
            <p class="type-label-small mb-5 font-mono uppercase tracking-[0.12em] text-on-background/45 m-0">
              Why Straya
            </p>
            <ul class="m-0 list-none p-0 flex flex-col gap-3">
              {trustPoints.map((text) => (
                <li class="flex items-start gap-3">
                  <svg class="h-3 w-3 shrink-0 text-accent mt-[0.2rem]" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 6.5L4.5 9L10 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="type-body-small text-on-background/70 leading-snug">{text}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Prefer a call -->
          <div class="flex items-center justify-between gap-4">
            <span class="type-label-small font-mono uppercase tracking-blueprint text-on-background/35">Prefer a call?</span>
            <a
              href={SITE_CONFIG.socials.calendly}
              target="_blank"
              rel="noopener noreferrer"
              class="type-label-small font-semibold tracking-blueprint uppercase text-on-background/60 hover:text-accent transition-colors duration-200"
            >
              Book 30 min →
            </a>
          </div>

        </aside>
      </div>
    </div>
  </section>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <script is:inline>
    (() => {
      // Pre-fill project type chip from URL param (?tier=growth-website etc.)
      const params = new URLSearchParams(window.location.search);
      const source = params.get("source");
      const tier   = params.get("tier");

      const srcField = document.getElementById("cta-source");
      const tierField = document.getElementById("cta-tier");
      if (source && srcField) srcField.value = source;
      if (tier && tierField) tierField.value = tier;

      if (tier) {
        const slug = tier.toLowerCase();
        const radio = document.querySelector(`input[data-tier-slug="${slug}"]`);
        if (radio instanceof HTMLInputElement) radio.checked = true;
      }

      // Character counter on brief textarea
      const brief    = document.getElementById("contact-brief");
      const counter  = document.getElementById("brief-count");
      if (brief instanceof HTMLTextAreaElement && counter) {
        brief.addEventListener("input", () => {
          counter.textContent = brief.value.length + " / 800";
        });
      }

      // Form submit
      const form   = document.getElementById("project-brief-form");
      const btn    = document.getElementById("submit-btn");
      const lbl    = document.getElementById("submit-label");
      const arrow  = document.getElementById("submit-arrow");
      const status = document.getElementById("form-status");

      if (!(form instanceof HTMLFormElement)) return;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (btn instanceof HTMLButtonElement) btn.disabled = true;
        if (arrow) arrow.style.display = "none";
        if (lbl)   lbl.textContent = "Sending…";

        try {
          const res = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });
          if (!res.ok) throw new Error();
          if (lbl)   lbl.textContent = "Brief sent ✓";
          if (status) {
            status.textContent = "We'll review your brief and reply within 24 hours.";
            status.className = "type-label-small text-center text-accent";
            status.classList.remove("hidden");
          }
          form.reset();
          if (counter) counter.textContent = "0 / 800";
        } catch {
          if (lbl)   lbl.textContent = "Get a fixed quote";
          if (arrow) arrow.style.display = "";
          if (btn instanceof HTMLButtonElement) btn.disabled = false;
          if (status) {
            status.textContent = "Something went wrong — email hello@strayastudio.com directly.";
            status.className = "type-label-small text-center text-error";
            status.classList.remove("hidden");
          }
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  /* ── Entrance animation ───────────────────────────────────── */
  .cp-el { opacity: 0; transform: translateY(22px); }
  .cp-line .cp-el { opacity: 1; transform: translateY(100%); }
  @media (prefers-reduced-motion: reduce) {
    .cp-el { opacity: 1 !important; transform: none !important; }
  }

  /* ── Form labels ──────────────────────────────────────────── */
  .cf-label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 237, 215, 0.50);
  }
  .cf-field { display: flex; flex-direction: column; gap: 0.5rem; }

  /* ── Dark form inputs ─────────────────────────────────────── */
  .cf-input {
    width: 100%;
    border: 1px solid rgba(255, 237, 215, 0.10);
    border-radius: 0;
    appearance: none;
    min-height: 2.75rem;
    padding: 0.75rem 0.875rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    font-family: var(--font-body, system-ui, sans-serif);
    color: var(--color-fg);
    caret-color: var(--color-accent);
    background-color: rgba(255, 237, 215, 0.03);
    outline: none;
    transition:
      border-color 180ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 180ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cf-input::placeholder { color: rgba(255, 237, 215, 0.25); }
  @media (hover: hover) and (pointer: fine) {
    .cf-input:hover:not(:focus) {
      border-color: rgba(255, 237, 215, 0.20);
      background-color: rgba(255, 237, 215, 0.05);
    }
  }
  .cf-input:focus {
    border-color: rgba(220, 80, 0, 0.65);
    background-color: rgba(220, 80, 0, 0.04);
    box-shadow: 0 0 0 3px rgba(220, 80, 0, 0.12);
  }
  .cf-textarea { min-height: 7rem; padding-top: 0.875rem; padding-bottom: 0.875rem; }

  /* Dark autofill */
  .cf-input:-webkit-autofill,
  .cf-input:-webkit-autofill:hover,
  .cf-input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--color-fg) !important;
    -webkit-box-shadow: 0 0 0 1000px rgba(8, 6, 5, 0.92) inset !important;
    caret-color: var(--color-accent);
    transition: background-color 99999s ease-out 0s;
  }

  /* ── Project type chips ───────────────────────────────────── */
  .chip-option {
    border: 1px solid rgba(255, 237, 215, 0.10);
    background: transparent;
    transition:
      border-color 200ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .chip-option:hover {
      border-color: rgba(255, 237, 215, 0.22);
      background-color: rgba(255, 237, 215, 0.04);
    }
  }
  .chip-option:has(:checked) {
    border-color: rgba(220, 80, 0, 0.55);
    background-color: rgba(220, 80, 0, 0.07);
  }
  .chip-option:has(:checked) .chip-name { color: rgba(255, 237, 215, 0.95); }
  .chip-option:has(:checked) .chip-price { color: #dc5000; }
  .chip-option:focus-within {
    outline: 2px solid rgba(220, 80, 0, 0.5);
    outline-offset: 2px;
  }

  /* ── Submit button ────────────────────────────────────────── */
  .cf-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border-radius: 9999px;
    background: var(--color-bg-inverted);
    padding: 0.875rem 1.75rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-inverted);
    border: none;
    cursor: pointer;
    transition:
      opacity 200ms ease,
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 200ms ease;
  }
  .cf-submit:hover:not(:disabled) { opacity: 0.88; transform: translateY(-1px); }
  .cf-submit:active:not(:disabled) { transform: translateY(0); opacity: 0.95; }
  .cf-submit:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<script>
  const EASE     = "cubic-bezier(0.16, 1, 0.3, 1)";
  const DURATION = 900;

  const cpEls = document.querySelectorAll<HTMLElement>(".cp-el");
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      cpEls.forEach((el) => {
        const delay  = parseInt(el.dataset.delay ?? "0", 10);
        const isLine = el.closest(".cp-line") !== null;
        el.animate(
          isLine
            ? [{ transform: "translateY(100%)" }, { transform: "translateY(0%)" }]
            : [{ opacity: 0, transform: "translateY(22px)" }, { opacity: 1, transform: "translateY(0px)" }],
          { duration: DURATION, delay, easing: EASE, fill: "forwards" },
        );
      });
    });
  });
</script>
