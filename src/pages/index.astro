---
import BaseLayout from "../layouts/BaseLayout.astro";
import AEOHeader from "../components/AEOHeader.astro";
import Hero from "../components/Hero.astro";
import ServicesMarquee from "../components/ServicesMarquee.astro";
import AboutSection from "../components/AboutSection.astro";
import WhyStraya from "../components/WhyStraya.astro";
import StrayaOffer from "../components/StrayaOffer.astro";
import Testimonials from "../components/Testimonials.astro";
import SelectedWork from "../components/SelectedWork.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import { SITE_CONFIG } from "../data/site-config";

const title = "Straya Studio — Framer, Webflow & Shopify Partner";
const description =
	"Premium technical partner for Framer, Webflow, Shopify & WordPress builds. Fast, conversion-led platforms for tech founders and ecommerce teams.";
const image = "/og-home.png";

const pageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: title,
	description,
	url: `${SITE_CONFIG.url}/`,
	isPartOf: {
		"@type": "WebSite",
		name: SITE_CONFIG.name,
		url: `${SITE_CONFIG.url}/`,
	},
};
---

<BaseLayout title={title} description={description} image={image}>
	<AEOHeader />

	<!-- 01: Hero -->
	<Hero />

	<!-- 02: About -->
	<AboutSection />

	<!-- 03: Selected Work -->
	<SelectedWork />

	<!-- 04: The Straya Method — cinematic horizontal scroll -->
	<WhyStraya />

	<!-- 05: Social Proof -->
	<Testimonials />

	<!-- 06: Services -->
	<ServicesMarquee />

	<!-- 07: The Straya Offer — bento grid -->
	<StrayaOffer />

	<!-- 08: FAQ -->
	<FAQ />

	<Footer />

	<script
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(pageSchema)}
	/>
</BaseLayout>
