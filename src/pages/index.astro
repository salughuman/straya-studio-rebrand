---
import BaseLayout from "../layouts/BaseLayout.astro";
import AEOHeader from "../components/AEOHeader.astro";
import Hero from "../components/Hero.astro";
import ServicesMarquee from "../components/ServicesMarquee.astro";
import TheStrayaMethod from "../components/TheStrayaMethod.astro";
import OurDifference from "../components/OurDifference.astro";
import AboutSection from "../components/AboutSection.astro";
import WhyStraya from "../components/WhyStraya.astro";
import Pricing from "../components/Pricing.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import { SITE_CONFIG } from "../data/site-config";
// SEO Metadata: Aligned with Straya Studio hybrid model
const title = "Straya Studio — Framer, Webflow & Shopify Partner";
const description =
	"Premium technical partner for Framer, Webflow, Shopify & WordPress builds. Fast, conversion-led platforms for tech founders and ecommerce teams.";
const image = "/og-home.png";

const pageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: title,
	description,
	url: `${SITE_CONFIG.url}/`,
	isPartOf: {
		"@type": "WebSite",
		name: SITE_CONFIG.name,
		url: `${SITE_CONFIG.url}/`,
	},
};
---

<BaseLayout title={title} description={description} image={image} noindex={true}>
	<!-- AEO preface for crawlers and assistants -->
	<AEOHeader />
	<!-- 01: Hero (qualify) -->
	<Hero />

	<!-- 02: Social Proof & Trust Signals (validate) -->
	<Testimonials />

	<!-- 03: What we do (scope) -->
	<ServicesMarquee />

	<!-- 04: Our process (trust) -->
	<TheStrayaMethod />

	<!-- 05: Why Straya Studio (differentiate) -->

	<WhyStraya />

	<!-- 06: Pricing (commit) -->
	<Pricing />

	<!-- 07: About section (context) -->
	<AboutSection />
	<OurDifference />
	<!-- 08: FAQ (reassure) -->
	<FAQ />

	<!-- 09: Final CTA (convert) -->
	<FinalCTA />
	<!-- Footer -->
	<Footer />
	<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
</BaseLayout>
