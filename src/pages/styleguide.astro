---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/buttons/Button.astro";
import tokens from "../styles/design-tokens.json";

const title = "Straya Studio Style Guide";
const description =
  "Technical manual for Straya Studio design system, tokens, and component standards.";

const inspectorTokens = [
  { label: "Base", value: tokens.color.background.base, token: "--color-background-base", tailwind: "bg-bg-base" },
  { label: "Surface", value: tokens.color.background.surface, token: "--color-background-surface", tailwind: "bg-bg-surface" },
  { label: "Elevated", value: tokens.color.background.elevated, token: "--color-background-elevated", tailwind: "bg-bg-elevated" },
  { label: "Accent", value: tokens.color.background.accent, token: "--color-accent", tailwind: "bg-brand-secondary" },
  { label: "Radius md", value: tokens.radius.md, token: "--radius-md", tailwind: "rounded-md / rounded-[var(--radius-md)]" },
  { label: "Shadow md", value: tokens.shadow.md, token: "--shadow-md", tailwind: "shadow-md" },
];

const colorSwatches = [
  { label: "Base", value: tokens.color.background.base, token: "--color-background-base", cls: "bg-bg-base" },
  { label: "Surface", value: tokens.color.background.surface, token: "--color-background-surface", cls: "bg-bg-surface" },
  { label: "Elevated", value: tokens.color.background.elevated, token: "--color-background-elevated", cls: "bg-bg-elevated" },
  { label: "Accent", value: tokens.color.background.accent, token: "--color-accent", cls: "bg-brand-secondary" },
  { label: "Success", value: tokens.color.status.success, token: "--color-status-success", cls: "bg-status-success" },
  { label: "Warning", value: tokens.color.status.warning, token: "--color-status-warning", cls: "bg-status-warning" },
  { label: "Error", value: tokens.color.status.error, token: "--color-status-error", cls: "bg-status-error" },
];

const typeSpecs = [
  { name: "H1", sample: "Designing Ideas Into Icons", cls: "type-h1", size: tokens.typography.h1.fontSize, lh: tokens.typography.h1.lineHeight, track: tokens.typography.h1.letterSpacing, family: "Bricolage Grotesque" },
  { name: "H2", sample: "Section Heading System", cls: "type-h2", size: tokens.typography.h2.fontSize, lh: tokens.typography.h2.lineHeight, track: tokens.typography.h2.letterSpacing, family: "Bricolage Grotesque" },
  { name: "H3", sample: "Card Heading", cls: "type-h3", size: tokens.typography.h3.fontSize, lh: tokens.typography.h3.lineHeight, track: tokens.typography.h3.letterSpacing, family: "Bricolage Grotesque" },
  { name: "H4", sample: "Subheading", cls: "type-h4", size: tokens.typography.h4.fontSize, lh: tokens.typography.h4.lineHeight, track: tokens.typography.h4.letterSpacing, family: "Bricolage Grotesque" },
  { name: "H5", sample: "Label Heading", cls: "type-h5", size: tokens.typography.h5.fontSize, lh: tokens.typography.h5.lineHeight, track: tokens.typography.h5.letterSpacing, family: "Bricolage Grotesque" },
  { name: "H6 / Label", sample: "UPPERCASE LABEL", cls: "type-label text-brand-secondary", size: tokens.typography.label.fontSize, lh: tokens.typography.label.lineHeight, track: tokens.typography.label.letterSpacing, family: "Inter" },
  { name: "Lead", sample: "Lead copy explains context in one concise paragraph.", cls: "type-body-lg text-text-secondary", size: tokens.typography.bodyLarge.fontSize, lh: tokens.typography.bodyLarge.lineHeight, track: tokens.typography.bodyLarge.letterSpacing, family: "Inter" },
  { name: "Body", sample: "Body copy is optimized for readability across all breakpoints.", cls: "type-body text-text-secondary", size: tokens.typography.body.fontSize, lh: tokens.typography.body.lineHeight, track: tokens.typography.body.letterSpacing, family: "Inter" },
  { name: "Caption", sample: "Caption and helper text.", cls: "type-small text-text-muted", size: tokens.typography.small.fontSize, lh: tokens.typography.small.lineHeight, track: tokens.typography.small.letterSpacing, family: "Inter" },
];

const radii = [
  { name: "xs", value: tokens.radius.xs, varName: "--radius-xs", cls: "rounded-[var(--radius-xs)]" },
  { name: "sm", value: tokens.radius.sm, varName: "--radius-sm", cls: "rounded-[var(--radius-sm)]" },
  { name: "md", value: tokens.radius.md, varName: "--radius-md", cls: "rounded-[var(--radius-md)]" },
  { name: "lg", value: tokens.radius.lg, varName: "--radius-lg", cls: "rounded-[var(--radius-lg)]" },
];
---

<BaseLayout title={title} description={description}>
  <section class="styleguide-shell">
    <div class="main-container guide-grid">
      <aside class="toc glass">
        <p class="type-label text-brand-secondary">Table of Contents</p>
        <nav class="toc-links">
          <a href="#inspector">Token Inspector</a>
          <a href="#colors">Color Architecture</a>
          <a href="#type">Typography Scale</a>
          <a href="#radius">Radius Scale</a>
          <a href="#elevation">Shadows & Glows</a>
          <a href="#buttons">Buttons</a>
          <a href="#forms">Form Elements</a>
          <a href="#cards">Cards</a>
          <a href="#grid-lab">Grid System Lab</a>
          <a href="#icons">Iconography</a>
        </nav>
      </aside>

      <div class="content-col">
        <header class="section-head">
          <p class="type-label text-brand-secondary">Straya Studio Design System</p>
          <h1 class="type-h2">Style Guide / Technical Manual</h1>
          <p class="type-body text-text-secondary">
            Source of truth for visual language, token values, and component construction.
          </p>
        </header>

        <section id="inspector" class="guide-section">
          <div class="section-row">
            <h2 class="type-h3">Token Inspector</h2>
            <p class="type-small text-text-muted">
              Click any line to copy. This is the “source of truth” view.
            </p>
          </div>
          <div class="spec-grid">
            {inspectorTokens.map((t) => (
              <article class="spec-card">
                <div class="render-box">
                  <div class="inspector-head">
                    <p class="type-small text-text-primary">{t.label}</p>
                    <button class="copy-pill" type="button" data-copy="all">Copy</button>
                  </div>
                  <div class="inspector-lines" data-inspector>
                    <button class="copy-line" type="button" data-copy-value={t.value}>{t.value}</button>
                    <button class="copy-line" type="button" data-copy-value={t.token}>{t.token}</button>
                    <button class="copy-line" type="button" data-copy-value={t.tailwind}>{t.tailwind}</button>
                  </div>
                </div>
                <div class="spec-lines">
                  <p class="mono">value · token · tailwind</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="colors" class="guide-section">
          <h2 class="type-h3">Color Architecture</h2>
          <div class="spec-grid">
            {colorSwatches.map((c) => (
              <article class="spec-card">
                <div class="render-box">
                  <div class:list={["swatch", c.cls]} />
                </div>
                <div class="spec-lines">
                  <p class="type-small text-text-primary">{c.label}</p>
                  <p class="mono">{c.value}</p>
                  <p class="mono">{c.token}</p>
                  <p class="mono">{c.cls}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="type" class="guide-section">
          <h2 class="type-h3">Typography Scale</h2>
          <div class="stack">
            {typeSpecs.map((t) => (
              <article class="spec-card">
                <div class="render-box">
                  <p class:list={[t.cls]}>{t.sample}</p>
                </div>
                <div class="spec-lines">
                  <p class="type-small text-text-primary">{t.name}</p>
                  <p class="mono">font-family: {t.family}</p>
                  <p class="mono">font-size: {t.size}</p>
                  <p class="mono">line-height: {t.lh}</p>
                  <p class="mono">tracking: {t.track}</p>
                  <p class="mono">class: {t.cls}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="radius" class="guide-section">
          <h2 class="type-h3">Radius Scale</h2>
          <div class="spec-grid">
            {radii.map((r) => (
              <article class="spec-card">
                <div class="render-box">
                  <div class="radius-stage">
                    <div class:list={["radius-demo", r.cls]}>
                      <div class="radius-corner" aria-hidden="true" />
                      <div class="radius-corner corner-br" aria-hidden="true" />
                    </div>
                    <div class="radius-compare">
                      <div class="radius-chip" style={`border-radius: ${r.value};`} aria-hidden="true" />
                      <div class="radius-chip square" aria-hidden="true" />
                    </div>
                  </div>
                </div>
                <div class="spec-lines">
                  <p class="type-small text-text-primary">{r.name}</p>
                  <p class="mono">{r.value}</p>
                  <p class="mono">{r.varName}</p>
                  <p class="mono">{r.cls}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="elevation" class="guide-section">
          <h2 class="type-h3">Shadows & Glows</h2>
          <div class="elevation-controls">
            <button class="elev-btn is-active" type="button" data-elev="md">md</button>
            <button class="elev-btn" type="button" data-elev="lg">lg</button>
            <button class="elev-btn" type="button" data-elev="diffusion">diffusion</button>
            <button class="elev-btn" type="button" data-elev="frosted">frosted</button>
            <button class="elev-btn" type="button" data-elev="glow">glow</button>
          </div>
          <div class="spec-grid">
            <article class="spec-card">
              <div class="render-box">
                <div class="elevation-stage">
                  <div class="elevation-target" data-elev-target />
                </div>
              </div>
              <div class="spec-lines">
                <p class="type-small text-text-primary">Elevation Preview (interactive)</p>
                <p class="mono">md: {tokens.shadow.md}</p>
                <p class="mono">lg: {tokens.shadow.lg}</p>
                <p class="mono">diffusion: {tokens.shadow.diffusion}</p>
                <p class="mono">frosted: {tokens.shadow.frosted}</p>
                <p class="mono">glow: {tokens.shadow.primary}</p>
              </div>
            </article>
            <article class="spec-card">
              <div class="render-box">
                <div class="elevation-glow" />
              </div>
              <div class="spec-lines">
                <p class="type-small text-text-primary">Primary Glow</p>
                <p class="mono">{tokens.shadow.primary}</p>
                <p class="mono">radial-gradient + shadow-primary</p>
              </div>
            </article>
            <article class="spec-card">
              <div class="render-box">
                <div class="elevation-frosted" />
              </div>
              <div class="spec-lines">
                <p class="type-small text-text-primary">Frosted Surface</p>
                <p class="mono">backdrop-blur(24px)</p>
                <p class="mono">{tokens.shadow.frosted}</p>
                <p class="mono">class: glass-elevated</p>
              </div>
            </article>
          </div>
        </section>

        <section id="buttons" class="guide-section">
          <h2 class="type-h3">Buttons</h2>
          <div class="stack">
            <article class="spec-card">
              <div class="render-box buttons-row">
                <Button href="#buttons" label="PrimaryButton" variant="primary" class="!w-fit" />
                <Button href="#buttons" label="SecondaryButton" variant="secondary" class="!w-fit" />
                <Button href="#buttons" label="CTA Icon" variant="light" class="!w-fit">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </Button>
              </div>
              <div class="spec-lines">
                <p class="mono">Default / Hover / Active handled via transition + transform</p>
                <p class="mono">Button.astro variants: primary | secondary | light</p>
              </div>
            </article>
            <article class="spec-card">
              <div class="render-box buttons-row">
                <Button href="#buttons" label="Ghost" variant="ghost" class="!w-fit !px-4 !py-2 !text-sm" />
                <Button href="#buttons" label="Frosted" variant="frosted" class="!w-fit !px-4 !py-2 !text-sm" />
                <button class="btn-disabled" disabled>Disabled</button>
              </div>
              <div class="spec-lines">
                <p class="mono">Button.astro variants: ghost | frosted</p>
                <p class="mono">disabled: opacity-45 + not-allowed cursor</p>
              </div>
            </article>
          </div>
        </section>

        <section id="forms" class="guide-section">
          <h2 class="type-h3">Form Elements</h2>
          <article class="spec-card">
            <div class="render-box">
              <form class="form-lab">
                <label class="type-small">Project Name
                  <input type="text" value="Start Your Build" />
                </label>
                <label class="type-small">Project Details
                  <textarea rows="4">Tell us what you need built, timeline, and platform preference.</textarea>
                </label>
                <fieldset class="radio-group">
                  <legend class="type-small">Platform Preference</legend>
                  <label><input type="radio" name="platform" checked /> Framer</label>
                  <label><input type="radio" name="platform" /> Webflow</label>
                  <label><input type="radio" name="platform" /> Shopify</label>
                </fieldset>
              </form>
            </div>
            <div class="spec-lines">
              <p class="mono">Inputs: border-white/10, bg-surface, focus:ring-accent/35</p>
              <p class="mono">Textarea + radio share 1.5px stroke iconography language</p>
            </div>
          </article>
        </section>

        <section id="cards" class="guide-section">
          <h2 class="type-h3">Cards</h2>
          <div class="spec-grid">
            <article class="spec-card">
              <div class="render-box">
                <div class="sample-card">
                  <p class="type-label text-brand-secondary">Pricing Card</p>
                  <h3 class="type-h5">Growth</h3>
                  <p class="type-small text-text-secondary">$5,000 – $12,000 · 2–4 weeks</p>
                </div>
              </div>
              <div class="spec-lines">
                <p class="mono">border: var(--color-border-default)</p>
                <p class="mono">radius: var(--radius-md)</p>
                <p class="mono">bg: var(--color-background-surface)</p>
              </div>
            </article>
            <article class="spec-card">
              <div class="render-box">
                <div class="sample-card service">
                  <p class="type-label text-brand-secondary">Service Card</p>
                  <h3 class="type-h5">Web Development</h3>
                  <p class="type-small text-text-secondary">Framer, Webflow, Shopify, WordPress</p>
                </div>
              </div>
              <div class="spec-lines">
                <p class="mono">border-white/10 + hover border brighten</p>
                <p class="mono">shadow-diffusion + shadow-primary on hover</p>
              </div>
            </article>
          </div>
        </section>

        <section id="grid-lab" class="guide-section">
          <h2 class="type-h3">Grid System / Technical Blueprint</h2>
          <article class="spec-card">
            <div class="render-box">
              <details class="grid-toggle" open>
                <summary class="type-small">Toggle 8pt grid overlay</summary>
                <div class="grid-demo">
                  <div class="blueprint-grid sample-surface"></div>
                </div>
              </details>
            </div>
            <div class="spec-lines">
              <p class="mono">8pt base unit: {tokens.spacing["8pt"]}px</p>
              <p class="mono">background-size: 32px 32px technical blueprint</p>
            </div>
          </article>
        </section>

        <section id="icons" class="guide-section">
          <h2 class="type-h3">Iconography</h2>
          <article class="spec-card">
            <div class="render-box icon-row">
              <svg viewBox="0 0 24 24" fill="none" class="icon"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg viewBox="0 0 24 24" fill="none" class="icon"><path d="m4 12 5 5 11-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg viewBox="0 0 24 24" fill="none" class="icon"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg viewBox="0 0 24 24" fill="none" class="icon"><path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div class="spec-lines">
              <p class="mono">Standard stroke width: 1.5px</p>
              <p class="mono">linecap: round · linejoin: round</p>
            </div>
          </article>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const copyText = async (text) => {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    }
  };

  // Token inspector copy
  document.addEventListener("click", async (e) => {
    const btn = e.target?.closest?.("[data-copy-value]");
    if (!btn) return;
    const val = btn.getAttribute("data-copy-value");
    if (!val) return;
    await copyText(val);
    btn.classList.add("copied");
    setTimeout(() => btn.classList.remove("copied"), 700);
  });

  // Elevation toggles
  const elevButtons = Array.from(document.querySelectorAll("[data-elev]"));
  const target = document.querySelector("[data-elev-target]");
  const applyElev = (mode) => {
    if (!target) return;
    target.setAttribute("data-mode", mode);
    elevButtons.forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-elev") === mode));
  };
  elevButtons.forEach((b) => b.addEventListener("click", () => applyElev(b.getAttribute("data-elev"))));
  applyElev("md");
</script>

<style>
  .styleguide-shell {
    position: relative;
    z-index: 10;
    padding: 7.5rem 0;
    background: transparent;
  }
  .guide-grid {
    display: grid;
    gap: 1.5rem;
  }
  .toc {
    position: sticky;
    top: 6rem;
    align-self: start;
    padding: 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-default);
    background: var(--color-background-surface);
    overflow: hidden;
  }
  .toc-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .toc-links a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.8125rem;
  }
  .toc-links a:hover { color: var(--color-accent); }

  .content-col { display: flex; flex-direction: column; gap: 1.5rem; }
  .section-head, .guide-section {
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: var(--radius-md);
    background: var(--color-background-surface);
    padding: 1.25rem;
    overflow: hidden;
  }
  .section-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }
  .guide-section h2 { margin: 0 0 1rem; }
  .section-head p, .section-head h1 { margin: 0; }
  .section-head { display: grid; gap: 0.5rem; }

  .spec-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  .stack { display: grid; gap: 1rem; }
  .spec-card {
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: var(--radius-md);
    background: var(--color-background-elevated);
    overflow: hidden;
  }
  .render-box { padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .spec-lines { padding: 0.85rem 1rem; display: grid; gap: 0.25rem; }
  .mono {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .swatch { height: 4rem; border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,0.12); }
  .radius-stage { display: grid; gap: 0.75rem; }
  .radius-demo {
    position: relative;
    height: 6rem;
    background: linear-gradient(135deg, rgba(60,205,127,0.22), rgba(255,255,255,0.06));
    border: 1px solid rgba(255,255,255,0.14);
    overflow: hidden;
  }
  .radius-corner {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 0.25rem;
    background: rgba(5,5,5,0.22);
  }
  .radius-corner.corner-br {
    top: auto;
    left: auto;
    right: 0.75rem;
    bottom: 0.75rem;
  }
  .radius-compare {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .radius-chip {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.06);
  }
  .radius-chip.square { border-radius: 0; opacity: 0.65; }

  .elevation-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .elev-btn {
    border-radius: 9999px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
    color: var(--color-text-secondary);
    padding: 0.4rem 0.7rem;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .elev-btn.is-active {
    border-color: rgba(60,205,127,0.45);
    background: rgba(60,205,127,0.10);
    color: var(--color-text-primary);
  }
  .elevation-stage {
    border-radius: var(--radius-md);
    border: 1px solid rgba(255,255,255,0.08);
    background: radial-gradient(circle at 20% 0%, rgba(60,205,127,0.10), rgba(5,5,5,1) 60%);
    padding: 1.25rem;
  }
  .elevation-target {
    height: 6.5rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255,255,255,0.10);
    background: var(--color-background-surface);
    transition: box-shadow 380ms cubic-bezier(0.16, 1, 0.3, 1), transform 380ms cubic-bezier(0.16, 1, 0.3, 1), background-color 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .elevation-target[data-mode="md"] { box-shadow: var(--shadow-md); }
  .elevation-target[data-mode="lg"] { box-shadow: var(--shadow-lg); }
  .elevation-target[data-mode="diffusion"] { box-shadow: var(--shadow-diffusion); }
  .elevation-target[data-mode="frosted"] {
    background-color: rgba(10,10,10,0.78);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: var(--shadow-frosted);
  }
  .elevation-target[data-mode="glow"] {
    box-shadow: var(--shadow-primary), var(--shadow-diffusion);
