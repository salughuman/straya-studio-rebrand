---
// Styleguide — redirects to homepage in production.
// Dev reference only — token paths updated to new design-tokens.json structure.
import BaseLayout from "../layouts/BaseLayout.astro";
import tokens from "../styles/design-tokens.json";

const title = "Style Guide | Straya Studio";
const description = "Design system reference for Straya Studio.";

const colorSwatches = [
  { label: "Background",          value: tokens.color.background.DEFAULT,         cls: "bg-background" },
  { label: "Surface",             value: tokens.color.background.surface,          cls: "bg-surface" },
  { label: "Container Low",       value: tokens.color.background.containerLow,     cls: "bg-surface-container-low" },
  { label: "Container",           value: tokens.color.background.container,        cls: "bg-surface-container" },
  { label: "Container High",      value: tokens.color.background.containerHigh,    cls: "bg-surface-container-high" },
  { label: "Container Lowest",    value: tokens.color.background.containerLowest,  cls: "bg-surface-container-lowest" },
  { label: "Primary",             value: tokens.color.primary.DEFAULT,             cls: "bg-primary" },
  { label: "Secondary",           value: tokens.color.secondary.DEFAULT,           cls: "bg-secondary" },
  { label: "Accent",              value: tokens.color.accent,                      cls: "bg-accent" },
  { label: "On Background",       value: tokens.color.onBackground.DEFAULT,        cls: "bg-on-background" },
  { label: "Outline",             value: tokens.color.outline.DEFAULT,             cls: "bg-outline" },
  { label: "Success",             value: tokens.color.status.success,              cls: "bg-success" },
  { label: "Error",               value: tokens.color.status.error,                cls: "bg-error" },
];

const typeSpecs = [
  { name: "H1",           sample: "Designing Ideas Into Icons",                          cls: "type-h1",           size: tokens.typography.h1.fontSize,        weight: tokens.typography.h1.fontWeight },
  { name: "H2",           sample: "Section Heading System",                              cls: "type-h2",           size: tokens.typography.h2.fontSize,        weight: tokens.typography.h2.fontWeight },
  { name: "H3",           sample: "Card Heading",                                        cls: "type-h3",           size: tokens.typography.h3.fontSize,        weight: tokens.typography.h3.fontWeight },
  { name: "H4",           sample: "Minor Heading",                                       cls: "type-h4",           size: tokens.typography.h4.fontSize,        weight: tokens.typography.h4.fontWeight },
  { name: "Body",         sample: "Body copy optimized for readability.",                 cls: "type-body",         size: tokens.typography.body.fontSize,      weight: tokens.typography.body.fontWeight },
  { name: "Body Small",   sample: "Supporting copy and descriptions.",                   cls: "type-body-small",   size: tokens.typography.bodySmall.fontSize, weight: tokens.typography.bodySmall.fontWeight },
  { name: "Label",        sample: "UPPERCASE LABEL",                                     cls: "type-label",        size: tokens.typography.label.fontSize,     weight: tokens.typography.label.fontWeight },
  { name: "Caption",      sample: "Caption text for metadata.",                          cls: "type-caption",      size: tokens.typography.caption.fontSize,   weight: tokens.typography.caption.fontWeight },
  { name: "Button",       sample: "INITIATE PROJECT",                                    cls: "type-button",       size: tokens.typography.button.fontSize,    weight: tokens.typography.button.fontWeight },
];
---

<BaseLayout title={title} description={description} noindex>
  <section class="section-y" aria-label="Design system style guide">
    <div class="main-container flex flex-col gap-16">

      <header class="border-b border-black/5 pb-8">
        <span class="type-label text-on-background/40 block mb-3">Internal</span>
        <h1 class="type-h2 text-on-background">Style Guide</h1>
        <p class="type-body-small text-on-surface-variant mt-2">Living reference for tokens, typography, and color.</p>
      </header>

      <!-- Colors -->
      <section aria-labelledby="colors-heading">
        <h2 id="colors-heading" class="type-h3 text-on-background mb-6 pb-4 border-b border-black/5">Color Architecture</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-black/5">
          {colorSwatches.map(c => (
            <div class="bg-background p-4 flex flex-col gap-3">
              <div class:list={["h-12 border border-black/5", c.cls]}></div>
              <div>
                <p class="type-label text-on-background">{c.label}</p>
                <p class="type-caption text-on-background/40 mt-0.5">{c.value}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Typography -->
      <section aria-labelledby="type-heading">
        <h2 id="type-heading" class="type-h3 text-on-background mb-6 pb-4 border-b border-black/5">Typography</h2>
        <div class="flex flex-col gap-px bg-black/5">
          {typeSpecs.map(t => (
            <div class="bg-background p-6 flex items-baseline justify-between gap-8">
              <p class:list={[t.cls, "flex-1"]}>{t.sample}</p>
              <div class="flex-shrink-0 text-right">
                <span class="type-label text-on-background/40 block">{t.name}</span>
                <span class="type-caption text-on-background/30 block">{t.size} / {t.weight}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Spacing & Effects -->
      <section aria-labelledby="effects-heading">
        <h2 id="effects-heading" class="type-h3 text-on-background mb-6 pb-4 border-b border-black/5">Effects & Tokens</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-black/5">
          {[
            { label: "Transition base",    value: tokens.effects.transition.base },
            { label: "Transition elastic", value: tokens.effects.transition.elastic },
            { label: "Duration normal",    value: tokens.effects.duration.normal },
            { label: "Duration slow",      value: tokens.effects.duration.slow },
            { label: "Depth 1",            value: tokens.effects.depth["1"] },
            { label: "Depth 2",            value: tokens.effects.depth["2"] },
            { label: "Border radius",      value: tokens.border.radius.DEFAULT },
            { label: "Grain opacity",      value: String(tokens.effects.grain.opacity) },
            { label: "Cursor",             value: tokens.cursor.DEFAULT },
          ].map(e => (
            <div class="bg-background p-5">
              <p class="type-label text-on-background mb-1">{e.label}</p>
              <p class="type-caption text-on-background/40 font-mono">{e.value}</p>
            </div>
          ))}
        </div>
      </section>

    </div>
  </section>
</BaseLayout>
